# Retro Rewind shard libraries and mod payloads for Switch.
include_guard(GLOBAL)

# 1. Process mod_data_patches_blobs.S for AArch64 ELF
set(_RR_EXTRA_PROCESSED)
foreach(_src IN LISTS MKW_RETRO_EXTRA_SOURCES)
  if(_src MATCHES "\\.S$")
    enable_language(ASM)
    file(READ "${_src}" _rr_blob_text)
    string(REPLACE ".rdata,\"dr\"" ".rodata,\"a\",@progbits" _rr_blob_text "${_rr_blob_text}")
    if(_rr_blob_text MATCHES "\\.incbin \"([^\"]*/mod_data_patches_blobs)/")
      set(_embedded_mod_blob_dir "${CMAKE_MATCH_1}")
      get_filename_component(_real_mod_cpp_dir "${_src}" DIRECTORY)
      set(_real_mod_blob_dir "${_real_mod_cpp_dir}/mod_data_patches_blobs")
      string(REPLACE "\\" "/" _embedded_mod_blob_dir "${_embedded_mod_blob_dir}")
      string(REPLACE "\\" "/" _real_mod_blob_dir "${_real_mod_blob_dir}")
      if(NOT _embedded_mod_blob_dir STREQUAL _real_mod_blob_dir)
        string(REPLACE "${_embedded_mod_blob_dir}" "${_real_mod_blob_dir}" _rr_blob_text "${_rr_blob_text}")
      endif()
    endif()
    set(_rr_blob_local "${CMAKE_BINARY_DIR}/gen/mod_data_patches_blobs.S")
    string(REPLACE "/e/" "E:/" _rr_blob_text "${_rr_blob_text}")
    file(WRITE "${_rr_blob_local}" "${_rr_blob_text}")
    set_source_files_properties("${_rr_blob_local}" PROPERTIES LANGUAGE ASM)
    list(APPEND _RR_EXTRA_PROCESSED "${_rr_blob_local}")
  else()
    set_source_files_properties("${_src}" PROPERTIES COMPILE_OPTIONS "-include;${CMAKE_CURRENT_LIST_DIR}/../src/retro_rewind_mod_shim.h")
    list(APPEND _RR_EXTRA_PROCESSED "${_src}")
  endif()
endforeach()

# 2. Sensitive base shards adapted for Retro Rewind hooks
if(MKW_RETRO_PORTABLE_SENSITIVE_SHARDS)
  add_library(mkw_retro_sensitive OBJECT ${MKW_RETRO_PORTABLE_SENSITIVE_SHARDS})
  target_include_directories(mkw_retro_sensitive PRIVATE ${_RT_INCLUDES})
  target_include_directories(mkw_retro_sensitive SYSTEM PRIVATE "${KARTPAD_RUNTIME_INCLUDE}")
  target_compile_definitions(mkw_retro_sensitive PRIVATE TARGET_PC __SWITCH__=1 NOMINMAX ${_PROFILE_DEFS})
  target_compile_options(mkw_retro_sensitive PRIVATE -O3 ${_FP_OPTS} ${_LEAN_CODEGEN} -fno-slp-vectorize -w -pipe)
  if(KARTPAD_PGO_PROFILE)
    target_compile_options(mkw_retro_sensitive PRIVATE "-fprofile-sample-use=${KARTPAD_PGO_PROFILE}")
  endif()
  set_target_properties(mkw_retro_sensitive PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON)
endif()

# 3. 4,096 translated mod functions from Code.pul + mod_data_patches
add_library(mkw_retro_rewind_functions OBJECT ${MKW_RETRO_MOD_SHARDS} ${_RR_EXTRA_PROCESSED})
target_include_directories(mkw_retro_rewind_functions PRIVATE ${_RT_INCLUDES})
target_include_directories(mkw_retro_rewind_functions SYSTEM PRIVATE "${KARTPAD_RUNTIME_INCLUDE}")
target_compile_definitions(mkw_retro_rewind_functions PRIVATE TARGET_PC __SWITCH__=1 NOMINMAX ${_PROFILE_DEFS})
target_compile_options(mkw_retro_rewind_functions PRIVATE -O3 ${_FP_OPTS} ${_LEAN_CODEGEN} -fno-slp-vectorize -w -pipe)
if(KARTPAD_PGO_PROFILE)
  target_compile_options(mkw_retro_rewind_functions PRIVATE "-fprofile-sample-use=${KARTPAD_PGO_PROFILE}")
endif()
set_target_properties(mkw_retro_rewind_functions PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON)
