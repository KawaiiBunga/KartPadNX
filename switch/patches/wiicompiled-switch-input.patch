--- a/src/hle/input/kpad.cpp
+++ b/src/hle/input/kpad.cpp
@@ -1,23 +1,100 @@
 #include "hle_stubs.h"
+#include "memory.h"
+#if defined(__SWITCH__)
+#include "kartpad_mobile_runtime_host.h"
+#endif
 
+#include <algorithm>
+#include <array>
+#include <cmath>
 #include <cstdint>
+
+namespace {
+#if defined(__SWITCH__)
+constexpr uint32_t kStatusSize = 0x84, kUnifiedSize = 0x38;
+constexpr uint32_t kDev = 0x5C, kErr = 0x5D, kDpd = 0x5E, kFormat = 0x5F;
+constexpr uint32_t kClHold = 0x60, kClTrig = 0x64, kClRelease = 0x68, kClLeft = 0x6C, kClRight = 0x74;
+constexpr uint32_t kClTriggerL = 0x7C, kClTriggerR = 0x80;
+constexpr uint32_t kUDev = 0x28, kUErr = 0x29, kUButtons = 0x2A, kULeftX = 0x2C, kULeftY = 0x2E;
+constexpr uint32_t kURightX = 0x30, kURightY = 0x32, kUTriggerL = 0x34, kUTriggerR = 0x35, kUFormat = 0x36;
+constexpr uint8_t kClassic = 2, kClassicAccDpd = 8;
+struct Channel { uint32_t previous = 0; };
+std::array<Channel, 4> g_channels{};
+
+void Zero(uint32_t address, uint32_t size) { for (uint32_t i = 0; i < size; i += 4) Memory::Write32(address + i, 0); }
+int16_t Stick(float value) { return static_cast<int16_t>(std::lround(std::clamp(value, -1.0f, 1.0f) * 511.0f)); }
+bool Read(uint32_t channel, KartPadMobileClassicInputSnapshot& input) {
+    return KartPadMobileReadClassicInputForPlayer(channel, &input) && input.connected != 0;
+}
+int32_t WriteStatus(uint32_t channel, uint32_t address, const KartPadMobileClassicInputSnapshot* input) {
+    Zero(address, kStatusSize);
+    Channel& state = g_channels[channel];
+    Memory::Write8(address + kDev, kClassic);
+    Memory::Write8(address + kDpd, 0);
+    Memory::Write8(address + kFormat, kClassicAccDpd);
+    if (!input) { state = {}; Memory::Write8(address + kErr, static_cast<uint8_t>(-1)); return 0; }
+    const uint32_t held = input->buttons;
+    Memory::Write32(address + kClHold, held);
+    Memory::Write32(address + kClTrig, held & ~state.previous);
+    Memory::Write32(address + kClRelease, state.previous & ~held);
+    state.previous = held;
+    Memory::WriteFloat32(address + kClLeft, input->leftStickX);
+    Memory::WriteFloat32(address + kClLeft + 4, input->leftStickY);
+    Memory::WriteFloat32(address + kClRight, 0.0f);
+    Memory::WriteFloat32(address + kClRight + 4, 0.0f);
+    Memory::WriteFloat32(address + kClTriggerL, (held & 0x2000u) ? 1.0f : 0.0f);
+    Memory::WriteFloat32(address + kClTriggerR, (held & 0x0200u) ? 1.0f : 0.0f);
+    Memory::Write8(address + kErr, 0);
+    return 1;
+}
+void WriteUnified(uint32_t address, const KartPadMobileClassicInputSnapshot* input) {
+    Zero(address, kUnifiedSize);
+    Memory::Write8(address + kUDev, kClassic);
+    Memory::Write8(address + kUErr, input ? 0 : static_cast<uint8_t>(-1));
+    Memory::Write8(address + kUFormat, kClassicAccDpd);
+    if (!input) return;
+    Memory::Write16(address + kUButtons, static_cast<uint16_t>(input->buttons));
+    Memory::Write16(address + kULeftX, static_cast<uint16_t>(Stick(input->leftStickX)));
+    Memory::Write16(address + kULeftY, static_cast<uint16_t>(Stick(input->leftStickY)));
+    Memory::Write16(address + kURightX, 0); Memory::Write16(address + kURightY, 0);
+    Memory::Write8(address + kUTriggerL, (input->buttons & 0x2000u) ? 255 : 0);
+    Memory::Write8(address + kUTriggerR, (input->buttons & 0x0200u) ? 255 : 0);
+}
+#endif
+} // namespace
 
 extern "C" int32_t KPAD__Read_HLE(uint32_t chan, uint32_t statusPtr, uint32_t count)
 {
+#if defined(__SWITCH__)
+    if (chan >= g_channels.size() || !statusPtr || !count) return 0;
+    KartPadMobileClassicInputSnapshot input{};
+    try { return WriteStatus(chan, statusPtr, Read(chan, input) ? &input : nullptr); }
+    catch (const Memory::AccessViolation&) { return 0; }
+#else
     (void)chan;
     (void)statusPtr;
     (void)count;
     return 0;
+#endif
 }
 PPC_NATIVE_OVERRIDE(80197380, KPAD__Read_HLE, int32_t, (uint32_t chan, uint32_t statusPtr, uint32_t count),
         (chan, statusPtr, count));
 
 extern "C" int32_t KPAD__GetUnifiedWpadStatus_HLE(uint32_t chan, uint32_t statusPtr, uint32_t count)
 {
+#if defined(__SWITCH__)
+    if (chan >= g_channels.size() || !statusPtr || !count) return 0;
+    KartPadMobileClassicInputSnapshot input{};
+    const bool connected = Read(chan, input);
+    try { for (uint32_t i = 0; i < std::min(count, 16u); ++i) WriteUnified(statusPtr + i * kUnifiedSize, connected ? &input : nullptr); }
+    catch (const Memory::AccessViolation&) { return 0; }
+    return connected ? 1 : 0;
+#else
     (void)chan;
     (void)statusPtr;
     (void)count;
     return 0;
+#endif
 }
 PPC_NATIVE_OVERRIDE(8019812C, KPAD__GetUnifiedWpadStatus_HLE, int32_t,
         (uint32_t chan, uint32_t statusPtr, uint32_t count), (chan, statusPtr, count));
