diff --git a/runtime/include/perf_diag.h b/runtime/include/perf_diag.h
--- /dev/null
+++ b/runtime/include/perf_diag.h
@@ -0,0 +1,65 @@
+#pragma once
+
+// Part 0 audio+performance diagnostics (see docs/AUDIO-PERF-PLAN.md).
+//
+// A self-contained, always-safe telemetry collector. Probe sites call the cheap
+// Note* functions (atomic increments / min-max updates); a background reporter
+// thread flushes a consolidated once-per-second line to
+// sdmc:/switch/kartpad/perf.txt (and stderr). The goal is one hardware boot that
+// answers: is the frame CPU-bound or GPU/submission-bound, and is audio dead,
+// starved, or wrong. Nothing here touches the translated ISA headers, so it is
+// cheap to compile and safe to leave in.
+//
+// All functions are no-throw and safe to call before Start(); counters simply
+// accumulate. Timing values are microseconds unless noted.
+
+#include <cstdint>
+
+namespace PerfDiag {
+
+// Starts the 1 Hz reporter thread (idempotent). Call once the runtime is up.
+void Start();
+// Joins the reporter thread and writes a final line (idempotent).
+void Stop();
+
+// ---- Frame / render ----
+// Called at each Aurora present (aurora_end_frame). realXfb=false for the
+// black/boot/overlay-only presents so game frames can be counted separately.
+void NoteFramePresented(bool realXfb);
+// Wall time spent inside aurora_end_frame() — the GPU submit/present cost.
+void NoteEndFrameMicros(uint64_t micros);
+// Wall time spent servicing the Aurora frame-worker wait callback — time Aurora
+// blocks waiting on the render worker / GPU. High values ⇒ GPU/submission-bound.
+void NoteFrameWorkerWaitMicros(uint64_t micros);
+// The VI retrace interval the guest is pacing to (16666=60Hz, 20000=50Hz PAL).
+void NoteViRetraceIntervalMicros(uint64_t micros);
+
+// ---- Audio ----
+// One-shot: result of opening the host audio device.
+void NoteAudioOpen(bool ok, uint32_t rate, uint32_t channels, int sdlFormat);
+// Called on every attempted push with the current output-queue depth and cap.
+void NoteAudioQueue(int queuedBytes, uint32_t limitBytes);
+// A block was dropped because the output queue was full.
+void NoteAudioDrop();
+// The output queue was observed empty while audio was active (a DAC underrun).
+void NoteAudioUnderrun();
+// PCM actually submitted to SDL: samples at the signed-16-bit rails and jumps
+// at DMA-block seams help distinguish clipping from output starvation.
+void NoteAudioPcm(uint32_t sampleCount, uint32_t railCount, uint32_t seamJump,
+                  uint32_t interiorJump);
+// AX/AI-DMA blocks actually pushed to the backend this tick.
+void NoteAxBlocksPushed(int count);
+// The per-tick drain loop hit kMaxBlocksPerTick (we are behind on audio).
+void NoteAxTickCap();
+// Wall time spent inside one Audio_HLE_Tick (AX mix + guest AI-DMA callbacks),
+// all of which runs on the guest thread. Large values ⇒ audio is stealing the
+// guest core from game logic and is a candidate to move off-thread.
+void NoteAudioTickMicros(uint64_t micros);
+
+// ---- Threading / cores ----
+// Called from the guest thread; records which physical core it is running on
+// (and, once, its affinity mask + the applet type). Reveals whether the guest
+// thread is pinned, bouncing across cores, or sharing a core with helpers.
+void NoteGuestCoreSample();
+
+}  // namespace PerfDiag
