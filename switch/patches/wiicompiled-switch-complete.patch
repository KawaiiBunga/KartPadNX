+constexpr uint32_t kClassicHold = 0x60, kClassicTrig = 0x64, kClassicRelease = 0x68;
+constexpr uint32_t kClassicLeftX = 0x6C, kClassicRightX = 0x74;
+constexpr uint32_t kClassicTriggerL = 0x7C, kClassicTriggerR = 0x80;
+constexpr uint32_t kUnifiedClassicButtons = 0x2A, kUnifiedClassicLeftX = 0x2C;
+constexpr uint32_t kUnifiedClassicLeftY = 0x2E, kUnifiedClassicRightX = 0x30;
+constexpr uint32_t kUnifiedClassicRightY = 0x32, kUnifiedClassicTriggerL = 0x34;
+constexpr uint32_t kUnifiedClassicTriggerR = 0x35, kUnifiedFormat = 0x36;
+constexpr uint8_t kClassicDevice = 2;       // WPAD_DEV_CLASSIC
+constexpr uint8_t kClassicAccDpdFormat = 8; // WPAD_FMT_CLASSIC_ACC_DPD
+constexpr int8_t kNoError = 0;
+
+struct ChannelState { uint32_t previousButtons = 0; };
+std::array<ChannelState, 4> g_channels{};
+
+int16_t RawStick(float value) {
+    const float clamped = std::clamp(value, -1.0f, 1.0f);
+    return static_cast<int16_t>(std::lround(clamped * 511.0f));
+}
+
+void ZeroGuest(uint32_t address, uint32_t bytes) {
+    for (uint32_t offset = 0; offset < bytes; offset += 4) Memory::Write32(address + offset, 0);
+}
+
+bool ReadInput(uint32_t channel, KartPadMobileClassicInputSnapshot& input) {
+    return KartPadMobileReadClassicInputForPlayer(channel, &input) && input.connected != 0;
+}
+
+int32_t WriteKpadStatus(uint32_t channel, uint32_t address, const KartPadMobileClassicInputSnapshot* input) {
+    ZeroGuest(address, kKpadStatusSize);
+    ChannelState& state = g_channels[channel];
+    if (input == nullptr) {
+        state = {};
+        Memory::Write8(address + kDevType, kClassicDevice);
+        Memory::Write8(address + kWpadErr, static_cast<uint8_t>(-1));
+        return 0;
+    }
+    const uint32_t held = input->buttons;
+    Memory::Write32(address + kHold, 0); // Remote buttons; the Switch supplies the extension only.
+    Memory::Write32(address + kClassicHold, held);
+    Memory::Write32(address + kClassicTrig, held & ~state.previousButtons);
+    Memory::Write32(address + kClassicRelease, state.previousButtons & ~held);
+    state.previousButtons = held;
+    Memory::WriteFloat32(address + kClassicLeftX, input->leftStickX);
+    Memory::WriteFloat32(address + kClassicLeftX + 4, input->leftStickY);
+    Memory::WriteFloat32(address + kClassicRightX, 0.0f);
+    Memory::WriteFloat32(address + kClassicRightX + 4, 0.0f);
+    Memory::WriteFloat32(address + kClassicTriggerL, (held & 0x2000u) ? 1.0f : 0.0f);
+    Memory::WriteFloat32(address + kClassicTriggerR, (held & 0x0200u) ? 1.0f : 0.0f);
+    Memory::Write8(address + kDevType, kClassicDevice);
+    Memory::Write8(address + kWpadErr, kNoError);
+    Memory::Write8(address + kDpdValid, 0);
+    Memory::Write8(address + kDataFormat, kClassicAccDpdFormat);
+    return 1;
+}
+
+void WriteUnifiedStatus(uint32_t address, const KartPadMobileClassicInputSnapshot* input) {
+    ZeroGuest(address, kUnifiedStatusSize);
+    Memory::Write8(address + 0x28, kClassicDevice);
+    Memory::Write8(address + 0x29, input ? kNoError : static_cast<uint8_t>(-1));
+    Memory::Write8(address + kUnifiedFormat, kClassicAccDpdFormat);
+    if (input == nullptr) return;
+    Memory::Write16(address + kUnifiedClassicButtons, static_cast<uint16_t>(input->buttons));
+    Memory::Write16(address + kUnifiedClassicLeftX, static_cast<uint16_t>(RawStick(input->leftStickX)));
+    Memory::Write16(address + kUnifiedClassicLeftY, static_cast<uint16_t>(RawStick(input->leftStickY)));
+    Memory::Write16(address + kUnifiedClassicRightX, 0);
+    Memory::Write16(address + kUnifiedClassicRightY, 0);
+    Memory::Write8(address + kUnifiedClassicTriggerL, (input->buttons & 0x2000u) ? 255 : 0);
+    Memory::Write8(address + kUnifiedClassicTriggerR, (input->buttons & 0x0200u) ? 255 : 0);
+}
+#endif
+
+} // namespace
 
