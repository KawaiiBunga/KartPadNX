+    // this region, so reading the already validated records is safe.
+    unsigned prefix = 0;
+    while (prefix < 8 && Word(a + prefix*4) == Word(b + prefix*4)) ++prefix;
+    r4 = 0; r10 = prefix >= 4; r11 = prefix >= 3; r12 = prefix >= 2;
+    r9 = Word(a + (prefix < 4 ? prefix : 4) * 4);
