+BlobCacheStats blob_cache_stats() noexcept {
+  BlobCacheStats result{lookups.load(), hits.load(), stores.load(), hitBytes.load(), loadMicros.load(), storeMicros.load()};
+  std::shared_ptr<BlobCache> instance;
+  { std::lock_guard lock(initMutex); instance = cache; }
