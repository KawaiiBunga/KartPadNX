diff --git a/aurora-main/cmake/AuroraSwitchDawnPatches.cmake b/aurora-main/cmake/AuroraSwitchDawnPatches.cmake
--- /dev/null
+++ b/aurora-main/cmake/AuroraSwitchDawnPatches.cmake
@@ -0,0 +1,75 @@
+# Source patches for the pinned Dawn fork's upstream Abseil submodule. libnx
+# pthread_t is an opaque pointer and HOS does not expose POSIX signal masks.
+function(_aurora_switch_dawn_replace file description before after)
+  file(READ "${file}" content)
+  string(FIND "${content}" "${after}" already)
+  if (NOT already EQUAL -1)
+    return()
+  endif ()
+  string(FIND "${content}" "${before}" found)
+  if (found EQUAL -1)
+    message(FATAL_ERROR "Switch Dawn patch '${description}' does not match ${file}; review the pinned dependency version")
+  endif ()
+  string(REPLACE "${before}" "${after}" content "${content}")
+  file(WRITE "${file}" "${content}")
+endfunction()
+
+function(aurora_switch_dawn_apply_patches source)
+  set(_absl "${source}/third_party/abseil-cpp/absl/base/internal")
+  _aurora_switch_dawn_replace("${_absl}/sysinfo.cc" "libnx thread handle include"
+[=[#include "absl/base/internal/sysinfo.h"]=]
+[=[#include "absl/base/internal/sysinfo.h"
+#if defined(__SWITCH__)
+#include <switch.h>
+#endif]=])
+  _aurora_switch_dawn_replace("${_absl}/sysinfo.cc" "libnx thread identifier"
+[=[// Fallback implementation of `GetTID` using `pthread_self`.
+pid_t GetTID() {]=]
+[=[// Fallback implementation of `GetTID` using `pthread_self`.
+pid_t GetTID() {
+#if defined(__SWITCH__)
+  return static_cast<pid_t>(threadGetCurHandle());
+#else]=])
+  _aurora_switch_dawn_replace("${_absl}/sysinfo.cc" "libnx thread identifier end"
+[=[  return static_cast<pid_t>(pthread_self());
+}]=]
+[=[  return static_cast<pid_t>(pthread_self());
+#endif
+}]=])
+  _aurora_switch_dawn_replace("${_absl}/thread_identity.cc" "libnx has no POSIX signals"
+[=[    defined(__hexagon__)
+  // Emscripten, WASI and MinGW]=]
+[=[    defined(__hexagon__) || defined(__SWITCH__)
+  // Emscripten, WASI and MinGW]=])
+  set(_cctz "${source}/third_party/abseil-cpp/absl/time/internal/cctz/src/time_zone_libc.cc")
+  _aurora_switch_dawn_replace("${_cctz}" "newlib timezone ABI"
+[=[#include "absl/base/config.h"]=]
+[=[#include "absl/base/config.h"
+#if defined(__SWITCH__)
+extern "C" {
+#include <sys/_tz_structs.h>
+extern char *_tzname[2];
+}
+#endif]=])
+  _aurora_switch_dawn_replace("${_cctz}" "newlib timezone offset"
+[=[#elif defined(__VXWORKS__)
+// Uses the globals: 'timezone' and 'tzname'.]=]
+[=[#elif defined(__SWITCH__)
+// newlib keeps the UTC offsets in its timezone rules rather than struct tm.
+long tm_gmtoff(const std::tm& tm) {
+  return -__gettzinfo()->__tzrule[tm.tm_isdst > 0 ? 1 : 0].offset;
+}
+const char* tm_zone(const std::tm& tm) {
+  return _tzname[tm.tm_isdst > 0 ? 1 : 0];
+}
+#elif defined(__VXWORKS__)
+// Uses the globals: 'timezone' and 'tzname'.]=])
+  _aurora_switch_dawn_replace("${source}/third_party/abseil-cpp/absl/debugging/internal/elf_mem_image.h" "HOS has no ELF loader or VDSO"
+[=[    !defined(__XTENSA__)
+#define ABSL_HAVE_ELF_MEM_IMAGE 1]=]
+[=[    !defined(__XTENSA__) && !defined(__SWITCH__)
+#define ABSL_HAVE_ELF_MEM_IMAGE 1]=])
+endfunction()
+if (DEFINED AURORA_SWITCH_DAWN_SOURCE_DIR)
+  aurora_switch_dawn_apply_patches("${AURORA_SWITCH_DAWN_SOURCE_DIR}")
+endif ()
diff --git a/aurora-main/cmake/AuroraSwitchSQLite.cmake b/aurora-main/cmake/AuroraSwitchSQLite.cmake
--- /dev/null
+++ b/aurora-main/cmake/AuroraSwitchSQLite.cmake
@@ -0,0 +1,19 @@
+function(aurora_configure_switch_sqlite target)
+  get_target_property(_already_configured ${target} _AURORA_SWITCH_SQLITE_CONFIGURED)
+  if(_already_configured)
+    return()
+  endif()
+  set_target_properties(${target} PROPERTIES _AURORA_SWITCH_SQLITE_CONFIGURED TRUE)
+  get_target_property(_sqlite_sources ${target} SOURCES)
+  list(GET _sqlite_sources 0 _sqlite_source)
+  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/AuroraSwitchDawnPatches.cmake")
+  # OS_OTHER otherwise selects noop mutexes even when pthreads were explicitly
+  # requested. Keep SQLite's real pthread mutex implementation on libnx.
+  _aurora_switch_dawn_replace("${_sqlite_source}" "SQLite explicit HOS pthread mutexes"
+    "#if SQLITE_THREADSAFE && !defined(SQLITE_MUTEX_NOOP)"
+    "#if SQLITE_THREADSAFE && !defined(SQLITE_MUTEX_NOOP) && !defined(SQLITE_MUTEX_PTHREADS)")
+  target_sources(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../lib/switch/sqlite_vfs.cpp")
+  target_compile_features(${target} PRIVATE cxx_std_17)
+  target_compile_definitions(${target} PRIVATE SQLITE_OS_OTHER=1 SQLITE_MUTEX_PTHREADS
+    SQLITE_OMIT_WAL SQLITE_MAX_MMAP_SIZE=0 SQLITE_OMIT_LOAD_EXTENSION SQLITE_TEMP_STORE=3)
+endfunction()
