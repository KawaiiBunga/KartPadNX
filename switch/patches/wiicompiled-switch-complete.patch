+    // Frame / render
+    uint64_t framesReal = 0;
+    uint64_t framesBlack = 0;
+    uint64_t periodCount = 0;
+    uint64_t periodSumUs = 0;
+    uint64_t periodMinUs = ~0ull;
+    uint64_t periodMaxUs = 0;
+    uint64_t endFrameCount = 0;
+    uint64_t endFrameSumUs = 0;
+    uint64_t endFrameMaxUs = 0;
+    uint64_t workerWaitCount = 0;
+    uint64_t workerWaitSumUs = 0;
+    uint64_t workerWaitMaxUs = 0;
+    // Audio
+    uint64_t audioPushes = 0;
+    uint64_t audioQueuedSumBytes = 0;
+    int      audioQueuedMinBytes = -1;
+    int      audioQueuedMaxBytes = 0;
+    uint64_t audioDrops = 0;
+    uint64_t audioUnderruns = 0;
+    uint64_t audioPcmSamples = 0;
+    uint64_t audioPcmRails = 0;
+    uint64_t audioSeamsOver16k = 0;
+    uint32_t audioMaxSeamJump = 0;
+    uint32_t audioMaxInteriorJump = 0;
+    uint64_t axBlocksPushed = 0;
+    uint64_t axTickCaps = 0;
+    uint64_t audioTickCount = 0;
+    uint64_t audioTickSumUs = 0;
+    uint64_t audioTickMaxUs = 0;
+    // Individual frame periods this interval, for real percentiles.
+    static constexpr size_t kMaxPeriodSamples = 256;
+    uint32_t periodSamplesUs[kMaxPeriodSamples] = {};
+    uint32_t periodSampleCount = 0;
+
+    void reset() { *this = Interval{}; }
+};
+
+struct State {
+    std::mutex mutex;
+    Interval iv;
+
+    // One-shot / latched facts.
+    bool audioOpenSeen = false;
+    bool audioOpenOk = false;
+    uint32_t audioRate = 0;
+    uint32_t audioChannels = 0;
+    int audioFormat = 0;
+    uint32_t audioQueueLimit = 0;
+    uint64_t viRetraceUs = 0;
+
+    // Guest-thread core placement (OR of (1<<core) seen at each sample).
+    uint32_t guestCoreMask = 0;
+    bool sysInfoLogged = false;
+
+    // Frame-period tracking.
+    bool haveLastPresent = false;
+    Clock::time_point lastPresent{};
+
+    // Reporter thread.
+    std::thread thread;
+    std::atomic_bool running{false};
+    std::atomic_bool started{false};
+
+    // PC sampler: a helper-core thread samples the guest thread's current
+    // indirect-dispatch target (RecompMod::g_publishedGuestPc) at ~1 kHz and
+    // histograms it by function-entry address. The 1 Hz reporter drains and
+    // prints the hottest targets, so one hardware run says which translated
+    // functions the (single, core-0) guest thread actually spends the frame in.
+    std::thread samplerThread;
+    std::mutex pcMutex;
+    std::unordered_map<uint64_t, uint32_t> pcBuckets;  // host addr -> hit count
+    uint64_t pcSamples = 0;
+    uint64_t pcZeroSamples = 0;  // sampled between dispatch scopes (addr==0)
+};
+
+State& S() {
+    static State state;
+    return state;
+}
+
+void WriteLine(const std::string& line) {
+#if defined(__SWITCH__)
+    if (std::FILE* f = std::fopen("sdmc:/switch/kartpad/perf.txt", "a")) {
+        std::fwrite(line.data(), 1, line.size(), f);
+        std::fflush(f);
+        fsync(fileno(f));
+        std::fclose(f);
+    }
+#else
+    if (std::FILE* f = std::fopen("perf.txt", "a")) {
+        std::fwrite(line.data(), 1, line.size(), f);
+        std::fflush(f);
+        std::fclose(f);
+    }
+#endif
+    // Also mirror to stderr (redirected to the SD runtime log on Switch).
+    std::fwrite(line.data(), 1, line.size(), stderr);
+    std::fflush(stderr);
+}
+
+std::string FormatReport(const Interval& iv, const State& st) {
+    char buf[1024];
+    const double totalFrames = static_cast<double>(iv.framesReal + iv.framesBlack);
+    const double meanPeriodMs =
+        iv.periodCount ? (static_cast<double>(iv.periodSumUs) / iv.periodCount) / 1000.0 : 0.0;
+    const double minPeriodMs =
+        iv.periodMinUs == ~0ull ? 0.0 : static_cast<double>(iv.periodMinUs) / 1000.0;
+    const double maxPeriodMs = static_cast<double>(iv.periodMaxUs) / 1000.0;
+    const double meanEndFrameMs =
+        iv.endFrameCount ? (static_cast<double>(iv.endFrameSumUs) / iv.endFrameCount) / 1000.0 : 0.0;
+    const double maxEndFrameMs = static_cast<double>(iv.endFrameMaxUs) / 1000.0;
+    const double workerWaitMsPerSec = static_cast<double>(iv.workerWaitSumUs) / 1000.0;
+    const double maxWorkerWaitMs = static_cast<double>(iv.workerWaitMaxUs) / 1000.0;
+    const double meanQueued =
+        iv.audioPushes ? static_cast<double>(iv.audioQueuedSumBytes) / iv.audioPushes : 0.0;
+    const double audioTickMsPerSec = static_cast<double>(iv.audioTickSumUs) / 1000.0;
+    const double meanAudioTickMs =
+        iv.audioTickCount ? (static_cast<double>(iv.audioTickSumUs) / iv.audioTickCount) / 1000.0
+                          : 0.0;
+    const double maxAudioTickMs = static_cast<double>(iv.audioTickMaxUs) / 1000.0;
+
+    std::snprintf(
+        buf, sizeof(buf),
+        "[perf] fps=%.1f (real=%llu black=%llu) period(ms) mean=%.2f min=%.2f max=%.2f | "
+        "endFrame(ms) mean=%.2f max=%.2f | workerWait ms/s=%.2f max=%.2f viIntervalUs=%llu | "
+        "coreMask=0x%x | audioTick ms/s=%.2f mean=%.2f max=%.2f | "
+        "audio open=%s rate=%u ch=%u fmt=%d | queue(bytes) mean=%.0f min=%d max=%d limit=%u "
+        "under=%llu drop=%llu | pcm rail=%llu/%llu seam16k=%llu max=%u inside=%u | ax blk/s=%llu tickCap/s=%llu\n",
+        totalFrames, (unsigned long long)iv.framesReal, (unsigned long long)iv.framesBlack,
+        meanPeriodMs, minPeriodMs, maxPeriodMs, meanEndFrameMs, maxEndFrameMs, workerWaitMsPerSec,
+        maxWorkerWaitMs, (unsigned long long)st.viRetraceUs, st.guestCoreMask, audioTickMsPerSec,
+        meanAudioTickMs, maxAudioTickMs,
+        st.audioOpenSeen ? (st.audioOpenOk ? "ok" : "FAIL") : "n/a", st.audioRate,
+        st.audioChannels, st.audioFormat, meanQueued, iv.audioQueuedMinBytes,
+        iv.audioQueuedMaxBytes, st.audioQueueLimit, (unsigned long long)iv.audioUnderruns,
+        (unsigned long long)iv.audioDrops, (unsigned long long)iv.audioPcmRails,
+        (unsigned long long)iv.audioPcmSamples, (unsigned long long)iv.audioSeamsOver16k,
+        iv.audioMaxSeamJump, iv.audioMaxInteriorJump, (unsigned long long)iv.axBlocksPushed,
+        (unsigned long long)iv.axTickCaps);
+    return std::string(buf);
+}
+
+// Builds the "hottest guest functions this second" line from the sampler
+// histogram, then clears it for the next interval. Addresses are guest PPC
+// function-entry points (indirect-dispatch targets) to resolve offline against
+// build/wiicompiled-fpscr/projects/mkwii/MAP.txt. Caller must NOT hold pcMutex.
+std::string DrainPcReport(State& st) {
+    std::vector<std::pair<uint64_t, uint32_t>> top;
+    uint64_t samples = 0;
+    uint64_t zero = 0;
+    {
+        std::lock_guard<std::mutex> lock(st.pcMutex);
+        samples = st.pcSamples;
+        zero = st.pcZeroSamples;
+        top.assign(st.pcBuckets.begin(), st.pcBuckets.end());
+        st.pcBuckets.clear();
+        st.pcSamples = 0;
+        st.pcZeroSamples = 0;
+    }
+    if (samples == 0 && zero == 0) {
+        return std::string();
+    }
+    constexpr size_t kTopN = 14;
+    if (top.size() > kTopN) {
+        std::partial_sort(top.begin(), top.begin() + kTopN, top.end(),
+                          [](const auto& a, const auto& b) { return a.second > b.second; });
+        top.resize(kTopN);
+    } else {
+        std::sort(top.begin(), top.end(),
+                  [](const auto& a, const auto& b) { return a.second > b.second; });
+    }
+    const double denom = static_cast<double>(samples + zero);
+    std::string line = "[perf] guestPC/s samples=";
+    line += std::to_string(samples);
+    if (zero) {
+        char z[48];
+        std::snprintf(z, sizeof(z), " idle=%.1f%%", denom ? 100.0 * zero / denom : 0.0);
+        line += z;
+    }
+    line += " top:";
+    for (const auto& [addr, count] : top) {
+        char e[64];
+        std::snprintf(e, sizeof(e), " %016llx=%.1f%%", static_cast<unsigned long long>(addr),
+                      denom ? 100.0 * count / denom : 0.0);
+        line += e;
+    }
+    line += "\n";
+    return line;
+}
+
+void SamplerLoop() {
+    State& st = S();
+    {
+#if defined(__SWITCH__)
+        const unsigned core = static_cast<unsigned>(svcGetCurrentProcessorNumber());
+#else
+        const unsigned core = 0;
+#endif
+        char m[96];
+        std::snprintf(m, sizeof(m), "[perf] sampler thread live core=%u\n", core);
+        WriteLine(m);
+    }
+
+#if defined(__SWITCH__)
+    Handle main_thread = envGetMainThreadHandle();
+#endif
+
+    while (st.running.load(std::memory_order_acquire)) {
+        uint64_t pc = 0;
+#if defined(__SWITCH__)
+        if (R_SUCCEEDED(svcSetThreadActivity(main_thread, ThreadActivity_Paused))) {
+            ThreadContext ctx{};
+            if (R_SUCCEEDED(svcGetThreadContext3(&ctx, main_thread))) {
+                pc = ctx.pc.x;
+            }
+            svcSetThreadActivity(main_thread, ThreadActivity_Runnable);
+        }
+#else
+        pc = RecompMod::g_publishedGuestPc;
+#endif
+
+        {
+            std::lock_guard<std::mutex> lock(st.pcMutex);
+            if (pc != 0) {
+                ++st.pcBuckets[pc];
+                ++st.pcSamples;
+            } else {
+                ++st.pcZeroSamples;
+            }
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+}
+
+extern "C" void MkwReportNativeScene() __attribute__((weak));
+
+// One line per second splitting the frame: guest-thread FIFO drain (Aurora GX
+// decode + draw recording), pipeline waits/compiles, per-thread CPU%, and real
+// frame-period percentiles. `ms/s` values are wall time per second of report.
+std::string FormatStages(Interval& iv) {
+    std::string line = "[stages]";
+    char part[192];
+    if (iv.periodSampleCount != 0) {
+        std::sort(iv.periodSamplesUs, iv.periodSamplesUs + iv.periodSampleCount);
+        const auto pct = [&](double p) {
+            size_t idx = static_cast<size_t>(p * (iv.periodSampleCount - 1) + 0.5);
+            return iv.periodSamplesUs[std::min<size_t>(idx, iv.periodSampleCount - 1)] / 1000.0;
+        };
+        uint32_t late = 0;
+        for (uint32_t i = 0; i < iv.periodSampleCount; ++i) {
+            if (iv.periodSamplesUs[i] > 17500) ++late;
+        }
+        std::snprintf(part, sizeof(part), " frame p50=%.1f p95=%.1f p99=%.1f late60=%u/%u", pct(0.50), pct(0.95),
+                      pct(0.99), late, iv.periodSampleCount);
+        line += part;
+    }
+#if defined(__SWITCH__)
+    static uint64_t lastFifo[4] = {};
+    if (aurora_switch_fifo_counters) {
+        uint64_t f[4] = {};
+        aurora_switch_fifo_counters(f);
+        std::snprintf(part, sizeof(part), " | fifo ms/s=%.1f wait ms/s=%.1f drains=%llu KB=%llu",
+                      (f[1] - lastFifo[1]) / 1e6, (f[0] - lastFifo[0]) / 1e6,
+                      static_cast<unsigned long long>(f[3] - lastFifo[3]),
+                      static_cast<unsigned long long>((f[2] - lastFifo[2]) / 1024));
+        line += part;
+        std::copy(f, f + 4, lastFifo);
+    }
+    static uint64_t lastPipe[7] = {};
+    if (aurora_switch_pipeline_counters) {
+        uint64_t p[7] = {};
+        aurora_switch_pipeline_counters(p);
+        const uint64_t compiles = p[4] - lastPipe[4];
+        std::snprintf(part, sizeof(part),
+                      " | pipe guestWait ms/s=%.1f waits=%llu sync=%llu compiles=%llu avg=%.0fms queued=%llu",
+                      (p[0] - lastPipe[0]) / 1e3, static_cast<unsigned long long>(p[1] - lastPipe[1]),
+                      static_cast<unsigned long long>(p[2] - lastPipe[2]), static_cast<unsigned long long>(compiles),
+                      compiles ? (p[3] - lastPipe[3]) / 1e3 / compiles : 0.0, static_cast<unsigned long long>(p[6]));
+        line += part;
+        std::copy(p, p + 7, lastPipe);
+    }
+    {
+        // VIWaitForRetrace pacing (hle/vi.cpp): calls and late-frame skips.
+        static uint32_t lastViCalls = 0, lastViSkips = 0;
+        const uint32_t calls = g_viWaitCalls.load(std::memory_order_relaxed);
+        const uint32_t skips = g_viWaitsSkippedLate.load(std::memory_order_relaxed);
+        std::snprintf(part, sizeof(part), " | viwait calls=%u skipped=%u", calls - lastViCalls, skips - lastViSkips);
+        line += part;
+        lastViCalls = calls;
+        lastViSkips = skips;
+        static uint32_t lastPump = 0, lastPumpOff = 0;
+        const uint32_t pump = g_audioPumpCalls.load(std::memory_order_relaxed);
+        const uint32_t pumpOff = g_audioPumpIrqOff.load(std::memory_order_relaxed);
+        std::snprintf(part, sizeof(part), " | apump calls=%u irqoff=%u", pump - lastPump, pumpOff - lastPumpOff);
+        line += part;
+        lastPump = pump;
+        lastPumpOff = pumpOff;
+    }
+    static uint64_t lastDl[10] = {};
+    if (kartpad_dl_counters) {
+        uint64_t dl[10] = {};
+        kartpad_dl_counters(dl);
+        constexpr double kTicksPerMs = 19200.0;
+        std::snprintf(part, sizeof(part),
+                      " | dl reg=%llu uniq=%llu %.1fms (aurora %.1f) %lluKB draw=%llu uniq=%llu %.1fms (aurora %.1f) %lluKB",
+                      static_cast<unsigned long long>(dl[0] - lastDl[0]),
+                      static_cast<unsigned long long>(dl[8] - lastDl[8]), (dl[1] - lastDl[1]) / kTicksPerMs,
+                      (dl[6] - lastDl[6]) / kTicksPerMs, static_cast<unsigned long long>((dl[2] - lastDl[2]) / 1024),
+                      static_cast<unsigned long long>(dl[3] - lastDl[3]),
+                      static_cast<unsigned long long>(dl[9] - lastDl[9]), (dl[4] - lastDl[4]) / kTicksPerMs,
+                      (dl[7] - lastDl[7]) / kTicksPerMs, static_cast<unsigned long long>((dl[5] - lastDl[5]) / 1024));
+        line += part;
+        std::copy(dl, dl + 10, lastDl);
+    }
+    // aurora_switch_gx_worker_counters fills 10 slots (gx_worker.cpp); the array is oversized so an
+    // older/newer Aurora can never write past it.
+    static uint64_t lastGxw[16] = {};
+    if (aurora_switch_gx_worker_counters) {
+        uint64_t g[16] = {};
+        aurora_switch_gx_worker_counters(g);
+        if (g[6] != 0) {
+            // GX decode worker: records/s, MB/s, guest syncs and their wait, ring-full stalls,
+            // the worker's own busy time, how often the guest had to wake a sleeping worker,
+            // wake-ups the wait timeout had to rescue (must stay 0; non-zero = broken wake path) and
+            // late signals (a timeout racing a publish; a few per run are normal).
+            std::snprintf(part, sizeof(part),
+                          " | gxw rec=%llu MB=%.1f sync=%llu wait ms/s=%.1f full ms/s=%.1f busy ms/s=%.1f wakes=%llu"
+                          " rescued=%llu late=%llu",
+                          static_cast<unsigned long long>(g[0] - lastGxw[0]), (g[1] - lastGxw[1]) / 1048576.0,
+                          static_cast<unsigned long long>(g[2] - lastGxw[2]), (g[3] - lastGxw[3]) / 1e6,
+                          (g[4] - lastGxw[4]) / 1e6, (g[5] - lastGxw[5]) / 1e6,
+                          static_cast<unsigned long long>(g[7] - lastGxw[7]),
+                          static_cast<unsigned long long>(g[8] - lastGxw[8]),
+                          static_cast<unsigned long long>(g[9] - lastGxw[9]));
+            line += part;
+        }
+        std::copy(g, g + 16, lastGxw);
+    }
+    // DVD reads (dvd_contract.h): synchronous reads on the game thread and their time, then the
+    // read-ahead: requests served from a prefetched block (and how many waited for one in flight),
+    // blocks fetched in the background, and handle-cache (re)opens.
+    static uint64_t lastDvd[8] = {};
+    if (kartpad_dvd_counters) {
+        uint64_t d[8] = {};
+        kartpad_dvd_counters(d);
+        std::snprintf(part, sizeof(part), " | dvd reads=%llu KB=%llu ms=%.1f ra hit=%llu wait=%llu fetched=%llu opens=%llu",
+                      static_cast<unsigned long long>(d[0] - lastDvd[0]),
+                      static_cast<unsigned long long>((d[1] - lastDvd[1]) / 1024),
+                      (d[2] - lastDvd[2]) / 1e6, static_cast<unsigned long long>(d[3] - lastDvd[3]),
+                      static_cast<unsigned long long>(d[4] - lastDvd[4]),
+                      static_cast<unsigned long long>(d[5] - lastDvd[5]),
+                      static_cast<unsigned long long>(d[6] - lastDvd[6]));
+        line += part;
+        std::copy(d, d + 8, lastDvd);
+    }
+    // ax_mix_split (ax_mix.cpp): split PB lists and serial ones, helper busy and mix-worker wait
+    // time, lost (must stay 0) and late wake-ups, verified lists and mismatches (must stay 0),
+    // voices mixed by the mix worker / helper / game thread, and the game thread's mixing time.
+    static uint64_t lastSplit[16] = {};
+    if (kartpad_ax_split_counters) {
+        uint64_t a[16] = {};
+        kartpad_ax_split_counters(a);
+        if (a[0] != 0 || a[1] != 0) {
+            constexpr double kTicksPerMs = 19200.0;
+            std::snprintf(part, sizeof(part),
+                          " | axsplit lists=%llu serial=%llu helper ms/s=%.1f wait ms/s=%.1f lost=%llu late=%llu"
+                          " verified=%llu bad=%llu voices w/h/g=%llu/%llu/%llu guest ms/s=%.1f",
+                          static_cast<unsigned long long>(a[0] - lastSplit[0]),
+                          static_cast<unsigned long long>(a[1] - lastSplit[1]), (a[2] - lastSplit[2]) / kTicksPerMs,
+                          (a[3] - lastSplit[3]) / kTicksPerMs, static_cast<unsigned long long>(a[4] - lastSplit[4]),
+                          static_cast<unsigned long long>(a[5] - lastSplit[5]),
+                          static_cast<unsigned long long>(a[6] - lastSplit[6]),
+                          static_cast<unsigned long long>(a[7]),
+                          static_cast<unsigned long long>(a[8] - lastSplit[8]),
+                          static_cast<unsigned long long>(a[9] - lastSplit[9]),
+                          static_cast<unsigned long long>(a[10] - lastSplit[10]), (a[11] - lastSplit[11]) / kTicksPerMs);
+            line += part;
+        }
+        std::copy(a, a + 16, lastSplit);
+    }
+    if (kartpad_perf_thread_cpu) {
+        char cpu[640];
+        if (kartpad_perf_thread_cpu(cpu, sizeof(cpu)) > 0) {
+            line += " | cpu ";
+            line += cpu;
+        }
+    }
+    if (kartpad_log_dropped_bytes) {
+        const unsigned long long dropped = kartpad_log_dropped_bytes();
+        if (dropped != 0) {
+            std::snprintf(part, sizeof(part), " | logDropped=%llu", dropped);
+            line += part;
+        }
+    }
+#endif
+    line += "\n";
+    return line;
+}
+
+void ReporterLoop() {
+    State& st = S();
+    int reportCounter = 0;
+    while (st.running.load(std::memory_order_acquire)) {
+        for (int i = 0; i < 10 && st.running.load(std::memory_order_acquire); ++i) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        }
+        Interval snapshot;
+        std::string oneShot;
+        {
+            std::lock_guard<std::mutex> lock(st.mutex);
+            snapshot = st.iv;
+            st.iv.reset();
+            oneShot = FormatReport(snapshot, st);
+        }
+        WriteLine(oneShot);
+        WriteLine(FormatStages(snapshot));
+        std::string pcLine = DrainPcReport(st);
+        if (!pcLine.empty()) {
+            WriteLine(pcLine);
+        }
+        if (++reportCounter >= 10) {
+            reportCounter = 0;
+            if (MkwReportNativeScene) {
+                MkwReportNativeScene();
+            }
+        }
+    }
+}
+
+}  // namespace detail
+
+void Start() {
+    detail::State& st = detail::S();
+    if (st.started.exchange(true, std::memory_order_acq_rel)) {
+        return;
+    }
+    st.running.store(true, std::memory_order_release);
+    // Build fingerprint on line 1 so the log itself says which binary produced
+    // it (compile date/time changes every build). If this string does not match
+    // the build just made, the console is running an older NRO than expected.
+    detail::WriteLine("[perf] diagnostics started build=" __DATE__ " " __TIME__ "\n");
+    {
+        char m[96];
+        std::snprintf(m, sizeof(m), "[perf] base proxy Start=%016llx\n", 
+                      static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(&Start)));
+        detail::WriteLine(m);
+    }
+    // Keep the stop-the-world guest PC sampler out of production builds; on Horizon
+    // it pauses the main guest thread for every sample and materially distorts frame time.
+#if defined(MKW_ENABLE_GUEST_PC_SAMPLER)
+    try {
+        st.samplerThread = std::thread(detail::SamplerLoop);
+    } catch (const std::exception& e) {
+        char m[160];
+        std::snprintf(m, sizeof(m), "[perf] sampler spawn FAILED: %s\n", e.what());
+        detail::WriteLine(m);
+    } catch (...) {
+        detail::WriteLine("[perf] sampler spawn FAILED: unknown exception\n");
+#endif
+    st.thread = std::thread(detail::ReporterLoop);
+}
+
+void Stop() {
+    detail::State& st = detail::S();
+    if (!st.started.load(std::memory_order_acquire)) {
+        return;
+    }
+    st.running.store(false, std::memory_order_release);
+    if (st.thread.joinable()) {
+        st.thread.join();
+    }
+    if (st.samplerThread.joinable()) {
+        st.samplerThread.join();
+    }
+    {
+        std::lock_guard<std::mutex> lock(st.mutex);
+        detail::WriteLine(detail::FormatReport(st.iv, st));
+    }
+}
+
+void NoteFramePresented(bool realXfb) {
+    detail::State& st = detail::S();
+    const auto now = detail::Clock::now();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    if (realXfb) {
+        ++st.iv.framesReal;
+    } else {
+        ++st.iv.framesBlack;
+    }
+    if (st.haveLastPresent) {
+        const uint64_t us = static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::microseconds>(now - st.lastPresent).count());
+        ++st.iv.periodCount;
+        st.iv.periodSumUs += us;
+        if (us < st.iv.periodMinUs) st.iv.periodMinUs = us;
+        if (us > st.iv.periodMaxUs) st.iv.periodMaxUs = us;
+        if (st.iv.periodSampleCount < detail::Interval::kMaxPeriodSamples) {
+            st.iv.periodSamplesUs[st.iv.periodSampleCount++] =
+                static_cast<uint32_t>(std::min<uint64_t>(us, UINT32_MAX));
+        }
+    }
+    st.haveLastPresent = true;
+    st.lastPresent = now;
+}
+
+void NoteEndFrameMicros(uint64_t micros) {
+    detail::State& st = detail::S();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    ++st.iv.endFrameCount;
+    st.iv.endFrameSumUs += micros;
+    if (micros > st.iv.endFrameMaxUs) st.iv.endFrameMaxUs = micros;
+}
+
+void NoteFrameWorkerWaitMicros(uint64_t micros) {
+    detail::State& st = detail::S();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    ++st.iv.workerWaitCount;
+    st.iv.workerWaitSumUs += micros;
+    if (micros > st.iv.workerWaitMaxUs) st.iv.workerWaitMaxUs = micros;
+}
+
+void NoteViRetraceIntervalMicros(uint64_t micros) {
+    detail::State& st = detail::S();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    st.viRetraceUs = micros;
+}
+
+void NoteAudioOpen(bool ok, uint32_t rate, uint32_t channels, int sdlFormat) {
+    detail::State& st = detail::S();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    st.audioOpenSeen = true;
+    st.audioOpenOk = ok;
+    st.audioRate = rate;
+    st.audioChannels = channels;
+    st.audioFormat = sdlFormat;
+}
+
+void NoteAudioQueue(int queuedBytes, uint32_t limitBytes) {
+    detail::State& st = detail::S();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    ++st.iv.audioPushes;
+    st.audioQueueLimit = limitBytes;
+    if (queuedBytes >= 0) {
+        st.iv.audioQueuedSumBytes += static_cast<uint64_t>(queuedBytes);
+        if (st.iv.audioQueuedMinBytes < 0 || queuedBytes < st.iv.audioQueuedMinBytes) {
+            st.iv.audioQueuedMinBytes = queuedBytes;
+        }
+        if (queuedBytes > st.iv.audioQueuedMaxBytes) st.iv.audioQueuedMaxBytes = queuedBytes;
+        if (queuedBytes == 0) ++st.iv.audioUnderruns;
+    }
+}
+
+void NoteAudioDrop() {
+    detail::State& st = detail::S();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    ++st.iv.audioDrops;
+}
+
+void NoteAudioUnderrun() {
+    detail::State& st = detail::S();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    ++st.iv.audioUnderruns;
+}
+
+void NoteAudioPcm(uint32_t sampleCount, uint32_t railCount, uint32_t seamJump,
+                  uint32_t interiorJump) {
+    detail::State& st = detail::S();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    st.iv.audioPcmSamples += sampleCount;
+    st.iv.audioPcmRails += railCount;
+    st.iv.audioSeamsOver16k += seamJump >= 16384;
+    st.iv.audioMaxSeamJump = std::max(st.iv.audioMaxSeamJump, seamJump);
+    st.iv.audioMaxInteriorJump = std::max(st.iv.audioMaxInteriorJump, interiorJump);
+}
+
+void NoteAxBlocksPushed(int count) {
+    if (count <= 0) return;
+    detail::State& st = detail::S();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    st.iv.axBlocksPushed += static_cast<uint64_t>(count);
+}
+
+void NoteAxTickCap() {
+    detail::State& st = detail::S();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    ++st.iv.axTickCaps;
+}
+
+void NoteAudioTickMicros(uint64_t micros) {
+    detail::State& st = detail::S();
+    std::lock_guard<std::mutex> lock(st.mutex);
+    ++st.iv.audioTickCount;
+    st.iv.audioTickSumUs += micros;
+    if (micros > st.iv.audioTickMaxUs) st.iv.audioTickMaxUs = micros;
+}
+
+void NoteGuestCoreSample() {
+#if defined(__SWITCH__)
+    detail::State& st = detail::S();
+    const u32 core = svcGetCurrentProcessorNumber();
+    bool logSys = false;
+    {
+        std::lock_guard<std::mutex> lock(st.mutex);
+        st.guestCoreMask |= (1u << core);
+        if (!st.sysInfoLogged) {
+            st.sysInfoLogged = true;
+            logSys = true;
+        }
+    }
+    if (logSys) {
+        s32 preferred = -1;
+        u64 affinity = 0;
+        svcGetThreadCoreMask(&preferred, &affinity, CUR_THREAD_HANDLE);
+        char line[256];
+        std::snprintf(line, sizeof(line),
+                      "[perf] guest thread: preferredCore=%d affinityMask=0x%llx appletType=%d\n",
+                      static_cast<int>(preferred), static_cast<unsigned long long>(affinity),
+                      static_cast<int>(appletGetAppletType()));
+        detail::WriteLine(line);
+    }
+#endif
+}
+
+}  // namespace PerfDiag
