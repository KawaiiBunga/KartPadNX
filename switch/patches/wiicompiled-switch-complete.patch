+    const auto* a = MemoryInline::ResolveRangeHost(source, 0, 32, true, false);
+    const auto* b = MemoryInline::ResolveRangeHost(cache, 0, 32, true, false);
+    if (!a || !b) return false;
+    if (checkedSource) *checkedSource = a;
+    const uint32_t firstA = Word(a), firstB = Word(b);
+    if (firstA != firstB) {
+        r4 = r5 = r6 = r7 = r10 = r11 = r12 = 0;
+        r8 = firstB; r9 = firstA;
+        return true;
+    }
+    if (EqualTextureBytes(a, b)) {
+        // Preserve even volatile registers left by the final comparisons.
+        r4 = r10 = r11 = r12 = 1;
