+        }
+        return true;
+    }
+
+    // Asks the read-ahead thread for [offset, offset + length) of `path` (clamped to the file).
+    void Queue(const std::string& path, uint64_t offset, uint32_t length) {
+        if (length == 0 || length > kReadAheadMaxBytes) {
+            return;
+        }
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_failed || Find(path, offset, length) != nullptr) {
+            return;
+        }
+        Block* victim = nullptr;
