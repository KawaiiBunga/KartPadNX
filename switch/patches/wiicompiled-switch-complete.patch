+// Inputs remain live; neither texture identity nor guest pointers are cached.
+inline bool CompareTexture(uint32_t source, uint32_t cache,
+                         uint32_t& r4, uint32_t& r5, uint32_t& r6, uint32_t& r7,
+                         uint32_t& r8, uint32_t& r9, uint32_t& r10, uint32_t& r11, uint32_t& r12,
+                         const uint8_t** checkedSource = nullptr) {
+    if (checkedSource) *checkedSource = nullptr;
