+/* WiiCompiled adaptation: native libnx window with external Dawn/NVK
+ * presentation. Based on SnepOMatic/SDL3-Switch's Switch video driver.
+ * Copied to that driver's source directory by AuroraSwitchSDL3Patches.cmake.
+ * No EGL surface is created: two swapchain owners cannot share an NWindow.
+ */
+#include "SDL_internal.h"
+
+#if SDL_VIDEO_DRIVER_SWITCH
+#include <switch.h>
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
+#include "../SDL_sysvideo.h"
+#include "SDL_switchkeyboard.h"
+#include "SDL_switchmouse_c.h"
+#include "SDL_switchswkb.h"
+#include "SDL_switchtouch.h"
+
+static SDL_Window *switch_window;
+
+static bool SWITCH_VideoInit(SDL_VideoDevice *device)
+{
+    SDL_DisplayMode mode;
+    SDL_zero(mode);
+    mode.w = 1280;
+    mode.h = 720;
+    mode.refresh_rate = 60.0f;
+    mode.format = SDL_PIXELFORMAT_RGBA8888;
+    if (!SDL_AddBasicVideoDisplay(&mode)) {
+        return false;
+    }
+    Result rc = psmInitialize();
+    if (R_FAILED(rc)) {
+        return SDL_SetError("psmInitialize failed: 0x%x", rc);
+    }
+    SWITCH_InitTouch();
+    SWITCH_InitKeyboard();
+    SWITCH_InitMouse();
+    SWITCH_InitSwkb();
+    return true;
+}
+
+static void SWITCH_VideoQuit(SDL_VideoDevice *device)
+{
+    SWITCH_QuitTouch();
+    SWITCH_QuitKeyboard();
+    SWITCH_QuitMouse();
+    SWITCH_QuitSwkb();
+    psmExit();
+}
+
+static bool SWITCH_CreateWindow(SDL_VideoDevice *device, SDL_Window *window,
+                                SDL_PropertiesID properties)
+{
+    if (switch_window) {
+        return SDL_SetError("Switch supports one native window");
+    }
+    Result rc = nwindowSetDimensions(nwindowGetDefault(), window->w, window->h);
+    if (R_FAILED(rc)) {
+        return SDL_SetError("nwindowSetDimensions failed: 0x%x", rc);
+    }
+    switch_window = window;
+    SDL_SetMouseFocus(window);
+    SDL_SetKeyboardFocus(window);
+    return true;
+}
+
+static void SWITCH_DestroyWindow(SDL_VideoDevice *device, SDL_Window *window)
+{
+    if (switch_window == window) {
+        switch_window = NULL;
+    }
+    /* libnx owns the default NWindow; Dawn has already destroyed its surface. */
+}
+
+static void SWITCH_SetWindowSize(SDL_VideoDevice *device, SDL_Window *window)
+{
+    Result rc = nwindowSetDimensions(nwindowGetDefault(), window->w, window->h);
+    if (R_FAILED(rc)) {
+        SDL_SetError("nwindowSetDimensions failed: 0x%x", rc);
+    }
+}
+
+static void SWITCH_PumpEvents(SDL_VideoDevice *device)
+{
+    if (!appletMainLoop()) {
+        SDL_Event event;
+        SDL_zero(event);
+        event.type = SDL_EVENT_QUIT;
+        SDL_PushEvent(&event);
+        return;
+    }
+    Uint64 timestamp = SDL_GetTicksNS();
+    if (switch_window && !SDL_TextInputActive(switch_window)) {
+        SWITCH_PollTouch(timestamp);
+        SWITCH_PollKeyboard(timestamp);
+        SWITCH_PollMouse(timestamp);
+    }
+    SWITCH_PollSwkb(timestamp);
+}
+
+static void SWITCH_DestroyDevice(SDL_VideoDevice *device)
+{
+    SDL_free(device);
+}
+
+static SDL_VideoDevice *SWITCH_CreateDevice(void)
+{
+    SDL_VideoDevice *device = SDL_calloc(1, sizeof(*device));
+    if (!device) {
+        return NULL;
+    }
+    device->free = SWITCH_DestroyDevice;
+    device->VideoInit = SWITCH_VideoInit;
+    device->VideoQuit = SWITCH_VideoQuit;
+    device->CreateSDLWindow = SWITCH_CreateWindow;
+    device->DestroyWindow = SWITCH_DestroyWindow;
+    device->SetWindowSize = SWITCH_SetWindowSize;
+    device->PumpEvents = SWITCH_PumpEvents;
+    device->StartTextInput = SWITCH_StartTextInput;
+    device->StopTextInput = SWITCH_StopTextInput;
+    device->HasScreenKeyboardSupport = SWITCH_HasScreenKeyboardSupport;
+    device->IsScreenKeyboardShown = SWITCH_IsScreenKeyboardShown;
+    return device;
+}
+
+VideoBootStrap SWITCH_bootstrap = {
+    .name = "Switch",
+    .desc = "Nintendo Switch native NWindow (external Dawn/NVK presentation)",
+    .create = SWITCH_CreateDevice
+};
+#endif
diff --git a/aurora-main/lib/switch/blob_cache.cpp b/aurora-main/lib/switch/blob_cache.cpp
--- /dev/null
+++ b/aurora-main/lib/switch/blob_cache.cpp
@@ -0,0 +1,259 @@
+#include "blob_cache.hpp"
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+#include <ctime>
+#include <string>
+#include <sqlite3.h>
+#ifdef AURORA_CACHE_USE_ZSTD
+#include <zstd.h>
+#endif
+
+namespace aurora::switch_platform {
+namespace {
+int64_t today() { return static_cast<int64_t>(std::time(nullptr) / 86400); }
+constexpr size_t MaxEntries = 32768;
+}
+
+BlobCache::~BlobCache() { shutdown(); }
+
+bool BlobCache::exec(const char* sql) {
+  if (sqlite3_exec(db_, sql, nullptr, nullptr, nullptr) == SQLITE_OK) return true;
+  error_(sqlite3_errmsg(db_));
+  return false;
+}
+
+bool BlobCache::initialize(sqlite3* db, Error error) {
+  db_ = db;
+  error_ = std::move(error);
+  // Private connection: keep the native lock rather than mkdir/rmdir for every
+  // statement. Rollback journals and explicit VFS flushes still protect commits.
+  if (!exec("PRAGMA journal_mode=DELETE; PRAGMA synchronous=NORMAL;"
+            "PRAGMA locking_mode=EXCLUSIVE; PRAGMA cache_size=-4096;"
+            "CREATE TABLE IF NOT EXISTS aurora_schema(value INTEGER);")) return false;
+  sqlite3_stmt* stmt = nullptr;
+  if (sqlite3_prepare_v2(db_, "SELECT value FROM aurora_schema", -1, &stmt, nullptr) != SQLITE_OK) return false;
+  const auto schemaResult = sqlite3_step(stmt);
+  const bool compatible = schemaResult == SQLITE_ROW && sqlite3_column_int(stmt, 0) == 4;
+  sqlite3_finalize(stmt);
+  if (schemaResult != SQLITE_ROW && schemaResult != SQLITE_DONE) {
+    error_(sqlite3_errmsg(db_));
+    return false;
+  }
+  if (!compatible && !exec(
+      "BEGIN IMMEDIATE; DROP TABLE IF EXISTS cache;"
+      "CREATE TABLE cache(key BLOB PRIMARY KEY NOT NULL,value BLOB NOT NULL,size INTEGER NOT NULL,"
+      "compressed INTEGER NOT NULL,last_used INTEGER NOT NULL DEFAULT 0);"
+      "DELETE FROM aurora_schema; INSERT INTO aurora_schema VALUES(4); COMMIT;")) {
+    exec("ROLLBACK;");
+    return false;
+  }
+  // A single sequential scan replaces two SD queries per Dawn cache hit. Preserve
+  // stale entries on disk until the writer prunes them, with no VACUUM boot stall.
+  if (sqlite3_prepare_v2(db_, "SELECT key,value,size,compressed,last_used FROM cache WHERE last_used >= ?",
+                         -1, &stmt, nullptr) != SQLITE_OK) return false;
+  sqlite3_bind_int64(stmt, 1, today() - 30);
+  int rc;
+  while ((rc = sqlite3_step(stmt)) == SQLITE_ROW) {
+    const auto rawSize = sqlite3_column_int64(stmt, 2);
+    const auto bytes = sqlite3_column_bytes(stmt, 1);
+    const auto compressed = sqlite3_column_int(stmt, 3);
+    if (sqlite3_column_bytes(stmt, 0) != sizeof(Key) || rawSize <= 0 || rawSize > MaxBlobBytes ||
+        bytes <= 0 || bytes > MaxBlobBytes || (compressed != 0 && compressed != 1) ||
+        (!compressed && rawSize != bytes)) continue;
+#ifndef AURORA_CACHE_USE_ZSTD
+    if (compressed) continue;
+#endif
+    if (residentBytes_ + bytes > ResidentLimit || entries_.size() >= MaxEntries) continue;
+    Key key;
+    std::memcpy(key.data(), sqlite3_column_blob(stmt, 0), sizeof(key));
+    auto entry = std::make_shared<Entry>();
+    entry->size = static_cast<size_t>(rawSize);
+    entry->compressed = compressed;
+    entry->day = sqlite3_column_int64(stmt, 4);
+    const auto* data = static_cast<const uint8_t*>(sqlite3_column_blob(stmt, 1));
+    entry->bytes.assign(data, data + bytes);
+    remember(key, entry);
+  }
+  sqlite3_finalize(stmt);
+  if (rc != SQLITE_DONE) { error_(sqlite3_errmsg(db_)); return false; }
+  thread_ = std::thread(&BlobCache::writer, this);
+  return true;
+}
+
+void BlobCache::remember(const Key& key, const std::shared_ptr<Entry>& entry) {
+  auto previous = entries_.find(key);
+  if (previous != entries_.end()) {
+    residentBytes_ -= previous->second->bytes.size();
+    entries_.erase(previous);
+  }
+  while (!entries_.empty() && (residentBytes_ + entry->bytes.size() > ResidentLimit ||
+                              entries_.size() >= MaxEntries)) {
+    residentBytes_ -= entries_.begin()->second->bytes.size();
+    entries_.erase(entries_.begin());
+  }
+  residentBytes_ += entry->bytes.size();
+  entries_.emplace(key, entry);
+}
+
+size_t BlobCache::load(const Key& key, void* value, size_t size) {
+  std::shared_ptr<Entry> entry;
+  {
+    std::lock_guard lock(mutex_);
+    auto found = entries_.find(key);
+    if (found == entries_.end()) return 0;
+    entry = found->second;
+    if (entry->day != today() && touches_.size() < MaxEntries) {
+      touches_.insert(key);
+      entry->day = today();
+    }
+  }
+  if (!value) return entry->size;
+  if (size != entry->size) return 0;
+  // Entry buffers are immutable; multiple compiler workers decompress in parallel.
+  if (entry->compressed) {
+#ifdef AURORA_CACHE_USE_ZSTD
+    const auto result = ZSTD_decompress(value, size, entry->bytes.data(), entry->bytes.size());
+    if (ZSTD_isError(result) || result != size) return 0;
+#else
+    return 0;
+#endif
+  } else {
+    std::memcpy(value, entry->bytes.data(), size);
+  }
+  return size;
+}
+
+bool BlobCache::store(const Key& key, const void* value, size_t size) {
+  std::lock_guard lock(mutex_);
+  if (stop_ || writeFailed_ || !value || !size || size > MaxBlobBytes) return false;
+  // Coalesce repeated monolithic pipeline snapshots that have not been picked up
+  // yet. Never block a Dawn device lock waiting for compression or SD flushes.
+  auto previous = std::find_if(queue_.begin(), queue_.end(), [&](const Job& job) { return job.key == key; });
+  const auto replaced = previous == queue_.end() ? 0 : previous->entry->size;
+  if (pendingBytes_ - replaced + size > PendingLimit ||
+      (previous == queue_.end() && queue_.size() >= MaxEntries)) {
+    ++droppedStores_;
+    return false; // best-effort cache: accepted writes still drain normally
+  }
+  auto entry = std::make_shared<Entry>();
+  entry->size = size;
+  entry->day = today();
+  const auto* data = static_cast<const uint8_t*>(value);
+  entry->bytes.assign(data, data + size);
+  pendingBytes_ = pendingBytes_ - replaced + size;
+  if (previous == queue_.end()) queue_.push_back({key, entry});
+  else previous->entry = entry;
+  remember(key, entry);
+  cv_.notify_one();
+  return true;
+}
+
+void BlobCache::writer() {
+  sqlite3_stmt *put = nullptr, *touch = nullptr;
+  bool ok = sqlite3_prepare_v2(db_, "REPLACE INTO cache(key,value,size,compressed,last_used) VALUES(?,?,?,?,?)",
+                              -1, &put, nullptr) == SQLITE_OK &&
+            sqlite3_prepare_v2(db_, "UPDATE cache SET last_used=? WHERE key=?", -1, &touch, nullptr) == SQLITE_OK;
+  while (ok) {
+    std::vector<Job> jobs;
+    std::unordered_set<Key, Hash> touches;
+    size_t batchBytes = 0;
+    {
+      std::unique_lock lock(mutex_);
+      cv_.wait_for(lock, std::chrono::seconds(10), [&] { return stop_ || !queue_.empty(); });
+      if (!stop_ && !queue_.empty()) cv_.wait_for(lock, std::chrono::milliseconds(100), [&] { return stop_; });
+      while (!queue_.empty() && jobs.size() < 64 && batchBytes < 16 * 1024 * 1024) {
+        batchBytes += queue_.front().entry->size;
+        jobs.push_back(std::move(queue_.front()));
+        queue_.pop_front();
+      }
+      touches.swap(touches_);
+      if (jobs.empty() && touches.empty() && stop_) break;
+    }
+    if (jobs.empty() && touches.empty()) continue;
+    std::vector<std::shared_ptr<Entry>> packed;
+    for (const auto& job : jobs) {
+      auto entry = job.entry;
+#ifdef AURORA_CACHE_USE_ZSTD
+      auto compressed = std::make_shared<Entry>();
+      compressed->size = entry->size;
+      compressed->day = today();
+      compressed->bytes.resize(ZSTD_compressBound(entry->size));
+      const auto size = ZSTD_compress(compressed->bytes.data(), compressed->bytes.size(),
+                                      entry->bytes.data(), entry->size, 1);
+      if (!ZSTD_isError(size) && size < entry->size) {
+        compressed->bytes.resize(size);
+        compressed->bytes.shrink_to_fit();
+        compressed->compressed = true;
+        entry = std::move(compressed);
+      }
+#endif
+      packed.push_back(std::move(entry));
+    }
+    ok = exec("BEGIN IMMEDIATE;");
+    const auto day = today();
+    for (size_t i = 0; ok && i < jobs.size(); ++i) {
+      const auto& entry = packed[i];
+      ok = sqlite3_bind_blob(put, 1, jobs[i].key.data(), sizeof(Key), SQLITE_STATIC) == SQLITE_OK &&
+           sqlite3_bind_blob64(put, 2, entry->bytes.data(), entry->bytes.size(), SQLITE_STATIC) == SQLITE_OK &&
+           sqlite3_bind_int64(put, 3, entry->size) == SQLITE_OK &&
+           sqlite3_bind_int(put, 4, entry->compressed) == SQLITE_OK &&
+           sqlite3_bind_int64(put, 5, day) == SQLITE_OK && sqlite3_step(put) == SQLITE_DONE;
+      sqlite3_reset(put);
+      sqlite3_clear_bindings(put);
+    }
+    for (const auto& key : touches) {
+      if (!ok) break;
+      ok = sqlite3_bind_int64(touch, 1, day) == SQLITE_OK &&
+           sqlite3_bind_blob(touch, 2, key.data(), sizeof(key), SQLITE_STATIC) == SQLITE_OK &&
+           sqlite3_step(touch) == SQLITE_DONE;
+      sqlite3_reset(touch);
+      sqlite3_clear_bindings(touch);
+    }
+    if (ok) ok = exec("COMMIT;");
+    if (!ok) {
+      error_(sqlite3_errmsg(db_));
+      if (!sqlite3_get_autocommit(db_)) exec("ROLLBACK;");
+    }
+    {
+      std::lock_guard lock(mutex_);
+      pendingBytes_ -= batchBytes;
+      if (ok) {
+        ++commits_;
+        for (size_t i = 0; i < jobs.size(); ++i) {
+          auto found = entries_.find(jobs[i].key);
+          if (found != entries_.end() && found->second == jobs[i].entry) remember(jobs[i].key, packed[i]);
+        }
+      } else droppedStores_ += jobs.size();
+    }
+  }
+  sqlite3_finalize(put);
+  sqlite3_finalize(touch);
+  if (ok) {
+    // Once per session, after accepted writes are durable; no full-file VACUUM.
+    const auto sql = "DELETE FROM cache WHERE last_used < " + std::to_string(today() - 30);
+    exec(sql.c_str());
+  } else {
+    std::lock_guard lock(mutex_);
+    writeFailed_ = true;
+    droppedStores_ += queue_.size();
+    queue_.clear();
+    pendingBytes_ = 0;
+  }
+}
+
+void BlobCache::shutdown() {
+  {
+    std::lock_guard lock(mutex_);
+    stop_ = true;
+  }
+  cv_.notify_all();
+  if (thread_.joinable()) thread_.join();
+  if (db_) { sqlite3_close(db_); db_ = nullptr; }
+}
+
+BlobCache::Stats BlobCache::stats() {
+  std::lock_guard lock(mutex_);
+  return {entries_.size(), residentBytes_, pendingBytes_, commits_, droppedStores_};
+}
+} // namespace aurora::switch_platform
diff --git a/aurora-main/lib/switch/blob_cache.hpp b/aurora-main/lib/switch/blob_cache.hpp
--- /dev/null
+++ b/aurora-main/lib/switch/blob_cache.hpp
@@ -0,0 +1,60 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+struct sqlite3;
+
+namespace aurora::switch_platform {
+// The compiler callbacks never access SQLite. A bounded, compressed RAM snapshot
+// serves reads, while one owner thread compresses and commits new blobs in batches.
+// Schema and XXH128 key bytes remain compatible with existing Dawn caches.
+class BlobCache {
+public:
+  using Key = std::array<uint64_t, 2>;
+  using Error = std::function<void(const char*)>;
+  static constexpr size_t MaxBlobBytes = 128 * 1024 * 1024;
+  static constexpr size_t ResidentLimit = 192 * 1024 * 1024;
+  static constexpr size_t PendingLimit = 128 * 1024 * 1024;
+  struct Stats { uint64_t entries, residentBytes, pendingBytes, commits, droppedStores; };
+
+  BlobCache() = default;
+  ~BlobCache();
+  // Takes ownership even on failure. Call before exposing this object to readers.
+  bool initialize(sqlite3* db, Error error);
+  size_t load(const Key& key, void* value, size_t size);
+  bool store(const Key& key, const void* value, size_t size);
+  void shutdown(); // joins and drains accepted writes; safe to call again
+  Stats stats();
+
+private:
+  struct Hash { size_t operator()(const Key& key) const { return key[0] ^ key[1]; } };
+  struct Entry { std::vector<uint8_t> bytes; size_t size = 0; bool compressed = false; int64_t day = 0; };
+  struct Job { Key key; std::shared_ptr<Entry> entry; };
+  using Map = std::unordered_map<Key, std::shared_ptr<Entry>, Hash>;
+  void remember(const Key& key, const std::shared_ptr<Entry>& entry); // mutex held
+  void writer();
+  bool exec(const char* sql);
+  sqlite3* db_ = nullptr;
+  Error error_;
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  std::thread thread_;
+  Map entries_;
+  std::unordered_set<Key, Hash> touches_;
+  std::deque<Job> queue_;
+  size_t residentBytes_ = 0, pendingBytes_ = 0;
+  uint64_t commits_ = 0, droppedStores_ = 0;
+  bool stop_ = false, writeFailed_ = false;
+};
+} // namespace aurora::switch_platform
diff --git a/aurora-main/lib/switch/perf.cpp b/aurora-main/lib/switch/perf.cpp
--- /dev/null
+++ b/aurora-main/lib/switch/perf.cpp
@@ -0,0 +1,220 @@
+#include <aurora/perf.hpp>
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#ifdef AURORA_PERF_TEST
+extern uint64_t perf_test_tick();
+#else
+#include <switch.h>
+#endif
+
+namespace aurora::perf {
+namespace {
+uint64_t tick() {
+#ifdef AURORA_PERF_TEST
+  return perf_test_tick();
+#else
+  return armGetSystemTick();
+#endif
+}
+double milliseconds(uint64_t ticks) {
+#ifdef AURORA_PERF_TEST
+  return ticks / 1000000.0;
+#else
+  return armTicksToNs(ticks) / 1000000.0;
+#endif
+}
+struct alignas(64) Counter { std::atomic<uint64_t> ticks{0}, calls{0}; };
+std::array<Counter, StageCount> counters;
+
+// Native threads accumulate without atomic read/modify/write instructions in
+// every timed GX call. Fibers share their native thread's pending totals, while
+// Context still determines whose exclusive time each checkpoint charges.
+// Publish at most 1024 checkpoints apart or after 16 ms of active work. A final
+// flush on thread exit preserves workers' trailing samples as well.
+struct PendingCounters {
+  Snapshot samples{};
+  uint64_t dirty = 0, lastPublishTick = 0;
+  uint32_t checkpoints = 0;
+  __attribute__((noinline)) void publish() noexcept {
+    while (dirty) {
+      const auto i = static_cast<size_t>(__builtin_ctzll(dirty));
+      dirty &= dirty - 1;
+      const auto sample = samples[i];
+      samples[i] = {};
+      if (sample.ticks) counters[i].ticks.fetch_add(sample.ticks, std::memory_order_relaxed);
+      if (sample.calls) counters[i].calls.fetch_add(sample.calls, std::memory_order_relaxed);
+    }
+    checkpoints = 0;
+  }
+};
+static_assert(StageCount <= 64);
+struct ThreadState {
+  PendingCounters pending;
+  Context defaultContext;
+  Context* selected = nullptr;
+  bool publisherRegistered = false;
+  Context* active() noexcept { return selected ? selected : &defaultContext; }
+};
+// One constant-initialized TLS block avoids separate thread-pointer lookups
+// and the dynamic initializer needed by a TLS pointer to another TLS object.
+thread_local ThreadState threadState;
+inline ThreadState& current_thread() noexcept {
+  auto* state = &threadState;
+#if defined(__SWITCH__)
+  // With libnx's soft TLS, GCC otherwise rematerializes this address with
+  // several __aarch64_read_tp calls in a single checkpoint. This emits no ARM
+  // instruction; it keeps the already-resolved pointer in a native register.
+  asm("" : "+r"(state));
+#endif
+  return *state;
+}
+struct PublishAtThreadExit { ~PublishAtThreadExit() { threadState.pending.publish(); } };
+__attribute__((noinline)) void register_thread_publisher() {
+  // Keep the accumulator itself trivially destructible: accessing it from
+  // checkpoint must not repeatedly invoke a dynamic TLS initialization guard.
+  static thread_local PublishAtThreadExit onExit;
+  (void)onExit;
+}
+inline void ensure_thread_publisher(ThreadState& thread) {
+  if (!thread.publisherRegistered) {
+    register_thread_publisher();
+    thread.publisherRegistered = true;
+  }
+}
+constexpr std::array<const char*, StageCount> names{
+  "untracked", "guest.main+HLE", "guest.THP-video+HLE", "guest.other-fibers+HLE", "wait.frame-worker",
+  "gx.fifo-decode", "texture.upload", "texture.convert", "wait.gpu-readback", "efb.encode",
+  "render.prepare", "wait.staging-map", "render.seal", "render.encode", "command.finish",
+  "queue.submit", "present.acquire", "present.encode", "present.call", "wait.pacing",
+  "events", "audio.mix", "wait.audio", "disc.read", "video.THP-native", "video.THP-fallback",
+  "guest.scene-calc", "guest.scene-draw", "guest.race-update", "guest.kart-update", "guest.model-calc",
+  "guest.model-draw", "guest.world-calc", "guest.view-calc",
+  "gx.capture", "gx.worker-decode", "wait.gx-worker",
+  "kart.sub-update", "kart.ai", "kart.movement", "kart.physics", "kart.apply-physics", "kart.contacts", "kart.collision", "kart.wheels", "kart.transforms", "kart.driver",
+  "scene.traversal", "scene.model-setup", "scene.material", "scene.channels",
+  "scene.textures", "scene.shapes", "scene.matrix-select",
+  "scene.draw-manager", "scene.shape-submit", "scene.efb-capture",
+  "wait.gx-lock", "gx.draw-build", "gx.prepared-replay", "scene.model-passes",
+  "scene.lights", "scene.done-draw", "scene.switch-root"
+};
+}
+
+void checkpoint() noexcept {
+  auto& thread = current_thread();
+  auto& pending = thread.pending;
+  auto* active = thread.active();
+  const auto now = tick();
+  const Stage stage = active->scope ? active->scope->stage_ : active->root;
+  // System ticks are monotonic; still reject a reset rather than subtracting
+  // unsigned counters into impossible multi-trillion-percent measurements.
+  if (active->lastTick && now >= active->lastTick && stage != Stage::Untracked) {
+    const auto i = static_cast<size_t>(stage);
+    pending.samples[i].ticks += now - active->lastTick;
+    pending.dirty |= uint64_t{1} << i;
+  }
+  active->lastTick = now;
+  // Tick conversion is a constant comparison, not a division per checkpoint.
+#ifdef AURORA_PERF_TEST
+  constexpr uint64_t publishTicks = 16000000;
+#else
+  constexpr uint64_t publishTicks = 19200000 / 1000 * 16;
+#endif
+  if (++pending.checkpoints >= 1024 || now < pending.lastPublishTick ||
+      now - pending.lastPublishTick >= publishTicks) {
+    pending.publish();
+    pending.lastPublishTick = now;
+  }
+}
+
+void activate(Context* context) noexcept {
+  auto& thread = current_thread();
+  ensure_thread_publisher(thread);
+  checkpoint();
+  thread.selected = context;
+  thread.active()->lastTick = tick();
+}
+
+void set_root(Context& context, Stage root) noexcept {
+  if (current_thread().active() == &context) checkpoint();
+  context.root = root;
+}
+
+Scope::Scope(Stage stage) noexcept : stage_(stage) {
+  auto& thread = current_thread();
+  ensure_thread_publisher(thread);
+  auto* active = thread.active();
+  context_ = active;
+  parent_ = active->scope;
+  checkpoint();
+  active->scope = this;
+  const auto i = static_cast<size_t>(stage);
+  ++thread.pending.samples[i].calls;
+  thread.pending.dirty |= uint64_t{1} << i;
+}
+
+Scope::~Scope() {
+  checkpoint();
+  context_->scope = parent_;
+}
+
+Snapshot snapshot() noexcept {
+  checkpoint();
+  current_thread().pending.publish();
+  Snapshot result;
+  for (size_t i = 0; i < result.size(); ++i)
+    result[i] = {counters[i].ticks.load(std::memory_order_relaxed), counters[i].calls.load(std::memory_order_relaxed)};
+  return result;
+}
+
+void frame() noexcept {
+  // Called only by the guest producer, once per frame submitted. Other native
+  // workers periodically publish counters atomically; no locks or allocations
+  // in timed scopes. The snapshot flushes the caller's pending samples.
+  static uint64_t previousTick = 0, frames = 0, window = 0;
+  static Snapshot previous;
+  const auto now = tick();
+  if (!previousTick) {
+    previousTick = now;
+    previous = snapshot();
+    std::fprintf(stderr, "[HOS perf] exclusive stage wall timers enabled; fiber-aware; thread-local accounting with periodic publication; kernel CPU percentages disabled\n");
+    return;
+  }
+  ++frames;
+  if (now < previousTick) {
+    previousTick = now;
+    previous = snapshot();
+    frames = 0;
+    return;
+  }
+  if (milliseconds(now - previousTick) < 10000) return;
+  Scope logging(Stage::Untracked);
+  const auto current = snapshot();
+  Snapshot delta;
+  std::array<size_t, StageCount> order;
+  for (size_t i = 0; i < order.size(); ++i) {
+    order[i] = i;
+    delta[i] = {current[i].ticks - previous[i].ticks, current[i].calls - previous[i].calls};
+  }
+  std::sort(order.begin(), order.end(), [&](size_t a, size_t b) { return delta[a].ticks > delta[b].ticks; });
+  // Leave room for every stage even when all scene/kart subcategories are
+  // active. This is emitted once per ten seconds, never per draw.
+  char output[8192];
+  const double elapsedMs = milliseconds(now - previousTick);
+  size_t used = std::snprintf(output, sizeof(output),
+      "[HOS perf] window=%llu duration=%.2fs submitted=%llu fps=%.1f; exclusive wall ms/frame (parallel threads overlap; not GPU execution time)\n",
+      static_cast<unsigned long long>(++window), elapsedMs / 1000.0,
+      static_cast<unsigned long long>(frames), frames * 1000.0 / elapsedMs);
+  for (const auto i : order) {
+    const auto totalMs = milliseconds(delta[i].ticks);
+    if (i == 0 || totalMs < 0.1 || used + 160 >= sizeof(output)) continue;
+    used += std::snprintf(output + used, sizeof(output) - used,
+        "[HOS perf] %s=%.3f ms/frame total=%.1f ms calls=%llu\n", names[i], totalMs / frames, totalMs,
+        static_cast<unsigned long long>(delta[i].calls));
+  }
+  std::fprintf(stderr, "%s", output);
+  previous = current;
+  previousTick = now;
+  frames = 0;
+}
+} // namespace aurora::perf
diff --git a/aurora-main/lib/switch/pipeline_policy.hpp b/aurora-main/lib/switch/pipeline_policy.hpp
--- /dev/null
+++ b/aurora-main/lib/switch/pipeline_policy.hpp
@@ -0,0 +1,24 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+namespace aurora::switch_platform {
+// Query HOS's allowed cores, not a desktop hardware_concurrency estimate.
+// Use up to all three application cores, with bounded compiler memory use.
+constexpr size_t pipeline_worker_count(uint64_t allowedCores) {
+  size_t count = 0;
+  while (allowedCores) { count += allowedCores & 1; allowedCores >>= 1; }
+  return count > 3 ? 3 : count ? count : 1;
+}
+
+constexpr int background_priority(uint64_t allowedPriorities, int normal) {
+  for (int priority = 63; priority > normal; --priority)
+    if (allowedPriorities & (uint64_t{1} << priority)) return priority;
+  return normal;
+}
+
+// Speculative boot recipes do not consume the bounded first-use queue.
+constexpr bool first_use_queue_full(size_t urgentQueued, size_t limit) {
+  return urgentQueued >= limit;
+}
+} // namespace aurora::switch_platform
diff --git a/aurora-main/lib/switch/sqlite_vfs.cpp b/aurora-main/lib/switch/sqlite_vfs.cpp
--- /dev/null
+++ b/aurora-main/lib/switch/sqlite_vfs.cpp
@@ -0,0 +1,326 @@
+// SQLite's HOS backend uses native file handles and offsets. The Unix VFS
+// assumes POSIX inode identities, permissions and locking that SD/fsdev lacks.
+#include <sqlite3.h>
+#include <switch.h>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#include <filesystem>
+#include <mutex>
+#include <new>
+#include <strings.h>
+#include <unistd.h>
+
+namespace {
+constexpr Result PathNotFound = 0x202;
+constexpr Result PathExists = 0x402;
+thread_local Result lastResult;
+
+// HOS rejects a second native open while a writable file handle exists. Keep
+// one handle per path in this process; SQLite locks still belong to individual
+// connections. Serialize native operations and retain the handle until the last
+// connection closes, regardless of which connection opened it first.
+struct SharedFile {
+  FsFile handle;
+  FsFileSystem* fs;
+  u32 mode;
+  unsigned references;
+  bool deleteOnClose;
+  char path[FS_MAX_PATH];
+  SharedFile* next;
+};
+std::mutex handleMutex;
+SharedFile* handles = nullptr;
+SharedFile* findHandle(FsFileSystem* fs, const char* path) {
+  for (auto* shared = handles; shared; shared = shared->next)
+    if (shared->fs == fs && strcasecmp(shared->path, path) == 0) return shared;
+  return nullptr;
+}
+
+struct HosFile {
+  sqlite3_file base;
+  SharedFile* shared;
+  FsFileSystem* fs;
+  int lock;
+  bool readOnly;
+  char path[FS_MAX_PATH];
+  char lockPath[FS_MAX_PATH];
+};
+HosFile* file(sqlite3_file* value) { return reinterpret_cast<HosFile*>(value); }
+int error(Result result, int code, const char* operation, const char* path) {
+  lastResult = result;
+  std::fprintf(stderr, "[sqlite-hos] %s failed: result=%08x path=%s\n", operation, result, path);
+  return code;
+}
+int unlock(sqlite3_file* base, int level) {
+  auto* f = file(base);
+  if (level == SQLITE_LOCK_NONE && f->lock != SQLITE_LOCK_NONE) {
+    const Result rc = fsFsDeleteDirectory(f->fs, f->lockPath);
+    if (R_FAILED(rc) && rc != PathNotFound) return error(rc, SQLITE_IOERR_UNLOCK, "unlock", f->path);
+  }
+  f->lock = level;
+  return SQLITE_OK;
+}
+int close(sqlite3_file* base) {
+  auto* f = file(base);
+  const int result = unlock(base, SQLITE_LOCK_NONE);
+  std::lock_guard guard(handleMutex);
+  auto* shared = f->shared;
+  if (--shared->references == 0) {
+    fsFileClose(&shared->handle);
+    if (shared->deleteOnClose) fsFsDeleteFile(shared->fs, shared->path);
+    auto** entry = &handles;
+    while (*entry != shared) entry = &(*entry)->next;
+    *entry = shared->next;
+    delete shared;
+  }
+  f->shared = nullptr;
+  f->base.pMethods = nullptr;
+  return result;
+}
+int read(sqlite3_file* base, void* buffer, int amount, sqlite3_int64 offset) {
+  auto* f = file(base);
+  std::lock_guard guard(handleMutex);
+  s64 length = 0;
+  Result rc = fsFileGetSize(&f->shared->handle, &length);
+  if (R_FAILED(rc)) return error(rc, SQLITE_IOERR_READ, "read size", f->path);
+  const u64 available = offset < length ? static_cast<u64>(length - offset) : 0;
+  const u64 requested = available < static_cast<u64>(amount) ? available : static_cast<u64>(amount);
+  u64 count = 0;
+  if (requested) rc = fsFileRead(&f->shared->handle, offset, buffer, requested, FsReadOption_None, &count);
+  if ((rc & 0x3fffff) == 0xd401) {
+    // Like fsdev, bounce buffers from memory that HOS cannot map for IPC.
+    char bounce[4096];
+    count = 0;
+    while (count < requested) {
+      const u64 chunk = requested - count < sizeof(bounce) ? requested - count : sizeof(bounce);
+      u64 received = 0;
+      rc = fsFileRead(&f->shared->handle, offset + count, bounce, chunk, FsReadOption_None, &received);
+      if (R_FAILED(rc)) break;
+      if (received > chunk) return SQLITE_IOERR_READ;
+      std::memcpy(static_cast<char*>(buffer) + count, bounce, received);
+      count += received;
+      if (received < chunk) break;
+    }
+  }
+  if (R_FAILED(rc)) return error(rc, SQLITE_IOERR_READ, "read", f->path);
+  if (count < static_cast<u64>(amount)) {
+    std::memset(static_cast<char*>(buffer) + count, 0, amount - count);
+    return SQLITE_IOERR_SHORT_READ;
+  }
+  return SQLITE_OK;
+}
+int write(sqlite3_file* base, const void* buffer, int amount, sqlite3_int64 offset) {
+  auto* f = file(base);
+  if (f->readOnly) return SQLITE_READONLY;
+  std::lock_guard guard(handleMutex);
+  Result rc = fsFileWrite(&f->shared->handle, offset, buffer, amount, FsWriteOption_None);
+  if ((rc & 0x3fffff) == 0xd401) {
+    char bounce[4096];
+    int written = 0;
+    while (written < amount) {
+      const int chunk = amount - written < static_cast<int>(sizeof(bounce)) ? amount - written : sizeof(bounce);
+      std::memcpy(bounce, static_cast<const char*>(buffer) + written, chunk);
+      rc = fsFileWrite(&f->shared->handle, offset + written, bounce, chunk, FsWriteOption_None);
+      if (R_FAILED(rc)) break;
+      written += chunk;
+    }
+  }
+  return R_SUCCEEDED(rc) ? SQLITE_OK : error(rc, SQLITE_IOERR_WRITE, "write", f->path);
+}
+int truncate(sqlite3_file* base, sqlite3_int64 size) {
+  auto* f = file(base);
+  if (f->readOnly) return SQLITE_READONLY;
+  std::lock_guard guard(handleMutex);
+  const Result rc = fsFileSetSize(&f->shared->handle, size);
+  return R_SUCCEEDED(rc) ? SQLITE_OK : error(rc, SQLITE_IOERR_TRUNCATE, "truncate", f->path);
+}
+int sync(sqlite3_file* base, int) {
+  auto* f = file(base);
+  std::lock_guard guard(handleMutex);
+  const Result rc = fsFileFlush(&f->shared->handle);
+  return R_SUCCEEDED(rc) ? SQLITE_OK : error(rc, SQLITE_IOERR_FSYNC, "flush", f->path);
+}
+int size(sqlite3_file* base, sqlite3_int64* output) {
+  auto* f = file(base);
+  std::lock_guard guard(handleMutex);
+  s64 value = 0;
+  const Result rc = fsFileGetSize(&f->shared->handle, &value);
+  *output = value;
+  return R_SUCCEEDED(rc) ? SQLITE_OK : error(rc, SQLITE_IOERR_FSTAT, "size", f->path);
+}
+int lock(sqlite3_file* base, int level) {
+  auto* f = file(base);
+  if (level <= f->lock) return SQLITE_OK;
+  if (f->lock == SQLITE_LOCK_NONE) {
+    // Coarse but real exclusion: a read lock also owns the atomic directory.
+    // This supports rollback journals and serializes connections to one file.
+    const Result rc = fsFsCreateDirectory(f->fs, f->lockPath);
+    if (rc == PathExists) return SQLITE_BUSY;
+    if (R_FAILED(rc)) return error(rc, SQLITE_IOERR_LOCK, "lock", f->path);
+  }
+  f->lock = level;
+  return SQLITE_OK;
+}
+int reserved(sqlite3_file* base, int* output) {
+  auto* f = file(base);
+  if (f->lock != SQLITE_LOCK_NONE) {
+    *output = f->lock >= SQLITE_LOCK_RESERVED;
+    return SQLITE_OK;
+  }
+  FsDirEntryType type;
+  const Result rc = fsFsGetEntryType(f->fs, f->lockPath, &type);
+  *output = R_SUCCEEDED(rc);
+  return R_SUCCEEDED(rc) || rc == PathNotFound ? SQLITE_OK
+      : error(rc, SQLITE_IOERR_CHECKRESERVEDLOCK, "check lock", f->path);
+}
+int control(sqlite3_file* base, int operation, void* argument) {
+  if (operation == SQLITE_FCNTL_LOCKSTATE) {
+    *static_cast<int*>(argument) = file(base)->lock;
+    return SQLITE_OK;
+  }
+  if (operation == SQLITE_FCNTL_HAS_MOVED) {
+    *static_cast<int*>(argument) = 0; // private cache paths stay fixed while open
+    return SQLITE_OK;
+  }
+  return SQLITE_NOTFOUND;
+}
+int sector(sqlite3_file*) { return 4096; }
+int characteristics(sqlite3_file*) { return 0; } // do not promise atomic writes
+const sqlite3_io_methods methods = {
+    1, close, read, write, truncate, sync, size, lock, unlock, reserved, control,
+    sector, characteristics, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr};
+
+int fullPath(sqlite3_vfs*, const char* input, int capacity, char* output) {
+  char cwd[FS_MAX_PATH];
+  int length;
+  if (std::strstr(input, ":/") || input[0] == '/') {
+    length = std::snprintf(output, capacity, "%s", input);
+  } else {
+    if (!getcwd(cwd, sizeof(cwd))) return SQLITE_CANTOPEN;
+    length = std::snprintf(output, capacity, "%s/%s", cwd, input);
+  }
+  return length >= 0 && length < capacity ? SQLITE_OK : SQLITE_CANTOPEN;
+}
+int open(sqlite3_vfs*, const char* name, sqlite3_file* base, int flags, int* actualFlags) {
+  auto* f = file(base);
+  std::memset(f, 0, sizeof(*f));
+  char temporary[FS_MAX_PATH];
+  if (!name) {
+    u64 nonce;
+    randomGet(&nonce, sizeof(nonce));
+    std::snprintf(temporary, sizeof(temporary), "sdmc:/switch/kartpad/Cache/tmp-%016llx.db",
+                  static_cast<unsigned long long>(nonce));
+    name = temporary;
+    flags |= SQLITE_OPEN_CREATE | SQLITE_OPEN_EXCLUSIVE | SQLITE_OPEN_DELETEONCLOSE;
+  }
+  if (fsdevTranslatePath(name, &f->fs, f->path) != 0) return SQLITE_CANTOPEN;
+  try {
+    const auto normalized = std::filesystem::path(f->path).lexically_normal().generic_string();
+    if (normalized.size() >= sizeof(f->path)) return SQLITE_CANTOPEN;
+    std::strcpy(f->path, normalized.c_str());
+  } catch (const std::bad_alloc&) { return SQLITE_NOMEM; }
+  if (std::snprintf(f->lockPath, sizeof(f->lockPath), "%s.lock", f->path) >= FS_MAX_PATH)
+    return SQLITE_CANTOPEN;
+  std::lock_guard guard(handleMutex);
+  auto* shared = findHandle(f->fs, f->path);
+  if (shared && (flags & SQLITE_OPEN_EXCLUSIVE)) return SQLITE_CANTOPEN;
+  if (flags & SQLITE_OPEN_CREATE) {
+    const Result rc = fsFsCreateFile(f->fs, f->path, 0, 0);
+    if (R_FAILED(rc) && (rc != PathExists || (flags & SQLITE_OPEN_EXCLUSIVE)))
+      return error(rc, SQLITE_CANTOPEN, "create", f->path);
+  }
+  if (!shared) {
+    // A lock is a directory owned by an open handle of this process, the only user of these
+    // files. One that exists while no handle is open was left by a crash, and would make every
+    // later lock() return SQLITE_BUSY, silently disabling the cache for good.
+    if (flags & SQLITE_OPEN_MAIN_DB) fsFsDeleteDirectory(f->fs, f->lockPath);
+    shared = new (std::nothrow) SharedFile{};
+    if (!shared) return SQLITE_NOMEM;
+    // Keep main databases shareable if a read-only connection opens first.
+    // Connection-level readOnly below still forbids writes through that view.
+    u32 mode = FsOpenMode_Read;
+    if (flags & (SQLITE_OPEN_READWRITE | SQLITE_OPEN_MAIN_DB))
+      mode |= FsOpenMode_Write | FsOpenMode_Append;
+    Result rc = fsFsOpenFile(f->fs, f->path, mode, &shared->handle);
+    if (R_FAILED(rc) && (mode & FsOpenMode_Write)) {
+      mode = FsOpenMode_Read;
+      rc = fsFsOpenFile(f->fs, f->path, mode, &shared->handle);
+    }
+    if (R_FAILED(rc)) { delete shared; return error(rc, SQLITE_CANTOPEN, "open", f->path); }
+    shared->fs = f->fs;
+    shared->mode = mode;
+    std::strcpy(shared->path, f->path);
+    shared->next = handles;
+    handles = shared;
+  }
+  ++shared->references;
+  shared->deleteOnClose |= (flags & SQLITE_OPEN_DELETEONCLOSE) != 0;
+  f->shared = shared;
+  f->readOnly = !(flags & SQLITE_OPEN_READWRITE) || !(shared->mode & FsOpenMode_Write);
+  if (f->readOnly) flags = (flags & ~SQLITE_OPEN_READWRITE) | SQLITE_OPEN_READONLY;
+  f->base.pMethods = &methods;
+  if (actualFlags) *actualFlags = flags;
+  return SQLITE_OK;
+}
+int remove(sqlite3_vfs*, const char* name, int) {
+  FsFileSystem* fs;
+  char path[FS_MAX_PATH];
+  if (fsdevTranslatePath(name, &fs, path) != 0) return SQLITE_IOERR_DELETE;
+  const Result rc = fsFsDeleteFile(fs, path);
+  return R_SUCCEEDED(rc) || rc == PathNotFound ? SQLITE_OK
+      : error(rc, SQLITE_IOERR_DELETE, "delete", path);
+}
+int access(sqlite3_vfs*, const char* name, int flags, int* output) {
+  FsFileSystem* fs;
+  char path[FS_MAX_PATH];
+  *output = 0;
+  if (fsdevTranslatePath(name, &fs, path) != 0) return SQLITE_IOERR_ACCESS;
+  FsDirEntryType type;
+  Result rc = fsFsGetEntryType(fs, path, &type);
+  if (rc == PathNotFound) return SQLITE_OK;
+  if (R_FAILED(rc)) return error(rc, SQLITE_IOERR_ACCESS, "access", path);
+  if (flags == SQLITE_ACCESS_EXISTS) { *output = 1; return SQLITE_OK; }
+  std::lock_guard guard(handleMutex);
+  if (auto* shared = findHandle(fs, path)) {
+    *output = flags != SQLITE_ACCESS_READWRITE || (shared->mode & FsOpenMode_Write);
+    return SQLITE_OK;
+  }
+  FsFile handle;
+  rc = fsFsOpenFile(fs, path, FsOpenMode_Read |
+      (flags == SQLITE_ACCESS_READWRITE ? FsOpenMode_Write : 0), &handle);
+  if (R_SUCCEEDED(rc)) { *output = 1; fsFileClose(&handle); }
+  return SQLITE_OK;
+}
+int randomness(sqlite3_vfs*, int amount, char* bytes) {
+  randomGet(bytes, amount);
+  return amount;
+}
+int sleep(sqlite3_vfs*, int microseconds) {
+  svcSleepThread(static_cast<s64>(microseconds) * 1000);
+  return microseconds;
+}
+int currentTime64(sqlite3_vfs*, sqlite3_int64* output) {
+  timespec now{};
+  if (clock_gettime(CLOCK_REALTIME, &now) != 0) return SQLITE_ERROR;
+  *output = 210866760000000LL + static_cast<sqlite3_int64>(now.tv_sec) * 1000 + now.tv_nsec / 1000000;
+  return SQLITE_OK;
+}
+int currentTime(sqlite3_vfs* vfs, double* output) {
+  sqlite3_int64 value = 0;
+  const int result = currentTime64(vfs, &value);
+  *output = static_cast<double>(value) / 86400000.0;
+  return result;
+}
+int lastError(sqlite3_vfs*, int length, char* output) {
+  if (length > 0) std::snprintf(output, length, "HOS result %08x", lastResult);
+  return static_cast<int>(lastResult);
+}
+sqlite3_vfs vfs = {
+    2, sizeof(HosFile), FS_MAX_PATH - 1, nullptr, "hos", nullptr, open, remove, access, fullPath,
+    nullptr, nullptr, nullptr, nullptr, randomness, sleep, currentTime, lastError, currentTime64,
+    nullptr, nullptr, nullptr};
+} // namespace
+
+extern "C" int sqlite3_os_init() { return sqlite3_vfs_register(&vfs, 1); }
+extern "C" int sqlite3_os_end() { return SQLITE_OK; }
