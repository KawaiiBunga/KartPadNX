+
+// out: [0]=wait ns, [1]=process ns, [2]=bytes, [3]=drains (cumulative).
+extern "C" void aurora_switch_fifo_counters(uint64_t* out) {
+  using namespace aurora::gx::fifo;
+  out[0] = sDrainWaitNs.load(std::memory_order_relaxed);
+  out[1] = sDrainProcessNs.load(std::memory_order_relaxed);
+  out[2] = sDrainBytes.load(std::memory_order_relaxed);
+  out[3] = sDrainCount.load(std::memory_order_relaxed);
+}
