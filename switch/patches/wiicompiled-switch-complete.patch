diff --git a/aurora-main/include/aurora/perf.hpp b/aurora-main/include/aurora/perf.hpp
--- /dev/null
+++ b/aurora-main/include/aurora/perf.hpp
@@ -0,0 +1,64 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace aurora::perf {
+enum class Stage : uint8_t {
+  Untracked, Guest, ThpVideo, GuestOther, FrameWait, FifoDecode, TextureUpload,
+  TextureConvert, ReadbackWait, ReadbackEncode, FramePrepare, StagingWait,
+  FrameSeal, RenderEncode, CommandFinish, QueueSubmit, PresentAcquire,
+  PresentEncode, PresentCall, Pacing, Events, AudioMix, AudioWait, DiscRead,
+  ThpNative, ThpFallback, GuestSceneCalc, GuestSceneDraw, GuestRaceUpdate,
+  GuestKartUpdate, GuestModelCalc, GuestModelDraw, GuestWorldCalc, GuestViewCalc,
+  GxCapture, GxWorkerDecode, GxWorkerWait,
+  GuestKartSub, GuestKartAI, GuestKartMovement, GuestKartPhysics, GuestKartApplyPhysics, GuestKartContacts, GuestKartCollision, GuestKartWheels, GuestKartTransforms, GuestKartDriver,
+  GuestModelTraversal, GuestModelSetup, GuestMaterialLoad, GuestMaterialChannels,
+  GuestMaterialTextures, GuestShapeDraw, GuestMatrixSelect,
+  GuestSceneManagerDraw, GuestShapeSubmit, GuestSceneEfbCapture,
+  GxLockWait, GxDrawBuild, GxPreparedReplay, GuestSceneModelsDraw,
+  GuestSceneLights, GuestSceneDone, GuestSceneSwitch, Count
+};
+constexpr size_t StageCount = static_cast<size_t>(Stage::Count);
+struct Context;
+class Scope;
+struct Context {
+  Stage root = Stage::Untracked;
+  Scope* scope = nullptr;
+  uint64_t lastTick = 0;
+};
+struct Sample { uint64_t ticks = 0, calls = 0; };
+using Snapshot = std::array<Sample, StageCount>;
+
+#if defined(__SWITCH__) || defined(AURORA_PERF_TEST)
+// Contexts follow cooperative guest fibers. A suspended scope is not charged
+// for another fiber's work. Native worker threads each have their own context.
+void activate(Context* context) noexcept;
+void set_root(Context& context, Stage root) noexcept;
+void checkpoint() noexcept;
+Snapshot snapshot() noexcept;
+void frame() noexcept;
+class Scope {
+public:
+  explicit Scope(Stage stage) noexcept;
+  ~Scope();
+  Scope(const Scope&) = delete;
+  Scope& operator=(const Scope&) = delete;
+private:
+  friend void checkpoint() noexcept;
+  Context* context_;
+  Scope* parent_;
+  Stage stage_;
+};
+#else
+inline void activate(Context*) noexcept {}
+inline void set_root(Context&, Stage) noexcept {}
+inline void checkpoint() noexcept {}
+inline void frame() noexcept {}
+class Scope { public: explicit Scope(Stage) noexcept {} };
+#endif
+} // namespace aurora::perf
+
+#define AURORA_PERF_JOIN_INNER(a, b) a##b
+#define AURORA_PERF_JOIN(a, b) AURORA_PERF_JOIN_INNER(a, b)
+#define AURORA_PERF_SCOPE(stage) ::aurora::perf::Scope AURORA_PERF_JOIN(perfScope, __LINE__){::aurora::perf::Stage::stage}
