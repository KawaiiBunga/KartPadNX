diff --git a/aurora-main/lib/webgpu/gpu_cache_switch.cpp b/aurora-main/lib/webgpu/gpu_cache_switch.cpp
--- /dev/null
+++ b/aurora-main/lib/webgpu/gpu_cache_switch.cpp
@@ -0,0 +1,111 @@
+#include "../fs_helper.hpp"
+#include "../internal.hpp"
+#include "../sqlite_utils.hpp"
+#include "../switch/blob_cache.hpp"
+#include "gpu.hpp"
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#define XXH_STATIC_LINKING_ONLY
+#include <xxhash.h>
+
+namespace aurora::webgpu {
+static Module Log("aurora::gpu::cache");
+using switch_platform::BlobCache;
+static std::mutex initMutex;
+static std::shared_ptr<BlobCache> cache;
+static bool broken = false;
+static std::atomic<uint64_t> lookups{0}, hits{0}, stores{0}, hitBytes{0}, loadMicros{0}, storeMicros{0};
+struct Timer {
+  std::atomic<uint64_t>& total;
+  std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+  ~Timer() {
+    total.fetch_add(std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now() - start).count(), std::memory_order_relaxed);
+  }
+};
+
+static std::shared_ptr<BlobCache> get_cache() {
+  std::lock_guard lock(initMutex);
+  if (cache || broken) return cache;
+  const auto start = std::chrono::steady_clock::now();
+  std::error_code ec;
+  std::filesystem::create_directories(g_config.cachePath, ec);
+  const auto path = fs_path_to_string(std::filesystem::path(g_config.cachePath) / "dawn_cache.db");
+  sqlite3* db = nullptr;
+  if (sqlite::open_cache(path.c_str(), &db, Log) != SQLITE_OK) {
+    Log.error("Failed to open Dawn cache: {}", db ? sqlite3_errmsg(db) : "no connection");
+    sqlite3_close(db);
+    broken = true;
+    return {};
+  }
+  auto instance = std::make_shared<BlobCache>();
+  if (!instance->initialize(db, [](const char* message) { Log.error("HOS blob cache: {}", message); })) {
+    Log.error("HOS blob cache initialization failed");
+    broken = true;
+    return {};
+  }
+  const auto stats = instance->stats();
+  Log.info("HOS Dawn cache in RAM: {} blobs, {:.1f} MiB, loaded in {} ms; asynchronous batched writer",
+           stats.entries, stats.residentBytes / (1024.0 * 1024.0),
+           std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count());
+  cache = std::move(instance);
+  return cache;
+}
+
+static BlobCache::Key hash_key(const void* key, size_t size) {
+  const auto hash = XXH128(key, size, 0);
+  BlobCache::Key result;
+  static_assert(sizeof(result) == sizeof(hash));
+  std::memcpy(result.data(), &hash, sizeof(hash));
+  return result;
+}
+
+size_t load_from_cache(const void* key, size_t keySize, void* value, size_t valueSize, void*) {
+  Timer timer{loadMicros};
+  auto instance = get_cache();
+  if (!instance) return 0;
+  const auto size = instance->load(hash_key(key, keySize), value, valueSize);
+  if (!value) {
+    ++lookups;
+    if (size) ++hits;
+  } else if (size) hitBytes.fetch_add(size, std::memory_order_relaxed);
+  return size;
+}
+
+void store_to_cache(const void* key, size_t keySize, const void* value, size_t size, void*) {
+  Timer timer{storeMicros};
+  auto instance = get_cache();
+  if (instance && instance->store(hash_key(key, keySize), value, size)) ++stores;
+}
+
+void cache_shutdown() {
+  std::shared_ptr<BlobCache> instance;
