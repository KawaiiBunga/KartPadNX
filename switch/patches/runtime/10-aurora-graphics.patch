+  const auto* data = static_cast<const uint8_t*>(sqlite3_column_blob(getStmt_, 0));
+  bool valid = false;
+  if (bytes > 0 && bytes <= static_cast<int>(MaxBlobBytes) && data != nullptr) {
+    if (isCompressed) {
+      valid = true;
+    } else {
+      valid = (static_cast<size_t>(bytes) == expectedSize);
+    }
+  }
+  if (valid) {
+    outBytes.assign(data, data + bytes);
+  }
+  sqlite3_reset(getStmt_);
+  sqlite3_clear_bindings(getStmt_);
+  return valid;
