+bool BlobCache::load_blob_from_disk(const Key& key, std::vector<uint8_t>& outBytes, size_t expectedSize, bool isCompressed) {
+  if (!db_ || !getStmt_) return false;
+  if (sqlite3_bind_blob(getStmt_, 1, key.data(), sizeof(Key), SQLITE_STATIC) != SQLITE_OK) {
+    sqlite3_reset(getStmt_);
