+static std::string pipeline_cache_seed_path() {
+  if (g_config.resourcesPath == nullptr || g_config.resourcesPath[0] == '\0') {
+#if defined(AURORA_PLATFORM_SWITCH) || defined(__SWITCH__)
+    return "sdmc:/switch/kartpad/initial_pipeline_cache.db";
+#else
+    return InitialPipelineCacheName;
+#endif
+  }
+
+  std::string path{g_config.resourcesPath};
+  if (path.back() != '/' && path.back() != '\\') {
+    path += '/';
+  }
+  path += InitialPipelineCacheName;
+  return path;
+}
+
+static sqlite3* open_pipeline_cache_seed_db(const std::string& path) {
+#if defined(AURORA_PLATFORM_SWITCH) || defined(__SWITCH__)
+  sqlite3* seedDb = nullptr;
+  const auto ret = sqlite3_open_v2(path.c_str(), &seedDb, SQLITE_OPEN_READONLY, "hos");
+#else
+  if (!register_sdl_vfs()) {
+    Log.warn("Failed to register SDL pipeline cache seed VFS");
+    return nullptr;
+  }
+
+  sqlite3* seedDb = nullptr;
+  const auto ret =
+      sqlite3_open_v2(path.c_str(), &seedDb, SQLITE_OPEN_READONLY | SQLITE_OPEN_PRIVATECACHE, SdlVfsName);
+#endif
+  if (ret != SQLITE_OK) {
+    if (seedDb != nullptr) {
+      sqlite3_close(seedDb);
+    }
+    Log.info("No bundled initial pipeline cache found at '{}'", path);
+    return nullptr;
+  }
+
+  bool schemaMatch = false;
+  const auto schemaQuery = fmt::format("SELECT 1 FROM aurora_schema WHERE value = {}", PipelineCacheSchema);
+  const auto schemaRet =
+      sqlite::exec(seedDb, schemaQuery.c_str(), [&schemaMatch](int, char**, char**) { schemaMatch = true; });
+  if (schemaRet != SQLITE_OK) {
+    Log.warn("Failed to read bundled pipeline cache schema from '{}': {}", path, sqlite3_errmsg(seedDb));
+    sqlite3_close(seedDb);
+    return nullptr;
+  }
+  if (!schemaMatch) {
+    Log.warn("Bundled pipeline cache '{}' does not use schema version {}", path, PipelineCacheSchema);
+    sqlite3_close(seedDb);
+    return nullptr;
+  }
+
+  return seedDb;
+}
+
+static bool is_pipeline_cache_seeded(const std::string& seedPath) {
+  if (g_pipelineCacheDb == nullptr) return false;
+  sqlite::exec(g_pipelineCacheDb,
+               "CREATE TABLE IF NOT EXISTS aurora_seed_status (path TEXT PRIMARY KEY, version INTEGER);");
+  bool alreadySeeded = false;
+  const auto query = fmt::format(
+      "SELECT 1 FROM aurora_seed_status WHERE path = '{}' AND version = {};",
+      seedPath, PipelineCacheSchema);
+  sqlite::exec(g_pipelineCacheDb, query.c_str(),
+               [&alreadySeeded](int, char**, char**) { alreadySeeded = true; });
+  return alreadySeeded;
+}
+
+static void mark_pipeline_cache_seeded(const std::string& seedPath) {
+  if (g_pipelineCacheDb == nullptr) return;
+  const auto cmd = fmt::format(
+      "INSERT OR REPLACE INTO aurora_seed_status (path, version) VALUES ('{}', {});",
+      seedPath, PipelineCacheSchema);
+  sqlite::exec(g_pipelineCacheDb, cmd.c_str());
+}
+
+#if defined(AURORA_GFX_DEKO3D)
+// The native recipe seed ships in RomFS beside initial_dksh_cache.bin, with a small text file holding
+// an id of its contents (builder/deko-training.py pack-pipelines). SQLite's "hos" VFS opens only SD
+// card (fsdev) paths, so the seed is copied to the SD card whenever its id changes. It is merged into
+// the console's own recipes once per id, so a newer build's seed is merged again.
+constexpr const char* NativeSeedRomfs = "romfs:/deko/initial_pipeline_cache.db";
+constexpr const char* NativeSeedIdRomfs = "romfs:/deko/initial_pipeline_cache.id";
+constexpr const char* NativeSeedSd = "sdmc:/switch/kartpad/Cache/deko/initial_pipeline_cache.db";
+constexpr const char* NativeSeedIdSd = "sdmc:/switch/kartpad/Cache/deko/initial_pipeline_cache.id";
+
+static std::string read_seed_id(const char* path) {
+  std::string id;
+  if (FILE* f = std::fopen(path, "rb")) {
+    char buffer[128];
+    const size_t n = std::fread(buffer, 1, sizeof buffer, f);
+    std::fclose(f);
+    id.assign(buffer, n);
+    while (!id.empty() && (id.back() == '\n' || id.back() == '\r' || id.back() == ' ')) id.pop_back();
+  }
+  // The id becomes part of an SQL literal in the seed status table: accept hex digits only.
+  if (id.empty() || id.find_first_not_of("0123456789abcdef") != std::string::npos) return {};
+  return id;
+}
+
+// Writes `from` to `to` through a ".part" file, so an interrupted copy never looks complete.
+static bool copy_seed_file(const char* from, const char* to) {
+  FILE* in = std::fopen(from, "rb");
+  if (in == nullptr) return false;
+  const std::string part = std::string(to) + ".part";
+  FILE* out = std::fopen(part.c_str(), "wb");
+  if (out == nullptr) {
+    std::fclose(in);
+    return false;
+  }
+  std::vector<char> buffer(1 << 20);
+  bool ok = true;
+  for (size_t n; (n = std::fread(buffer.data(), 1, buffer.size(), in)) > 0;) {
+    if (std::fwrite(buffer.data(), 1, n, out) != n) {
+      ok = false;
+      break;
+    }
+  }
+  ok = ok && !std::ferror(in);
+  std::fclose(in);
+  ok = std::fclose(out) == 0 && ok;
+  std::remove(to);
+  ok = ok && std::rename(part.c_str(), to) == 0;
+  if (!ok) std::remove(part.c_str());
+  return ok;
+}
+
+// Returns the id of the seed now on the SD card, or "" when this build has none.
+static std::string stage_native_pipeline_seed() {
+  const std::string id = read_seed_id(NativeSeedIdRomfs);
+  if (id.empty()) return {};
+  if (read_seed_id(NativeSeedIdSd) == id) return id;
+  // The id file is written last: a copy cut short leaves the old id, and the next boot retries.
+  std::remove(NativeSeedIdSd);
+  if (!copy_seed_file(NativeSeedRomfs, NativeSeedSd) || !copy_seed_file(NativeSeedIdRomfs, NativeSeedIdSd)) {
+    Log.warn("Native deko3d: could not copy the pipeline recipe seed to '{}'", NativeSeedSd);
+    return {};
+  }
+  return id;
+}
+#endif
+
+static void seed_pipeline_cache() {
+  if (g_pipelineCacheBroken || g_pipelineCacheDb == nullptr || g_pipelineCacheUpsertStmt == nullptr) {
+    return;
+  }
+
+#if defined(AURORA_GFX_DEKO3D)
+  const std::string seedId = stage_native_pipeline_seed();
+  if (seedId.empty()) {
+    Log.info("Native deko3d: this build has no pipeline recipe seed");
+    return;
+  }
+  const std::string seedPath = NativeSeedSd;
+  const std::string seedKey = seedPath + "#" + seedId;
+#else
+  const auto seedPath = pipeline_cache_seed_path();
+  const auto& seedKey = seedPath;
+#endif
+  if (is_pipeline_cache_seeded(seedKey)) {
+    Log.info("Pipeline cache already seeded from '{}'; skipping redundant upsert", seedKey);
+    return;
+  }
+
+  sqlite3* seedDb = open_pipeline_cache_seed_db(seedPath);
+  if (seedDb == nullptr) {
+    return;
+  }
+
+  sqlite3_stmt* seedStmt = nullptr;
+  auto closeSeed = [&] {
+    if (seedStmt != nullptr) {
+      sqlite3_finalize(seedStmt);
+      seedStmt = nullptr;
+    }
+    sqlite3_close(seedDb);
+  };
+
+  auto ret = sqlite3_prepare_v3(seedDb,
+                                "SELECT type, hash, config_version, config_size, config, first_frame_used "
+                                "FROM pipeline_cache",
+                                -1, 0, &seedStmt, nullptr);
+  if (ret != SQLITE_OK) {
+    Log.warn("Failed to read bundled pipeline cache rows from '{}': {}", seedPath, sqlite3_errmsg(seedDb));
+    closeSeed();
+    return;
+  }
+
+  bool writeFailed = false;
+  bool readFailed = false;
+  uint32_t mergedRows = 0;
+  uint32_t skippedRows = 0;
+  // The whole merge in SQLite's page cache: with the default 2 MiB it spilled pages to the SD card
+  // in small random writes mid-transaction (25 s for 3242 rows on the console).
+  sqlite::exec(g_pipelineCacheDb, "PRAGMA cache_size=-65536;");
+  {
+    sqlite::Transaction tx(g_pipelineCacheDb, Log, true);
+    if (!tx) {
+      Log.error("Failed to begin pipeline cache seed transaction");
+      closeSeed();
+      pipeline_cache_abort();
+      return;
+    }
+
+    while ((ret = sqlite3_step(seedStmt)) == SQLITE_ROW) {
+      const auto typeValue = sqlite3_column_int(seedStmt, 0);
+      const auto hashValue = sqlite3_column_int64(seedStmt, 1);
+      const auto configVersionValue = sqlite3_column_int(seedStmt, 2);
+      const auto configSizeValue = sqlite3_column_int(seedStmt, 3);
+      const auto* configBlob = static_cast<const uint8_t*>(sqlite3_column_blob(seedStmt, 4));
+      const auto configBlobSize = sqlite3_column_bytes(seedStmt, 4);
+      const auto firstFrameUsedValue = sqlite3_column_int64(seedStmt, 5);
+      constexpr auto MaxShaderTypeValue = std::numeric_limits<std::underlying_type_t<ShaderType>>::max();
+      if (typeValue < 0 || typeValue > MaxShaderTypeValue || configVersionValue < 0 || configSizeValue < 0 ||
+          configSizeValue != configBlobSize || (configBlobSize > 0 && configBlob == nullptr) ||
+          firstFrameUsedValue < 0 || firstFrameUsedValue > std::numeric_limits<uint32_t>::max()) {
+        ++skippedRows;
+        continue;
+      }
+
+      PipelineCacheWrite write{
+          .type = static_cast<ShaderType>(typeValue),
+          .hash = static_cast<PipelineRef>(hashValue),
+          .configVersion = static_cast<uint32_t>(configVersionValue),
+          .config = ByteBuffer(static_cast<size_t>(configBlobSize)),
+          .firstFrameUsed = static_cast<uint32_t>(firstFrameUsedValue),
+      };
+      if (configBlobSize > 0) {
+        std::memcpy(write.config.data(), configBlob, static_cast<size_t>(configBlobSize));
+      }
+
+      if (!write_pipeline_cache_record(write)) {
+        writeFailed = true;
+        break;
+      }
+      ++mergedRows;
+#if defined(AURORA_GFX_DEKO3D)
+      if (mergedRows % 64 == 0) {
+        boot_screen_tick("UPDATING THE SHADER LIST");
+      }
+#endif
+    }
+
+    if (!writeFailed && ret != SQLITE_DONE) {
+      Log.warn("Failed while reading bundled pipeline cache rows from '{}': {}", seedPath, sqlite3_errmsg(seedDb));
+      readFailed = true;
+    }
+
+    if (!writeFailed && !readFailed) {
+      tx.commit();
+      mark_pipeline_cache_seeded(seedKey);
+    }
+  }
+  sqlite::exec(g_pipelineCacheDb, "PRAGMA cache_size=-2000;");
+
+  closeSeed();
+
+  if (writeFailed) {
+    pipeline_cache_abort();
+    return;
+  }
+
+  if (!readFailed) {
+    Log.info("Seeded pipeline cache from '{}' ({} rows merged, {} rows skipped)", seedPath, mergedRows,
+             skippedRows);
+  }
+}
+
+static bool prepare_pipeline_cache_db() {
+  if (g_pipelineCacheBroken) {
+    return false;
+  }
+  if (g_pipelineCacheDb != nullptr) {
+    return true;
+  }
+
+  std::error_code ec;
+  std::filesystem::create_directories(g_config.pipelineCachePath, ec);
+  const auto path = fs_path_to_string(std::filesystem::path(g_config.pipelineCachePath) /
+#if defined(AURORA_GFX_DEKO3D)
+      "pipeline_cache_deko.db"
+#else
+      "pipeline_cache.db"
+#endif
+  );
+  auto ret = sqlite::open_cache(path.c_str(), &g_pipelineCacheDb, Log);
+  if (ret != SQLITE_OK) {
+    Log.error("Failed to open pipeline cache database: {}", sqlite3_errmsg(g_pipelineCacheDb));
+    pipeline_cache_abort();
+    return false;
+  }
+
+  ret = sqlite::exec(g_pipelineCacheDb, sqlite::CachePragmas);
+  if (ret != SQLITE_OK) {
+    Log.error("Failed to set pipeline cache pragmas: {}", sqlite3_errmsg(g_pipelineCacheDb));
+    pipeline_cache_abort();
+    return false;
+  }
+
+  bool schemaFailed = false;
+  {
+    sqlite::Transaction tx(g_pipelineCacheDb, Log, true);
+    if (!tx) {
+      Log.error("Failed to begin pipeline cache schema transaction");
+      schemaFailed = true;
+    } else {
+      ret = sqlite::exec(g_pipelineCacheDb, "CREATE TABLE IF NOT EXISTS aurora_schema(value INTEGER);");
+      if (ret != SQLITE_OK) {
+        Log.error("Failed to create pipeline cache schema table: {}", sqlite3_errmsg(g_pipelineCacheDb));
+        schemaFailed = true;
+      }
+    }
+
+    bool schemaMatch = false;
+    if (!schemaFailed) {
+      const auto schemaQuery = fmt::format("SELECT 1 FROM aurora_schema WHERE value = {}", PipelineCacheSchema);
+      ret = sqlite::exec(g_pipelineCacheDb, schemaQuery.c_str(),
+                         [&schemaMatch](int, char**, char**) { schemaMatch = true; });
+      if (ret != SQLITE_OK) {
+        Log.error("Failed to read pipeline cache schema version: {}", sqlite3_errmsg(g_pipelineCacheDb));
+        schemaFailed = true;
+      }
+    }
+
+    if (!schemaFailed && !schemaMatch) {
+      const auto schemaSql = fmt::format(
+          R"(DROP TABLE IF EXISTS pipeline_cache;
+CREATE TABLE pipeline_cache (
+  type INTEGER NOT NULL,
+  hash INTEGER NOT NULL,
+  config_version INTEGER NOT NULL,
+  config_size INTEGER NOT NULL,
+  config BLOB NOT NULL,
+  first_frame_used INTEGER NOT NULL,
+  PRIMARY KEY (type, hash)
+);
+CREATE INDEX pipeline_cache_load_order_idx
+  ON pipeline_cache(type, config_version, first_frame_used);
+DELETE FROM aurora_schema;
+INSERT INTO aurora_schema VALUES ({});)",
+          PipelineCacheSchema);
+      ret = sqlite::exec(g_pipelineCacheDb, schemaSql.c_str());
+      if (ret != SQLITE_OK) {
+        Log.error("Failed to initialize pipeline cache schema: {}", sqlite3_errmsg(g_pipelineCacheDb));
+        schemaFailed = true;
+      }
+    }
+
+    if (!schemaFailed) {
+      tx.commit();
+    }
+  }
+
+  if (schemaFailed) {
+    pipeline_cache_abort();
+    return false;
+  }
+
+  ret = sqlite3_prepare_v3(g_pipelineCacheDb, PipelineCacheLoadSql, -1, SQLITE_PREPARE_PERSISTENT,
+                           &g_pipelineCacheLoadStmt, nullptr);
+  if (ret != SQLITE_OK) {
+    Log.error("Failed to prepare pipeline cache load statement: {}", sqlite3_errmsg(g_pipelineCacheDb));
+    pipeline_cache_abort();
+    return false;
+  }
+
+  ret = sqlite3_prepare_v3(
+      g_pipelineCacheDb,
+      "INSERT INTO pipeline_cache (type, hash, config_version, config_size, config, first_frame_used) "
+      "VALUES (?, ?, ?, ?, ?, ?) "
+      "ON CONFLICT(type, hash) DO UPDATE SET "
+      "config_version = excluded.config_version, "
+      "config_size = excluded.config_size, "
+      "config = excluded.config, "
+      "first_frame_used = MIN(pipeline_cache.first_frame_used, excluded.first_frame_used)",
+      -1, SQLITE_PREPARE_PERSISTENT, &g_pipelineCacheUpsertStmt, nullptr);
+  if (ret != SQLITE_OK) {
+    Log.error("Failed to prepare pipeline cache upsert statement: {}", sqlite3_errmsg(g_pipelineCacheDb));
+    pipeline_cache_abort();
+    return false;
+  }
+
+  seed_pipeline_cache();
+  if (g_pipelineCacheBroken) {
+    return false;
+  }
+
+  return true;
+}
+
+static void prune_old_pipeline_cache_versions() {
+  if (!prepare_pipeline_cache_db()) {
+    return;
+  }
+
+  const auto clearDelete = fmt::format("DELETE FROM pipeline_cache WHERE type = {} AND config_version < {}",
+                                       underlying(ShaderType::Clear), clear::ClearPipelineConfigVersion);
+  auto ret = sqlite::exec(g_pipelineCacheDb, clearDelete.c_str());
+  if (ret != SQLITE_OK) {
+    Log.error("Failed to prune clear pipeline cache rows: {}", sqlite3_errmsg(g_pipelineCacheDb));
+    pipeline_cache_abort();
+    return;
+  }
+
+  const auto gxDelete = fmt::format("DELETE FROM pipeline_cache WHERE type = {} AND config_version < {}",
+                                    underlying(ShaderType::GX), gx::GXPipelineConfigVersion);
+  ret = sqlite::exec(g_pipelineCacheDb, gxDelete.c_str());
+  if (ret != SQLITE_OK) {
+    Log.error("Failed to prune GX pipeline cache rows: {}", sqlite3_errmsg(g_pipelineCacheDb));
+    pipeline_cache_abort();
+  }
+}
+
+static bool write_pipeline_cache_record(const PipelineCacheWrite& write) {
+  const auto fail = [&]() {
+    sqlite3_reset(g_pipelineCacheUpsertStmt);
+    sqlite3_clear_bindings(g_pipelineCacheUpsertStmt);
+    return false;
+  };
+
+  auto ret = sqlite3_bind_int(g_pipelineCacheUpsertStmt, 1, underlying(write.type));
+  if (ret != SQLITE_OK) {
+    Log.error("Failed to bind pipeline cache type: {}", sqlite3_errmsg(g_pipelineCacheDb));
+    return fail();
+  }
+  ret = sqlite3_bind_int64(g_pipelineCacheUpsertStmt, 2, static_cast<sqlite3_int64>(write.hash));
+  if (ret != SQLITE_OK) {
+    Log.error("Failed to bind pipeline cache hash: {}", sqlite3_errmsg(g_pipelineCacheDb));
+    return fail();
+  }
+  ret = sqlite3_bind_int(g_pipelineCacheUpsertStmt, 3, static_cast<int>(write.configVersion));
+  if (ret != SQLITE_OK) {
+    Log.error("Failed to bind pipeline cache config version: {}", sqlite3_errmsg(g_pipelineCacheDb));
+    return fail();
+  }
+  ret = sqlite3_bind_int(g_pipelineCacheUpsertStmt, 4, static_cast<int>(write.config.size()));
+  if (ret != SQLITE_OK) {
+    Log.error("Failed to bind pipeline cache config size: {}", sqlite3_errmsg(g_pipelineCacheDb));
+    return fail();
+  }
+  ret = sqlite3_bind_blob64(g_pipelineCacheUpsertStmt, 5, write.config.data(), write.config.size(), SQLITE_TRANSIENT);
+  if (ret != SQLITE_OK) {
+    Log.error("Failed to bind pipeline cache config blob: {}", sqlite3_errmsg(g_pipelineCacheDb));
+    return fail();
+  }
+  ret = sqlite3_bind_int64(g_pipelineCacheUpsertStmt, 6, static_cast<sqlite3_int64>(write.firstFrameUsed));
+  if (ret != SQLITE_OK) {
+    Log.error("Failed to bind pipeline cache first-frame-used: {}", sqlite3_errmsg(g_pipelineCacheDb));
+    return fail();
+  }
+
+  ret = sqlite3_step(g_pipelineCacheUpsertStmt);
+  if (ret != SQLITE_DONE) {
+    Log.error("Failed to upsert pipeline cache row: {}", sqlite3_errmsg(g_pipelineCacheDb));
+    return fail();
+  }
+
+  sqlite3_reset(g_pipelineCacheUpsertStmt);
+  sqlite3_clear_bindings(g_pipelineCacheUpsertStmt);
+  return true;
+}
+
+static void pipeline_cache_writer() {
+#ifdef TRACY_ENABLE
+  tracy::SetThreadName("Pipeline cache writer thread");
+#endif
+
+  while (true) {
+    std::deque<PipelineCacheWrite> batch;
+    {
+      std::unique_lock lock{g_pipelineCacheWriterMutex};
+      g_pipelineCacheWriterCv.wait(lock,
+                                   [] { return g_pipelineCacheWriterStop || !g_pipelineCacheWriteQueue.empty(); });
+      if (g_pipelineCacheWriterStop && g_pipelineCacheWriteQueue.empty()) {
+        return;
+      }
+      batch.swap(g_pipelineCacheWriteQueue);
+      g_pipelineCachePendingWrites.clear();
+    }
+
+    bool writeFailed = false;
+    {
+      sqlite::Transaction tx(g_pipelineCacheDb, Log, true);
+      if (!tx) {
+        Log.error("Failed to begin pipeline cache write transaction");
+        writeFailed = true;
+      } else {
+        for (const auto& write : batch) {
+          if (!write_pipeline_cache_record(write)) {
+            writeFailed = true;
+            break;
+          }
+        }
+
+        if (!writeFailed) {
+          tx.commit();
+        }
+      }
+    }
+
+    if (writeFailed) {
+      pipeline_cache_abort();
+      return;
+    }
+  }
+}
+
+// Boot prewarm telemetry: how long the cached-recipe rebuild takes and how well the
+// Dawn blob cache served it. Logged once, when the launch queue first drains.
+static std::atomic_bool g_prewarmActive{false};
+static std::chrono::steady_clock::time_point g_prewarmStart{};
+static uint32_t g_prewarmCount = 0;
+
+#ifdef AURORA_PLATFORM_SWITCH
+static void report_pipeline_progress() {
+  const auto now = steady_millis();
+  auto next = g_nextProgressMs.load(std::memory_order_relaxed);
+  if (now < next || !g_nextProgressMs.compare_exchange_strong(next, now + 10000)) return;
+  const auto stats = webgpu::blob_cache_stats();
+  Log.info("HOS shader progress: elapsed={:.1f} s ready={} pending={} waits={} ({:.1f} s), synchronous builds={}, "
+           "cache hits={}/{} stores={} callback time load={:.1f} s store={:.1f} s, "
+           "writer pending={:.1f} MiB commits={} dropped={}",
+           (now - g_shaderStartMs) / 1000.0, createdPipelines.load(), queuedPipelines.load(),
+           g_waitCount.load(), g_waitMicros.load() / 1e6,
+           g_synchronousBuilds.load(), stats.hits, stats.lookups, stats.stores,
+           stats.loadMicros / 1e6, stats.storeMicros / 1e6,
+           stats.pendingBytes / (1024.0 * 1024.0), stats.commits, stats.droppedStores);
+}
+
+static void checkpoint_pipeline_cache(bool background) {
+  // A user may close the NRO before the long first prewarm finishes. Save
+  // completed native compiles periodically without doing this for every job.
+  if (!background || !g_prewarmActive.load(std::memory_order_acquire)) return;
+  const auto now = steady_millis();
+  auto next = g_nextCheckpointMs.load(std::memory_order_relaxed);
+  if (now < next) return;
+  {
+    std::lock_guard lock{g_pipelineMutex};
+    if (!g_priorityPipelines.empty() || g_pipelineThreadEnd) return;
+  }
+  if (!g_nextCheckpointMs.compare_exchange_strong(next, now + 60000)) return;
+  webgpu::serialize_pipeline_caches();
+  Log.info("HOS native pipeline cache checkpoint completed in {} ms", steady_millis() - now);
+}
+#endif
+
+static void note_pipeline_queue_drained() {
+  if (!g_prewarmActive.exchange(false, std::memory_order_acq_rel)) {
+    return;
+  }
+  // Persist the monolithic Vulkan pipeline cache once after boot prewarm only; doing it on
+  // every drained burst stalls the device lock mid-race. Later first-use compiles are
+  // covered by the shutdown serialize.
+  webgpu::serialize_pipeline_caches();
+  const auto elapsed =
+      std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - g_prewarmStart);
+  const auto stats = webgpu::blob_cache_stats();
+  Log.info("Pipeline prewarm finished: {} pipelines in {:.1f} s (Dawn blob cache: {}/{} hits, {} stores, {:.1f} MiB "
+           "loaded)",
+           g_prewarmCount, elapsed.count() / 1000.0, stats.hits, stats.lookups, stats.stores,
+           static_cast<double>(stats.hitBytes) / (1024.0 * 1024.0));
+}
+
+static void compile_pending_pipeline(PendingPipeline pending) {
+#ifdef AURORA_PLATFORM_SWITCH
+  const auto compileStart = steady_millis();
+  const bool verbose = (perf_get_int("shader_log_verbose", 0) != 0);
+  if (verbose) {
+    Log.info("Compiling pipeline 0x{:016x} (queued={})", static_cast<uint64_t>(pending.hash), queuedPipelines.load());
+  }
+#endif
+  auto result = pending.create();
+#ifdef AURORA_PLATFORM_SWITCH
+  const auto compileMs = steady_millis() - compileStart;
+  g_compileMicros.fetch_add(static_cast<uint64_t>(compileMs) * 1000, std::memory_order_relaxed);
+  g_compileCount.fetch_add(1, std::memory_order_relaxed);
+  if (verbose || compileMs >= 100) {
+    Log.info("Finished pipeline 0x{:016x} in {} ms (queued={})", static_cast<uint64_t>(pending.hash), compileMs, queuedPipelines.load());
+  }
+#endif
+  {
+    std::lock_guard lock{g_pipelineMutex};
+    const auto [_, inserted] = g_pipelines.try_emplace(pending.hash, CachedPipeline{
+                                                                         .pipeline = std::move(result),
+                                                                         .firstFrameUsed = pending.firstFrameUsed,
+                                                                     });
+    g_pendingPipelines.erase(pending.hash);
+    if (inserted) {
+      ++createdPipelines;
+    }
+  }
+  g_pipelineCv.notify_all();
+  --queuedPipelines;
+  if (queuedPipelines.load() == 0) {
+    note_pipeline_queue_drained();
+  }
+#ifdef AURORA_PLATFORM_SWITCH
+  report_pipeline_progress();
+#endif
+}
+
+static void pipeline_worker() {
+#ifdef TRACY_ENABLE
+  tracy::SetThreadName("Pipeline compilation thread");
+#endif
+#ifdef AURORA_PLATFORM_SWITCH
+  u64 allowedPriorities = 0;
+  const Result priorityQuery = svcGetInfo(&allowedPriorities, InfoType_PriorityMask, CUR_PROCESS_HANDLE, 0);
+  // Main thread runs at priority 44 (0x2c). Compiler workers should run at
+  // priority 46 (0x2e) so they are scheduled promptly when the game needs shaders,
+  // rather than inheriting libnx default 59 (0x3b) which gets starved to death.
+  s32 normalPriority = 46;
+  static std::atomic<int> s_workerIndex{0};
+  const int workerIndex = s_workerIndex.fetch_add(1, std::memory_order_relaxed);
+  if (kartpad_thread_priority) normalPriority = kartpad_thread_priority(KartpadRoleCompiler, normalPriority);
+  svcSetThreadPriority(CUR_THREAD_HANDLE, normalPriority);
+  // Pin each compiler to one non-guest core; see perf_switch.cpp.
+  if (kartpad_thread_apply) kartpad_thread_apply(KartpadRoleCompiler, workerIndex);
+  const s32 backgroundPriority = 59;
+  s32 currentPriority = normalPriority;
+  bool priorityWarning = false;
+  s32 idealCore = -1;
+  u64 affinity = 0;
+  svcGetThreadCoreMask(&idealCore, &affinity, CUR_THREAD_HANDLE);
+  Log.info("HOS shader worker: thread={:08x}, priority={} background={} cores={:x} priorities={:x}",
+           threadGetCurHandle(), normalPriority, backgroundPriority, affinity, allowedPriorities);
+#endif
+
+  while (true) {
+    PendingPipeline pending;
+    bool background = false;
+    {
+      std::unique_lock lock{g_pipelineMutex};
+      g_pipelineCv.wait(lock, [] {
+        return !g_priorityPipelines.empty() ||
+               (!g_backgroundPipelines.empty() &&
+                g_activeBackgroundPipelineWorkers < g_backgroundPipelineWorkerLimit) ||
+               g_pipelineThreadEnd;
+      });
+      if (g_pipelineThreadEnd) {
+        return;
+      }
+      background = g_priorityPipelines.empty();
+      auto& source = background ? g_backgroundPipelines : g_priorityPipelines;
+      pending = std::move(source.front());
+      source.pop_front();
+      if (background) {
+        ++g_activeBackgroundPipelineWorkers;
+      }
+    }
+#ifdef AURORA_PLATFORM_SWITCH
+#if defined(AURORA_GFX_DEKO3D)
+    const bool lowPriority = background && !g_bootPreload.load(std::memory_order_relaxed);
+#else
+    const bool lowPriority = background;
+#endif
+    const s32 desiredPriority = lowPriority ? backgroundPriority : normalPriority;
+    if (desiredPriority != currentPriority) {
+      const Result result = svcSetThreadPriority(CUR_THREAD_HANDLE, desiredPriority);
+      if (R_SUCCEEDED(result)) currentPriority = desiredPriority;
+      else if (!priorityWarning) {
+        Log.warn("Could not set shader worker priority: {:08x}", result);
+        priorityWarning = true;
+      }
+    }
+#endif
+    compile_pending_pipeline(std::move(pending));
+#ifdef AURORA_PLATFORM_SWITCH
+    checkpoint_pipeline_cache(background);
+#endif
+    if (background) {
+      {
+        std::lock_guard lock{g_pipelineMutex};
+        --g_activeBackgroundPipelineWorkers;
+      }
+      g_pipelineCv.notify_all();
+    }
+  }
+}
+
+static void build_synchronous_pipelines_for_frame() {
+  while (g_pipelinesPerFrame < BuildPipelinesPerFrame) {
+    PendingPipeline pending;
+    {
+      std::lock_guard lock{g_pipelineMutex};
+      if (g_priorityPipelines.empty() && g_backgroundPipelines.empty()) {
+        return;
+      }
+      auto& source = !g_priorityPipelines.empty() ? g_priorityPipelines : g_backgroundPipelines;
+      pending = std::move(source.front());
+      source.pop_front();
+    }
+    compile_pending_pipeline(std::move(pending));
+    ++g_pipelinesPerFrame;
+  }
+}
+
+#if defined(AURORA_GFX_DEKO3D)
+static std::vector<std::thread> g_bootPreloadHelpers;
+
+// A preload helper on a core the compile workers leave free (the game thread's: idle until the game
+// starts). It takes recorded pipelines like a worker and stops with the preload.
+static void boot_preload_helper(s32 idealCore, u64 affinity) {
+  svcSetThreadPriority(CUR_THREAD_HANDLE,
+                       kartpad_thread_priority ? kartpad_thread_priority(KartpadRoleCompiler, 46) : 46);
+  if (affinity != 0) {
+    svcSetThreadCoreMask(CUR_THREAD_HANDLE, idealCore, affinity);
+  }
+  while (true) {
+    PendingPipeline pending;
+    {
+      std::unique_lock lock{g_pipelineMutex};
+      g_pipelineCv.wait(lock, [] {
+        return !g_backgroundPipelines.empty() || !g_bootPreload.load(std::memory_order_relaxed) ||
+               g_pipelineThreadEnd;
+      });
+      if (!g_bootPreload.load(std::memory_order_relaxed) || g_pipelineThreadEnd) {
+        return;
+      }
+      pending = std::move(g_backgroundPipelines.front());
+      g_backgroundPipelines.pop_front();
+    }
+    compile_pending_pipeline(std::move(pending));
+  }
+}
+
+// Before the recipes load, so the workers build while the rest are still read.
+static void begin_boot_preload(size_t workerCount) {
+  if (perf_get_int("boot_preload", 1) == 0) {
+    Log.info("Boot shader preload off (perf.cfg boot_preload 0): recorded pipelines build in the background");
+    return;
+  }
+  g_bootPreload.store(true, std::memory_order_release);
+  {
+    std::lock_guard lock{g_pipelineMutex};
+    g_backgroundPipelineWorkerLimit = MaxBackgroundPipelineWorkers;
+  }
+  if (kartpad_set_boot_cpu_boost) {
+    kartpad_set_boot_cpu_boost(1);
+  }
+  aurora_switch_dk_compile_boost(true);
+  u64 coreMask = 0;
+  svcGetInfo(&coreMask, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0);
+  const size_t cores = static_cast<size_t>(__builtin_popcountll(coreMask & 0x7));
+  s32 idealCore = -2;
+  u64 affinity = 0;
+  svcGetThreadCoreMask(&idealCore, &affinity, CUR_THREAD_HANDLE);
+  for (size_t i = workerCount; i < cores; ++i) {
+    g_bootPreloadHelpers.emplace_back(boot_preload_helper, idealCore, affinity);
+  }
+  g_pipelineCv.notify_all();
+  Log.info("Boot shader preload: {} compile workers and {} helper(s) at the game thread's priority", workerCount,
+           g_bootPreloadHelpers.size());
+}
+
+// Until every queued pipeline is built or + is pressed, drawing the boot screen at 10 Hz.
+static void wait_for_boot_preload(size_t total) {
+  if (!g_bootPreload.load(std::memory_order_acquire)) {
+    return;
+  }
+  const auto start = steady_millis();
+  PadState pad;
+  padInitializeDefault(&pad);
+  bool skipped = false;
+  char detail[64];
+  while (queuedPipelines.load() > 0) {
+    const size_t queued = queuedPipelines.load();
+    const size_t done = total > queued ? total - queued : 0;
+    std::snprintf(detail, sizeof detail, "%zu / %zu", done, total);
+    boot_screen_tick(detail, total ? static_cast<float>(done) / static_cast<float>(total) : 1.0f,
+                     "PRESS + TO START NOW. THE REST BUILD WHILE YOU PLAY.");
+    padUpdate(&pad);
+    if (padGetButtonsDown(&pad) & HidNpadButton_Plus) {
+      skipped = true;
+      break;
+    }
+    std::unique_lock lock{g_pipelineMutex};
+    g_pipelineCv.wait_for(lock, std::chrono::milliseconds(50));
+  }
+  const size_t left = queuedPipelines.load();
+  boot_screen_tick(skipped ? "STARTING" : "DONE",
+                   total ? static_cast<float>(total - left) / static_cast<float>(total) : 1.0f, nullptr, true);
+  Log.info("Boot shader preload: {} of {} pipelines in {:.1f} s{}", total - left, total,
+           (steady_millis() - start) / 1000.0, skipped ? " (+ pressed: the rest build in the background)" : "");
+}
+
+static size_t steady_background_worker_limit(size_t workerCount);
+
+static void end_boot_preload(size_t workerCount) {
+  if (!g_bootPreload.exchange(false, std::memory_order_acq_rel)) {
+    return;
+  }
+  g_pipelineCv.notify_all();
+  for (auto& helper : g_bootPreloadHelpers) {
+    helper.join();
+  }
+  g_bootPreloadHelpers.clear();
+  {
+    std::lock_guard lock{g_pipelineMutex};
+    g_backgroundPipelineWorkerLimit = steady_background_worker_limit(workerCount);
+  }
+  g_pipelineCv.notify_all();
+  aurora_switch_dk_compile_boost(false);
+  if (kartpad_set_boot_cpu_boost) {
+    kartpad_set_boot_cpu_boost(0);
+  }
+}
+#endif
+
+static size_t pipeline_worker_count() {
+#ifdef AURORA_PLATFORM_SWITCH
+  u64 coreMask = 0;
+  const Result result = svcGetInfo(&coreMask, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0);
+  auto workers = switch_platform::pipeline_worker_count(coreMask);
+  if (kartpad_perf_int) {
+    // Tuned profile: one compiler per non-guest core (2 of the 3 app cores).
+    const bool tuned = kartpad_perf_tuned && kartpad_perf_tuned();
+    const int requested = kartpad_perf_int("compile_workers", tuned ? 2 : 0);
+    if (requested > 0) workers = std::min<size_t>(static_cast<size_t>(requested), 3);
+  }
+  Log.info("HOS shader scheduling: allowed cores={:#x}, query={:08x}, workers={}", coreMask, result, workers);
+  return workers;
+#else
+  const size_t logicalProcessors = std::thread::hardware_concurrency();
+  if (logicalProcessors == 0) {
+    return 1;
+  }
+  const size_t availableWorkers =
+      logicalProcessors > ReservedLogicalProcessors ? logicalProcessors - ReservedLogicalProcessors : 1;
+  return std::clamp(availableWorkers, size_t{1}, MaxPipelineWorkers);
+#endif
+}
+
+template <typename PipelineConfig, typename CreateFn>
+static size_t load_pipeline_cache_entries(sqlite3_stmt* stmt, ShaderType type, uint32_t configVersion,
+                                          CreateFn&& create,
+                                          size_t maxEntries = std::numeric_limits<size_t>::max()) {
+  // A zero warmup budget performs no sqlite3_step. Binding a statement returns
+  // SQLITE_OK, which must not be mistaken for a failed SQLITE_ROW/SQLITE_DONE.
+  if (maxEntries == 0) return 0;
+  if (!prepare_pipeline_cache_db()) {
+    return 0;
+  }
+  sqlite3* const db = sqlite3_db_handle(stmt);
+
+  auto ret = sqlite3_bind_int(stmt, 1, underlying(type));
+  if (ret != SQLITE_OK) {
+    Log.error("Failed to bind pipeline cache load type: {}", sqlite3_errmsg(db));
+    pipeline_cache_abort();
+    return 0;
+  }
+  ret = sqlite3_bind_int(stmt, 2, static_cast<int>(configVersion));
+  if (ret != SQLITE_OK) {
+    Log.error("Failed to bind pipeline cache load config version: {}", sqlite3_errmsg(db));
+    pipeline_cache_abort();
+    return 0;
+  }
+
+  size_t loaded = 0;
+  while (loaded < maxEntries && (ret = sqlite3_step(stmt)) == SQLITE_ROW) {
+    const auto storedHash = static_cast<PipelineRef>(sqlite3_column_int64(stmt, 0));
+    const auto* configBlob = static_cast<const uint8_t*>(sqlite3_column_blob(stmt, 1));
+    const auto configSize = sqlite3_column_bytes(stmt, 1);
+    const auto firstFrameUsed = static_cast<uint32_t>(sqlite3_column_int64(stmt, 2));
+    if (configSize != static_cast<int>(sizeof(PipelineConfig)) || (configSize != 0 && configBlob == nullptr)) {
+      continue;
+    }
+    if (xxh3_hash_s(configBlob, static_cast<size_t>(configSize), static_cast<HashType>(type)) != storedHash) {
+      Log.warn("Skipping cached pipeline configuration with mismatched content hash");
+      continue;
+    }
+    PipelineConfig config;
+    std::memcpy(&config, configBlob, sizeof(config));
+    if (config.version != configVersion) {
+      continue;
+    }
+    if constexpr (std::is_same_v<PipelineConfig, gx::PipelineConfig>) {
+      if (!gx::valid_pipeline_config(config)) {
+        Log.warn("Skipping invalid cached GX pipeline configuration");
+        continue;
+      }
+    }
+
+    find_pipeline_impl(type, config, [=] { return create(config); }, false, firstFrameUsed);
+    ++loaded;
+#if defined(AURORA_GFX_DEKO3D)
+    if (loaded % 64 == 0) {
+      boot_screen_tick("READING THE SHADER LIST");
+    }
+#endif
+  }
+
+  if (ret != SQLITE_DONE && ret != SQLITE_ROW) {
+    Log.error("Failed to read pipeline cache rows: {}", sqlite3_errmsg(db));
+    pipeline_cache_abort();
+    return loaded;
+  }
+
+  sqlite3_reset(stmt);
+  sqlite3_clear_bindings(stmt);
+  return loaded;
+}
+
+#if defined(AURORA_GFX_DEKO3D)
+// A read-only RAM copy of the recipe database for the boot load. Through the SD card every 4 KiB
+// page was its own read IPC (3.0 s for 3550 recipes on the console, the whole boot preload once the
+// stage lookups stopped touching the card); here the file is read in 1 MiB pieces through the
+// connection's own handle (HOS refuses a second open while it is writable) and queried in memory.
+// The committed state is on the card: journal_mode=OFF writes every page at commit, and the writer
+// thread starts after the load. Null when unavailable; the caller then reads the file itself.
+static sqlite3* open_pipeline_cache_snapshot(double* mib, int64_t* ms) {
+  const auto start = steady_millis();
+  sqlite3_file* file = nullptr;
+  if (sqlite3_file_control(g_pipelineCacheDb, "main", SQLITE_FCNTL_FILE_POINTER, &file) != SQLITE_OK ||
+      file == nullptr || file->pMethods == nullptr) {
+    return nullptr;
+  }
+  sqlite3_int64 size = 0;
+  if (file->pMethods->xFileSize(file, &size) != SQLITE_OK || size <= 0) {
+    return nullptr;
+  }
+  auto* data = static_cast<unsigned char*>(sqlite3_malloc64(static_cast<sqlite3_uint64>(size)));
+  if (data == nullptr) {
+    return nullptr;
+  }
+  for (sqlite3_int64 offset = 0; offset < size;) {
+    const int chunk = static_cast<int>(std::min<sqlite3_int64>(size - offset, 1 << 20));
+    if (file->pMethods->xRead(file, data + offset, chunk, offset) != SQLITE_OK) {
+      sqlite3_free(data);
+      return nullptr;
+    }
+    offset += chunk;
+  }
+  sqlite3* snapshot = nullptr;
+  if (sqlite3_open_v2(":memory:", &snapshot, SQLITE_OPEN_READWRITE, nullptr) != SQLITE_OK) {
+    sqlite3_close(snapshot);
+    sqlite3_free(data);
+    return nullptr;
+  }
+  // FREEONCLOSE frees `data` with the connection, and on failure too.
+  if (sqlite3_deserialize(snapshot, "main", data, size, size,
+                          SQLITE_DESERIALIZE_FREEONCLOSE | SQLITE_DESERIALIZE_READONLY) != SQLITE_OK) {
+    sqlite3_close(snapshot);
+    return nullptr;
+  }
+  *mib = static_cast<double>(size) / (1024.0 * 1024.0);
+  *ms = steady_millis() - start;
+  return snapshot;
+}
+#endif
+
+static void load_pipeline_cache() {
+  if (!prepare_pipeline_cache_db()) {
+    return;
+  }
+  const auto t0 = std::chrono::steady_clock::now();
+  prune_old_pipeline_cache_versions();
+  if (g_pipelineCacheBroken) {
+    return;
+  }
+
+#if defined(AURORA_GFX_DEKO3D)
+  // Rebuild every recorded pipeline in the background, in first-use order, so a pipeline seen in an
+  // earlier session is ready before the game draws with it. Native DKSH hits make each rebuild cheap,
+  // and one worker always stays free for first-use requests (initialize_pipeline_cache).
+  // perf.cfg `prewarm_max N` limits the count; 0 turns prewarm off.
+  const int prewarmMaxSetting = perf_get_int("prewarm_max", -1);
+  Log.info("Native deko3d: pipeline_cache_deko.db, prewarm max {} (-1 = all recorded pipelines)",
+           prewarmMaxSetting);
+#else
+  const int prewarmMaxSetting = perf_get_int("prewarm_max", -1);
+#endif
+  const size_t prewarmMax = prewarmMaxSetting >= 0 ? static_cast<size_t>(prewarmMaxSetting) : std::numeric_limits<size_t>::max();
+
+  sqlite3_stmt* loadStmt = g_pipelineCacheLoadStmt;
+#if defined(AURORA_GFX_DEKO3D)
+  double snapshotMib = 0.0;
+  int64_t snapshotMs = 0;
+  sqlite3* snapshot = prewarmMax != 0 ? open_pipeline_cache_snapshot(&snapshotMib, &snapshotMs) : nullptr;
+  sqlite3_stmt* snapshotStmt = nullptr;
+  if (snapshot != nullptr &&
+      sqlite3_prepare_v3(snapshot, PipelineCacheLoadSql, -1, 0, &snapshotStmt, nullptr) == SQLITE_OK) {
+    loadStmt = snapshotStmt;
+  } else if (snapshot != nullptr) {
+    Log.warn("Pipeline cache RAM copy unusable ({}); reading the recipes from the card", sqlite3_errmsg(snapshot));
+  }
+#endif
+
+  const size_t clearCount = load_pipeline_cache_entries<clear::PipelineConfig>(
+      loadStmt, ShaderType::Clear, clear::ClearPipelineConfigVersion, clear::create_pipeline, prewarmMax);
+
+  size_t remainingMax = std::numeric_limits<size_t>::max();
+  if (prewarmMaxSetting >= 0) {
+    remainingMax = (prewarmMax > clearCount) ? (prewarmMax - clearCount) : 0;
+  }
+
+  const size_t gxCount = g_pipelineCacheBroken ? 0 : load_pipeline_cache_entries<gx::PipelineConfig>(
+      loadStmt, ShaderType::GX, gx::GXPipelineConfigVersion, gx::create_pipeline, remainingMax);
+
+  const auto loadElapsed = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - t0).count();
+#if defined(AURORA_GFX_DEKO3D)
+  sqlite3_finalize(snapshotStmt);
+  sqlite3_close(snapshot);
+  Log.info("Loaded {} pipeline cache recipes ({} clear, {} GX) from DB in {} ms ({})", clearCount + gxCount,
+           clearCount, gxCount, loadElapsed,
+           snapshotStmt != nullptr ? fmt::format("RAM copy: {:.1f} MiB read in {} ms", snapshotMib, snapshotMs)
+                                   : std::string("read from the card"));
+#else
+  Log.info("Loaded {} pipeline cache recipes ({} clear, {} GX) from DB in {} ms",
+           clearCount + gxCount, clearCount, gxCount, loadElapsed);
+#endif
+
+  const auto queued = queuedPipelines.load();
+  if (queued > 0) {
+    g_prewarmCount = queued;
+    g_prewarmStart = std::chrono::steady_clock::now();
+    g_prewarmActive.store(true, std::memory_order_release);
+  }
+}
+
+static void start_pipeline_cache_writer() {
+  if (!prepare_pipeline_cache_db()) {
+    return;
+  }
+
+  g_pipelineCacheWriterStop = false;
+  g_pipelineCacheWriterThread = std::thread(pipeline_cache_writer);
+}
+
+static void stop_pipeline_cache_writer() {
+  if (g_pipelineCacheWriterThread.joinable()) {
+    {
+      std::lock_guard lock{g_pipelineCacheWriterMutex};
+      g_pipelineCacheWriterStop = true;
+    }
+    g_pipelineCacheWriterCv.notify_one();
+    g_pipelineCacheWriterThread.join();
+  } else {
+    g_pipelineCacheWriterStop = false;
+  }
+
+  g_pipelineCacheWriteQueue.clear();
+  g_pipelineCachePendingWrites.clear();
+}
