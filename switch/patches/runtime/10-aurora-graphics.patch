+static int sdl_vfs_access(sqlite3_vfs*, const char* name, int flags, int* result) {
+  if (result == nullptr) {
+    return SQLITE_IOERR_ACCESS;
+  }
+  if (name == nullptr || flags == SQLITE_ACCESS_READWRITE) {
+    *result = 0;
+    return SQLITE_OK;
+  }
+
+  auto* io = SDL_IOFromFile(name, "rb");
+  *result = io != nullptr ? 1 : 0;
+  if (io != nullptr) {
+    SDL_CloseIO(io);
+  }
+  return SQLITE_OK;
+}
