+template <>
+PipelineRef find_pipeline(ShaderType type, const gx::PipelineConfig& config, NewPipelineCallback&& cb) {
+  return find_pipeline_impl(type, config, std::move(cb), true, std::nullopt);
+}
+
+bool pipeline_exists(PipelineRef hash) {
+  const uint32_t frame = current_frame();
+  std::scoped_lock guard{g_pipelineMutex};
+  const auto it = g_pipelines.find(hash);
+  // find_pipeline_impl's found path only acts when this frame is earlier than the recorded first
+  // use (then it rewrites the persisted ordering); leave that case to it.
+  return it != g_pipelines.end() && frame >= it->second.firstFrameUsed;
+}
+
+// Recorded pipelines are built by all workers but one on deko3d, which stays free for pipelines the
+// game needs now (its prewarm runs for minutes); none with perf.cfg `bg_compile 0`.
+static size_t steady_background_worker_limit(size_t workerCount) {
+  size_t limit = std::min(workerCount, MaxBackgroundPipelineWorkers);
+#if defined(AURORA_GFX_DEKO3D)
+  if (workerCount > 1) limit = std::min(limit, workerCount - 1);
+#endif
+#ifdef AURORA_PLATFORM_SWITCH
+  if (kartpad_perf_int && kartpad_perf_int("bg_compile", 1) == 0) {
+    Log.info("perf.cfg: background pipeline prewarm paused");
+    limit = 0;
+  }
+#endif
+  return limit;
+}
+
+void initialize_pipeline_cache() {
+  size_t workerCount = 0;
+#ifdef AURORA_PLATFORM_SWITCH
+  g_shaderStartMs = steady_millis();
+  g_nextProgressMs.store(g_shaderStartMs + 10000);
+  g_nextCheckpointMs.store(g_shaderStartMs + 60000);
+  g_waitMicros.store(0);
+  g_waitCount.store(0);
+  g_synchronousBuilds.store(0);
+#endif
+  g_pipelineCacheBroken = false;
+  g_pipelineCacheWriterStop = false;
+  g_pipelineFrameActive = false;
+  g_pipelineThreadEnd = false;
+  g_activeBackgroundPipelineWorkers = 0;
+
+  if (webgpu::g_backendType == wgpu::BackendType::OpenGL || webgpu::g_backendType == wgpu::BackendType::OpenGLES ||
+      webgpu::g_backendType == wgpu::BackendType::WebGPU) {
+    g_hasPipelineThread = false;
+  } else {
+    g_hasPipelineThread = true;
+    workerCount = pipeline_worker_count();
+    g_backgroundPipelineWorkerLimit = steady_background_worker_limit(workerCount);
+    g_pipelineThreads.reserve(workerCount);
+    for (size_t i = 0; i < workerCount; ++i) {
+      g_pipelineThreads.emplace_back(pipeline_worker);
+    }
+    Log.info("Enabled {} priority pipeline compilation workers ({} background prewarm)",
+             workerCount, g_backgroundPipelineWorkerLimit);
+  }
+
+#if defined(AURORA_GFX_DEKO3D)
+  if (g_hasPipelineThread) {
+    begin_boot_preload(workerCount);
+  }
+#endif
+  load_pipeline_cache();
+  if (!g_pipelineCacheBroken) {
+    start_pipeline_cache_writer();
+  }
+#if defined(AURORA_GFX_DEKO3D)
+  wait_for_boot_preload(queuedPipelines.load() + createdPipelines.load());
+  end_boot_preload(workerCount);
+#endif
+}
+
+void shutdown_pipeline_cache() {
+  if (g_hasPipelineThread) {
+    {
+      std::lock_guard lock{g_pipelineMutex};
+      g_pipelineThreadEnd = true;
+    }
+    g_pipelineCv.notify_all();
+    for (auto& thread : g_pipelineThreads) {
+      thread.join();
+    }
+  }
+  g_pipelineThreads.clear();
+  g_hasPipelineThread = false;
+  g_activeBackgroundPipelineWorkers = 0;
+
+  stop_pipeline_cache_writer();
+  pipeline_cache_abort();
+  g_pipelineCacheBroken = false;
+  g_pipelineFrameActive = false;
+  g_pipelinesPerFrame = 0;
+  g_pipelines.clear();
+  g_priorityPipelines.clear();
+  g_backgroundPipelines.clear();
+  g_pendingPipelines.clear();
+
+  queuedPipelines = 0;
+  createdPipelines = 0;
+}
+
+void begin_pipeline_frame() {
+  g_pipelineFrameActive = true;
+  if (!g_hasPipelineThread) {
+    g_pipelinesPerFrame = 0;
+  }
+}
+
+void end_pipeline_frame() {
+  g_pipelineFrameActive = false;
+  if (!g_hasPipelineThread) {
+    build_synchronous_pipelines_for_frame();
+  }
+}
+
+void set_skip_unready_pipelines(bool enabled) noexcept {
+  g_skipUnreadyGxPipelines.store(enabled, std::memory_order_relaxed);
+}
+
+bool skip_unready_pipelines() noexcept { return g_skipUnreadyGxPipelines.load(std::memory_order_relaxed); }
+
+uint32_t queued_pipeline_count() noexcept {
+#if defined(__cpp_lib_atomic_ref)
+  return queuedPipelines.load(std::memory_order_relaxed);
+#else
+  return queuedPipelines.load();
+#endif
+}
+
+bool try_pipeline(PipelineRef ref, wgpu::RenderPipeline& pipeline) {
+  std::scoped_lock lock{g_pipelineMutex};
+  const auto it = g_pipelines.find(ref);
+  if (it == g_pipelines.end()) {
+    return false;
+  }
+  pipeline = it->second.pipeline;
+  return true;
+}
+
+#if defined(AURORA_PLATFORM_SWITCH) || defined(__SWITCH__)
+extern "C" void KartPadPumpAudioHook() __attribute__((weak));
+#endif
+
+static bool wait_pipeline_impl(PipelineRef ref, wgpu::RenderPipeline& pipeline, bool fatalIfMissing,
+                               bool persistentPass) {
+  std::unique_lock lock{g_pipelineMutex};
+  if (!g_pipelines.contains(ref) && g_pendingPipelines.contains(ref)) {
+    ZoneScopedN("wait_pipeline");
+#ifdef AURORA_PLATFORM_SWITCH
+    const auto waitStart = std::chrono::steady_clock::now();
+#endif
+    const auto finished = [ref] {
+      return g_pipelines.contains(ref) || !g_pendingPipelines.contains(ref) || g_pipelineThreadEnd;
+    };
+    if (promote_pending_pipeline_for_wait(ref)) {
+      g_pipelineCv.notify_all();
+    }
+#if defined(AURORA_PLATFORM_SWITCH) || defined(__SWITCH__)
+    while (!finished()) {
+      if (KartPadPumpAudioHook) {
+        lock.unlock();
+        KartPadPumpAudioHook();
+        lock.lock();
+      }
+      if (g_pipelineCv.wait_for(lock, std::chrono::milliseconds(5), finished)) break;
+    }
+    g_waitCount.fetch_add(1, std::memory_order_relaxed);
+    g_waitMicros.fetch_add(std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now() - waitStart).count(), std::memory_order_relaxed);
+#else
+    g_pipelineCv.wait(lock, finished);
+#endif
+  }
+  const auto it = g_pipelines.find(ref);
+  if (it == g_pipelines.end()) {
+    lock.unlock();
+    if (fatalIfMissing) {
+      Log.fatal("Pipeline 0x{:x} is unavailable at its ordered draw boundary", static_cast<uint64_t>(ref));
+    }
+    Log.error("Pipeline 0x{:x} is unavailable for a persistent resolve pass; dropping its draw",
+              static_cast<uint64_t>(ref));
+    return false;
+  }
+  pipeline = it->second.pipeline;
+  return true;
+}
+
+bool wait_pipeline(PipelineRef ref, wgpu::RenderPipeline& pipeline) {
+  return wait_pipeline_impl(ref, pipeline, true, false);
+}
+
+bool wait_pipeline_for_persistent_pass(PipelineRef ref, wgpu::RenderPipeline& pipeline) {
+  return wait_pipeline_impl(ref, pipeline, false, true);
+}
+
+} // namespace aurora::gfx
+
+void aurora_set_skip_unready_pipelines(const bool enabled) { aurora::gfx::set_skip_unready_pipelines(enabled); }
+
+bool aurora_get_skip_unready_pipelines() { return aurora::gfx::skip_unready_pipelines(); }
+
+uint32_t aurora_get_queued_pipeline_count() { return aurora::gfx::queued_pipeline_count(); }
+
+#ifdef AURORA_PLATFORM_SWITCH
+// out: [0]=guest wait us, [1]=guest waits, [2]=synchronous builds, [3]=compile us,
+// [4]=compiles, [5]=created (total), [6]=queued (now). Cumulative except [6].
+extern "C" void aurora_switch_pipeline_counters(uint64_t* out) {
+  using namespace aurora::gfx;
+  out[0] = g_waitMicros.load(std::memory_order_relaxed);
+  out[1] = g_waitCount.load(std::memory_order_relaxed);
+  out[2] = g_synchronousBuilds.load(std::memory_order_relaxed);
+  out[3] = g_compileMicros.load(std::memory_order_relaxed);
+  out[4] = g_compileCount.load(std::memory_order_relaxed);
+  out[5] = static_cast<uint64_t>(createdPipelines.load());
+  out[6] = static_cast<uint64_t>(queuedPipelines.load());
+}
+#endif
