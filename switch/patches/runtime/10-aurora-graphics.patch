-  uint32_t load() const { return __atomic_load_n(&ref, __ATOMIC_RELAXED); }
-};
-static AtomicStatRef queuedPipelines{g_stats.queuedPipelines};
-static AtomicStatRef createdPipelines{g_stats.createdPipelines};
