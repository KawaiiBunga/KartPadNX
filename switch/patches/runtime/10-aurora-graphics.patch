-static void pipeline_worker() {
-#ifdef TRACY_ENABLE
-  tracy::SetThreadName("Pipeline compilation thread");
-#endif
-#ifdef AURORA_PLATFORM_SWITCH
-  u64 allowedPriorities = 0;
-  const Result priorityQuery = svcGetInfo(&allowedPriorities, InfoType_PriorityMask, CUR_PROCESS_HANDLE, 0);
-  // Main thread runs at priority 44 (0x2c). Compiler workers should run at
-  // priority 46 (0x2e) so they are scheduled promptly when the game needs shaders,
-  // rather than inheriting libnx default 59 (0x3b) which gets starved to death.
-  s32 normalPriority = 46;
-  svcSetThreadPriority(CUR_THREAD_HANDLE, normalPriority);
-  const s32 backgroundPriority = 59;
-  s32 currentPriority = normalPriority;
-  bool priorityWarning = false;
-  s32 idealCore = -1;
-  u64 affinity = 0;
-  svcGetThreadCoreMask(&idealCore, &affinity, CUR_THREAD_HANDLE);
-  Log.info("HOS shader worker: thread={:08x}, priority={} background={} cores={:x} priorities={:x}",
-           threadGetCurHandle(), normalPriority, backgroundPriority, affinity, allowedPriorities);
-#endif
-
-  while (true) {
-    PendingPipeline pending;
-    bool background = false;
-    {
-      std::unique_lock lock{g_pipelineMutex};
-      g_pipelineCv.wait(lock, [] {
-        return !g_priorityPipelines.empty() ||
-               (!g_backgroundPipelines.empty() &&
-                g_activeBackgroundPipelineWorkers < g_backgroundPipelineWorkerLimit) ||
-               g_pipelineThreadEnd;
-      });
-      if (g_pipelineThreadEnd) {
-        return;
-      }
-      background = g_priorityPipelines.empty();
-      auto& source = background ? g_backgroundPipelines : g_priorityPipelines;
-      pending = std::move(source.front());
-      source.pop_front();
-      if (background) {
-        ++g_activeBackgroundPipelineWorkers;
-      }
-    }
-#ifdef AURORA_PLATFORM_SWITCH
-    const s32 desiredPriority = background ? backgroundPriority : normalPriority;
-    if (desiredPriority != currentPriority) {
-      const Result result = svcSetThreadPriority(CUR_THREAD_HANDLE, desiredPriority);
-      if (R_SUCCEEDED(result)) currentPriority = desiredPriority;
-      else if (!priorityWarning) {
-        Log.warn("Could not set shader worker priority: {:08x}", result);
-        priorityWarning = true;
-      }
-    }
-#endif
-    compile_pending_pipeline(std::move(pending));
-#ifdef AURORA_PLATFORM_SWITCH
-    checkpoint_pipeline_cache(background);
-#endif
-    if (background) {
-      {
-        std::lock_guard lock{g_pipelineMutex};
-        --g_activeBackgroundPipelineWorkers;
-      }
-      g_pipelineCv.notify_all();
-    }
-  }
-}
-
-static void build_synchronous_pipelines_for_frame() {
-  while (g_pipelinesPerFrame < BuildPipelinesPerFrame) {
-    PendingPipeline pending;
-    {
-      std::lock_guard lock{g_pipelineMutex};
-      if (g_priorityPipelines.empty() && g_backgroundPipelines.empty()) {
-        return;
-      }
-      auto& source = !g_priorityPipelines.empty() ? g_priorityPipelines : g_backgroundPipelines;
-      pending = std::move(source.front());
-      source.pop_front();
-    }
-    compile_pending_pipeline(std::move(pending));
-    ++g_pipelinesPerFrame;
-  }
-}
-
-static size_t pipeline_worker_count() {
-#ifdef AURORA_PLATFORM_SWITCH
-  u64 coreMask = 0;
-  const Result result = svcGetInfo(&coreMask, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0);
-  const auto workers = switch_platform::pipeline_worker_count(coreMask);
-  Log.info("HOS shader scheduling: allowed cores={:#x}, query={:08x}, workers={}", coreMask, result, workers);
-  return workers;
-#else
-  const size_t logicalProcessors = std::thread::hardware_concurrency();
-  if (logicalProcessors == 0) {
-    return 1;
-  }
-  const size_t availableWorkers =
-      logicalProcessors > ReservedLogicalProcessors ? logicalProcessors - ReservedLogicalProcessors : 1;
-  return std::clamp(availableWorkers, size_t{1}, MaxPipelineWorkers);
-#endif
-}
