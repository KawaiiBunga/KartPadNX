+void BlobCache::enforce_resident_limit(const Key* keepKey) {
+  if (residentBytes_ <= residentLimit_) return;
+  for (auto it = entries_.begin(); it != entries_.end() && residentBytes_ > residentLimit_;) {
+    if (keepKey && it->first == *keepKey) {
+      ++it;
+      continue;
+    }
+    if (it->second && it->second->loaded) {
+      if (!it->second->committed) {
+        // Pin accepted pending/in-flight entries: do not demote to disk stubs
+        // while newer bytes have not been committed to SQLite!
+        ++it;
+        continue;
+      }
+      residentBytes_ -= it->second->bytes.size();
+      if (lazy_) {
+        auto stub = std::make_shared<Entry>();
+        stub->size = it->second->size;
+        stub->compressed = it->second->compressed;
+        stub->loaded = false;
+        stub->committed = true;
+        stub->day = it->second->day;
+        it->second = std::move(stub);
+        ++it;
+      } else {
+        it = entries_.erase(it);
+      }
+    } else {
+      ++it;
+    }
+  }
