-    }
-  }
-
-  if (schemaFailed) {
-    pipeline_cache_abort();
-    return false;
-  }
-
-  ret = sqlite3_prepare_v3(g_pipelineCacheDb,
-                           "SELECT hash, config, first_frame_used FROM pipeline_cache "
-                           "WHERE type = ? AND config_version = ? "
-                           "ORDER BY first_frame_used ASC, rowid ASC",
