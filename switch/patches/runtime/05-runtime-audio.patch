+// Cumulative ax_mix_split counters for the per-second [stages] line (kartpad_ax_split_counters):
+// [0] split PB lists, [1] lists mixed serially (fewer than kSplitMinVoices running voices),
+// [2] helper busy ticks, [3] mix-worker ticks spent waiting for the other participants (19.2 MHz),
+// [4] lost wake-ups rescued by a timeout, [5] late signals (benign), [6] lists verified against a
+// serial recomputation, [7] verification mismatches, [8]/[9]/[10] voices mixed by the mix worker /
+// the helper / the game thread (ax_mix_guest_help), [11] game-thread ticks spent mixing voices.
+constexpr size_t kSplitStatCount = 12;
+std::atomic<uint64_t> g_splitStats[kSplitStatCount] = {};
