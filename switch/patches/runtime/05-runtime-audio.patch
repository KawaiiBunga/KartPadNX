+            {
+                std::lock_guard<std::mutex> lock(m_mixMutex);
+                m_mixBusy = false;
+                // Publishes the finished mix to a spinning JoinMix (acquire side there). Cleared
+                // only if no newer list was queued meanwhile, i.e. under the same lock as the set.
+                if (!m_mixPending) {
+                    m_mixInFlight.store(false, std::memory_order_release);
+                }
+            }
+            m_mixIdle.notify_all();
+        }
+    }
