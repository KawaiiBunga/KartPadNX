+    void MixWorkerMain() {
+        t_onMixWorker = true;
+        RefreshMixMemoryMap();
+#if defined(__SWITCH__)
+        u64 allowed = 0;
+        // perf.cfg placement (switch/src/perf_switch.cpp) owns this when active.
+        if (kartpad_thread_apply && kartpad_thread_apply(4 /* audio mix */, 0)) {
+        } else if (R_SUCCEEDED(svcGetInfo(&allowed, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0)) && allowed != 0) {
+            s32 pref = (allowed & (1u << 3)) ? 3 : ((allowed & (1u << 2)) ? 2 : ((allowed & (1u << 1)) ? 1 : 0));
+            u32 mask = (allowed & (1u << pref)) ? (1u << pref) : static_cast<u32>(allowed);
+            svcSetThreadCoreMask(CUR_THREAD_HANDLE, pref, mask);
+            svcSetThreadPriority(CUR_THREAD_HANDLE, 0x24);
+        }
+#endif
+        for (;;) {
+            // During the guest's catch-up bursts the next command list arrives within the AX
+            // callback's run time; spin for it before paying a sleep/wake. The wait below
+            // re-checks m_mixPending under the lock, so this only ever skips a sleep.
+            SpinWhile(m_mixInFlight, false, kWorkerSpinTicks);
+            {
+                std::unique_lock<std::mutex> lock(m_mixMutex);
+                m_mixWake.wait(lock, [this] { return m_mixStop || m_mixPending; });
+                if (!m_mixPending) {
+                    return;
+                }
+                m_mixPending = false;
+                m_mixBusy = true;
+            }
