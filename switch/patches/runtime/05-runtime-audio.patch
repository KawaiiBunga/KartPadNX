+}
+
+void AudioBackend::FinishCaptureLocked() {
+    if (!m_captureFile) return;
+    WriteWaveHeader(m_captureFile, m_captureFrames, m_sampleRate);
+    std::fclose(m_captureFile);
+    m_captureFile = nullptr;
+    m_captureFinished = true;
+    RT_LOG(RT_TAG_AUDIO) << "pre-SDL PCM capture finished: " << m_captureFrames
+                         << " frames at " << m_sampleRate << " Hz" << std::endl;
+}
+
+void AudioBackend::CapturePcmBlockLocked(const int16_t* samples, size_t frameCount) {
+    // Diagnostic only: writing to SD on every 3 ms block would skew normal frame-time tests.
+    // perf.cfg `audio_capture_s 8` records up to eight seconds starting at the first
+    // audible block, so menu music is sufficient to isolate continuous distortion.
+    static const int seconds = kartpad_opt ? std::clamp(kartpad_opt("audio_capture_s", 0), 0, 30) : 0;
+    if (seconds == 0 || m_captureFinished || m_sampleRate != 32000 || m_channels != 2) return;
+    if (!m_captureFile) {
+        bool audible = false;
+        for (size_t i = 0; i < frameCount * 2; ++i) {
+            if (samples[i] >= 256 || samples[i] <= -256) { audible = true; break; }
+        }
+        if (!audible) return;
+        m_captureFile = std::fopen("sdmc:/switch/kartpad/audio-before-sdl.wav", "wb");
+        if (!m_captureFile) {
+            m_captureFinished = true;
+            RT_LOG(RT_TAG_AUDIO) << "pre-SDL PCM capture could not open WAV" << std::endl;
+            return;
+        }
+        WriteWaveHeader(m_captureFile, 0, m_sampleRate);
+        RT_LOG(RT_TAG_AUDIO) << "pre-SDL PCM capture started" << std::endl;
+    }
+    const uint32_t target = static_cast<uint32_t>(seconds) * m_sampleRate;
+    const size_t count = std::min(frameCount, static_cast<size_t>(target - m_captureFrames));
+    const size_t written = std::fwrite(samples, sizeof(int16_t) * 2, count, m_captureFile);
+    m_captureFrames += static_cast<uint32_t>(written);
+    if (written != count || m_captureFrames >= target) FinishCaptureLocked();
+}
+
+void AudioBackend::NotePcmBlockLocked(const int16_t* samples, size_t frameCount) {
+    if (frameCount == 0) return;
+    CapturePcmBlockLocked(samples, frameCount);
+    uint32_t rails = 0;
+    uint32_t interiorJump = 0;
+    const auto jump = [](int16_t a, int16_t b) -> uint32_t {
+        const int difference = static_cast<int>(a) - static_cast<int>(b);
+        return static_cast<uint32_t>(difference < 0 ? -difference : difference);
+    };
+    uint32_t seamJump = m_haveLastPcmFrame
+        ? std::max(jump(samples[0], m_lastPcmLeft), jump(samples[1], m_lastPcmRight)) : 0;
+    for (size_t i = 0; i < frameCount * 2; ++i) {
+        const int16_t value = samples[i];
+        rails += value == INT16_MIN || value == INT16_MAX;
+        if (i >= 2) interiorJump = std::max(interiorJump, jump(value, samples[i - 2]));
+    }
+    m_lastPcmLeft = samples[(frameCount - 1) * 2];
+    m_lastPcmRight = samples[(frameCount - 1) * 2 + 1];
+    m_haveLastPcmFrame = true;
+    PerfDiag::NoteAudioPcm(static_cast<uint32_t>(frameCount * 2), rails, seamJump, interiorJump);
+}
 
