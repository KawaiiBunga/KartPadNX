+namespace {
+void WriteWaveHeader(std::FILE* file, uint32_t frames, uint32_t rate) {
+    const uint32_t dataBytes = frames * 4u;
+    uint8_t header[44] = {'R','I','F','F',0,0,0,0,'W','A','V','E',
+                          'f','m','t',' ',16,0,0,0,1,0,2,0,
+                          0,0,0,0,0,0,0,0,4,0,16,0,
+                          'd','a','t','a',0,0,0,0};
+    const auto put32 = [&](size_t offset, uint32_t value) {
+        for (unsigned i = 0; i < 4; ++i) header[offset + i] = static_cast<uint8_t>(value >> (i * 8));
+    };
+    put32(4, dataBytes + 36u);
+    put32(24, rate);
+    put32(28, rate * 4u);
+    put32(40, dataBytes);
+    std::fseek(file, 0, SEEK_SET);
+    std::fwrite(header, 1, sizeof(header), file);
+}
+} // namespace
 
