+            try {
+                ExecuteCommandList(m_mixLayout, m_mixCmdListSize);
+            } catch (const std::exception& error) {
+                ReportMixWorkerFailure(error.what());
+            } catch (...) {
+                ReportMixWorkerFailure("unknown exception");
+            }
