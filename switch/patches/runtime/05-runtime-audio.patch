+namespace {
+
+int64_t ConsumeAudioPollDeltaMicros()
+{
+    using Clock = std::chrono::steady_clock;
+    static thread_local Clock::time_point lastPoll = Clock::now();
+
+    const Clock::time_point now = Clock::now();
+    auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(now - lastPoll).count();
+    lastPoll = now;
+
+    if (elapsed < 0) {
+        elapsed = 0;
+    }
+
+    constexpr int64_t kMaxPollDeltaMicros = 100'000;
+    return std::min(elapsed, kMaxPollDeltaMicros);
+}
+
+} // namespace
+
+bool Audio_HLE_YieldPending()
+{
+    return g_axYieldPending;
+}
+
+void Audio_HLE_JoinYieldedMix()
+{
+    AxDspHle::JoinMixWorker();
+}
+
+void Audio_HLE_HostTick(CpuContext* ctx)
+{
+    Audio_HLE_Tick(ctx, static_cast<uint32_t>(ConsumeAudioPollDeltaMicros()));
+}
+
+void Audio_HLE_Poll(CpuContext* ctx)
+{
+    if (OsHostThread::OwnsAudioTicks()) {
+        // The hosted sound thread delivers audio in real time; only the volume layer stays here.
+        MusicAttenuation::TickGuest();
+        return;
+    }
+    // Called from the scheduler's idle loop. Blocking there on an in-flight mix
+    // (JoinMix inside the tick) was 4.6% of the game thread in a race and held
+    // off the retrace/alarm polling that wakes the game. Leave the tick for the
+    // next spin; the poll delta is not consumed, so no audio time is lost.
+    if (AxDspHle::MixWorkerBusy()) {
+        return;
+    }
+    MusicAttenuation::TickGuest();
+    Audio_HLE_Tick(ctx, static_cast<uint32_t>(ConsumeAudioPollDeltaMicros()));
+}
+
+void Audio_HLE_PollDeferred()
+{
+    if (OsHostThread::OwnsAudioTicks() || !OS_HLE_InterruptsEnabled()) {
+        return;
+    }
+
+    GuestInterruptCallbackContext interrupt;
+    CpuContext* cpu = interrupt.get();
+
+    OS_HLE_BeginDeferredGuestCallbacks();
+    try {
+        Audio_HLE_Tick(cpu, static_cast<uint32_t>(ConsumeAudioPollDeltaMicros()));
+    } catch (...) {
+        OS_HLE_EndDeferredGuestCallbacks();
+        throw;
+    }
+    OS_HLE_EndDeferredGuestCallbacks();
+}
+
+extern "C" void KartPadPumpAudioHook()
+{
+    Audio_HLE_PollDeferred();
+}
