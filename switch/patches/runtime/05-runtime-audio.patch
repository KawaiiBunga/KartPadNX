+void Audio_HLE_Tick(CpuContext* ctx, uint32_t deltaMicros)
+{
+    const auto pdTickStart = std::chrono::steady_clock::now();
+    struct PdTickTimer {
+        std::chrono::steady_clock::time_point start;
+        ~PdTickTimer() {
+            PerfDiag::NoteAudioTickMicros(static_cast<uint64_t>(
+                std::chrono::duration_cast<std::chrono::microseconds>(
+                    std::chrono::steady_clock::now() - start)
+                    .count()));
+        }
+    } pdTickTimer{pdTickStart};
+    g_axYieldPending = false;
+
+    uint32_t startAddr = 0;
+    uint32_t length = 0;
+    uint32_t callback = 0;
+    uint32_t sampleRate = kDefaultSampleRate;
+    bool enabled = false;
+
+    {
+        std::lock_guard<std::mutex> lock(g_ai.mutex);
+        enabled = g_ai.enabled;
+        startAddr = g_ai.startAddr;
+        length = g_ai.length;
+        callback = g_ai.callback;
+        sampleRate = g_ai.sampleRate;
+
+        if (enabled && startAddr != 0 && length != 0 && sampleRate != 0) {
+            const double bytesPerSecond = static_cast<double>(sampleRate) * kAudioChannels * kBytesPerSample;
+            const double blockDuration = static_cast<double>(length) / bytesPerSecond;
+
+            // Hard proportional backpressure control:
+            // Target buffer depth: ~70ms. Safe ceiling: ~90ms.
+            // When queued audio exceeds the safe ceiling, throttle accumulation so the buffer never
+            // inflates or overflows, preventing dropped samples and crunchy audio.
+            const int queued = AudioBackend::Instance().GetQueuedBytes();
+            if (queued >= 0) {
+                const double queuedSeconds = static_cast<double>(queued) / bytesPerSecond;
+                if (queuedSeconds >= 0.090) {
+                    // Output queue is fully populated; do NOT advance accumulator past blockDuration
+                    if (g_ai.accumulatorSeconds > blockDuration) {
+                        g_ai.accumulatorSeconds = blockDuration;
+                    }
+                } else {
+                    double rateAdjustment = 1.0;
+                    if (queuedSeconds > 0.070) {
+                        rateAdjustment = 0.85; // Drain smoothly towards 70ms
+                    } else if (queuedSeconds < 0.035) {
+                        rateAdjustment = 1.15; // Refill towards 70ms to avoid starvation
+                    }
+                    g_ai.accumulatorSeconds += (static_cast<double>(deltaMicros) / 1'000'000.0) * rateAdjustment;
+                }
+            } else {
+                g_ai.accumulatorSeconds += static_cast<double>(deltaMicros) / 1'000'000.0;
+            }
+
+            if (g_ai.tickActive) {
+                return;
+            }
+            g_ai.tickActive = true;
+        }
+    }
+
+    if (!enabled || startAddr == 0 || length == 0 || sampleRate == 0) {
+        return;
+    }
+
+    struct ActiveTickReset {
+        bool armed = true;
+        ~ActiveTickReset()
+        {
+            if (!armed) {
+                return;
+            }
+            std::lock_guard<std::mutex> lock(g_ai.mutex);
+            g_ai.tickActive = false;
+        }
+    } activeTickReset;
+
+    const double bytesPerSecond = static_cast<double>(sampleRate) * kAudioChannels * kBytesPerSample;
+    const double blockDuration = static_cast<double>(length) / bytesPerSecond;
+    if (blockDuration <= 0.0) {
+        return;
+    }
+
+    CpuContext* cpu = ctx ? ctx : &GetPersistentCpuContext();
+    CpuContextScope scope(cpu);
+
+    int blocksCompleted = 0;
+    while (true) {
+        if (blocksCompleted > 0 && AxTickYieldWhenMixBusy() && AxDspHle::MixWorkerBusy()) {
+            bool yield = false;
+            {
+                std::lock_guard<std::mutex> lock(g_ai.mutex);
+                yield = g_ai.accumulatorSeconds >= blockDuration &&
+                        g_ai.accumulatorSeconds < blockDuration * kYieldMaxOwedBlocks;
+            }
+            if (yield) {
+                g_axYieldPending = true;
+                PerfDiag::NoteAxTickYield();
+                break;
+            }
+        }
+        {
+            std::lock_guard<std::mutex> lock(g_ai.mutex);
+            if (g_ai.accumulatorSeconds < blockDuration) {
+                break;
+            }
+            g_ai.accumulatorSeconds -= blockDuration;
+            g_ai.bytesLeft = 0;
+        }
+
+        AxDspHle::JoinMixWorker();
+
+        if (!EnsureAudioBackend(sampleRate)) {
+            std::lock_guard<std::mutex> lock(g_ai.mutex);
+            if (!g_ai.loggedBackendFailure) {
+                g_ai.loggedBackendFailure = true;
+                ReportAudioProblem("Audio", "audio backend unavailable; dropping samples");
+            }
+        } else {
+            const bool pushed = PushAudioBlock(startAddr, length);
+            if (!pushed) {
+                std::lock_guard<std::mutex> lock(g_ai.mutex);
+                if (!g_ai.loggedAccessFailure) {
+                    g_ai.loggedAccessFailure = true;
+                    ReportAudioProblem("Audio", "failed to read DMA buffer; disabling audio DMA");
+                }
+                g_ai.enabled = false;
+                return;
+            }
+        }
+
+        if (callback != 0) {
+            const auto* info = TranslatedFunctionRegistry::FindByAddressPtr(callback);
+            if (!info || !info->rawCpuInvoker) {
+                std::lock_guard<std::mutex> lock(g_ai.mutex);
+                if (!g_ai.loggedMissingCallback) {
+                    g_ai.loggedMissingCallback = true;
+                    ReportAudioProblem("Audio", "AI DMA callback not registered; skipping");
+                }
+            } else {
+                // Guest interrupt work: keep the other host thread out of it (os_host_thread.h).
+                OsHostThread::IlScope interruptLock;
+                Memory::TryWrite32(kAICallbackBusyAddr, 1);
+                InvokeIndirectCpu(callback, cpu);
+                Memory::TryWrite32(kAICallbackBusyAddr, 0);
+                AxDspHle::ServiceDeferredCallbacks();
+                OsHostThread::KeepIlForWokenSoundThread();
+            }
+        }
+
+        {
+            std::lock_guard<std::mutex> lock(g_ai.mutex);
+            startAddr = g_ai.startAddr;
+            length = g_ai.length;
+            callback = g_ai.callback;
+            sampleRate = g_ai.sampleRate;
+            g_ai.bytesLeft = g_ai.length;
+        }
+
+        if (++blocksCompleted >= kMaxBlocksPerTick) {
+            break;
+        }
+    }
+
+    if (blocksCompleted > 0) {
+        PerfDiag::NoteAxBlocksPushed(blocksCompleted);
+        if (blocksCompleted >= kMaxBlocksPerTick) {
+            PerfDiag::NoteAxTickCap();
+        }
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(g_ai.mutex);
+        if (g_ai.length != 0) {
+            const double bytesRemaining = g_ai.length * (g_ai.accumulatorSeconds / blockDuration);
+            if (bytesRemaining < static_cast<double>(g_ai.length)) {
+                g_ai.bytesLeft = g_ai.length - static_cast<uint32_t>(bytesRemaining);
+            }
+        }
+        g_ai.tickActive = false;
+        activeTickReset.armed = false;
+    }
+}
