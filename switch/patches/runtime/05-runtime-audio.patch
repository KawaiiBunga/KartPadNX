-    static bool LooksLikeMainRamPointer(uint32_t addr) {
-        return addr == 0 || MixContains(addr, sizeof(uint16_t) * 8);
-    }
-
-    static bool LooksLikeAxSampleFormat(uint16_t format) {
-        return format == 0 || format == 0x19 || format == 0x0a;
-    }
