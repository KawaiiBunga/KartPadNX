+    // Busy-waits while `flag` still equals `value`, for at most `ticks` of the system counter.
+    static void SpinWhile(const std::atomic<bool>& flag, bool value, uint64_t ticks) {
+#if defined(__SWITCH__)
+        if (flag.load(std::memory_order_acquire) != value) {
+            return;
+        }
+        const uint64_t deadline = armGetSystemTick() + ticks;
+        while (flag.load(std::memory_order_acquire) == value && armGetSystemTick() < deadline) {
+            __asm__ __volatile__("yield");
+        }
+#else
+        (void)flag;
+        (void)value;
+        (void)ticks;
+#endif
+    }
