+    if (callbackPtr == 0) {
+        return;
+    }
+    if (!TranslatedFunctionRegistry::FindByAddressPtr(callbackPtr)) {
+        return;
+    }
+    auto& cpu = DvdCallbackContext();
+    cpu.gpr[3] = static_cast<uint32_t>(result);
+    InvokeIndirectCpu(callbackPtr, &cpu);
