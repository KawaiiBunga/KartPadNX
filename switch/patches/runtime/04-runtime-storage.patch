+void SystemBridge::WriteGuestMemorySnapshot(std::ostream& os, const char* mem1Path) {
+    constexpr uint32_t kMem1Base = 0x80000000u;
+    constexpr uint32_t kMem1Size = 0x01800000u;
+    if (Memory::Contains(kMem1Base, kMem1Size)) {
+        std::ofstream dump(mem1Path, std::ios::binary | std::ios::trunc);
+        dump.write(reinterpret_cast<const char*>(Memory::GetPointer(kMem1Base, kMem1Size)),
+                   kMem1Size);
+        os << "[runtime] MEM1 snapshot written to " << mem1Path
+           << (dump.good() ? "" : " (write failed)") << std::endl;
+    }
+    constexpr uint32_t kMem2Base = 0x90000000u;
+    // Try a single contiguous capture first (desktop/host builds map MEM2 as one
+    // region). If that fails, MEM2 is backed by discontiguous slices (the Switch
+    // 4 MiB shared-memory slicing), so walk it in chunks and dump every mapped
+    // slice, zero-filling gaps to keep byte offsets == guest offset. Without this
+    // the Switch build wrote no MEM2 snapshot at all, which hid every crash whose
+    // faulting object lives in MEM2 (0x90000000+).
+    constexpr uint32_t kMem2Size = 0x04000000u; // retail 64 MiB MEM2
+    const std::string mem2Path = std::string(mem1Path) + ".mem2";
+    if (Memory::Contains(kMem2Base, kMem2Size)) {
+        std::ofstream dump(mem2Path, std::ios::binary | std::ios::trunc);
+        dump.write(reinterpret_cast<const char*>(Memory::GetPointer(kMem2Base, kMem2Size)),
+                   kMem2Size);
+        os << "[runtime] MEM2 snapshot written to " << mem2Path
+           << (dump.good() ? "" : " (write failed)") << std::endl;
+        return;
+    }
+
+    constexpr uint32_t kChunk = 0x00400000u; // 4 MiB, matches the slice size
+    std::ofstream dump(mem2Path, std::ios::binary | std::ios::trunc);
+    if (!dump) {
+        return;
+    }
+    std::vector<char> zeros(kChunk, 0);
+    uint32_t mapped = 0;
+    for (uint32_t off = 0; off < kMem2Size; off += kChunk) {
+        const uint32_t base = kMem2Base + off;
+        if (Memory::Contains(base, kChunk)) {
+            dump.write(reinterpret_cast<const char*>(Memory::GetPointer(base, kChunk)), kChunk);
+            mapped += kChunk;
+        } else {
+            dump.write(zeros.data(), kChunk);
+        }
+    }
+    os << "[runtime] MEM2 snapshot written to " << mem2Path << " (sliced, "
+       << mapped << " bytes mapped" << (dump.good() ? "" : ", write failed") << ")"
+       << std::endl;
+}
+
+void SystemBridge::DumpCrashHeuristics(std::ostream& os, const CpuContext* cpu,
+                                       const uint32_t* missingGuestTarget) {
+    if (!cpu) {
+        return;
+    }
+
+    if (missingGuestTarget && *missingGuestTarget == 0) {
+        os << "[runtime] The guest jumped to address 0 - almost always a virtual call "
+              "through a bad object, or a callback pointer that was never set."
+           << std::endl;
+        if (cpu->gpr[3] == 0) {
+            os << "[runtime] r3 (the C++ 'this' pointer) is NULL at the call. A very common "
+                  "cause is an unchecked guest heap allocation failure: every "
+                  "\"heap (...)->alloc(size(...))\" OSReport line above is a FAILED "
+                  "allocation (the number after 'free' is the bytes actually left in "
+                  "that heap). If those lines are present, the heap was exhausted "
+                  "before this crash." << std::endl;
+        } else {
+            // The object (r3) and its vtable: which words were overwritten, and with what.
+            const uint32_t object = cpu->gpr[3] & ~3u;
+            uint32_t vtable = 0;
+            MemoryInline::TryReadGuestScalar(object, vtable);
+            for (uint32_t region = 0; region < 2; ++region) {
+                const uint32_t start = region == 0 ? object - 0x20u : (vtable & ~3u);
+                if (region == 1 && (vtable < 0x80000000u || vtable >= 0x94000000u)) break;
+                os << "[runtime] " << (region == 0 ? "r3 object" : "its vtable") << " words:" << std::endl;
+                for (uint32_t row = 0; row < (region == 0 ? 8u : 4u); ++row) {
+                    char line[96];
+                    uint32_t w[4] = {};
+                    for (uint32_t k = 0; k < 4; ++k) {
+                        MemoryInline::TryReadGuestScalar(start + row * 16u + k * 4u, w[k]);
+                    }
+                    std::snprintf(line, sizeof(line), "[runtime]   %08x: %08x %08x %08x %08x",
+                                  start + row * 16u, w[0], w[1], w[2], w[3]);
+                    os << line << std::endl;
+                }
+            }
+        }
+    } else if (missingGuestTarget) {
+        os << "[runtime] The guest jumped to 0x" << std::hex << std::uppercase
+           << *missingGuestTarget << std::dec
+           << ", which is not a translated function entry. If the value looks like "
+              "readable text or a data pointer, a function pointer or vtable was "
+              "overwritten (guest memory stomp)." << std::endl;
+    }
+}
