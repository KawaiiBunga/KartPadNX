-void SystemBridge::WriteGuestMemorySnapshot(std::ostream& os, const char* mem1Path) {
-    constexpr uint32_t kMem1Base = 0x80000000u;
-    constexpr uint32_t kMem1Size = 0x01800000u;
-    if (Memory::Contains(kMem1Base, kMem1Size)) {
-        std::ofstream dump(mem1Path, std::ios::binary | std::ios::trunc);
-        dump.write(reinterpret_cast<const char*>(Memory::GetPointer(kMem1Base, kMem1Size)),
-                   kMem1Size);
-        os << "[runtime] MEM1 snapshot written to " << mem1Path
-           << (dump.good() ? "" : " (write failed)") << std::endl;
-    }
-    constexpr uint32_t kMem2Base = 0x90000000u;
-    // Try a single contiguous capture first (desktop/host builds map MEM2 as one
-    // region). If that fails, MEM2 is backed by discontiguous slices (the Switch
-    // 4 MiB shared-memory slicing), so walk it in chunks and dump every mapped
-    // slice, zero-filling gaps to keep byte offsets == guest offset. Without this
-    // the Switch build wrote no MEM2 snapshot at all, which hid every crash whose
-    // faulting object lives in MEM2 (0x90000000+).
-    constexpr uint32_t kMem2Size = 0x04000000u; // retail 64 MiB MEM2
-    const std::string mem2Path = std::string(mem1Path) + ".mem2";
-    if (Memory::Contains(kMem2Base, kMem2Size)) {
-        std::ofstream dump(mem2Path, std::ios::binary | std::ios::trunc);
-        dump.write(reinterpret_cast<const char*>(Memory::GetPointer(kMem2Base, kMem2Size)),
-                   kMem2Size);
-        os << "[runtime] MEM2 snapshot written to " << mem2Path
-           << (dump.good() ? "" : " (write failed)") << std::endl;
-        return;
-    }
-
-    constexpr uint32_t kChunk = 0x00400000u; // 4 MiB, matches the slice size
-    std::ofstream dump(mem2Path, std::ios::binary | std::ios::trunc);
-    if (!dump) {
-        return;
-    }
-    std::vector<char> zeros(kChunk, 0);
-    uint32_t mapped = 0;
-    for (uint32_t off = 0; off < kMem2Size; off += kChunk) {
-        const uint32_t base = kMem2Base + off;
-        if (Memory::Contains(base, kChunk)) {
-            dump.write(reinterpret_cast<const char*>(Memory::GetPointer(base, kChunk)), kChunk);
-            mapped += kChunk;
-        } else {
-            dump.write(zeros.data(), kChunk);
-        }
-    }
-    os << "[runtime] MEM2 snapshot written to " << mem2Path << " (sliced, "
-       << mapped << " bytes mapped" << (dump.good() ? "" : ", write failed") << ")"
-       << std::endl;
-}
