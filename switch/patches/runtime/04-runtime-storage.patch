+static void DvdTrace(const char* event, const std::string& detail,
+                     long long offset, long long length, long long result) {
+    static std::mutex traceMutex;
+    static int lineBudget = 400;
+    std::lock_guard<std::mutex> lock(traceMutex);
+    if (lineBudget <= 0) {
+        return;
+    }
+    --lineBudget;
+    std::ofstream out("sdmc:/switch/kartpad/dvdlog.txt",
+                      std::ios::app | std::ios::binary);
+    if (!out) {
+        return;
+    }
+    out << event << " off=" << offset << " len=" << length
+        << " res=" << result << " " << detail << "\n";
+    out.flush();
+}
+#define DVD_TRACE(ev, detail, off, len, res) DvdTrace((ev), (detail), (off), (len), (res))
