+// 0x8015E74C -> DVDReadAsyncPrio (internal)
+// HLE: perform synchronous read and invoke callback immediately.
+extern "C" int32_t DVD__ReadAsyncPrio_HLE_8015e74c(uint32_t fileInfoPtr,
+                                                   uint32_t bufferPtr,
+                                                   int32_t length,
+                                                   int32_t offset,
