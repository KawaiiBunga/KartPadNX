+struct RiivoState {
+    std::vector<RuntimeRiivolution::Overlay> overlays;
+    std::optional<RuntimeRiivolution::SaveRedirect> saveRedirect;
+};
+
+std::once_flag g_riivoOnce;
+RiivoState g_riivoState;
