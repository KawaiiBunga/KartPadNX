-    const char makerHi = static_cast<char>((maker >> 8) & 0xffu);
-    const char makerLo = static_cast<char>(maker & 0xffu);
-    if (std::isalnum(static_cast<unsigned char>(makerHi)) &&
-        std::isalnum(static_cast<unsigned char>(makerLo))) {
-        id[4] = makerHi;
-        id[5] = makerLo;
-    } else {
-        id[4] = '0';
-        id[5] = '1';
-    }
-    return id;
-}
