+// perf.cfg optimization switch (switch/src/perf_switch.cpp); absent in host/test builds.
+extern "C" int kartpad_opt(const char* key, int fallback) __attribute__((weak));
+
+// Open-handle cache for ReadExact (perf.cfg `dvd_handle_cache`, default 1). The path above
+// opens, sizes and closes the host file on every guest DVD read; in a race that was ~1% of the
+// game thread in Horizon fs IPC alone (music streams read every few frames). Game files never
+// change while the game runs, so an open FILE* and its size stay valid. Sixteen LRU slots cover
+// the streams and archives read concurrently (b19-b26 had eight, and r16 still reopened files
+// mid-race). Any failed read closes the slot, so a retry reopens the file from scratch.
+struct CachedHostFile {
+    std::string path;
+    std::FILE* file = nullptr;
+    uint64_t size = 0;
+    uint64_t lastUse = 0;
+    // End of the last read from this handle: a read starting here continues a sequential stream.
+    uint64_t nextOffset = UINT64_MAX;
+};
+constexpr size_t kHostFileCacheSlots = 16;
+
+inline bool HostFileCacheEnabled() {
+    static const bool enabled = kartpad_opt != nullptr && kartpad_opt("dvd_handle_cache", 1) != 0;
+    return enabled;
+}
+
+// Cumulative DVD counters for the per-second [stages] line (dvd.cpp kartpad_dvd_counters):
+// [0] synchronous host reads on the game thread, [1] their bytes, [2] their time in ns,
+// [3] reads served from a read-ahead block, [4] of those, how many waited for a block in flight,
+// [5] blocks the read-ahead thread fetched, [6] handle-cache opens, [7] read-ahead fetch time in ns.
+struct DvdCounters {
+    std::atomic<uint64_t> v[8] = {};
+};
+inline DvdCounters& Counters() {
+    static DvdCounters* counters = new DvdCounters();  // never destroyed (read at any time)
+    return *counters;
+}
+inline uint64_t SteadyNowNs() {
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                     std::chrono::steady_clock::now().time_since_epoch())
+                                     .count());
+}
+
+// Opens `path` unbuffered and sizes it. Unbuffered: every read seeks first, so a stdio buffer only
+// adds a copy, and newlib would split a large read into buffer-sized fs IPC calls. _IONBF makes
+// each fread one direct read, like the ifstream path.
+inline bool OpenHostFileSlot(CachedHostFile& slot, const std::string& path, HostReadFailure& failure) {
+    std::FILE* file = std::fopen(path.c_str(), "rb");
+    if (file == nullptr) {
+        failure = HostReadFailure::MissingFile;
+        return false;
+    }
+    std::setvbuf(file, nullptr, _IONBF, 0);
+    if (std::fseek(file, 0, SEEK_END) != 0) {
+        std::fclose(file);
+        failure = HostReadFailure::BadOffset;
+        return false;
+    }
+    const long end = std::ftell(file);
+    if (end < 0) {
+        std::fclose(file);
+        failure = HostReadFailure::BadOffset;
+        return false;
+    }
+    slot.path = path;
+    slot.file = file;
+    slot.size = static_cast<uint64_t>(end);
+    slot.nextOffset = UINT64_MAX;
+    Counters().v[6].fetch_add(1, std::memory_order_relaxed);
+    return true;
+}
+
+// perf.cfg `dvd_readahead` (default 1; needs dvd_handle_cache). r16 spent 1.8% of the race's game
+// thread blocked in fsFileRead: DVD reads are synchronous in this HLE (DVDReadAsync completes
+// before it returns). Once a file is read twice back to back (the second read starts where the
+// first ended, e.g. a streamed music track), a background thread prefetches the next block of the
+// same length, so the stream's next request is a memcpy. Game files never change, so a prefetched
+// block stays valid; a request that is not wholly inside a finished or in-flight block takes the
+// normal synchronous path, so a wrong guess only costs one wasted background read.
+// Only the game thread calls Take/Queue; the read-ahead thread only fills blocks.
+// A stream's reads need not repeat one length: a THP movie reads each frame with the size its
+// predecessor's header gave, so a block of the last read's length missed whenever a frame grew
+// (test 13's movie menu: 40 of 64 reads a second read synchronously, 160 ms/s of the guest core).
+// A block holds several reads (ReadAheadSpan), and the next is queued while the current one still
+// holds the next two reads.
+constexpr uint32_t kReadAheadMaxBytes = 512u * 1024u;
+constexpr size_t kReadAheadBlocks = 6;
+
+inline uint32_t ReadAheadSpan(uint32_t length) {
+    return std::min<uint32_t>(kReadAheadMaxBytes, std::max<uint32_t>(length * 4u, 128u * 1024u));
+}
+
+inline bool ReadAheadEnabled() {
+    static const bool enabled =
+        HostFileCacheEnabled() && kartpad_opt != nullptr && kartpad_opt("dvd_readahead", 1) != 0;
+    return enabled;
+}
+
+class ReadAhead {
+public:
+    static ReadAhead& Instance() {
+        // Never destroyed: its thread blocks on these members for the life of the process.
+        static ReadAhead* instance = new ReadAhead();
+        return *instance;
+    }
+
+    // Serves [offset, offset + length) of `path` from a prefetched block. A block still in flight
+    // is waited for (its read is already under way, so waiting beats issuing a second one).
+    bool Take(const std::string& path, uint64_t offset, uint32_t length, std::vector<uint8_t>& destination,
+              uint64_t& fileSize) {
+        std::unique_lock<std::mutex> lock(m_mutex);
+        Block* block = Find(path, offset, length);
+        if (block == nullptr) {
+            return false;
+        }
+        bool waited = false;
+        if (block->state != Block::Ready) {
+            waited = true;
+            const bool done = m_cv.wait_for(lock, std::chrono::milliseconds(kTakeWaitMs), [&] {
+                Block* again = Find(path, offset, length);
+                return again == nullptr || again->state == Block::Ready;
+            });
+            if (!done && !m_loggedSlowFetch) {
+                m_loggedSlowFetch = true;
+                std::fprintf(stderr, "[dvd] read-ahead block still loading after %d ms; reading synchronously (%s)\n",
+                             kTakeWaitMs, path.c_str());
+            }
+            block = Find(path, offset, length);
+            if (block == nullptr || block->state != Block::Ready) {
+                return false;
+            }
+        }
+        const size_t start = static_cast<size_t>(offset - block->offset);
+        destination.assign(block->data.begin() + static_cast<std::ptrdiff_t>(start),
+                           block->data.begin() + static_cast<std::ptrdiff_t>(start + length));
+        block->lastUse = ++m_clock;
+        fileSize = block->fileSize;
+        Counters().v[3].fetch_add(1, std::memory_order_relaxed);
+        if (waited) {
+            Counters().v[4].fetch_add(1, std::memory_order_relaxed);
+        }
+        return true;
+    }
+
+    // Asks the read-ahead thread for [offset, offset + length) of `path` (clamped to the file).
+    void Queue(const std::string& path, uint64_t offset, uint32_t length) {
+        if (length == 0 || length > kReadAheadMaxBytes) {
+            return;
+        }
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_failed || Find(path, offset, length) != nullptr) {
+            return;
+        }
+        Block* victim = nullptr;
+        for (Block& block : m_blocks) {
+            if (block.state == Block::Empty) {
+                victim = &block;
+                break;
+            }
+            if (block.state == Block::Ready && (victim == nullptr || block.lastUse < victim->lastUse)) {
+                victim = &block;
+            }
+        }
+        if (victim == nullptr) {
+            return;  // every block is queued or loading
+        }
+        victim->path = path;
+        victim->offset = offset;
+        victim->length = length;
+        victim->fileSize = 0;
+        victim->data.clear();
+        victim->state = Block::Queued;
+        victim->lastUse = ++m_clock;
+        if (!m_started) {
+            m_started = true;
+            try {
+                new std::thread([this] { Main(); });  // never joined: lives as long as the process
+                std::fprintf(stderr, "[dvd] read-ahead thread started (%zu blocks of up to %u KiB)\n",
+                             kReadAheadBlocks, kReadAheadMaxBytes / 1024u);
+            } catch (...) {
+                m_failed = true;
+                victim->state = Block::Empty;
+                std::fprintf(stderr, "[dvd] read-ahead thread creation failed; reads stay synchronous\n");
+                return;
+            }
+        }
+        m_cv.notify_all();
+    }
+
+    // Keeps a stream whose last read was `length` bytes ahead: unless a block already holds the
+    // next two such reads from `next`, queues one of ReadAheadSpan(length) from there (clamped to
+    // the file, so a stream's tail is not fetched again at every read).
+    void QueueStream(const std::string& path, uint64_t next, uint32_t length, uint64_t fileSize) {
+        if (length == 0 || length > kReadAheadMaxBytes || next >= fileSize) {
+            return;
+        }
+        const uint64_t left = fileSize - next;
+        const uint32_t lookahead = static_cast<uint32_t>(std::min<uint64_t>(uint64_t{length} * 2u, left));
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            if (Find(path, next, std::min(lookahead, kReadAheadMaxBytes)) != nullptr) {
+                return;
+            }
+        }
+        Queue(path, next, static_cast<uint32_t>(std::min<uint64_t>(ReadAheadSpan(length), left)));
+    }
+
+private:
+    static constexpr int kTakeWaitMs = 200;
+
+    struct Block {
+        enum State { Empty, Queued, Loading, Ready };
+        State state = Empty;
+        std::string path;
+        uint64_t offset = 0;
+        uint32_t length = 0;  // requested; the bytes actually held once Ready (clamped to the file)
+        uint64_t fileSize = 0;
+        uint64_t lastUse = 0;
+        std::vector<uint8_t> data;
+    };
+
+    Block* Find(const std::string& path, uint64_t offset, uint32_t length) {
+        for (Block& block : m_blocks) {
+            if (block.state != Block::Empty && offset >= block.offset &&
+                offset + length <= block.offset + block.length && block.path == path) {
+                return &block;
+            }
+        }
+        return nullptr;
+    }
+
+    void Main() {
+        std::array<CachedHostFile, 4> files{};  // own handles: never shared with the game thread's
+        uint64_t useClock = 0;
+        for (;;) {
+            Block* block = nullptr;
+            std::string path;
+            uint64_t offset = 0;
+            uint32_t length = 0;
+            {
+                std::unique_lock<std::mutex> lock(m_mutex);
+                m_cv.wait(lock, [&] {
+                    for (Block& candidate : m_blocks) {
+                        if (candidate.state == Block::Queued) {
+                            block = &candidate;
+                            return true;
+                        }
+                    }
+                    return false;
+                });
+                block->state = Block::Loading;
+                path = block->path;
+                offset = block->offset;
+                length = block->length;
+            }
+            const uint64_t start = SteadyNowNs();
+            std::vector<uint8_t> data;
+            uint64_t fileSize = 0;
+            const bool ok = Fetch(files, useClock, path, offset, length, data, fileSize);
+            Counters().v[7].fetch_add(SteadyNowNs() - start, std::memory_order_relaxed);
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                if (ok) {
+                    block->length = static_cast<uint32_t>(data.size());
+                    block->fileSize = fileSize;
+                    block->data = std::move(data);
+                    block->state = Block::Ready;
+                    Counters().v[5].fetch_add(1, std::memory_order_relaxed);
+                } else {
+                    block->state = Block::Empty;
+                }
+            }
+            m_cv.notify_all();
+        }
+    }
+
+    static bool Fetch(std::array<CachedHostFile, 4>& files, uint64_t& useClock, const std::string& path,
+                      uint64_t offset, uint32_t length, std::vector<uint8_t>& data, uint64_t& fileSize) {
+        CachedHostFile* slot = nullptr;
+        for (CachedHostFile& candidate : files) {
+            if (candidate.file != nullptr && candidate.path == path) {
+                slot = &candidate;
+                break;
+            }
+        }
+        if (slot == nullptr) {
+            slot = &files[0];
+            for (CachedHostFile& candidate : files) {
+                if (candidate.file == nullptr) {
+                    slot = &candidate;
+                    break;
+                }
+                if (candidate.lastUse < slot->lastUse) {
+                    slot = &candidate;
+                }
+            }
+            if (slot->file != nullptr) {
+                std::fclose(slot->file);
+            }
+            *slot = CachedHostFile{};
+            HostReadFailure failure = HostReadFailure::None;
+            if (!OpenHostFileSlot(*slot, path, failure)) {
+                return false;
+            }
+        }
+        slot->lastUse = ++useClock;
+        fileSize = slot->size;
+        if (offset >= slot->size || offset > static_cast<uint64_t>(std::numeric_limits<long>::max())) {
+            return false;
+        }
+        const uint64_t available = slot->size - offset;
+        const uint32_t bytes = static_cast<uint32_t>(std::min<uint64_t>(length, available));
+        data.resize(bytes);
+        if (std::fseek(slot->file, static_cast<long>(offset), SEEK_SET) != 0 ||
+            std::fread(data.data(), 1, bytes, slot->file) != bytes) {
+            std::fclose(slot->file);
+            *slot = CachedHostFile{};
+            return false;
+        }
+        return true;
+    }
+
+    std::mutex m_mutex;
+    std::condition_variable m_cv;
+    std::array<Block, kReadAheadBlocks> m_blocks{};
+    uint64_t m_clock = 0;
+    bool m_started = false;
+    bool m_failed = false;
+    bool m_loggedSlowFetch = false;
+};
+
+inline void CloseCachedHostFile(CachedHostFile& slot) {
+    if (slot.file != nullptr) {
+        std::fclose(slot.file);
+    }
+    slot = CachedHostFile{};
+}
+
+inline bool ReadExactCached(const std::string& hostPath,
+                            uint64_t offset,
+                            uint32_t length,
+                            std::vector<uint8_t>& destination,
+                            HostReadFailure& failure) {
+    failure = HostReadFailure::None;
+    if (ReadAheadEnabled() && length != 0) {
+        uint64_t fileSize = 0;
+        if (ReadAhead::Instance().Take(hostPath, offset, length, destination, fileSize)) {
+            // Keep the stream ahead.
+            ReadAhead::Instance().QueueStream(hostPath, offset + length, length, fileSize);
+            return true;
+        }
+    }
+
+    static std::mutex mutex;
+    static std::array<CachedHostFile, kHostFileCacheSlots> slots;
+    static uint64_t useClock = 0;
+    std::lock_guard<std::mutex> lock(mutex);
+
+    CachedHostFile* slot = nullptr;
+    for (auto& candidate : slots) {
+        if (candidate.file != nullptr && candidate.path == hostPath) {
+            slot = &candidate;
+            break;
+        }
+    }
+    if (slot == nullptr) {
+        CachedHostFile* victim = &slots[0];
+        for (auto& candidate : slots) {
+            if (candidate.file == nullptr) {
+                victim = &candidate;
+                break;
+            }
+            if (candidate.lastUse < victim->lastUse) {
+                victim = &candidate;
+            }
+        }
+        CloseCachedHostFile(*victim);
+        if (!OpenHostFileSlot(*victim, hostPath, failure)) {
+            return false;
+        }
+        slot = victim;
+    }
+    slot->lastUse = ++useClock;
+
+    if (offset >= slot->size) {
+        failure = HostReadFailure::BadOffset;
+        return false;
+    }
+    if (static_cast<uint64_t>(length) > slot->size - offset) {
+        failure = HostReadFailure::ShortRead;
+        return false;
+    }
+    const uint64_t start = SteadyNowNs();
+    std::vector<uint8_t> staged(length);
+    if (offset > static_cast<uint64_t>(std::numeric_limits<long>::max()) ||
+        std::fseek(slot->file, static_cast<long>(offset), SEEK_SET) != 0) {
+        CloseCachedHostFile(*slot);
+        failure = HostReadFailure::BadOffset;
+        return false;
+    }
+    if (length != 0 && std::fread(staged.data(), 1, length, slot->file) != length) {
+        CloseCachedHostFile(*slot);
+        failure = HostReadFailure::ShortRead;
+        return false;
+    }
+    DvdCounters& counters = Counters();
+    counters.v[0].fetch_add(1, std::memory_order_relaxed);
+    counters.v[1].fetch_add(length, std::memory_order_relaxed);
+    counters.v[2].fetch_add(SteadyNowNs() - start, std::memory_order_relaxed);
+    destination = std::move(staged);
+    // A read that continues the previous one on this file makes it a stream: prefetch the next block.
+    const bool sequential = slot->nextOffset == offset;
+    slot->nextOffset = offset + length;
+    if (sequential && ReadAheadEnabled()) {
+        ReadAhead::Instance().QueueStream(hostPath, offset + length, length, slot->size);
+    }
+    return true;
+}
+
+// Callers hold host paths as strings: this overload skips the std::filesystem::path conversion
+// and takes the cached path when the switch is on.
+inline bool ReadExact(const std::string& hostPath,
+                      uint64_t offset,
+                      uint32_t length,
+                      std::vector<uint8_t>& destination,
+                      HostReadFailure& failure) {
+    if (HostFileCacheEnabled()) {
+        return ReadExactCached(hostPath, offset, length, destination, failure);
+    }
+    return ReadExact(std::filesystem::path(hostPath), offset, length, destination, failure);
+}
+
 } // namespace DvdReadContract
