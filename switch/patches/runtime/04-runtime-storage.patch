-            tempPath.c_str(), targetPath.c_str(), static_cast<unsigned long>(GetLastError()));
-    return false;
-#else
-    if (std::rename(tempPath.c_str(), targetPath.c_str()) != 0) {
-        LogNandError(who, "ERROR: rename('%s' -> '%s') failed",
-                tempPath.c_str(), targetPath.c_str());
