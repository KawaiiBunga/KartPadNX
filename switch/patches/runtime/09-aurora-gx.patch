+      if (usesFixedTexcoordState) {
+        if (stage.indTexAddPrev) {
+          fragmentFnPre += fmt::format("\n    t_TexCoord += {};", finalCoord);
+        } else {
+          fragmentFnPre += fmt::format("\n    t_TexCoord = {};", finalCoord);
+        }
+        fragmentFnPre += "\n    t_TexCoord = tev_s24_fixed_vec2i(t_TexCoord);";
