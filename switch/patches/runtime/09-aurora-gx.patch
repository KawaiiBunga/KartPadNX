+void prune_copy_texture_pool(const void* dest) noexcept {
+  if (dest == nullptr) {
+    g_copyTexturePool.clear();
+    return;
+  }
+  std::erase_if(g_copyTexturePool, [dest](const CopyTexturePoolEntry& entry) { return entry.key.dest == dest; });
+}
