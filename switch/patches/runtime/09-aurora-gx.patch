+        const auto appendScaleShift = [&](u32 mtxIdx) {
+          fragmentFnPre += fmt::format(
+              "\n    let ind{0}_shift = ubuf.ind_mtx[{1}].z;"
+              "\n    if (ind{0}_shift >= 0) {{"
+              "\n      ind{0}_offset_fixed = ind{0}_offset_fixed >> vec2u(u32(ind{0}_shift));"
+              "\n    }} else {{"
+              "\n      ind{0}_offset_fixed = ind{0}_offset_fixed << vec2u(u32(-ind{0}_shift));"
+              "\n    }}",
