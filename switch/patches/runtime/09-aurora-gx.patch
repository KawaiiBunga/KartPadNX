new file mode 100644
--- /dev/null
+++ b/aurora-main/lib/gx/gx_worker.cpp
@@ -0,0 +1,579 @@
+#include "gx_worker.hpp"
+
+#include "fifo.hpp"
+#include "command_processor.hpp"
+#include "../internal.hpp"
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <thread>
+#include <vector>
+#if defined(_WIN32)
+#include <malloc.h>
+#endif
+
+#if defined(__SWITCH__)
+#include <switch.h>
+// Image start from libnx crt0: logged addresses are printed relative to it, so they symbolize
+// directly against kartpad_full.elf (addr2line / builder/crash-sym.py).
+extern "C" char __start__[];
+extern "C" char __end__[];
+#endif
+
+extern "C" int kartpad_thread_apply(int role, int index) __attribute__((weak));
+// perf.cfg optimization switches (switch/src/perf_switch.cpp); absent in non-Switch builds.
+extern "C" int kartpad_opt(const char* key, int fallback) __attribute__((weak));
+
+namespace aurora::gx::worker {
+namespace {
+
+// One ring of variable-length records, written only by the guest thread and read
+// only by the worker. Positions are monotonically increasing byte offsets; the
+// slot is `pos % kRingBytes`. 16 MiB holds several frames of GX traffic (a race
+// frame is ~0.3 MB of display lists plus ~0.1 MB of FIFO).
+constexpr uint64_t kRingBytes = 16ull << 20;
+constexpr uint32_t kAlign = 16;
+constexpr uint32_t kMaxRecord = static_cast<uint32_t>(kRingBytes / 4);
+
+enum Kind : uint32_t {
+  kStreamBE = 1,
+  kStreamLE = 2,
+  kCall = 3,
+  kWrap = 4,
+};
+
+struct alignas(16) Header {
+  uint32_t kind;
+  uint32_t payloadBytes;
+  CallFn fn;
+};
+static_assert(sizeof(Header) == 16);
+
+uint8_t* g_ring = nullptr;
+// Producer and worker positions live on separate cache lines: each side writes its own and only
+// occasionally reads the other's.
+alignas(64) std::atomic<uint64_t> g_write{0};  // published by the producer
+alignas(64) std::atomic<uint64_t> g_read{0};   // published by the worker
+alignas(64) uint64_t g_producerPos = 0;        // producer-private copy of g_write
+uint64_t g_producerKnownRead = 0;              // producer-private, last g_read it loaded
+
+alignas(64) std::atomic<bool> g_workerSleeping{false};
+std::atomic<bool> g_producerWaiting{false};
+
+// Wake-ups. `gxw_levent 1` (default): libnx light events, a futex-style wait/signal with no
+// mutex, so the producer's wake is one svc and never contends with the worker. `0`: the b18
+// mutex + condition variable pair. Both use the same Dekker handshake on the flags above.
+//
+// The light events are MANUAL-clear: the sleeper clears its event before it announces itself.
+// b24 used autoclear and hung at the first frame with both threads in leventWait
+// (docs/PERF-60FPS-ROADMAP.md, finding 13). libnx's autoclear waiter only returns once the counter
+// reads "signaled" (2), but the kernel's wake-one signal (SignalAndModifyByWaitingCountIfEqual)
+// sets the counter to 0 when it wakes the last blocked waiter, so a waiter that is already asleep
+// in the kernel wakes up and goes straight back to sleep: every such wake-up is lost.
+//
+// Every wait also times out after kRescueWaitNs and re-checks its condition, so a broken wake path
+// costs milliseconds instead of hanging the game. A timeout that finds the condition true is then
+// classified by waiting up to kLateSignalNs more for the signal: the waker always signals after it
+// publishes (its flag check sees the sleeper's flag, which stays set for the whole wait), so
+//  - the signal arrives: the timeout merely fired between the waker's publish and its signal
+//    (`late=` on the [stages] gxw line; normal, r16 saw 8 in a whole run, no log line);
+//  - no signal: the wake-up was LOST (`rescued=`, plus a `[gx_worker] LOST ...` log line). That
+//    is a bug in the wake path (Finding 13 was one); `gxw_levent 0` switches to the condvar path.
+// A guest wait longer than kStallLogNs logs a STALL line with the ring state.
+constexpr uint64_t kRescueWaitNs = 10'000'000;   // 10 ms
+constexpr uint64_t kLateSignalNs = 2'000'000;    // 2 ms
+constexpr uint64_t kStallLogNs = 1'000'000'000;  // 1 s
+bool g_useLEvent = false;
+#if defined(__SWITCH__)
+LEvent g_workerEvent;
+LEvent g_producerEvent;
+#endif
+std::mutex g_mutex;
+std::condition_variable g_workerCv;
+std::condition_variable g_producerCv;
+
+std::atomic<bool> g_active{false};
+bool g_requested = false;
+bool g_activationTried = false;
+thread_local bool t_onWorker = false;
+// The ring has exactly one producer: the host thread that activated the worker (the guest thread,
+// from aurora_begin_frame). append() checks it and logs any other thread once (report_foreign_producer).
+thread_local bool t_isProducer = false;
+uint32_t g_batchBytes = 0;
+
+// Producer-side stats are single-writer: plain counters published with relaxed stores (no
+// read-modify-write on the hot path). The worker's busy time is likewise single-writer.
+uint64_t g_localSubmits = 0;
+uint64_t g_localBytes = 0;
+std::atomic<uint64_t> g_statSubmits{0};
+std::atomic<uint64_t> g_statBytes{0};
+std::atomic<uint64_t> g_statSyncs{0};
+std::atomic<uint64_t> g_statSyncWaitNs{0};
+std::atomic<uint64_t> g_statFullWaitNs{0};
+std::atomic<uint64_t> g_statBusyNs{0};
+std::atomic<uint64_t> g_statWakes{0};
+std::atomic<uint64_t> g_statRescues{0};
+std::atomic<uint64_t> g_statLate{0};
+
+inline uint64_t now_ns() {
+  return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                   std::chrono::steady_clock::now().time_since_epoch())
+                                   .count());
+}
+
+inline void cpu_relax() {
+#if defined(__aarch64__)
+  __asm__ __volatile__("yield");
+#endif
+}
+
+inline uint32_t record_bytes(uint32_t payload) {
+  return (static_cast<uint32_t>(sizeof(Header)) + payload + (kAlign - 1)) & ~(kAlign - 1);
+}
+
+void wake_worker() {
+  if (!g_workerSleeping.load(std::memory_order_seq_cst)) {
+    return;
+  }
+  g_statWakes.store(g_statWakes.load(std::memory_order_relaxed) + 1, std::memory_order_relaxed);
+#if defined(__SWITCH__)
+  if (g_useLEvent) {
+    leventSignal(&g_workerEvent);
+    return;
+  }
+#endif
+  std::lock_guard lock(g_mutex);
+  g_workerCv.notify_one();
+}
+
+void wake_producer() {
+  if (!g_producerWaiting.load(std::memory_order_seq_cst)) {
+    return;
+  }
+#if defined(__SWITCH__)
+  if (g_useLEvent) {
+    leventSignal(&g_producerEvent);
+    return;
+  }
+#endif
+  std::lock_guard lock(g_mutex);
+  g_producerCv.notify_all();
+}
+
+enum class Side { Worker, Producer };
+
+const char* wake_name() { return g_useLEvent ? "levent" : "condvar"; }
+
+// `late`: the signal came within kLateSignalNs of the timeout (benign). Otherwise it never came.
+void note_timeout_found_ready(Side side, bool late) {
+  if (late) {
+    g_statLate.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  const uint64_t n = g_statRescues.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (n <= 8 || (n & (n - 1)) == 0) {  // the first few, then powers of two
+    std::fprintf(stderr,
+                 "[gx_worker] LOST %s wake-up: no signal %llu ms after the condition held; rescued by the "
+                 "timeout (#%llu, wake %s)\n",
+                 side == Side::Worker ? "worker" : "guest",
+                 static_cast<unsigned long long>((kRescueWaitNs + kLateSignalNs) / 1000000),
+                 static_cast<unsigned long long>(n), wake_name());
+  }
+}
+
+// One side's sleep until `ready()`. The sleeper announces itself in its flag (seq_cst) and then
+// re-checks; the waker publishes its progress (seq_cst) and signals only if it sees the flag. Either
+// the re-check sees the progress or the waker sees the flag (Dekker), so the only way to lose a
+// wake-up is a signal primitive that drops it, which the timeout covers. `onTimeout` runs after each
+// timeout that finds the condition still false.
+template <typename Ready, typename OnTimeout>
+void sleep_until(Side side, Ready ready, OnTimeout onTimeout) {
+  std::atomic<bool>& flag = side == Side::Worker ? g_workerSleeping : g_producerWaiting;
+#if defined(__SWITCH__)
+  if (g_useLEvent) {
+    LEvent* event = side == Side::Worker ? &g_workerEvent : &g_producerEvent;
+    for (;;) {
+      leventClear(event);  // drop a signal left over from an earlier round
+      flag.store(true, std::memory_order_seq_cst);
+      if (ready()) break;
+      if (!leventWait(event, kRescueWaitNs)) {
+        if (ready()) {
+          note_timeout_found_ready(side, leventWait(event, kLateSignalNs));
+          break;
+        }
+        onTimeout();
+      }
+    }
+    flag.store(false, std::memory_order_relaxed);
+    return;
+  }
+#endif
+  std::unique_lock lock(g_mutex);
+  std::condition_variable& cv = side == Side::Worker ? g_workerCv : g_producerCv;
+  flag.store(true, std::memory_order_seq_cst);
+  while (!ready()) {
+    if (cv.wait_for(lock, std::chrono::nanoseconds(kRescueWaitNs)) == std::cv_status::timeout) {
+      if (ready()) {
+        note_timeout_found_ready(
+            side, cv.wait_for(lock, std::chrono::nanoseconds(kLateSignalNs)) == std::cv_status::no_timeout);
+        break;
+      }
+      onTimeout();
+    }
+  }
+  flag.store(false, std::memory_order_relaxed);
+}
+
+// Producer: block until `done()` holds, i.e. the worker's read position reached `target`. The
+// worker publishes g_read after every record and signals when g_producerWaiting is set.
+template <typename Pred>
+void producer_wait(const char* what, uint64_t target, Pred done) {
+  for (int spin = 0; spin < 4096; ++spin) {
+    if (done()) return;
+    cpu_relax();
+  }
+  const uint64_t start = now_ns();
+  uint64_t nextStallLog = start + kStallLogNs;
+  sleep_until(Side::Producer, done, [&] {
+    const uint64_t now = now_ns();
+    if (now < nextStallLog) return;
+    nextStallLog = now + 5 * kStallLogNs;
+    // read == write < target means records were promised (g_producerPos) but never published:
+    // a second producer thread or a lost g_write update. read < write with the worker asleep
+    // means the worker missed its wake-up and the rescue timeout is not firing either.
+    std::fprintf(stderr,
+                 "[gx_worker] STALL: guest waiting %.1f s in %s: target=%llu read=%llu write=%llu "
+                 "workerSleeping=%d wake=%s rescued=%llu\n",
+                 (now - start) / 1e9, what, static_cast<unsigned long long>(target),
+                 static_cast<unsigned long long>(g_read.load(std::memory_order_relaxed)),
+                 static_cast<unsigned long long>(g_write.load(std::memory_order_relaxed)),
+                 g_workerSleeping.load(std::memory_order_relaxed) ? 1 : 0, wake_name(),
+                 static_cast<unsigned long long>(g_statRescues.load(std::memory_order_relaxed)));
+  });
+}
+
+#if defined(__SWITCH__)
+static uint32_t g_producerHandle = 0;
+#endif
+
+[[gnu::noinline, gnu::cold]] void report_foreign_producer(const void* caller) {
+  static thread_local bool reported = false;
+  if (reported) return;
+  reported = true;
+#if defined(__SWITCH__)
+  const unsigned long long offset = reinterpret_cast<uintptr_t>(caller) - reinterpret_cast<uintptr_t>(__start__);
+  const uint32_t myHandle = threadGetCurHandle();
+#else
+  const unsigned long long offset = reinterpret_cast<uintptr_t>(caller);
+  const uint32_t myHandle = 0;
+#endif
+  std::fprintf(stderr,
+               "[gx_worker] BUG: a second host thread queued GX work (caller image+0x%llx); the ring has "
+               "one producer, so this can corrupt or hang it\n",
+               offset);
+#if defined(__SWITCH__)
+  std::fprintf(stderr, "[gx_worker] offending thread handle: %08x, registered producer handle: %08x\n", myHandle, g_producerHandle);
+  std::fprintf(stderr, "[gx_worker] Backtrace:\n");
+  void* fp = __builtin_frame_address(0);
+  for (int i = 0; i < 12 && fp; ++i) {
+    if (reinterpret_cast<uintptr_t>(fp) & 0xF) break;
+    void* next_fp = *((void**)fp);
+    if (next_fp && next_fp <= fp) break;
+    void* lr = *((void**)fp + 1);
+    unsigned long long lr_val = reinterpret_cast<uintptr_t>(lr);
+    unsigned long long start_val = reinterpret_cast<uintptr_t>(__start__);
+    unsigned long long end_val = reinterpret_cast<uintptr_t>(__end__);
+    if (lr_val >= start_val && lr_val < end_val) {
+      std::fprintf(stderr, "  frame %d: image+0x%llx\n", i, lr_val - start_val);
+    } else {
+      std::fprintf(stderr, "  frame %d: abs 0x%llx\n", i, lr_val);
+    }
+    fp = next_fp;
+  }
+#endif
+  if (kartpad_opt && kartpad_opt("gxw_abort_foreign", 1) != 0) {
+    std::abort();
+  }
+}
+
+// Producer: wait until `pos + need` fits behind the worker's read position. The cached read
+// position answers almost every call without touching the worker's cache line.
+void wait_for_space(uint64_t pos, uint64_t need) {
+  if (pos + need - g_producerKnownRead <= kRingBytes) {
+    return;
+  }
+  g_producerKnownRead = g_read.load(std::memory_order_acquire);
+  if (pos + need - g_producerKnownRead <= kRingBytes) {
+    return;
+  }
+  const uint64_t start = now_ns();
+  wake_worker();  // it may be asleep on records that were never large enough to wake it
+  producer_wait("ring-full", pos + need - kRingBytes, [&] {
+    g_producerKnownRead = g_read.load(std::memory_order_seq_cst);
+    return pos + need - g_producerKnownRead <= kRingBytes;
+  });
+  g_statFullWaitNs.fetch_add(now_ns() - start, std::memory_order_relaxed);
+}
+
+// Producer: append one record. `a`/`b` are copied back to back as the payload.
+void append(uint32_t kind, CallFn fn, const void* a, uint32_t aBytes, const void* b, uint32_t bBytes) {
+  if (__builtin_expect(!t_isProducer, 0)) {
+    report_foreign_producer(__builtin_return_address(0));
+  }
+  const uint32_t payload = aBytes + bBytes;
+  const uint32_t bytes = record_bytes(payload);
+  uint64_t pos = g_producerPos;
+  const uint64_t slot = pos % kRingBytes;
+  const uint64_t tail = kRingBytes - slot;
+  if (tail < bytes) {
+    // The record would straddle the end: pad to the start with a wrap marker.
+    wait_for_space(pos, tail + bytes);
+    auto* wrap = reinterpret_cast<Header*>(g_ring + slot);
+    wrap->kind = kWrap;
+    wrap->payloadBytes = static_cast<uint32_t>(tail - sizeof(Header));
+    wrap->fn = nullptr;
+    pos += tail;
+  } else {
+    wait_for_space(pos, bytes);
+  }
+  uint8_t* dst = g_ring + (pos % kRingBytes);
+  auto* header = reinterpret_cast<Header*>(dst);
+  header->kind = kind;
+  header->payloadBytes = payload;
+  header->fn = fn;
+  if (aBytes != 0) std::memcpy(dst + sizeof(Header), a, aBytes);
+  if (bBytes != 0) std::memcpy(dst + sizeof(Header) + aBytes, b, bBytes);
+  pos += bytes;
+  g_producerPos = pos;
+  // seq_cst: pairs with the worker's g_workerSleeping store (Dekker-style handshake in
+  // wake_worker / the worker's sleep check), so a wakeup can never be lost.
+  g_write.store(pos, std::memory_order_seq_cst);
+  g_statSubmits.store(++g_localSubmits, std::memory_order_relaxed);
+  g_statBytes.store(g_localBytes += payload, std::memory_order_relaxed);
+  wake_worker();
+}
+
+void execute(const Header& header, const uint8_t* payload) {
+  switch (header.kind) {
+  case kStreamBE:
+  case kStreamLE:
+    // What drain() did before decoding on the guest thread: the frame worker must have
+    // released producer-shared renderer state (SEALED) before new commands decode.
+    aurora::wait_for_frame_worker_sealed();
+    fifo::process(payload, header.payloadBytes, header.kind == kStreamBE);
+    break;
+  case kCall:
+    // Closures touch the same producer-shared renderer state as decoding does.
+    aurora::wait_for_frame_worker_sealed();
+    header.fn(payload);
+    break;
+  default:
+    break;
+  }
+}
+
+// Worker: sleep until g_write moves past `read`. Idle, it wakes every kRescueWaitNs to re-check.
+void worker_sleep(uint64_t read) {
+  sleep_until(Side::Worker, [&] { return g_write.load(std::memory_order_seq_cst) != read; }, [] {});
+}
+
+void worker_main() {
+#if defined(AURORA_PLATFORM_SWITCH) || defined(__SWITCH__)
+  constexpr int kKartpadRoleGxWorker = 6;  // KARTPAD_ROLE_GX_WORKER in switch/src/perf_switch.h
+  if (kartpad_thread_apply) kartpad_thread_apply(kKartpadRoleGxWorker, 0);
+#endif
+  t_onWorker = true;
+  uint64_t read = g_read.load(std::memory_order_relaxed);
+  uint64_t busyNs = 0;
+  for (;;) {
+    uint64_t write = g_write.load(std::memory_order_acquire);
+    if (read == write) {
+      // Commands arrive in bursts all through the guest's draw phase; spin a
+      // little before paying a sleep/wake round trip.
+      for (int spin = 0; spin < 2048 && read == write; ++spin) {
+        cpu_relax();
+        write = g_write.load(std::memory_order_acquire);
+      }
+      if (read == write) {
+        worker_sleep(read);
+        continue;
+      }
+    }
+    const uint64_t start = now_ns();
+    while (read != write) {
+      const auto* header = reinterpret_cast<const Header*>(g_ring + (read % kRingBytes));
+      if (header->kind != kWrap) {
+        execute(*header, reinterpret_cast<const uint8_t*>(header) + sizeof(Header));
+        read += record_bytes(header->payloadBytes);
+      } else {
+        read += sizeof(Header) + header->payloadBytes;
+      }
+      g_read.store(read, std::memory_order_seq_cst);
+      wake_producer();
+    }
+    busyNs += now_ns() - start;
+    g_statBusyNs.store(busyNs, std::memory_order_relaxed);
+  }
+}
+
+// Oversized records (> kMaxRecord) are decoded inline on the guest thread once the worker has
+// drained everything before them. While that runs the guest thread must act as the worker, or any
+// nested GX call would queue itself behind the inline decode (wrong order) and an oversized raw draw
+// would resubmit itself forever. Safe because sync() left the worker idle and nothing else queues
+// while the guest thread is busy here.
+struct InlineAsWorker {
+  InlineAsWorker() { t_onWorker = true; }
+  ~InlineAsWorker() { t_onWorker = false; }
+  InlineAsWorker(const InlineAsWorker&) = delete;
+  InlineAsWorker& operator=(const InlineAsWorker&) = delete;
+};
+
+} // namespace
+
+void configure(bool enabled) noexcept { g_requested = enabled; }
+
+void activate() noexcept {
+  if (!g_requested || g_activationTried || t_onWorker) {
+    return;
+  }
+  g_activationTried = true;
+  // perf.cfg `gxw_batch_kb` (default 32): FIFO bytes and display lists accumulate in the
+  // producer buffer and go to the worker in batches of at least this size, so a frame is tens
+  // of records instead of thousands. 0 = one record per drain and per display list (b18).
+  g_batchBytes = static_cast<uint32_t>((kartpad_opt ? kartpad_opt("gxw_batch_kb", 32) : 0)) * 1024u;
+  if (g_batchBytes > kMaxRecord / 4) {
+    g_batchBytes = kMaxRecord / 4;
+  }
+#if defined(__SWITCH__)
+  g_useLEvent = kartpad_opt ? kartpad_opt("gxw_levent", 1) != 0 : false;
+  // Manual clear (autoclear = false): see the wake-up comment at the top of this file.
+  leventInit(&g_workerEvent, false, false);
+  leventInit(&g_producerEvent, false, false);
+#endif
+  // Lives for the whole process. Windows' C runtime has no aligned_alloc.
+#if defined(_WIN32)
+  g_ring = static_cast<uint8_t*>(_aligned_malloc(kRingBytes, 64));
+#else
+  g_ring = static_cast<uint8_t*>(std::aligned_alloc(64, kRingBytes));
+#endif
+  if (g_ring == nullptr) {
+    std::fprintf(stderr, "[gx_worker] ring allocation failed; decoding stays on the guest thread\n");
+    return;
+  }
+  try {
+    // Never joined or detached: it lives as long as the process (libnx has no pthread_detach,
+    // and the exit path is _exit, so no destructor ever sees a joinable thread).
+    new std::thread(worker_main);
+  } catch (...) {
+    std::fprintf(stderr, "[gx_worker] thread creation failed; decoding stays on the guest thread\n");
+    return;
+  }
+  t_isProducer = true;
+#if defined(__SWITCH__)
+  g_producerHandle = threadGetCurHandle();
+#endif
+  g_active.store(true, std::memory_order_release);
+  std::fprintf(stderr,
+               "[gx_worker] GX decode worker started (%llu MiB ring, batch %u KiB, wake %s, rescue %llu ms)\n",
+               static_cast<unsigned long long>(kRingBytes >> 20), g_batchBytes / 1024u,
+               g_useLEvent ? "levent-manual" : "condvar", static_cast<unsigned long long>(kRescueWaitNs / 1000000));
+}
+
+bool enqueue_mode() noexcept { return !t_onWorker && g_active.load(std::memory_order_relaxed); }
+bool on_worker() noexcept { return t_onWorker; }
+uint32_t batch_bytes() noexcept { return g_batchBytes; }
+
+void submit_stream(const uint8_t* data, uint32_t size, bool bigEndian) {
+  if (size == 0) return;
+  if (size > kMaxRecord) {
+    // Oversized burst: run it inline once the worker is idle (same ordering).
+    sync();
+    std::fprintf(stderr, "[gx_worker] oversized stream record (%u bytes) decoded inline\n", size);
+    aurora::wait_for_frame_worker_sealed();
+    InlineAsWorker inlineScope;
+    fifo::process(data, size, bigEndian);
+    return;
+  }
+  append(bigEndian ? kStreamBE : kStreamLE, nullptr, data, size, nullptr, 0);
+}
+
+void submit_call(CallFn fn, const void* payload, uint32_t payloadBytes) {
+  append(kCall, fn, payload, payloadBytes, nullptr, 0);
+}
+
+void submit_owned_stream_call(CallFn fn, const void* payload, uint32_t payloadBytes, uint32_t streamBytes) {
+  g_localBytes += streamBytes;  // producer-only counter; append() publishes it with the record
+  append(kCall, fn, payload, payloadBytes, nullptr, 0);
+}
+
+void submit_call2(CallFn fn, const void* a, uint32_t aBytes, const void* b, uint32_t bBytes) {
+  if (aBytes + bBytes > kMaxRecord) {
+    sync();
+    std::fprintf(stderr, "[gx_worker] oversized call record (%u bytes) run inline\n", aBytes + bBytes);
+    // Rebuild the concatenated payload inline: rare (raw draws are small).
+    std::vector<uint8_t> tmp(aBytes + bBytes);
+    std::memcpy(tmp.data(), a, aBytes);
+    std::memcpy(tmp.data() + aBytes, b, bBytes);
+    aurora::wait_for_frame_worker_sealed();
+    InlineAsWorker inlineScope;
+    fn(tmp.data());
+    return;
+  }
+  append(kCall, fn, a, aBytes, b, bBytes);
+}
+
+void sync() noexcept {
+  if (!enqueue_mode()) return;
+  // Everything the guest has produced, including FIFO bytes still batching in the producer
+  // buffer, must reach the worker before we wait for it.
+  fifo::flush();
+  const uint64_t target = g_producerPos;
+  g_producerKnownRead = g_read.load(std::memory_order_acquire);
+  if (g_producerKnownRead >= target) return;
+  g_statSyncs.fetch_add(1, std::memory_order_relaxed);
+  const uint64_t start = now_ns();
+  wake_worker();
+  producer_wait("sync", target, [&] {
+    g_producerKnownRead = g_read.load(std::memory_order_seq_cst);
+    return g_producerKnownRead >= target;
+  });
+  g_statSyncWaitNs.fetch_add(now_ns() - start, std::memory_order_relaxed);
+}
+
+Stats stats() noexcept {
+  return Stats{
+      g_statSubmits.load(std::memory_order_relaxed), g_statBytes.load(std::memory_order_relaxed),
+      g_statSyncs.load(std::memory_order_relaxed),   g_statSyncWaitNs.load(std::memory_order_relaxed),
+      g_statFullWaitNs.load(std::memory_order_relaxed), g_statBusyNs.load(std::memory_order_relaxed),
+      g_statWakes.load(std::memory_order_relaxed),   g_statRescues.load(std::memory_order_relaxed),
+      g_statLate.load(std::memory_order_relaxed),
+  };
+}
+
+} // namespace aurora::gx::worker
+
+// out: [0]=submits [1]=bytes [2]=syncs [3]=sync wait ns [4]=full wait ns [5]=worker busy ns [6]=active
+//      [7]=worker wake-ups signalled [8]=lost wake-ups rescued by the wait timeout
+//      [9]=late signals (the timeout fired between a publish and its signal; benign)
+extern "C" void aurora_switch_gx_worker_counters(uint64_t* out) {
+  const auto s = aurora::gx::worker::stats();
+  out[0] = s.submits;
+  out[1] = s.bytes;
+  out[2] = s.syncs;
+  out[3] = s.syncWaitNs;
+  out[4] = s.fullWaitNs;
+  out[5] = s.busyNs;
+  out[6] = aurora::gx::worker::enqueue_mode() ? 1 : 0;
+  out[7] = s.wakes;
+  out[8] = s.rescues;
+  out[9] = s.lateWakes;
+}
+
+extern "C" void aurora_gx_worker_configure(int enabled) { aurora::gx::worker::configure(enabled != 0); }
+
+// Guest GXDrawDone with the worker on: wait until every queued command has been decoded.
+extern "C" void aurora_gx_worker_sync(void) { AURORA_GX_SYNC(); }
