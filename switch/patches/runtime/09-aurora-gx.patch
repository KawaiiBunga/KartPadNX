+
+    if ((config.fogType & 0x8u) == 0) {
+      fragmentFn += fmt::format(
+          "\n    // Fog"
+          "\n    let fogZCoord = {};"
+          "\n    let fogShiftedZ = fogZCoord >> u32(ubuf.fog.pad);"
+          "\n    var fogZe = (ubuf.fog.a * 16777216.0) / (ubuf.fog.b - f32(fogShiftedZ));",
