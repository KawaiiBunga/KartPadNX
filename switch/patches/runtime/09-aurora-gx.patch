+    fragmentFn += "\n    let ztexDepth = f32(ztexCoord) / 16777216.0;";
+    fogZCoordExpr = "ztexCoord";
+  }
+
+  if (info.usesPTTexMtx.any())
+    uniBufAttrs += fmt::format("\n    postmtx: array<mat3x4f, {}>,", MaxPTTexMtx);
+  if (info.usesFog) {
+    uniformPre +=
+        "\n"
+        "struct Fog {\n"
+        "    color: vec4f,\n"
+        "    a: f32,\n"
+        "    b: f32,\n"
+        "    c: f32,\n"
+        "    pad: f32,\n"
+        "    range_base: vec4f,\n"
+        "    range_k: array<vec4f, 3>,\n"
+        "}";
