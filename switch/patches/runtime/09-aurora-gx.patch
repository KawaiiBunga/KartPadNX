-  if (entry.tlutObjId != tlutObjId) {
-    clear_texture_dependency(obj.texObjId, entry.tlutObjId);
-  }
-
-  entry.handle = std::move(handle);
-  entry.texDataVersion = obj.texDataVersion;
-  entry.tlutObjId = tlutObjId;
