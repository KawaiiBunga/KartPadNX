+void set_logical_viewport(const gfx::Viewport& viewport) noexcept {
+  const bool changed = viewport != g_gxState.logicalViewport;
+  g_gxState.logicalViewport = viewport;
+  g_gxState.stateDirty = g_gxState.stateDirty || changed;
