+    } else {
+      fragmentFn += fmt::format(
+          "\n    // Fog"
+          "\n    let fogZCoord = {};"
+          "\n    var fogZe = ubuf.fog.a * f32(fogZCoord) / 16777216.0;",
+          fogZCoordExpr);
