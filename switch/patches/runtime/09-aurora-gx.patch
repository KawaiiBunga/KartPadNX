+// (a stalled worker) batches take the copy path again, whose ring space is the backpressure.
+// The free list holds every buffer that can be in flight: with 64 slots, a worker more than 64
+// batches behind (menus flush once per layout quad) had its returned buffers freed and the producer
+// allocating new ones, 5-6% of the GX HLE thread in malloc (test 14).
+namespace {
+struct OwnedBatch {
+  uint8_t* data;
+  uint32_t bytes;
+  uint32_t capacity;
+};
+constexpr uint32_t kOwnedMaxInFlight = 256;
+constexpr uint32_t kOwnedFreeSlots = kOwnedMaxInFlight;
+OwnedBatch sOwnedFree[kOwnedFreeSlots];
+std::atomic<uint32_t> sOwnedFreeHead{0};  // producer pops
+std::atomic<uint32_t> sOwnedFreeTail{0};  // worker pushes
+std::atomic<uint32_t> sOwnedInFlight{0};
+
+bool owned_batches_enabled() {
+  static const bool enabled = kartpad_opt == nullptr || kartpad_opt("gxw_owned_batches", 1) != 0;
+  return enabled;
+}
+
+bool pop_owned_free(OwnedBatch& out) {
+  const uint32_t head = sOwnedFreeHead.load(std::memory_order_relaxed);
+  if (head == sOwnedFreeTail.load(std::memory_order_acquire)) {
+    return false;
+  }
+  out = sOwnedFree[head % kOwnedFreeSlots];
+  sOwnedFreeHead.store(head + 1, std::memory_order_release);
+  return true;
+}
+
+void recycle_owned(const OwnedBatch& batch) {
+  const uint32_t tail = sOwnedFreeTail.load(std::memory_order_relaxed);
+  if (tail - sOwnedFreeHead.load(std::memory_order_acquire) >= kOwnedFreeSlots) {
+    free(batch.data);
+  } else {
+    sOwnedFree[tail % kOwnedFreeSlots] = batch;
+    sOwnedFreeTail.store(tail + 1, std::memory_order_release);
+  }
+  sOwnedInFlight.fetch_sub(1, std::memory_order_release);
+}
+
+void process_owned(const void* payload) {
+  OwnedBatch batch;
+  std::memcpy(&batch, payload, sizeof(batch));
+  process(batch.data, batch.bytes, true);
+  recycle_owned(batch);
+}
+
+bool hand_owned_to_worker(uint32_t bytes) {
+  if (!owned_batches_enabled() || sOwnedInFlight.load(std::memory_order_acquire) >= kOwnedMaxInFlight) {
+    return false;
+  }
+  OwnedBatch next{};
+  if (!pop_owned_free(next)) {
+    next.capacity = detail::sBufferCapacity;
+    next.data = static_cast<uint8_t*>(malloc(next.capacity));
+    if (next.data == nullptr) {
+      return false;
+    }
+  }
+  const OwnedBatch out{detail::sBufferData, bytes, detail::sBufferCapacity};
+  detail::sBufferData = next.data;
+  detail::sBufferCapacity = next.capacity;
+  detail::sBufferSize = 0;
+  sOwnedInFlight.fetch_add(1, std::memory_order_relaxed);
+  worker::submit_owned_stream_call(process_owned, &out, sizeof(out), bytes);
+  return true;
+}
+} // namespace
+
+static void hand_to_worker() {
+  const uint32_t bytes = detail::sBufferSize;
+  if (!hand_owned_to_worker(bytes)) {
+    detail::sBufferSize = 0;
+    worker::submit_stream(detail::sBufferData, bytes, true);
+  }
+  sDrainBytes.fetch_add(bytes, std::memory_order_relaxed);
+  sDrainCount.fetch_add(1, std::memory_order_relaxed);
+}
+
+void flush() {
+  if (worker::on_worker()) {
+    return;
+  }
+  if (worker::enqueue_mode()) {
+    if (detail::sBufferSize != 0) {
+      hand_to_worker();
+    }
+    return;
+  }
+  drain();
+}
+
 void drain() {
+  // The producer's FIFO buffer belongs to the guest thread: on the worker every earlier command
+  // has already run (records execute in order), so there is nothing to drain.
+  if (worker::on_worker()) {
+    return;
+  }
+  if (worker::enqueue_mode()) {
+    // Batched (perf.cfg gxw_batch_kb): the bytes stay in order in the producer buffer, and every
+    // path that queues a different record or waits on the worker calls flush() first.
+    if (detail::sBufferSize != 0 && detail::sBufferSize >= worker::batch_bytes()) {
+      hand_to_worker();
+    }
+    return;
+  }
   // SEALED, not DONE.
   const auto waited = aurora::wait_for_frame_worker_sealed();
   if (waited.count() > 0) UNLIKELY {
     note_drain_wait(static_cast<uint64_t>(waited.count()));
+    sDrainWaitNs.fetch_add(static_cast<uint64_t>(waited.count()), std::memory_order_relaxed);
   }
   if (detail::sBufferSize == 0) {
     return;
   }
+  const auto start = std::chrono::steady_clock::now();
+  const uint32_t bytes = detail::sBufferSize;
   process(detail::sBufferData, detail::sBufferSize, true);
   detail::sBufferSize = 0;
+  sDrainProcessNs.fetch_add(static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now() - start).count()),
+                            std::memory_order_relaxed);
+  sDrainBytes.fetch_add(bytes, std::memory_order_relaxed);
+  sDrainCount.fetch_add(1, std::memory_order_relaxed);
 }
 
 const uint8_t* get_buffer_data() { return detail::sBufferData; }
-uint32_t get_buffer_size() { return detail::sBufferSize; }
+uint32_t get_buffer_size() { return worker::on_worker() ? 0u : detail::sBufferSize; }
 void clear_buffer() {
   detail::sBufferSize = 0;
 }
 
 } // namespace aurora::gx::fifo
+
+// out: [0]=wait ns, [1]=process ns, [2]=bytes, [3]=drains (cumulative).
+extern "C" void aurora_switch_fifo_counters(uint64_t* out) {
+  using namespace aurora::gx::fifo;
+  out[0] = sDrainWaitNs.load(std::memory_order_relaxed);
+  out[1] = sDrainProcessNs.load(std::memory_order_relaxed);
+  out[2] = sDrainBytes.load(std::memory_order_relaxed);
+  out[3] = sDrainCount.load(std::memory_order_relaxed);
+}
