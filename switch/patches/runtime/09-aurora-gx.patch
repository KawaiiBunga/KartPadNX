+  if (auto it = s_tlutObjectCaches.find(tlutObjId); it != s_tlutObjectCaches.end()) {
+    it->second.staticTextureUsers.erase(texObjId);
+    if (!it->second.tlutTexture.handle && it->second.dynamicPaletteTextures.empty() &&
