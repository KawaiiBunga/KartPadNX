+void ServiceGuestTimingDuringAuroraFrameWait() {
+    // Guest interrupt delivery: only when Aurora blocks the guest thread itself. On the GX HLE
+    // thread the guest thread keeps running and services its own timers.
+    if (GxHle::OnHleThread()) {
+        return;
+    }
+    // Aurora can block inside FIFO drains before control returns to GX HLE, for as long as a
+    // whole display period. Keep VI retraces, alarms and audio moving at wall-clock cadence here
+    // while still suppressing guest rescheduling and recursive Aurora work.
+    // Time spent here per second is a proxy for how long Aurora blocks waiting on the render
+    // worker / GPU (a GPU/submission-bound indicator; see docs/AUDIO-PERF-PLAN.md Part 0).
+    const auto waitStart = std::chrono::steady_clock::now();
+    VI_HLE_ProcessRetracesDeferred(8);
+    OS_HLE_ProcessAlarmsDeferred(8);
+    Audio_HLE_PollDeferred();
+    PerfDiag::NoteFrameWorkerWaitMicros(static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now() - waitStart)
+            .count()));
+}
