+        }
+        ImGui::EndMenu();
+    }
+
+    if (ImGui::BeginMenu("Graphics")) {
+        DrawGraphicsSettings();
+        ImGui::EndMenu();
+    }
+
+    if (ImGui::BeginMenu("Controller settings")) {
+        DrawControllerSettings();
+        ImGui::EndMenu();
