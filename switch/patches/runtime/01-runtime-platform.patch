+// GXRenderModeObj::viTVmode encodes the output family (0 NTSC, 1 PAL, 2 MPAL,
+// 5 EURGB60) in bits [4:2].
+uint32_t ExtractTvFormat(uint32_t tvMode) {
+    return (tvMode >> 2) & 0x7;
