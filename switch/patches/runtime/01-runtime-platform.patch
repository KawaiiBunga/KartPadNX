+void EnsureInitializedLocked() {
+    if (g_vi.initialized) {
+        return;
+    }
+    g_vi.initialized = true;
+    g_vi.retraceInterval = IntervalForFormat(g_vi.tvFormat);
+    g_vi.lastRetrace = Clock::now();
+    WriteGuestStateLocked();
