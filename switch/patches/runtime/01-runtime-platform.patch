+// The one resolver for configured paths. A relative value means the same thing
+// everywhere it can be configured: relative to the config file that named it,
+// never to the process working directory (docs/WHEELWIZARD_CONTRACT.md).
+#if defined(__SWITCH__)
+// libnx devoptab paths ("sdmc:/...", "romfs:/...", "save:/...") are absolute but
+// carry no POSIX root, so std::filesystem::path::is_relative() reports them
+// relative. Base-joining one then doubles the mount prefix
+// (sdmc:/switch/kartpad/sdmc:/switch/kartpad/NAND), which is a real directory to
+// nobody. Recognize a leading "<device>:/" (a mount name, then ":/", with no
+// separator before the colon) as an absolute path to leave untouched.
+inline bool HasDevoptabRoot(const std::string& value) {
+    const auto colon = value.find(':');
+    if (colon == std::string::npos || colon == 0) {
+        return false;
+    }
+    if (colon + 1 >= value.size() || value[colon + 1] != '/') {
+        return false;
+    }
+    return value.find_first_of("/\\") > colon;  // colon precedes any separator
+}
+#endif
+
+inline std::filesystem::path ResolveRelativeTo(const std::filesystem::path& base,
+                                               const std::string& value) {
+    std::filesystem::path path(value);
+#if defined(__SWITCH__)
+    if (HasDevoptabRoot(value)) {
+        return path.lexically_normal();
+    }
+#endif
+    if (path.is_relative()) {
+        path = base / path;
+    }
+    return path.lexically_normal();
+}
+
+inline std::filesystem::path ResolveRelativeToConfig(const std::string& value) {
+    return ResolveRelativeTo(ResolveConfigPath().parent_path(), value);
+}
+
+// The extracted DATA directory. Empty when nothing is configured.
+inline std::filesystem::path ResolvedDvdRoot() {
+    const std::string configured = DvdRoot();
+#if defined(__SWITCH__)
+    // Default to the standalone extractor's output when Config.toml names no
+    // dvd_root. Matches switch/src/runtime_host_switch.cpp (kDataDir) and the
+    // disc-extractor front end.
+    if (configured.empty()) {
+        return std::filesystem::path("sdmc:/switch/kartpad/data");
+    }
+#endif
+    return configured.empty() ? std::filesystem::path{} : ResolveRelativeToConfig(configured);
+}
