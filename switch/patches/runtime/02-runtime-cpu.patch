+#endif
+
+// The memo-miss paths of InvokeIndirectCpu/Jump. The indirect-call profiler and the EABI check
+// run here: while either is on, no memo entry has a fast entry (FastEntriesAllowed), so every
+// indirect call arrives here, and the inline fast path at ~14k call sites carries no check.
+MKW_PPC_NO_INLINE inline void InvokeIndirectCpuSlow(uint32_t target, CpuContext* ctx) {
+#if defined(__SWITCH__)
+    if (const int flags = kartpad_indirect_profile_enabled.load(std::memory_order_relaxed); flags != 0) [[unlikely]] {
+        if ((flags & 2) != 0) {
+            InvokeIndirectCpuEabiChecked(target, ctx);
+            return;
+        }
+        if ((++g_indirectProfileSampleCounter & 127u) == 0u)
+            kartpad_indirect_profile_record(ctx ? ctx->lr : 0u, target);
+    }
+#endif
+    // A target a slot conflict moved to its victim slot: the fast call, as InvokeIndirectCpu's.
+    if (const auto fast = TranslatedFunctionRegistry::PromoteVictim(target);
+        fast != nullptr && ctx != nullptr && TryGetCpuContext() == ctx) {
+        fast(ctx);
+        return;
+    }
+    InvokeIndirectCpuResolve(target, ctx);
+}
+
+MKW_PPC_NO_INLINE inline void InvokeIndirectJumpSlow(uint32_t target, CpuContext* ctx) {
+#if defined(__SWITCH__)
+    if ((kartpad_indirect_profile_enabled.load(std::memory_order_relaxed) & 2) != 0) [[unlikely]] {
+        InvokeIndirectCpuEabiChecked(target, ctx, true);
+        return;
+    }
+#endif
+    if (const auto fast = TranslatedFunctionRegistry::PromoteVictim(target);
+        fast != nullptr && ctx != nullptr && TryGetCpuContext() == ctx) {
+        fast(ctx);
+        return;
+    }
+    InvokeIndirectJumpResolve(target, ctx);
+}
+
+// Every bctrl/bctr. The common case - a memoized plain target called from the context that is
+// already current - is a probe and a direct branch, inlined so each call site gets its own
+// indirect-branch history instead of all ~14k sites sharing one `blr` in a shared dispatcher.
+// Entries are only written after registry publication (FindRawByAddressPtr), and a zeroed
+// entry has no fastEntry, so address 0 and pre-publication calls always take the slow path.
+// Skipped here versus the slow path: ScopedTranslatedExecutionAddress (diagnostic only, already
+// skipped by all static translated calls) and the guards/options IsPlainRawDispatch excludes.
+MKW_PPC_FORCE_INLINE void InvokeIndirectCpu(uint32_t target, CpuContext* ctx) {
+    // The indirect-call profiler and the EABI check (perf.cfg) used to be tested here, a global
+    // load and a branch at every bctrl; they now run in InvokeIndirectCpuSlow, which every call
+    // reaches while one of them is on. These lines keep the body's line offsets, which sample
+    // PGO keys this inlined code by.
+    //
+    //
+    const auto& cached = g_indirectRawDispatchMemo[IndirectDispatchMemoIndex(target)];
+    if (cached.address == target && cached.fastEntry != nullptr && ctx != nullptr &&
+        TryGetCpuContext() == ctx) [[likely]] {
+        cached.fastEntry(ctx);
+        return;
+    }
+    InvokeIndirectCpuSlow(target, ctx);
+}
+
+// The EABI check for tail jumps runs in InvokeIndirectJumpSlow (see InvokeIndirectCpu); the empty
+// macro keeps InvokeIndirectJump's inlined line offsets for sample PGO.
+#define MKW_EABI_VERIFY_JUMP(target, ctx)
+MKW_PPC_FORCE_INLINE void InvokeIndirectJump(uint32_t target, CpuContext* ctx) {
+    MKW_EABI_VERIFY_JUMP(target, ctx) const auto& cached = g_indirectRawDispatchMemo[IndirectDispatchMemoIndex(target)];
+    if (cached.address == target && cached.fastEntry != nullptr && ctx != nullptr &&
+        TryGetCpuContext() == ctx) [[likely]] {
+        cached.fastEntry(ctx);
+        return;
+    }
+    InvokeIndirectJumpSlow(target, ctx);
+}
