+class PpcNonvolatileFprGuard {
+public:
+    explicit PpcNonvolatileFprGuard(CpuContext* cpu, uint32_t mask = kPpcAllNonvolatileFprMask) noexcept
+        : cpu_(cpu), mask_(mask & kPpcAllNonvolatileFprMask) {
+        if (!cpu_ || mask_ == 0) {
+            return;
+        }
+        // The default (unknown writer) mask: one constant-size copy, inline ldp/stp rather than the
+        // variable-length libc memmove below (b72).
+        if (mask_ == kPpcAllNonvolatileFprMask) {
+            firstSlot_ = 0;
+            slotCount_ = 18;
+            std::memcpy(saved_.data(), &cpu_->fpr[14], sizeof(saved_));
+            return;
+        }
+        // Real masks are a single contiguous register run - f14..f31 for the
+        // conservative default and f23..f31 or similar for a measured writer -
+        // so resolve the run once and copy it as one straight-line block instead
+        // of testing 18 mask bits. Any other mask keeps the per-bit loop, which
+        // saves and restores exactly the same registers.
+        const uint32_t lowest = mask_ & (0u - mask_);
+        const uint32_t aboveRun = mask_ + lowest;
+        if ((aboveRun & (aboveRun - 1u)) == 0u) {
+            const unsigned first = PpcLowestSetBitIndex(mask_);
+            const unsigned end = aboveRun == 0u ? 32u : PpcLowestSetBitIndex(aboveRun);
+            firstSlot_ = static_cast<uint8_t>(first - 14u);
+            slotCount_ = static_cast<uint8_t>(end - first);
+            std::memcpy(&saved_[firstSlot_], &cpu_->fpr[first], slotCount_ * sizeof(PPC_FPR));
+            return;
+        }
+        for (size_t i = 0; i < saved_.size(); ++i) {
+            if ((mask_ & (1u << (14 + i))) == 0) {
+                continue;
+            }
+            saved_[i] = cpu_->fpr[14 + i];
+        }
+    }
+
+    ~PpcNonvolatileFprGuard() noexcept {
+        if (!cpu_ || mask_ == 0) {
+            return;
+        }
+        if (slotCount_ == 18) {
+            std::memcpy(&cpu_->fpr[14], saved_.data(), sizeof(saved_));
+            return;
+        }
+        if (slotCount_ != 0) {
+            const unsigned first = 14u + firstSlot_;
+            std::memcpy(&cpu_->fpr[first], &saved_[firstSlot_], slotCount_ * sizeof(PPC_FPR));
+            return;
+        }
+        for (size_t i = 0; i < saved_.size(); ++i) {
+            if ((mask_ & (1u << (14 + i))) == 0) {
+                continue;
+            }
+            cpu_->fpr[14 + i] = saved_[i];
+        }
+    }
+
+    PpcNonvolatileFprGuard(const PpcNonvolatileFprGuard&) = delete;
+    PpcNonvolatileFprGuard& operator=(const PpcNonvolatileFprGuard&) = delete;
+
+private:
+    CpuContext* cpu_ = nullptr;
+    uint32_t mask_ = 0;
+    // Contiguous-run description of mask_. slotCount_ == 0 means the mask is not
+    // a single run, so the destructor mirrors the constructor's per-bit loop.
+    uint8_t firstSlot_ = 0;
+    uint8_t slotCount_ = 0;
+    // Every element selected by mask_ is written before it is read. Leaving the
+    // remaining slots uninitialized avoids zero-filling all 18 values around a
+    // call that may preserve only one or two architectural FPRs.
+    std::array<PPC_FPR, 18> saved_;
+};
+
+// PpcNonvolatileFprGuard for a mask known at compile time (statically bound translated
+// callees). The runtime-mask guard's variable-length memcpy is an out-of-line libc call in its
+// destructor; here the run is a constant, so the copy is a few inline q-register moves.
+template <uint32_t Mask>
+class PpcNonvolatileFprGuardStatic {
+    static constexpr uint32_t kMask = Mask & kPpcAllNonvolatileFprMask;
+    static constexpr uint32_t kLowest = kMask & (0u - kMask);
+    static constexpr uint32_t kAbove = kMask + kLowest;
+    static constexpr bool kContiguous = kMask != 0 && (kAbove & (kAbove - 1u)) == 0u;
+    static constexpr unsigned kFirst = kMask != 0 ? static_cast<unsigned>(__builtin_ctz(kMask)) : 14u;
+    static constexpr unsigned kEnd =
+        kContiguous ? (kAbove == 0 ? 32u : static_cast<unsigned>(__builtin_ctz(kAbove))) : 32u;
+    static constexpr unsigned kSlots = kContiguous ? kEnd - kFirst : 18u;
+
+public:
+    MKW_PPC_FORCE_INLINE explicit PpcNonvolatileFprGuardStatic(CpuContext* cpu) noexcept : cpu_(cpu) {
+        if constexpr (kContiguous) {
+            std::memcpy(saved_, &cpu_->fpr[kFirst], sizeof(saved_));
+        } else {
+            for (unsigned i = 0; i < 18; ++i) {
+                if (kMask & (1u << (14 + i))) {
+                    saved_[i] = cpu_->fpr[14 + i];
+                }
+            }
+        }
+    }
+
+    MKW_PPC_FORCE_INLINE ~PpcNonvolatileFprGuardStatic() noexcept {
+        if constexpr (kContiguous) {
+            std::memcpy(&cpu_->fpr[kFirst], saved_, sizeof(saved_));
+        } else {
+            for (unsigned i = 0; i < 18; ++i) {
+                if (kMask & (1u << (14 + i))) {
+                    cpu_->fpr[14 + i] = saved_[i];
+                }
+            }
+        }
+    }
+
+    PpcNonvolatileFprGuardStatic(const PpcNonvolatileFprGuardStatic&) = delete;
+    PpcNonvolatileFprGuardStatic& operator=(const PpcNonvolatileFprGuardStatic&) = delete;
+
+private:
+    CpuContext* cpu_;
+    PPC_FPR saved_[kSlots];
+};
