-    case 0:
-    case 8:
-        blockShiftX = 3;
-        blockShiftY = 3;
-        blockType = 1;
-        break;
-    case 1:
-    case 2:
-    case 9:
-        blockShiftX = 3;
-        blockShiftY = 2;
-        blockType = 2;
-        break;
-    case 3:
-    case 4:
-    case 5:
-    case 10:
-        blockShiftX = 2;
-        blockShiftY = 2;
-        blockType = 2;
-        break;
-    case 6:
-        blockShiftX = 2;
-        blockShiftY = 2;
-        blockType = 3;
-        break;
-    case 14:
-        blockShiftX = 3;
-        blockShiftY = 3;
-        blockType = 0;
-        break;
-    default:
-        blockShiftX = 2;
-        blockShiftY = 2;
-        blockType = 2;
-        break;
-    }
