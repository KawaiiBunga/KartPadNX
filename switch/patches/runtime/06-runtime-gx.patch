new file mode 100644
--- /dev/null
+++ b/runtime/src/hle/gx/gx_hle_thread.cpp
@@ -0,0 +1,597 @@
+// GX HLE thread: ring, thread, waits and counters (contract in gx_hle_thread.h).
+//
+// Built outside the gx_bridge unity group (switch/cmake/FullApp.cmake): it includes <switch.h> for
+// libnx light events, whose u32/s32 typedefs collide with the Dolphin SDK headers that group uses.
+// The ring and wake-up protocol are the b25+ GX decode worker's (aurora-main/lib/gx/gx_worker.cpp,
+// docs/PERF-60FPS-ROADMAP.md finding 13): manual-clear light events, a Dekker handshake on a
+// sleeping flag, and a 10 ms rescue timeout that counts any wake-up the primitive lost.
+#include "gx_hle_thread.h"
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <exception>
+#include <mutex>
+
+#include <pthread.h>
+#if defined(_WIN32)
+#include <malloc.h>  // _aligned_malloc: Windows' C runtime has no aligned_alloc
+#endif
+
+#if defined(__SWITCH__)
+#include <switch.h>
+#endif
+
+extern "C" int kartpad_opt(const char* key, int fallback) __attribute__((weak));
+extern "C" int kartpad_thread_apply(int role, int index) __attribute__((weak));
+// Gather-pipe burst parser (gx_fifo.cpp); on the HLE thread it runs the real parser.
+extern "C" void GX_HLE_FIFO_WriteBurst(const uint8_t* data, uint32_t sizeBytes);
+
+namespace GxHle {
+namespace detail {
+std::atomic<bool> g_active{false};
+__thread uint8_t t_role = 0;
+__thread bool t_inStream = false;
+uint8_t* g_streamCur = nullptr;
+uint8_t* g_streamLimit = nullptr;
+uint64_t g_vertexPayloadBytes = 0;
+uint32_t g_rawSkipBytes = 0;
+bool g_vertexShadowKnown = false;
+} // namespace detail
+
+namespace ring {
+
+using namespace detail;
+
+// 32 MiB holds well over a frame of race traffic (r42: ~0.5 MB of FIFO bytes and ~25k calls a frame).
+constexpr uint64_t kRingBytes = 32ull << 20;
+constexpr uint32_t kAlign = 16;
+constexpr uint32_t kMaxPayload = static_cast<uint32_t>(kRingBytes / 4);
+// Close an open gather-pipe stream at this size or before another record.
+// Closed records publish in bounded batches; sync/frame/space pressure flush partial batches.
+constexpr uint32_t kStreamChunk = 16 * 1024;
+constexpr int kRoleGxHle = 7;  // KARTPAD_ROLE_GX_HLE in switch/src/perf_switch.h
+
+constexpr uint64_t kRescueWaitNs = 10'000'000;  // 10 ms
+constexpr uint64_t kLateSignalNs = 2'000'000;   // 2 ms
+constexpr uint64_t kStallLogNs = 1'000'000'000; // 1 s
+
+enum Kind : uint32_t {
+    kStream = 1,
+    kCall = 2,
+    kWrap = 3,
+};
+
+struct alignas(16) Header {
+    uint32_t kind;
+    uint32_t bytes;
+    CallFn fn;
+};
+static_assert(sizeof(Header) == 16);
+
+uint8_t* g_ring = nullptr;
+alignas(64) std::atomic<uint64_t> g_write{0};  // published by the guest
+alignas(64) std::atomic<uint64_t> g_read{0};   // published by the HLE thread after each record
+alignas(64) uint64_t g_pos = 0;                // guest-private: end of the last closed record
+uint64_t g_knownRead = 0;                      // guest-private: last g_read it loaded
+uint32_t g_publishBatch = 32;
+uint32_t g_closedSincePublish = 0;
+uint64_t g_lastPublishedPos = 0;
+bool g_inlineCapture = true;
+Header* g_open = nullptr;                      // guest-private: open stream record (unpublished)
+uint64_t g_openPos = 0;
+
+alignas(64) std::atomic<bool> g_workerSleeping{false};
+std::atomic<bool> g_producerWaiting{false};
+#if defined(__SWITCH__)
+LEvent g_workerEvent;
+LEvent g_producerEvent;
+#else
+std::mutex g_mutex;
+std::condition_variable g_workerCv;
+std::condition_variable g_producerCv;
+#endif
+
+uint64_t g_framesQueued = 0;                  // guest-private
+std::atomic<uint64_t> g_framesDone{0};         // HLE thread
+uint32_t g_maxFramesAhead = 1;
+
+// Counters. Guest-side ones are single-writer and published with relaxed stores.
+uint64_t g_localRecords = 0;
+uint64_t g_localStreamBytes = 0;
+std::atomic<uint64_t> g_statRecords{0};
+std::atomic<uint64_t> g_statStreamBytes{0};
+std::atomic<uint64_t> g_statSyncs[kSyncReasonCount]{};
+std::atomic<uint64_t> g_statSyncWaitNs{0};
+std::atomic<uint64_t> g_statFullWaitNs{0};
+std::atomic<uint64_t> g_statFrameWaitNs{0};
+std::atomic<uint64_t> g_statBusyNs{0};
+std::atomic<uint64_t> g_statWakes{0};
+std::atomic<uint64_t> g_statRescues{0};
+std::atomic<uint64_t> g_statLate{0};
+std::atomic<uint64_t> g_statExceptions{0};
+
+inline uint64_t NowNs() {
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                     std::chrono::steady_clock::now().time_since_epoch())
+                                     .count());
+}
+
+inline void CpuRelax() {
+#if defined(__aarch64__)
+    __asm__ __volatile__("yield");
+#endif
+}
+
+inline uint32_t RecordBytes(uint32_t payload) {
+    return (static_cast<uint32_t>(sizeof(Header)) + payload + (kAlign - 1)) & ~(kAlign - 1);
+}
+
+inline void Bump(std::atomic<uint64_t>& counter, uint64_t by = 1) {
+    counter.store(counter.load(std::memory_order_relaxed) + by, std::memory_order_relaxed);
+}
+
+void WakeWorker() {
+    if (!g_workerSleeping.load(std::memory_order_seq_cst)) {
+        return;
+    }
+    Bump(g_statWakes);
+#if defined(__SWITCH__)
+    leventSignal(&g_workerEvent);
+#else
+    std::lock_guard lock(g_mutex);
+    g_workerCv.notify_one();
+#endif
+}
+
+void WakeProducer() {
+    if (!g_producerWaiting.load(std::memory_order_seq_cst)) {
+        return;
+    }
+#if defined(__SWITCH__)
+    leventSignal(&g_producerEvent);
+#else
+    std::lock_guard lock(g_mutex);
+    g_producerCv.notify_all();
+#endif
+}
+
+// os_host_thread.cpp: the sound thread may run while the guest core sleeps on the ring.
+extern "C" uint32_t kartpad_guest_wait_begin() __attribute__((weak));
+extern "C" void kartpad_guest_wait_end(uint32_t released) __attribute__((weak));
+
+void NoteTimeoutFoundReady(bool worker, bool late) {
+    if (late) {
+        g_statLate.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    const uint64_t n = g_statRescues.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (n <= 8 || (n & (n - 1)) == 0) {
+        std::fprintf(stderr, "[gx_hle] LOST %s wake-up, rescued by the timeout (#%llu)\n",
+                     worker ? "hle-thread" : "guest", static_cast<unsigned long long>(n));
+    }
+}
+
+// One side's sleep until ready() (Dekker on the side's flag, see gx_worker.cpp).
+template <typename Ready, typename OnTimeout>
+void SleepUntil(bool worker, Ready ready, OnTimeout onTimeout) {
+    std::atomic<bool>& flag = worker ? g_workerSleeping : g_producerWaiting;
+#if defined(__SWITCH__)
+    LEvent* event = worker ? &g_workerEvent : &g_producerEvent;
+    for (;;) {
+        leventClear(event);
+        flag.store(true, std::memory_order_seq_cst);
+        if (ready()) break;
+        if (!leventWait(event, kRescueWaitNs)) {
+            if (ready()) {
+                NoteTimeoutFoundReady(worker, leventWait(event, kLateSignalNs));
+                break;
+            }
+            onTimeout();
+        }
+    }
+#else
+    std::unique_lock lock(g_mutex);
+    std::condition_variable& cv = worker ? g_workerCv : g_producerCv;
+    flag.store(true, std::memory_order_seq_cst);
+    while (!ready()) {
+        if (cv.wait_for(lock, std::chrono::nanoseconds(kRescueWaitNs)) == std::cv_status::timeout) {
+            if (ready()) {
+                NoteTimeoutFoundReady(worker, cv.wait_for(lock, std::chrono::nanoseconds(kLateSignalNs)) ==
+                                                  std::cv_status::no_timeout);
+                break;
+            }
+            onTimeout();
+        }
+    }
+#endif
+    flag.store(false, std::memory_order_relaxed);
+}
+
+template <typename Pred>
+void ProducerWait(const char* what, Pred done) {
+    for (int spin = 0; spin < 4096; ++spin) {
+        if (done()) return;
+        CpuRelax();
+    }
+    const uint64_t start = NowNs();
+    uint64_t nextStallLog = start + kStallLogNs;
+    const uint32_t released = kartpad_guest_wait_begin ? kartpad_guest_wait_begin() : 0;
+    SleepUntil(false, done, [&] {
+        const uint64_t now = NowNs();
+        if (now < nextStallLog) return;
+        nextStallLog = now + 5 * kStallLogNs;
+        std::fprintf(stderr,
+                     "[gx_hle] STALL: guest waiting %.1f s in %s: read=%llu write=%llu pos=%llu frames %llu/%llu "
+                     "hleSleeping=%d rescued=%llu\n",
+                     (now - start) / 1e9, what,
+                     static_cast<unsigned long long>(g_read.load(std::memory_order_relaxed)),
+                     static_cast<unsigned long long>(g_write.load(std::memory_order_relaxed)),
+                     static_cast<unsigned long long>(g_pos),
+                     static_cast<unsigned long long>(g_framesDone.load(std::memory_order_relaxed)),
+                     static_cast<unsigned long long>(g_framesQueued),
+                     g_workerSleeping.load(std::memory_order_relaxed) ? 1 : 0,
+                     static_cast<unsigned long long>(g_statRescues.load(std::memory_order_relaxed)));
+    });
+    if (released != 0) kartpad_guest_wait_end(released);
+}
+
+void Publish();
+
+// Guest: [pos, pos + need) must not overlap anything the HLE thread has yet to read.
+void WaitForSpace(uint64_t pos, uint64_t need) {
+    if (pos + need - g_knownRead <= kRingBytes) {
+        return;
+    }
+    g_knownRead = g_read.load(std::memory_order_acquire);
+    if (pos + need - g_knownRead <= kRingBytes) {
+        return;
+    }
+    const uint64_t start = NowNs();
+    // A partial producer batch must reach the consumer before waiting for space.
+    Publish();
+    WakeWorker();
+    ProducerWait("ring-full", [&] {
+        g_knownRead = g_read.load(std::memory_order_seq_cst);
+        return pos + need - g_knownRead <= kRingBytes;
+    });
+    Bump(g_statFullWaitNs, NowNs() - start);
+}
+
+void Publish() {
+    if (g_closedSincePublish == 0) return;
+    // seq_cst pairs with the HLE thread's sleeping-flag store (Dekker), so no wake-up is lost.
+    g_write.store(g_pos, std::memory_order_seq_cst);
+    g_statRecords.store(g_localRecords, std::memory_order_relaxed);
+    g_closedSincePublish = 0;
+    g_lastPublishedPos = g_pos;
+    WakeWorker();
+}
+
+void RecordClosed() {
+    ++g_localRecords;
+    // Keep ordering, but pay the publication fence/wake check once per batch.
+    // Large captures publish promptly even when the record threshold is not met.
+    if (++g_closedSincePublish >= g_publishBatch || g_pos - g_lastPublishedPos >= 64u * 1024u)
+        Publish();
+}
+
+// Frequent POD captures have these exact byte lengths. Constant-size copies
+// become scalar/vector moves on A57, avoiding a variable-size libc call. Never
+// read capture padding or write beyond its length; unusual sizes use memcpy.
+inline void CopyCallPayload(void* out, const void* in, uint32_t size) {
+    if (g_inlineCapture) {
+#define GX_CAPTURE_COPY(N) case N: std::memcpy(out, in, N); return
+        switch (size) {
+            GX_CAPTURE_COPY(1); GX_CAPTURE_COPY(4); GX_CAPTURE_COPY(8);
+            GX_CAPTURE_COPY(12); GX_CAPTURE_COPY(16); GX_CAPTURE_COPY(20);
+            GX_CAPTURE_COPY(24); GX_CAPTURE_COPY(28); GX_CAPTURE_COPY(32);
+            GX_CAPTURE_COPY(48); GX_CAPTURE_COPY(64);
+            default: break;
+        }
+#undef GX_CAPTURE_COPY
+    }
+    if (size) std::memcpy(out, in, size);
+}
+
+// Guest: pads to the ring start with a wrap marker when `bytes` would straddle the end; returns
+// the ring position where a record of `bytes` may start.
+uint64_t ReserveContiguous(uint64_t pos, uint64_t bytes) {
+    const uint64_t slot = pos % kRingBytes;
+    const uint64_t tail = kRingBytes - slot;
+    if (tail >= bytes) {
+        WaitForSpace(pos, bytes);
+        return pos;
+    }
+    WaitForSpace(pos, tail + bytes);
+    auto* wrap = reinterpret_cast<Header*>(g_ring + slot);
+    wrap->kind = kWrap;
+    wrap->bytes = static_cast<uint32_t>(tail - sizeof(Header));
+    wrap->fn = nullptr;
+    return pos + tail;
+}
+
+void CloseStream() {
+    if (g_open == nullptr) {
+        return;
+    }
+    const auto bytes = static_cast<uint32_t>(g_streamCur - reinterpret_cast<uint8_t*>(g_open + 1));
+    Header* open = g_open;
+    g_open = nullptr;
+    g_streamCur = nullptr;
+    g_streamLimit = nullptr;
+    if (bytes == 0) {
+        return;  // nothing written: the reserved space is simply reused
+    }
+    open->kind = kStream;
+    open->bytes = bytes;
+    open->fn = nullptr;
+    g_localStreamBytes += bytes;
+    g_statStreamBytes.store(g_localStreamBytes, std::memory_order_relaxed);
+    g_pos = g_openPos + RecordBytes(bytes);
+    RecordClosed();
+}
+
+void OpenStream() {
+    // AppendStream/U8/U16/U32 already forgot the shadow before any byte
+    // outside a proven immediate vertex payload. Ring chunk boundaries do
+    // not themselves change the vertex layout.
+    const uint64_t want = sizeof(Header) + kStreamChunk;
+    const uint64_t pos = ReserveContiguous(g_pos, want);
+    if (pos != g_pos) {
+        g_pos = pos;  // the wrap marker before it is published with the stream
+    }
+    g_open = reinterpret_cast<Header*>(g_ring + (pos % kRingBytes));
+    g_openPos = pos;
+    g_streamCur = reinterpret_cast<uint8_t*>(g_open + 1);
+    g_streamLimit = g_streamCur + kStreamChunk;
+}
+
+void Execute(const Header& header, const uint8_t* payload) {
+    t_inStream = header.kind == kStream;
+    try {
+        if (header.kind == kStream) {
+            GX_HLE_FIFO_WriteBurst(payload, header.bytes);
+        } else if (header.kind == kCall) {
+            header.fn(payload);
+        }
+    } catch (const std::exception& e) {
+        if (g_statExceptions.fetch_add(1, std::memory_order_relaxed) < 16) {
+            std::fprintf(stderr, "[gx_hle] record kind %u threw: %s\n", header.kind, e.what());
+        }
+    } catch (...) {
+        if (g_statExceptions.fetch_add(1, std::memory_order_relaxed) < 16) {
+            std::fprintf(stderr, "[gx_hle] record kind %u threw a non-std exception\n", header.kind);
+        }
+    }
+    t_inStream = false;
+}
+
+// The ring is cache-line aligned. Windows' C runtime has no aligned_alloc.
+static void* RingAlloc(size_t bytes) {
+#if defined(_WIN32)
+    return _aligned_malloc(bytes, 64);
+#else
+    return std::aligned_alloc(64, bytes);
+#endif
+}
+
+static void RingFree(void* ring) {
+#if defined(_WIN32)
+    _aligned_free(ring);
+#else
+    std::free(ring);
+#endif
+}
+
+void* WorkerMain(void*) {
+    if (kartpad_thread_apply) kartpad_thread_apply(kRoleGxHle, 0);
+    t_role = 2;
+    uint64_t read = 0;
+    uint64_t busyNs = 0;
+    // 1 restores per-record retirement for on-console A/B testing.
+    const uint32_t retireBatch = static_cast<uint32_t>(std::clamp(
+        kartpad_opt ? kartpad_opt("gxh_retire_batch", 32) : 32, 1, 64));
+    for (;;) {
+        uint64_t write = g_write.load(std::memory_order_acquire);
+        if (read == write) {
+            // GX calls arrive in bursts through the guest's draw phase; spin briefly before paying
+            // a sleep/wake round trip.
+            for (int spin = 0; spin < 2048 && read == write; ++spin) {
+                CpuRelax();
+                write = g_write.load(std::memory_order_acquire);
+            }
+            if (read == write) {
+                SleepUntil(true, [&] { return g_write.load(std::memory_order_seq_cst) != read; }, [] {});
+                continue;
+            }
+        }
+        const uint64_t start = NowNs();
+        uint32_t retired = 0;
+        while (read != write) {
+            const auto* header = reinterpret_cast<const Header*>(g_ring + (read % kRingBytes));
+            if (header->kind == kWrap) {
+                read += sizeof(Header) + header->bytes;
+            } else {
+                Execute(*header, reinterpret_cast<const uint8_t*>(header) + sizeof(Header));
+                read += RecordBytes(header->bytes);
+            }
+            if (++retired == retireBatch || read == write) {
+                g_read.store(read, std::memory_order_seq_cst);
+                WakeProducer();
+                retired = 0;
+            }
+        }
+        busyNs += NowNs() - start;
+        g_statBusyNs.store(busyNs, std::memory_order_relaxed);
+    }
+    return nullptr;
+}
+
+} // namespace ring
+
+namespace detail {
+
+void AppendStreamSlow(const void* data, uint32_t bytes) {
+    using namespace ring;
+    const auto* src = static_cast<const uint8_t*>(data);
+    while (bytes != 0) {
+        if (g_open == nullptr || g_streamCur == g_streamLimit) {
+            CloseStream();
+            OpenStream();
+        }
+        const uint32_t chunk = std::min<uint32_t>(bytes, static_cast<uint32_t>(g_streamLimit - g_streamCur));
+        std::memcpy(g_streamCur, src, chunk);
+        g_streamCur += chunk;
+        src += chunk;
+        bytes -= chunk;
+    }
+}
+
+void SubmitCall(CallFn fn, const void* payload, uint32_t payloadBytes) {
+    using namespace ring;
+    if (payloadBytes > kMaxPayload) {
+        std::fprintf(stderr, "[gx_hle] closure payload %u bytes too large; dropped\n", payloadBytes);
+        return;
+    }
+    CloseStream();
+    const uint32_t bytes = RecordBytes(payloadBytes);
+    const uint64_t pos = ReserveContiguous(g_pos, bytes);
+    auto* header = reinterpret_cast<Header*>(g_ring + (pos % kRingBytes));
+    header->kind = kCall;
+    header->bytes = payloadBytes;
+    header->fn = fn;
+    CopyCallPayload(header + 1, payload, payloadBytes);
+    g_pos = pos + bytes;
+    RecordClosed();
+}
+
+} // namespace detail
+
+bool IsCaughtUp() noexcept {
+    using namespace ring;
+    return !Deferring() || (g_open == nullptr && g_read.load(std::memory_order_acquire) >= g_pos);
+}
+
+void Sync(SyncReason reason) noexcept {
+    using namespace ring;
+    if (!Deferring()) {
+        return;
+    }
+    CloseStream();
+    Publish();
+    Bump(g_statSyncs[reason < kSyncReasonCount ? reason : kSyncOther]);
+    const uint64_t target = g_pos;
+    if (g_read.load(std::memory_order_acquire) >= target) {
+        return;
+    }
+    const uint64_t start = NowNs();
+    WakeWorker();
+    ProducerWait("sync", [&] { return g_read.load(std::memory_order_seq_cst) >= target; });
+    Bump(g_statSyncWaitNs, NowNs() - start);
+}
+
+void NoteFramePresented() {
+    using namespace ring;
+    if (!Deferring()) {
+        return;
+    }
+    const uint64_t queued = ++g_framesQueued;
+    Submit([queued]() { g_framesDone.store(queued, std::memory_order_release); });
+    // Includes the presentation marker, even on the first frame with no wait.
+    Publish();
+    if (queued <= g_maxFramesAhead) {
+        return;
+    }
+    const uint64_t need = queued - g_maxFramesAhead;
+    if (g_framesDone.load(std::memory_order_acquire) >= need) {
+        return;
+    }
+    const uint64_t start = NowNs();
+    WakeWorker();
+    ProducerWait("frame", [&] { return g_framesDone.load(std::memory_order_seq_cst) >= need; });
+    Bump(g_statFrameWaitNs, NowNs() - start);
+}
+
+void StartIfConfigured() {
+    using namespace ring;
+    if (g_active.load(std::memory_order_relaxed)) {
+        return;
+    }
+    const int enabled = kartpad_opt ? kartpad_opt("gx_hle_thread", 1) : 0;
+    if (enabled == 0) {
+        return;
+    }
+    const int ahead = kartpad_opt ? kartpad_opt("gx_hle_frames", 1) : 1;
+    g_maxFramesAhead = static_cast<uint32_t>(std::clamp(ahead, 1, 3));
+    g_publishBatch = static_cast<uint32_t>(std::clamp(
+        kartpad_opt ? kartpad_opt("gxh_publish_batch", 32) : 32, 1, 64));
+    g_inlineCapture = !kartpad_opt || kartpad_opt("gxh_inline_capture", 1) != 0;
+#if defined(__SWITCH__)
+    leventInit(&g_workerEvent, false, false);    // manual clear: see gx_worker.cpp
+    leventInit(&g_producerEvent, false, false);
+#endif
+    g_ring = static_cast<uint8_t*>(RingAlloc(kRingBytes));
+    if (g_ring == nullptr) {
+        std::fprintf(stderr, "[gx_hle] ring allocation failed; GX HLE stays on the guest thread\n");
+        return;
+    }
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, 1u << 20);  // display-list and frame paths, ImGui
+    pthread_t thread;
+    const int rc = pthread_create(&thread, &attr, WorkerMain, nullptr);
+    pthread_attr_destroy(&attr);
+    if (rc != 0) {
+        RingFree(g_ring);
+        g_ring = nullptr;
+        std::fprintf(stderr, "[gx_hle] thread creation failed (%d); GX HLE stays on the guest thread\n", rc);
+        return;
+    }
+    t_role = 1;  // the calling (guest) thread is the ring's only producer
+    g_active.store(true, std::memory_order_release);
+    std::fprintf(stderr, "[gx_hle] GX HLE thread started (%llu MiB ring, stream chunk %u KiB, frames ahead %u, publish batch %u, inline capture %u)\n",
+                 static_cast<unsigned long long>(kRingBytes >> 20), kStreamChunk / 1024, g_maxFramesAhead, g_publishBatch, unsigned(g_inlineCapture));
+}
+
+void Quiesce() noexcept {
+    if (!Deferring()) {
+        return;
+    }
+    Sync(kSyncOther);
+    detail::g_active.store(false, std::memory_order_release);
+}
+
+} // namespace GxHle
+
+// out: [0]=records [1]=stream bytes [2]=sync wait ns [3]=ring-full wait ns [4]=frame wait ns
+//      [5]=HLE busy ns [6]=active [7]=wakes [8]=rescued [9]=late [10]=exceptions
+//      [11..16]=syncs by reason (drawdone, displaylist, fifoobj, vtxgetter, texgetter, other)
+//      [17..23]=vertex-layout tracking and ef SetupGP strips (see kartpad_vtx_track_counters)
+// Guest-side vertex-layout tracking counters (gx_vertex.cpp; absent in the ring test).
+extern "C" void kartpad_vtx_track_counters(uint64_t* out) __attribute__((weak));
+
+extern "C" void kartpad_gx_hle_counters(uint64_t* out) {
+    using namespace GxHle;
+    using namespace GxHle::ring;
+    out[0] = g_statRecords.load(std::memory_order_relaxed);
+    out[1] = g_statStreamBytes.load(std::memory_order_relaxed);
+    out[2] = g_statSyncWaitNs.load(std::memory_order_relaxed);
+    out[3] = g_statFullWaitNs.load(std::memory_order_relaxed);
+    out[4] = g_statFrameWaitNs.load(std::memory_order_relaxed);
+    out[5] = g_statBusyNs.load(std::memory_order_relaxed);
+    out[6] = detail::g_active.load(std::memory_order_relaxed) ? 1 : 0;
+    out[7] = g_statWakes.load(std::memory_order_relaxed);
+    out[8] = g_statRescues.load(std::memory_order_relaxed);
+    out[9] = g_statLate.load(std::memory_order_relaxed);
+    out[10] = g_statExceptions.load(std::memory_order_relaxed);
+    for (uint32_t i = 0; i < kSyncReasonCount; ++i) {
+        out[11 + i] = g_statSyncs[i].load(std::memory_order_relaxed);
+    }
+    // [17..23]: display lists followed / forgotten, raw commands followed, raw bytes that forgot
+    // the shadow (unfollowable / no known boundary), draw lists answered from the walk cache, ef
+    // SetupGP strips written by this thread.
+    if (kartpad_vtx_track_counters) kartpad_vtx_track_counters(out + 17);
+}
