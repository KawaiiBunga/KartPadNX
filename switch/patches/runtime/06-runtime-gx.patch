-    case GX_TF_I8:
-    case GX_TF_IA4:
-    case GX_TF_IA8:
-    case GX_TF_C4:
-    case GX_TF_C8:
-    case GX_TF_C14X2:
-    case GX_TF_RGB565:
-    case GX_TF_RGB5A3:
-    case GX_TF_Z8:
-    case GX_TF_Z16:
-    case GX_TF_Z24X8:
-    case GX_TF_RGBA8:
-    case GX_CTF_YUVA8:
-    case GX_TF_CMPR:
-        return true;
-    default:
-        return false;
-    }
