+// ============================================================================
+// Texture Object Getters
+// ============================================================================
+// perf.cfg `gxh_tex_getter_direct` (default 1). Both getters drained the whole GX HLE queue first
+// (b61 race: ~40 drains/s from nw4r::lyt::TexMap::Set, nw4r::g3d::ApplyTexPatAnmResult and
+// EGG::G3DUtility::SetMaterialTexObj). Real GX decodes the guest GXTexObj words, and the guest
+// thread writes those at call time (GXInitTexObj*, or the game's own stores and copies), so the
+// guest thread now decodes them itself when they describe a usable texture. The first 256 answers
+// of each getter, and every 64th after that, are also taken the old way (drain + cache) and
+// compared; a mismatch logs once and returns that getter to the drain for good, answering the
+// drained value. Mode 2 compares every answer.
+namespace {
+struct DirectTexGetter {
+    const char* name;
+    std::atomic<bool> off{false};
+    uint32_t calls = 0;  // guest thread only
+};
+DirectTexGetter g_directTexAll{"GXGetTexObjAll"};
+DirectTexGetter g_directTexLod{"GXGetTexObjLODAll"};
+
+// Guest thread: `meta` decoded from guest memory when this getter may answer from it; `verify`
+// asks the caller to drain and compare as well.
+bool DirectTexObjMeta(DirectTexGetter& getter, uint32_t oa, TexObjMeta& meta, bool& verify) {
+    static const int mode = kartpad_opt != nullptr ? kartpad_opt("gxh_tex_getter_direct", 1) : 0;
+    if (mode == 0 || !GxHle::Deferring() || getter.off.load(std::memory_order_relaxed)) return false;
+    meta = ExtractTexObjMetaFromGuest(oa);
+    if (meta.dataAddr == 0 || meta.width == 0 || meta.height == 0 || !IsKnownTexFormat(meta.format)) {
+        return false;
+    }
+    ++getter.calls;
+    verify = mode >= 2 || getter.calls <= 256u || (getter.calls & 63u) == 0;
+    return true;
+}
+
+void TurnDirectTexGetterOff(DirectTexGetter& getter, uint32_t oa) {
+    if (!getter.off.exchange(true, std::memory_order_relaxed)) {
+        std::fprintf(stderr, "[gx_hle] %s: guest decode of GXTexObj @0x%08X differs from the HLE cache; "
+                     "draining for every call from now on\n", getter.name, oa);
+    }
+}
