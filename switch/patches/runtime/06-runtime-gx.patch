+extern "C" int kartpad_opt(const char* key, int fallback) __attribute__((weak));
+
+// gx_diag: guest ranges written by recent EFB->texture copies (HLE thread only).
+std::vector<GxDiagCopyRange> g_gxDiagCopyRanges;
+
+extern "C" void GX__CopyTex_8016fd74(uint32_t da, uint32_t c) { GX_HLE_DEFER(GX__CopyTex_8016fd74, da, c);
+    // perf.cfg `gx_diag 1`: log each distinct EFB->texture copy (source rect, size, format, dest).
+    static const bool diag = kartpad_opt != nullptr && kartpad_opt("gx_diag", 0) != 0;
+    if (diag) {
+        {
+            const uint32_t w = g_texCopyState.dstWidth, h = g_texCopyState.dstHeight;
+            const uint32_t bpp = (g_texCopyState.dstFormat == 0x6 || g_texCopyState.dstFormat == 0x16) ? 4u : 2u;
+            auto it = std::find_if(g_gxDiagCopyRanges.begin(), g_gxDiagCopyRanges.end(),
+                                   [&](const GxDiagCopyRange& r) { return r.addr == (da & 0x1FFFFFFFu); });
+            const GxDiagCopyRange range{da & 0x1FFFFFFFu, w * h * bpp, g_texCopyState.dstFormat, w, h};
+            if (it != g_gxDiagCopyRanges.end()) *it = range;
+            else if (g_gxDiagCopyRanges.size() < 256) g_gxDiagCopyRanges.push_back(range);
+            static uint32_t fullCopies = 0, copies = 0;
+            static auto windowStart = std::chrono::steady_clock::now();
+            ++copies;
+            if (w >= 600 && h >= 400) ++fullCopies;
+            const auto now = std::chrono::steady_clock::now();
+            if (now - windowStart >= std::chrono::seconds(1)) {
+                std::fprintf(stderr, "[gx_diag] copies/s=%u fullscreen/s=%u\n", copies, fullCopies);
+                copies = fullCopies = 0;
+                windowStart = now;
+            }
+        }
+        static std::vector<uint64_t> seen;
+        const uint64_t key = (uint64_t(g_texCopyState.srcLeft) << 48) ^ (uint64_t(g_texCopyState.srcTop) << 36) ^
+            (uint64_t(g_texCopyState.srcWidth) << 24) ^ (uint64_t(g_texCopyState.srcHeight) << 12) ^
+            (uint64_t(g_texCopyState.dstFormat) << 4) ^ (c & 1u) ^ (uint64_t(da) << 20);
+        if (seen.size() < 256 && (g_texCopyState.srcWidth > 8 || g_texCopyState.srcHeight > 8) &&
+            std::find(seen.begin(), seen.end(), key) == seen.end()) {
+            seen.push_back(key);
+            std::fprintf(stderr, "[gx_diag] CopyTex src=%u,%u %ux%u dst=%ux%u fmt=0x%x mip=%u clear=%u addr=0x%08x\n",
+                         g_texCopyState.srcLeft, g_texCopyState.srcTop, g_texCopyState.srcWidth,
+                         g_texCopyState.srcHeight, g_texCopyState.dstWidth, g_texCopyState.dstHeight,
+                         g_texCopyState.dstFormat, g_texCopyState.dstMipmap, c & 1u, da);
+        }
+    }
+    EnsureAuroraFrameActive();
+    // Match GX FIFO ordering: texture copies observe all prior draws.
+    GXDrawDone();
+    const uint16_t rawSrcLeft = g_texCopyState.srcLeft;
+    const uint16_t rawSrcTop = g_texCopyState.srcTop;
+    const uint16_t rawSrcWidth = g_texCopyState.srcWidth;
+    const uint16_t rawSrcHeight = g_texCopyState.srcHeight;
+
+    // Keep the source in guest EFB coordinates. Aurora maps it to the scaled
+    // EFB exactly once, matching Dolphin's ConvertEFBRectangle path.
+    GXSetTexCopySrc(rawSrcLeft, rawSrcTop, rawSrcWidth, rawSrcHeight);
+    // EFB copies stay GPU-only except probe-sized ones (e.g. the 4x4 lens-flare depth probe),
+    // which Aurora reads back asynchronously via efb_ram::schedule and land in guest RAM a frame
+    // later. RISK: copies above the probe threshold, or on the offscreen list, are not
+    // auto-downloaded, so guest reads see stale RAM; call aurora_flush_efb_copies_to_ram if a
+    // copy needs reading back.
+    GXCopyTex(GuestToHostPtr(da), (GXBool)c);
+    RememberEfbCopyDestination(
+        da, GXGetTexBufferSize(g_texCopyState.dstWidth, g_texCopyState.dstHeight,
+                               g_texCopyState.dstFormat, GX_FALSE, 0));
+    GXSetTexCopySrc(rawSrcLeft, rawSrcTop, rawSrcWidth, rawSrcHeight);
+}
+PPC_NATIVE_OVERRIDE_VOID(8016fd74, GX__CopyTex_8016fd74, (uint32_t da, uint32_t c), (da, c));
