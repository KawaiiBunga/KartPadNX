+// ============================================================================
+// nw4r::ef::DrawStrategyImpl::SetupGP dummy strip (perf.cfg `gxh_ef_dummy_strip`, default 1)
+// ============================================================================
+// SetupGP (0x8003CB60) is the game's only caller of GXGetVtxDesc / GXGetVtxAttrFmt (checked over
+// every base and Retro Rewind shard). It reads the POS/NRM/TEX0 descriptors and their VTXFMT0
+// formats only to write an 8-vertex all-zero triangle strip in the current layout, a hardware
+// workaround, right after the reads. Answering those reads is why the guest core kept a copy of
+// the HLE thread's vertex layout: the tracker above followed every display list and raw command
+// byte for it, ~4.7% of the b61 race guest core. SetupGP's calls are recognised exactly (attribute
+// and out-pointers at its stack offsets, then GXBegin(GX_TRIANGLESTRIP, GX_VTXFMT0, 8) at the same
+// SP, with its code checked once at 0x8003CC64): the reads answer GX_NONE, so the translated loop
+// writes nothing, and the HLE thread writes the payload SetupGP would have written from its own
+// state right after the begin. The consumer sees the same bytes in the same order. The faked
+// answers only reach SetupGP's dead stack locals and volatile registers.
+namespace {
+constexpr uint32_t kEfDescAttr[3] = {GX_VA_POS, GX_VA_NRM, GX_VA_TEX0};
+constexpr uint32_t kEfDescOut[3] = {36, 24, 12};                    // GXGetVtxDesc type pointers
+constexpr uint32_t kEfFmtOut[3][2] = {{40, 44}, {28, 32}, {16, 20}};  // GXGetVtxAttrFmt cnt/type
+constexpr uint32_t kEfFmtFrac = 8;
+uint32_t g_efSp = 0;    // guest thread only
+uint32_t g_efStep = 0;  // SetupGP reads matched so far (6 = all)
+
+bool EfSetupGpCodeVerified() {
+    // addi r4,r1,36; li r3,9 (first GXGetVtxDesc) and li r3,152; li r4,0; li r5,8 (GXBegin).
+    static const bool ok = [] {
+        uint32_t a = 0, b = 0, c = 0, d = 0, e = 0;
+        const bool read = MemoryInline::TryReadGuestScalar(0x8003CC64u, a) &&
+                          MemoryInline::TryReadGuestScalar(0x8003CC68u, b) &&
+                          MemoryInline::TryReadGuestScalar(0x8003CCD8u, c) &&
+                          MemoryInline::TryReadGuestScalar(0x8003CCDCu, d) &&
+                          MemoryInline::TryReadGuestScalar(0x8003CCE0u, e);
+        const bool match = read && a == 0x38810024u && b == 0x38600009u && c == 0x38600098u &&
+                           d == 0x38800000u && e == 0x38A00008u;
+        std::fprintf(stderr, "[gx_hle] ef SetupGP dummy strip %s\n",
+                     match ? "on: vertex getters answered by the HLE thread"
+                           : "off: SetupGP code not found at 0x8003CC64");
+        return match;
+    }();
+    return ok;
+}
+
+// Guest thread: true when this getter is SetupGP's read number `step` (0-2 descriptors, 3-5
+// formats). The six reads are straight-line code, so a matched first read is always followed by
+// the other five.
+bool EfMatchRead(uint32_t step, uint32_t attr, uint32_t out) {
+    if (!EfDummyStripEnabled() || !GxHle::Deferring()) return false;
+    CpuContext* ctx = TryGetCpuContext();
+    if (ctx == nullptr) return false;
+    const uint32_t sp = ctx->gpr[1];
+    const uint32_t i = step % 3u;
+    const uint32_t expected = step < 3 ? kEfDescOut[i] : kEfFmtOut[i][0];
+    if (attr != kEfDescAttr[i] || out != sp + expected) {
+        g_efStep = 0;
+        return false;
+    }
+    if (step == 0) {
+        if (!EfSetupGpCodeVerified()) return false;
+        g_efSp = sp;
+    } else if (g_efStep != step || g_efSp != sp) {
+        g_efStep = 0;
+        return false;
+    }
+    g_efStep = step + 1;
+    return true;
+}
+
+bool EfMatchDescRead(uint32_t attr, uint32_t tp) {
+    const uint32_t step = g_efStep < 3 ? g_efStep : 0;
+    return EfMatchRead(step, attr, tp);
+}
+
+bool EfMatchFmtRead(uint32_t vf, uint32_t attr, uint32_t cp, uint32_t tp, uint32_t fp) {
+    if (g_efStep < 3 || g_efStep > 5 || vf != 0) {
+        g_efStep = 0;
+        return false;
+    }
+    const uint32_t i = g_efStep - 3;
+    if (tp != g_efSp + kEfFmtOut[i][1] || fp != g_efSp + kEfFmtFrac) {
+        g_efStep = 0;
+        return false;
+    }
+    return EfMatchRead(g_efStep, attr, cp);
+}
+
+// Guest thread, GXBegin: consumes a complete match.
+bool EfMatchBegin(uint32_t t, uint32_t vf, uint32_t nv) {
+    if (g_efStep == 0) return false;
+    const bool all = g_efStep == 6;
+    g_efStep = 0;
+    if (!all || t != GX_TRIANGLESTRIP || vf != GX_VTXFMT0 || nv != 8) return false;
+    CpuContext* ctx = TryGetCpuContext();
+    return ctx != nullptr && ctx->gpr[1] == g_efSp;
+}
+
+// HLE thread: SetupGP's vertex loop on the consumer's own layout. Integer components are 0; float
+// components are the sdata2 constant SetupGP loads (passed as its bits).
+void EmitEfDummyPayload(uint32_t floatBits) {
+    float f;
+    std::memcpy(&f, &floatBits, sizeof(f));
+    const float fz = static_cast<float>(static_cast<double>(f));  // SetupGP goes through an FPR
+    auto comps = [fz](uint32_t type, uint32_t n) {
+        for (uint32_t k = 0; k < n; ++k) {
+            if (type <= GX_S8) GX_HLE_FIFO_Write8(0);
+            else if (type <= GX_S16) GX_HLE_FIFO_Write16(0);
+            else if (type == GX_F32) GX_HLE_FIFO_WriteFloat(fz);
+        }
+    };
+    auto index = [](uint32_t desc) {
+        if (desc == GX_INDEX8) GX_HLE_FIFO_Write8(0);
+        else if (desc == GX_INDEX16) GX_HLE_FIFO_Write16(0);
+    };
+    const uint32_t pos = g_hleGxState.vtxDesc[GX_VA_POS];
+    const uint32_t nrm = g_hleGxState.vtxDesc[GX_VA_NRM];
+    const uint32_t tex = g_hleGxState.vtxDesc[GX_VA_TEX0];
+    const VtxAttrFmt pf = g_hleGxState.vtxAttrFmt[GX_VTXFMT0][GX_VA_POS];
+    const VtxAttrFmt nf = g_hleGxState.vtxAttrFmt[GX_VTXFMT0][GX_VA_NRM];
+    const VtxAttrFmt tf = g_hleGxState.vtxAttrFmt[GX_VTXFMT0][GX_VA_TEX0];
+    const uint32_t pcnt = pf.cnt, ptype = pf.type, ncnt = nf.cnt, ntype = nf.type;
+    const uint32_t tcnt = tf.cnt, ttype = tf.type;
+    for (int v = 0; v < 8; ++v) {
+        if (pos == GX_DIRECT) {
+            if ((pcnt == GX_POS_XYZ || pcnt == GX_POS_XY) && ptype <= GX_F32)
+                comps(ptype, pcnt == GX_POS_XYZ ? 3u : 2u);
+        } else {
+            index(pos);
+        }
+        if (nrm == GX_DIRECT) {
+            // SetupGP writes direct normals only as NRM_XYZ in S8, S16 or F32.
+            if (ncnt == GX_NRM_XYZ && (ntype == GX_S8 || ntype == GX_S16 || ntype == GX_F32))
+                comps(ntype, 3u);
+        } else {
+            index(nrm);
+        }
+        if (tex == GX_DIRECT) {
+            if ((tcnt == GX_TEX_ST || tcnt == GX_TEX_S) && ttype <= GX_F32)
+                comps(ttype, tcnt == GX_TEX_ST ? 2u : 1u);
+        } else {
+            index(tex);
+        }
+    }
+}
