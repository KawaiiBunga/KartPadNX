diff --git a/runtime/include/gx_hle_thread.h b/runtime/include/gx_hle_thread.h
new file mode 100644
--- /dev/null
+++ b/runtime/include/gx_hle_thread.h
@@ -0,0 +1,216 @@
+#pragma once
+
+// GX HLE thread (perf.cfg `gx_hle_thread`, default 1): Dolphin dual-core for the whole GX HLE layer.
+//
+// Without it the guest thread runs every GX HLE call itself: gather-pipe parsing, display-list scan
+// and array resolution, texture objects, the Aurora front end. r42 (b43): 23% of the guest thread
+// sat under those entry points while three other cores were mostly idle. With it the guest thread
+// only appends to one ordered ring - gather-pipe bytes as a byte stream, every other GX call as a
+// small closure - and this thread runs the HLE layer and owns Aurora's producer side (frame begin,
+// end and present included). The Aurora decode worker then sits behind it, as before.
+//
+// Ordering contract (docs/PERF-60FPS-ROADMAP.md, b44):
+//  - GPU-fetched guest memory (display lists, vertex/matrix arrays, textures, TLUTs) is read when
+//    this thread reaches the command, exactly as the real GPU does; the guest keeps it stable until
+//    its own GPU sync points (GXDrawDone), which wait for this thread AND the Aurora worker.
+//  - Data real GX copies into the FIFO at call time (colors and matrices passed by pointer, light
+//    objects, projection vectors) is read on the guest thread at call time and queued by value.
+//  - Guest-visible CPU-side state (__GXData writes, guest GXTexObj words, getter shadows) is still
+//    written on the guest thread at call time.
+//  - Anything returning HLE-owned state to the guest (vertex-format and texture-object getters,
+//    display-list end, FIFO objects) waits for this thread first (Sync / RunSync).
+//
+// Everything here is a no-op until StartIfConfigured() starts the thread; callers then run inline.
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <type_traits>
+
+namespace GxHle {
+
+enum SyncReason : uint32_t {
+    kSyncDrawDone = 0,
+    kSyncDisplayList,
+    kSyncFifoObj,
+    kSyncVtxGetter,
+    kSyncTexGetter,
+    kSyncOther,
+    kSyncReasonCount,
+};
+
+using CallFn = void (*)(const void* payload);
+
+namespace detail {
+extern std::atomic<bool> g_active;
+// 1 on the guest thread (the ring's single producer, set by StartIfConfigured), 2 on the HLE thread,
+// 0 elsewhere: other threads keep running GX HLE inline exactly as before.
+// __thread, not thread_local: an extern thread_local is read through a TLS wrapper call in every
+// other TU (0.14% of the b56 race guest thread, once per GX entry point via Deferring()).
+extern __thread uint8_t t_role;
+// HLE thread: true while it executes a gather-pipe stream record (vertex-shadow guard).
+extern __thread bool t_inStream;
+// Producer-only cursor into the open gather-pipe stream record (null when none is open).
+extern uint8_t* g_streamCur;
+extern uint8_t* g_streamLimit;
+// Producer-only proof for the raw bytes of an immediate GXBegin payload.
+// A byte beyond this budget may be a CP command and must forget the layout.
+extern uint64_t g_vertexPayloadBytes;
+// Guest thread: data bytes of an XF packet the raw-command tracker still has to pass over
+// (gx_vertex.cpp). Matrix loads arrive one word per append, so this is checked inline.
+extern uint32_t g_rawSkipBytes;
+extern bool g_vertexShadowKnown;
+void SubmitCall(CallFn fn, const void* payload, uint32_t payloadBytes);
+void AppendStreamSlow(const void* data, uint32_t bytes);
+} // namespace detail
+
+// True while the caller must queue GX work instead of running it: the HLE thread runs and the
+// caller is the guest thread.
+inline bool Deferring() noexcept {
+    return detail::g_active.load(std::memory_order_relaxed) && detail::t_role == 1;
+}
+inline bool OnHleThread() noexcept { return detail::t_role == 2; }
+
+// Guest thread, once Aurora is initialized and before the guest runs: starts the thread when
+// perf.cfg enables it. From then on every Aurora producer call must come from the HLE thread.
+void StartIfConfigured();
+
+// Guest thread, before aurora_shutdown(): drains every queued record and stops deferring, so the
+// (now idle) HLE thread never touches Aurora again and later GX calls run inline.
+void Quiesce() noexcept;
+
+// Gather-pipe bytes, in guest (big-endian) byte order.
+void VtxShadowInvalidate() noexcept;
+inline void ObserveStreamBytes(uint32_t bytes) noexcept {
+    if (detail::g_vertexShadowKnown && bytes != 0) {
+        if (bytes <= detail::g_vertexPayloadBytes) detail::g_vertexPayloadBytes -= bytes;
+        else VtxShadowInvalidate();
+    }
+}
+// Guest thread, gx_vertex.cpp (perf.cfg `gxh_vtx_track`): follows raw command bytes beyond the
+// proven payload (CP layout writes, XF/BP packets, sized raw draws) and forgets the shadow only
+// for bytes it cannot follow.
+void VtxShadowObserveCommands(const uint8_t* bytes, uint32_t count) noexcept;
+inline void ObserveStreamData(const void* data, uint32_t bytes) noexcept {
+    if (detail::g_vertexShadowKnown && bytes != 0) {
+        if (bytes <= detail::g_vertexPayloadBytes) detail::g_vertexPayloadBytes -= bytes;
+        else if (detail::g_vertexPayloadBytes == 0 && bytes <= detail::g_rawSkipBytes) detail::g_rawSkipBytes -= bytes;
+        else VtxShadowObserveCommands(static_cast<const uint8_t*>(data), bytes);
+    }
+}
+inline void AppendStream(const void* data, uint32_t bytes) {
+    ObserveStreamData(data, bytes);
+    if (detail::g_streamCur != nullptr &&
+        static_cast<uint32_t>(detail::g_streamLimit - detail::g_streamCur) >= bytes) {
+        std::memcpy(detail::g_streamCur, data, bytes);
+        detail::g_streamCur += bytes;
+        return;
+    }
+    detail::AppendStreamSlow(data, bytes);
+}
+inline void AppendU8(uint8_t v) {
+    ObserveStreamData(&v, 1);
+    if (detail::g_streamCur != nullptr && detail::g_streamCur < detail::g_streamLimit) {
+        *detail::g_streamCur++ = v;
+        return;
+    }
+    detail::AppendStreamSlow(&v, 1);
+}
+inline void AppendU16(uint16_t v) {
+    const uint16_t be = __builtin_bswap16(v);
+    ObserveStreamData(&be, 2);
+    if (detail::g_streamCur != nullptr &&
+        static_cast<uint32_t>(detail::g_streamLimit - detail::g_streamCur) >= 2) {
+        std::memcpy(detail::g_streamCur, &be, 2);
+        detail::g_streamCur += 2;
+        return;
+    }
+    detail::AppendStreamSlow(&be, 2);
+}
+inline void AppendU32(uint32_t v) {
+    const uint32_t be = __builtin_bswap32(v);
+    ObserveStreamData(&be, 4);
+    if (detail::g_streamCur != nullptr &&
+        static_cast<uint32_t>(detail::g_streamLimit - detail::g_streamCur) >= 4) {
+        std::memcpy(detail::g_streamCur, &be, 4);
+        detail::g_streamCur += 4;
+        return;
+    }
+    detail::AppendStreamSlow(&be, 4);
+}
+
+// Queues `f` to run on the HLE thread, in order with the byte stream.
+template <typename F>
+void Submit(const F& f) {
+    static_assert(std::is_trivially_copyable_v<F>, "GX HLE closures must capture PODs by value");
+    static_assert(alignof(F) <= 16, "ring payloads are 16-byte aligned");
+    detail::SubmitCall(
+        [](const void* payload) {
+            alignas(F) unsigned char storage[sizeof(F)];
+            std::memcpy(storage, payload, sizeof(F));
+            (*reinterpret_cast<const F*>(storage))();
+        },
+        &f, static_cast<uint32_t>(sizeof(F)));
+}
+
+// Blocks until the HLE thread has executed everything queued so far.
+void Sync(SyncReason reason) noexcept;
+
+// Guest thread only: acquire completed work without publishing or waiting.
+// An open stream or any queued call makes this false. Useful for diagnostics
+// that can run at a natural drain instead of creating another worker barrier.
+bool IsCaughtUp() noexcept;
+
+// Runs `f` on the HLE thread and waits for it (inline when not deferring).
+// Guest-side vertex-state shadow (gx_vertex.cpp, perf.cfg `gxh_vtx_shadow`): forget it before
+// queueing anything that may change vertex descriptors/formats outside the vertex setters.
+void VtxShadowInvalidate() noexcept;
+
+template <typename F>
+void RunSync(SyncReason reason, const F& f) {
+    if (!Deferring()) {
+        f();
+        return;
+    }
+    VtxShadowInvalidate();
+    Submit(f);
+    Sync(reason);
+}
+
+template <typename R, typename F>
+R RunSyncValue(SyncReason reason, const F& f) {
+    if (!Deferring()) {
+        return f();
+    }
+    R result{};
+    R* out = &result;
+    VtxShadowInvalidate();
+    Submit([out, f]() { *out = f(); });
+    Sync(reason);
+    return result;
+}
+
+// Guest thread, right after it queued a frame's present: waits while the HLE thread is more than
+// perf.cfg `gx_hle_frames` (default 1) whole frames behind.
+void NoteFramePresented();
+
+} // namespace GxHle
+
+// Whole-call deferral for an HLE entry point with no guest-visible effect: queues the same call
+// (which then runs inline on the HLE thread) and returns.
+#define GX_HLE_DEFER(fn, ...)                                                                       \
+    do {                                                                                            \
+        if (::GxHle::Deferring()) {                                                                 \
+            ::GxHle::Submit([=]() { fn(__VA_ARGS__); });                                            \
+            return;                                                                                 \
+        }                                                                                           \
+    } while (0)
+
+// Runs a block on the HLE thread (queued) or inline. Captures by value.
+#define GX_HLE_RUN(...)                                                                             \
+    do {                                                                                            \
+        if (::GxHle::Deferring()) {                                                                 \
+            ::GxHle::Submit([=]() __VA_ARGS__);                                                     \
+        } else                                                                                      \
+            __VA_ARGS__                                                                             \
+    } while (0)
