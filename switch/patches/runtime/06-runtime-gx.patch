+    if (w == 0 || h == 0) {
+        auto* cpu = TryGetCpuContext();
+        RT_LOGF(RT_TAG_GX,
+                "GXInitTexObj zero size oa=0x%08X da=0x%08X w=%u h=%u f=%u ws=%u wt=%u m=%u pc=0x%08X lr=0x%08X\n",
