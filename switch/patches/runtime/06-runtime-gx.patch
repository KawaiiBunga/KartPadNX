+namespace {
+uint32_t CanonicalVtxAttr(uint32_t attr) {
+    return attr == GX_VA_NBT ? GX_VA_NRM : attr;
+}
+
+// There is deliberately no indexed-aurora path here. The immediate begin path
+// streams vertex data incrementally, and aurora's indexed-array upload must
+// precede the draw carrying the max-index bounds, which cannot be known without
+// buffering the whole primitive. Indexed attributes are therefore expanded into
+// the packed direct stream below (GX_INDEX8/16 -> GX_DIRECT).
+void ApplyAuroraVtxStateForBegin(GXVtxFmt fmt) {
+    GxStream::PublishAuroraVtxState(fmt,
+                                    GxStream::AuroraVtxPublishOptions{
+                                        /*includeNbt=*/false,
+                                        /*fmtLoopFirst=*/static_cast<int>(GX_VA_POS),
+                                        /*fmtLoopLast=*/static_cast<int>(GX_VA_TEX7)});
+}
+}
+
+
+// ============================================================================
+// Guest-side vertex-state shadow (perf.cfg `gxh_vtx_shadow`, default 1)
+// ============================================================================
+// With the GX HLE thread on, g_hleGxState belongs to that thread, so GXGetVtxDesc/GXGetVtxAttrFmt
+// had to Sync (drain the whole ring) first. nw4r::ef::DrawStrategyImpl::SetupGP calls GXGetVtxDesc
+// for every emitter it draws: r46 (b47) spent 8.5% of guest-thread race samples waiting there.
+// The guest thread now keeps its own copy, taken right after a Sync and then updated by the
+// vertex setters at call time (the setters are the only writers, in order, on the HLE thread).
+// Any other writer forgets the copy before it is queued: display lists (CP VCD/VAT writes),
+// DrawSphere, every RunSync (display-list begin/end, FIFO objects, GXInit). A vertex-layout
+// change in a raw gather-pipe stream invalidates the copy on the guest thread before the first
+// byte outside a proven immediate vertex payload is queued; the next getter drains and refreshes it.
+// `gxh_vertex_payload_shadow 0` restores unconditional raw-byte invalidation.
+// `gxh_vtx_shadow 2` checks every answer; mode 1
+// schedules a check every 64 getters. With `gxh_vtx_verify_defer` (default 1),
+// known state is verified at a natural queue drain; after 1024 getters without
+// a check, it forces a drain. Unknown state always drains immediately. Mode 2
+// still drains/checks every getter. A mismatch logs once and turns the shadow off.
+extern "C" int kartpad_opt(const char* key, int fallback) __attribute__((weak));
+
+namespace {
+struct VtxShadow {
+    GXAttrType desc[GX_VA_MAX_ATTR];
+    VtxAttrFmt fmt[GX_MAX_VTXFMT][GX_VA_MAX_ATTR];
+};
+static_assert(sizeof(VtxShadow::desc) == sizeof(g_hleGxState.vtxDesc));
+static_assert(sizeof(VtxShadow::fmt) == sizeof(g_hleGxState.vtxAttrFmt));
+
+VtxShadow g_vtxShadow;          // guest thread only
+bool g_vtxShadowValid = false;  // guest thread only
+bool g_vtxDescKnown = false;
+uint32_t g_vtxFmtKnown[GX_MAX_VTXFMT]{};
+uint32_t g_vtxShadowChecks = 0; // guest thread only
+uint32_t g_vtxShadowLastChecked = 0;
+std::atomic<bool> g_vtxShadowOff{false};
+
+// Guest-side CP layout tracking (after GxVtxShadowNoteStreamChange below). The raw gather-pipe
+// parser needs a known consumer packet boundary; these keep it in step with the shadow.
+void VtxTrackRawBoundary(bool lost) noexcept;
+void VtxTrackAfterSync() noexcept;
+
+bool EfDummyStripEnabled() {
+    static const bool on = kartpad_opt != nullptr && kartpad_opt("gxh_ef_dummy_strip", 1) != 0;
+    return on;
+}
+
+int VtxShadowMode() {
+    // gxh_ef_dummy_strip retires the game's only getter caller, so nothing reads the shadow.
+    static const int mode =
+        kartpad_opt != nullptr ? kartpad_opt("gxh_vtx_shadow", EfDummyStripEnabled() ? 0 : 1) : 0;
+    return g_vtxShadowOff.load(std::memory_order_relaxed) ? 0 : mode;
+}
+
+bool SameFmt(const VtxAttrFmt& a, const VtxAttrFmt& b) {
+    return a.cnt == b.cnt && a.type == b.type && a.frac == b.frac;
+}
+
+void TurnVtxShadowOff(const char* why) {
+    if (!g_vtxShadowOff.exchange(true, std::memory_order_relaxed)) {
+        std::fprintf(stderr, "[gx_hle] vtx shadow off: %s\n", why);
+    }
+}
+
+// Guest thread, deferring: makes the shadow equal to the HLE-owned state (or reports that it is
+// off). Returns true when the getter may answer from the shadow.
+bool PrepareVtxShadow(bool formats) {
+    const int mode = VtxShadowMode();
+    if (mode == 0) {
+        GxHle::Sync(GxHle::kSyncVtxGetter);
+        return false;
+    }
+    const bool check = mode >= 2 || (++g_vtxShadowChecks & 63u) == 0 ||
+                       g_vtxShadowChecks - g_vtxShadowLastChecked >= 1024u;
+    const bool known = formats ? g_vtxShadowValid : g_vtxDescKnown;
+    if (known) {
+        if (!check) return true;
+        static const bool defer = kartpad_opt && kartpad_opt("gxh_vtx_verify_defer", 1) != 0;
+        if (mode == 1 && defer && g_vtxShadowChecks - g_vtxShadowLastChecked < 1024u &&
+            !GxHle::IsCaughtUp()) return true;
+    }
+    GxHle::Sync(GxHle::kSyncVtxGetter);
+    VtxTrackAfterSync();
+    g_vtxShadowLastChecked = g_vtxShadowChecks;
+    if (g_vtxDescKnown) {
+        bool same = std::memcmp(g_vtxShadow.desc, g_hleGxState.vtxDesc, sizeof(g_vtxShadow.desc)) == 0;
+        for (int f = 0; same && f < GX_MAX_VTXFMT; ++f) {
+            for (int a = 0; same && a < GX_VA_MAX_ATTR; ++a) {
+                if (g_vtxFmtKnown[f] & (1u << a))
+                    same = SameFmt(g_vtxShadow.fmt[f][a], g_hleGxState.vtxAttrFmt[f][a]);
+            }
+        }
+        if (!same) {
+            TurnVtxShadowOff("verify mismatch (a writer is not tracked)");
+            g_vtxShadowValid = false;
+            g_vtxDescKnown = false;
+            GxHle::detail::g_vertexShadowKnown = false;
+            GxHle::detail::g_vertexPayloadBytes = 0;
+            return false;
+        }
+        // Every field was compared after the acquire/drain. A fully known
+        // shadow already equals the consumer; recopying all eight VAT rows
+        // here merely repeats the same several-kilobyte snapshot.
+        if (g_vtxShadowValid) return true;
+    }
+    if (g_vtxShadowOff.load(std::memory_order_relaxed)) {
+        g_vtxShadowValid = false;
+        g_vtxDescKnown = false;
+        GxHle::detail::g_vertexShadowKnown = false;
+        GxHle::detail::g_vertexPayloadBytes = 0;
+        return false;
+    }
+    std::memcpy(g_vtxShadow.desc, g_hleGxState.vtxDesc, sizeof(g_vtxShadow.desc));
+    std::memcpy(g_vtxShadow.fmt, g_hleGxState.vtxAttrFmt, sizeof(g_vtxShadow.fmt));
+    g_vtxShadowValid = true;
+    g_vtxDescKnown = true;
+    for (auto& mask : g_vtxFmtKnown) mask = (1u << GX_VA_MAX_ATTR) - 1u;
+    GxHle::detail::g_vertexShadowKnown = true;
+    return true;
+}
+
+void ShadowVtxDesc(uint32_t a, uint32_t t) {
+    GxHle::detail::g_vertexPayloadBytes = 0;
+    if (!g_vtxDescKnown) return;
+    const uint32_t sa = CanonicalVtxAttr(a);
+    if (sa < 26 && sa != GX_VA_NULL) {
+        g_vtxShadow.desc[sa] = (GXAttrType)t;
+        if (a == GX_VA_NBT) g_vtxShadow.desc[GX_VA_NBT] = GX_NONE;
+    }
+}
+
+void ShadowVtxFmt(uint32_t vf, uint32_t a, uint32_t c, uint32_t t, uint32_t fr) {
+    GxHle::detail::g_vertexPayloadBytes = 0;
+    if (VtxShadowMode() == 0) return;
+    const uint32_t sa = CanonicalVtxAttr(a);
+    if (vf < 8 && sa < 26) {
+        g_vtxShadow.fmt[vf][sa] = {(GXCompCnt)c, (GXCompType)t, (u8)fr};
+        g_vtxFmtKnown[vf] |= 1u << sa;
+        if (a == GX_VA_NBT) {
+            g_vtxShadow.fmt[vf][GX_VA_NBT] = {};
+            g_vtxFmtKnown[vf] |= 1u << GX_VA_NBT;
+        }
+    }
+}
+
+bool VtxSetterBatchEnabled() {
+    static const bool on = kartpad_opt && kartpad_opt("gxh_vtx_setter_batch", 1) != 0;
+    return on;
+}
+
+// Only the explicit HLE Begin gives a known parser boundary. Raw draw headers
+// and unsupported layouts keep the ordinary invalidation/drain path. Count
+// only legal attributes; direct values and bounded indices are both vertex
+// payload, so none of these bytes can be CP writes. NBT3 carries three indices.
+// Byte size of one vertex of format vf under the shadow layout, for exactly the layouts every
+// consumer parser sizes identically; false otherwise (unknown rows, indexed matrix indices,
+// pseudo-attributes, invalid counts/types, or no attribute at all: the consumer then discards
+// bytes for as long as the packet lasts).
+bool ShadowStrideFor(uint32_t vf, uint32_t& stride) {
+    stride = 0;
+    if (!g_vtxDescKnown || vf >= 8) return false;
+    for (uint32_t a = 0; a < 26; ++a) {
+        if (g_vtxShadow.desc[a] == GX_NONE) continue;
+        const auto inputType = g_vtxShadow.desc[a];
+        if (a > GX_VA_TEX7 || inputType < GX_DIRECT || inputType > GX_INDEX16) return false;
+        if (a < GX_VA_POS) {
+            // Matrix indices are always one byte; indexed descriptors here
+            // are invalid GX layouts and retain the conservative fallback.
+            if (inputType != GX_DIRECT) return false;
+            ++stride;
+            continue;
+        }
+        if (!(g_vtxFmtKnown[vf] & (1u << a))) return false;
+        const auto& fmt = g_vtxShadow.fmt[vf][a];
+        if (a == GX_VA_CLR0 || a == GX_VA_CLR1) {
+            if ((fmt.cnt != GX_CLR_RGB && fmt.cnt != GX_CLR_RGBA) ||
+                fmt.type < GX_RGB565 || fmt.type > GX_RGBA8) return false;
+        } else {
+            if (fmt.type < GX_U8 || fmt.type > GX_F32) return false;
+            if (a == GX_VA_POS && fmt.cnt != GX_POS_XY && fmt.cnt != GX_POS_XYZ) return false;
+            if (a == GX_VA_NRM && fmt.cnt != GX_NRM_XYZ && fmt.cnt != GX_NRM_NBT && fmt.cnt != GX_NRM_NBT3) return false;
+            if (a >= GX_VA_TEX0 && fmt.cnt != GX_TEX_S && fmt.cnt != GX_TEX_ST) return false;
+        }
+        const uint32_t bytes = inputType == GX_DIRECT
+            ? GxStream::DirectAttrByteSize(static_cast<GXAttr>(a), fmt, true, 1u)
+            : (inputType == GX_INDEX8 ? 1u : 2u) *
+              (a == GX_VA_NRM ? GxStream::NormalIndexCount(fmt) : 1u);
+        if (!bytes) return false;
+        stride += bytes;
+    }
+    return stride != 0;
+}
+
+void VtxShadowBegin(uint32_t vf, uint32_t count) {
+    GxHle::detail::g_vertexPayloadBytes = 0;
+    static const bool on = kartpad_opt && kartpad_opt("gxh_vertex_payload_shadow", 1) != 0;
+    uint32_t stride = 0;
+    if (!on || !g_vtxDescKnown || VtxShadowMode() == 0 || vf >= 8 || count == 0 || count > 65535 ||
+        !ShadowStrideFor(vf, stride)) {
+        VtxTrackRawBoundary(true);
+        return;
+    }
+    GxHle::detail::g_vertexPayloadBytes = uint64_t(stride) * count;
+    // The consumer's GXBegin drops partially buffered packet bytes and starts this payload.
+    VtxTrackRawBoundary(false);
+}
+
+const GXAttrType* VtxDescForGetter() {
+    if (!GxHle::Deferring()) return g_hleGxState.vtxDesc;
+    return PrepareVtxShadow(false) ? g_vtxShadow.desc : g_hleGxState.vtxDesc;
+}
+
+using VtxFmtTable = VtxAttrFmt[GX_VA_MAX_ATTR];
+const VtxFmtTable* VtxFmtForGetter() {
+    if (!GxHle::Deferring()) return g_hleGxState.vtxAttrFmt;
+    return PrepareVtxShadow(true) ? g_vtxShadow.fmt : g_hleGxState.vtxAttrFmt;
+}
+} // namespace
+
+void GxHle::VtxShadowInvalidate() noexcept {
+    // Deferred entry points are invoked again on the consumer; only the guest
+    // may write its validity bit. The producer already invalidated before Submit.
+    if (!GxHle::OnHleThread()) {
+        g_vtxShadowValid = false;
+        g_vtxDescKnown = false;
+        for (auto& mask : g_vtxFmtKnown) mask = 0;
+        GxHle::detail::g_vertexShadowKnown = false;
+        GxHle::detail::g_vertexPayloadBytes = 0;
+        VtxTrackRawBoundary(true);
+    }
+}
+
+void GxVtxShadowNoteStreamChange() noexcept {
+    // AppendStream invalidates before bytes outside a proven payload are queued.
+    // Sync closes that stream before a getter refreshes, so raw layout changes
+    // need no cross-thread write to guest-owned validity and no permanent off.
+}
+
+// ============================================================================
+// Guest-side CP vertex-layout tracking (perf.cfg `gxh_vtx_track`, default 1)
+// ============================================================================
+// b56 still drained the whole GX HLE queue ~2,300 times a second from GXGetVtxDesc /
+// GXGetVtxAttrFmt (nw4r::ef::DrawStrategyImpl::SetupGP, per emitter): every display list and
+// every raw gather-pipe command byte outside a proven vertex payload forgot the shadow, and model
+// draws produce both. The consumer's vertex layout changes only through CP VCD/VAT writes, and
+// only where its own parsers apply them, so the guest now applies the same writes to its copy:
+//  - Display lists are classified exactly like the consumer's DisplayListMayContainDraw. A
+//    register-only list leaves g_hleGxState untouched (its CP writes go to Aurora only); any other
+//    list applies its CP writes in stream order (the scan, flatten, cache replay and parse paths all
+//    end there), with draws sized from the shadow. A nested call inside such a list, an unknown
+//    command, a truncated packet or an unsizable draw still forgets the shadow.
+//  - Raw stream bytes go through a command parser mirroring HleFifoWrite (NOP/INVL 1, BP 5,
+//    CP 6, XF 5 plus its words, indexed XF 5, call 9, draw 3 plus its sized payload) that carries
+//    partial packets across appends. It only runs from a known consumer packet boundary: a Sync
+//    that found the consumer between packets, a proven HLE GXBegin (the consumer then drops any
+//    partial packet bytes), or the GXEnd of an exactly consumed payload. Display-list recording,
+//    unknown bytes and unsizable draws fall back to the previous invalidation.
+// Decoding uses the consumer's own GxCpDecode functions; the 64-getter verification still checks
+// every field and turns the shadow off on a mismatch. `gxh_vtx_track 0` restores b57 behaviour.
+namespace {
+bool VtxTrackEnabled() {
+    static const bool on = kartpad_opt != nullptr && kartpad_opt("gxh_vtx_track", 1) != 0;
+    return on;
+}
+
+// Guest thread only.
+bool g_vtxDlRecording = false;  // between GXBeginDisplayList and GXEndDisplayList
+bool g_rawLost = true;          // no known consumer packet boundary for the raw parser
+uint8_t g_rawHdr[9];
+uint32_t g_rawLen = 0;          // header bytes of the packet in progress
+
+// Read by the [stages] report; written only by the guest thread.
+std::atomic<uint64_t> g_trackDlKept{0};
+std::atomic<uint64_t> g_trackDlLost{0};
+std::atomic<uint64_t> g_trackRawCmds{0};
+std::atomic<uint64_t> g_trackRawLost{0};
+std::atomic<uint64_t> g_trackBoundaryLost{0};
+std::atomic<uint64_t> g_trackDlCached{0};
+std::atomic<uint64_t> g_efStrips{0};  // SetupGP strips written by the HLE thread
+inline void CountTrack(std::atomic<uint64_t>& counter) {
+    counter.store(counter.load(std::memory_order_relaxed) + 1, std::memory_order_relaxed);
+}
+
+inline uint16_t TrackBE16(const uint8_t* p) { return static_cast<uint16_t>((p[0] << 8) | p[1]); }
+inline uint32_t TrackBE32(const uint8_t* p) {
+    return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+}
+
+constexpr uint32_t kVatABits = (1u << GX_VA_POS) | (1u << GX_VA_NRM) | (1u << GX_VA_CLR0) |
+                               (1u << GX_VA_CLR1) | (1u << GX_VA_TEX0);
+constexpr uint32_t kVatBBits = (1u << GX_VA_TEX1) | (1u << GX_VA_TEX2) | (1u << GX_VA_TEX3);
+constexpr uint32_t kVatCBits = (1u << GX_VA_TEX5) | (1u << GX_VA_TEX6) | (1u << GX_VA_TEX7);
+
+// GxCpDecode::ApplyCpRegWrite's layout half, on the shadow. Fields a write fully defines become
+// known; TEX4 (split over VAT B and C) keeps its previous knowledge.
+void ShadowApplyCp(uint8_t reg, uint32_t value) {
+    if (reg == 0x50) {
+        GxCpDecode::DecodeVcdLo(g_vtxShadow.desc, value);
+    } else if (reg == 0x60) {
+        GxCpDecode::DecodeVcdHi(g_vtxShadow.desc, value);
+    } else if (reg >= 0x70 && reg <= 0x77) {
+        GxCpDecode::DecodeVatA(g_vtxShadow.fmt[reg - 0x70], value);
+        g_vtxFmtKnown[reg - 0x70] |= kVatABits;
+    } else if (reg >= 0x80 && reg <= 0x87) {
+        GxCpDecode::DecodeVatB(g_vtxShadow.fmt[reg - 0x80], value);
+        g_vtxFmtKnown[reg - 0x80] |= kVatBBits;
+    } else if (reg >= 0x90 && reg <= 0x97) {
+        GxCpDecode::DecodeVatC(g_vtxShadow.fmt[reg - 0x90], value);
+        g_vtxFmtKnown[reg - 0x90] |= kVatCBits;
+    }
+}
+
+// DlMayContainDrawVisitor walked by WalkDisplayList without draw handling: true exactly when the
+// consumer takes the register-only path. sawNested marks answers that cover other lists' bytes.
+bool ClassifyRegisterOnly(const uint8_t* data, uint32_t nbytes, int depth, bool& sawNested) {
+    if (depth > 8) return false;
+    uint32_t pos = 0;
+    while (pos < nbytes) {
+        const uint8_t cmd = data[pos++];
+        if (cmd == GxCmd::GX_NOP_CMD) continue;
+        if (cmd == GxCmd::GX_LOAD_BP_REG_CMD) {
+            if (pos + 4u > nbytes) return false;
+            pos += 4u;
+            continue;
+        }
+        const uint8_t opcode = cmd & GxCmd::GX_OPCODE_MASK_CMD;
+        if (opcode == GxCmd::GX_LOAD_CP_REG_CMD) {
+            if (pos + 5u > nbytes) return false;
+            const uint8_t reg = data[pos];
+            if (reg >= 0xA0 && reg <= 0xBF) return false;
+            pos += 5u;
+            continue;
+        }
+        if (opcode == GxCmd::GX_LOAD_XF_REG_CMD) {
+            if (pos > nbytes || nbytes - pos < 4u) return false;
+            const uint32_t payloadBytes = 4u + (uint32_t(TrackBE16(data + pos)) + 1u) * 4u;
+            if (payloadBytes > nbytes - pos) return false;
+            pos += payloadBytes;
+            continue;
+        }
+        if (opcode >= GxCmd::GX_LOAD_INDX_A_CMD && opcode <= GxCmd::GX_LOAD_INDX_D_CMD) {
+            if (pos + 4u > nbytes) return false;
+            pos += 4u;
+            continue;
+        }
+        if (opcode == GxCmd::GX_CMD_CALL_DL_CMD) {
+            if (pos + 8u > nbytes) return false;
+            const uint32_t addr = TrackBE32(data + pos);
+            const uint32_t size = TrackBE32(data + pos + 4);
+            pos += 8u;
+            sawNested = true;
+            if (addr == 0 || size == 0) continue;
+            const auto* nested = static_cast<const uint8_t*>(GuestToHostPtr(addr, size));
+            if (!nested || !ClassifyRegisterOnly(nested, size, depth + 1, sawNested)) return false;
+            continue;
+        }
+        if (opcode == GxCmd::GX_CMD_INVL_VC_CMD) continue;
+        return false;  // a draw, or a command byte the walker does not model
+    }
+    return true;
+}
+
+struct DlClassSlot {
+    uint32_t addr = 0;
+    uint32_t nbytes = 0;
+    uint64_t generation = 0;
+    bool registerOnly = false;
+    bool valid = false;
+};
+DlClassSlot g_dlClassSlots[1u << 11];
+
+bool DisplayListIsRegisterOnly(const uint8_t* list, uint32_t canonical, uint32_t nbytes,
+                               uint64_t generation) {
+    DlClassSlot& slot = g_dlClassSlots[((canonical >> 5) * 2654435761u) >> 21];
+    if (generation != GxGuestWrite::kUntracked && slot.valid && slot.addr == canonical &&
+        slot.nbytes == nbytes && slot.generation == generation) {
+        return slot.registerOnly;
+    }
+    bool sawNested = false;
+    const bool registerOnly = ClassifyRegisterOnly(list, nbytes, 0, sawNested);
+    if (generation != GxGuestWrite::kUntracked && !sawNested) {
+        slot = {canonical, nbytes, generation, registerOnly, true};
+    }
+    return registerOnly;
+}
+
+// What a draw-path walk depended on: the formats its draws used, with the strides that framed
+// them, and whether it wrote the vertex layout.
+struct DrawListWalk {
+    uint32_t stride[GX_MAX_VTXFMT]{};
+    uint8_t fmtMask = 0;
+    bool wroteLayout = false;
+};
+
+// A list the consumer runs through its scan/flatten/parse paths: CP writes land in order.
+bool ApplyDrawListToShadow(const uint8_t* data, uint32_t nbytes, DrawListWalk& walk) {
+    uint32_t pos = 0;
+    while (pos < nbytes) {
+        const uint8_t cmd = data[pos++];
+        if (cmd == GxCmd::GX_NOP_CMD) continue;
+        if (cmd == GxCmd::GX_LOAD_BP_REG_CMD) {
+            if (pos + 4u > nbytes) return false;
+            pos += 4u;
+            continue;
+        }
+        const uint8_t opcode = cmd & GxCmd::GX_OPCODE_MASK_CMD;
+        if (opcode == GxCmd::GX_LOAD_CP_REG_CMD) {
+            if (pos + 5u > nbytes) return false;
+            const uint8_t reg = data[pos];
+            walk.wroteLayout |= reg == 0x50 || reg == 0x60 || (reg >= 0x70 && reg <= 0x97);
+            ShadowApplyCp(reg, TrackBE32(data + pos + 1));
+            pos += 5u;
+            continue;
+        }
+        if (opcode == GxCmd::GX_LOAD_XF_REG_CMD) {
+            if (pos > nbytes || nbytes - pos < 4u) return false;
+            const uint32_t payloadBytes = 4u + (uint32_t(TrackBE16(data + pos)) + 1u) * 4u;
+            if (payloadBytes > nbytes - pos) return false;
+            pos += payloadBytes;
+            continue;
+        }
+        if (opcode >= GxCmd::GX_LOAD_INDX_A_CMD && opcode <= GxCmd::GX_LOAD_INDX_D_CMD) {
+            if (pos + 4u > nbytes) return false;
+            pos += 4u;
+            continue;
+        }
+        if (opcode == GxCmd::GX_CMD_INVL_VC_CMD) continue;
+        if (GxStream::IsDrawOpcode(opcode)) {
+            uint32_t stride = 0;
+            const uint32_t fmt = cmd & GxCmd::GX_VAT_MASK_CMD;
+            if (!ShadowStrideFor(fmt, stride)) return false;
+            walk.fmtMask |= uint8_t(1u << fmt);
+            walk.stride[fmt] = stride;
+            if (pos + 2u > nbytes) return false;
+            const uint64_t payloadBytes = uint64_t(TrackBE16(data + pos)) * stride;
+            pos += 2u;
+            if (payloadBytes > nbytes - pos) return false;
+            pos += static_cast<uint32_t>(payloadBytes);
+            continue;
+        }
+        return false;  // nested calls (consumer paths differ there) and unknown bytes
+    }
+    return true;
+}
+
+// Draw lists that do not write the layout leave the shadow untouched while the strides that framed
+// their draws are unchanged. Most shape lists are exactly that, and walking them meant one cold
+// header per primitive on the guest thread every call, so the walk runs again only when the
+// list's bytes (write generation) or the strides of the formats it draws with change.
+struct DrawListSlot {
+    uint32_t addr = 0;
+    uint32_t nbytes = 0;
+    uint64_t generation = 0;
+    DrawListWalk walk;
+    bool valid = false;
+};
+DrawListSlot g_drawListSlots[1u << 11];
+
+bool DrawListStridesUnchanged(const DrawListWalk& walk) {
+    for (uint32_t fmt = 0; fmt < GX_MAX_VTXFMT; ++fmt) {
+        if (!(walk.fmtMask & (1u << fmt))) continue;
+        uint32_t stride = 0;
+        if (!ShadowStrideFor(fmt, stride) || stride != walk.stride[fmt]) return false;
+    }
+    return true;
+}
+
+bool ShadowFollowDisplayList(uint32_t addr, uint32_t nbytes) {
+    if (addr == 0 || nbytes == 0) return true;  // the consumer returns before touching state
+    const auto* list = static_cast<const uint8_t*>(GuestToHostPtr(addr, nbytes));
+    if (!list) return true;                       // likewise for an unmapped list
+    const uint32_t canonical = CanonicalizeGxMainRamAddress(addr);
+    const uint64_t generation = GxGuestWrite::GenerationForRange(addr, nbytes);
+    if (DisplayListIsRegisterOnly(list, canonical, nbytes, generation)) return true;
+    const bool tracked = generation != GxGuestWrite::kUntracked;
+    DrawListSlot& slot = g_drawListSlots[((canonical >> 5) * 2654435761u) >> 21];
+    if (tracked && slot.valid && slot.addr == canonical && slot.nbytes == nbytes &&
+        slot.generation == generation && DrawListStridesUnchanged(slot.walk)) {
+        CountTrack(g_trackDlCached);
+        return true;
+    }
+    DrawListWalk walk;
+    if (!ApplyDrawListToShadow(list, nbytes, walk)) return false;
+    if (tracked && !walk.wroteLayout) {
+        slot = {canonical, nbytes, generation, walk, true};
+    }
+    return true;
+}
+
+// HleFifoWrite's packet walk outside a begin packet. False: the stream cannot be followed.
+bool ParseRawStream(const uint8_t* p, uint32_t n) {
+    uint64_t& payload = GxHle::detail::g_vertexPayloadBytes;
+    while (n != 0) {
+        if (payload != 0) {
+            const uint32_t take = payload < n ? static_cast<uint32_t>(payload) : n;
+            payload -= take;
+            p += take;
+            n -= take;
+            continue;
+        }
+        uint32_t& skip = GxHle::detail::g_rawSkipBytes;
+        if (skip != 0) {
+            const uint32_t take = skip < n ? skip : n;
+            skip -= take;
+            p += take;
+            n -= take;
+            continue;
+        }
+        const uint8_t byte = *p++;
+        --n;
+        if (g_rawLen == 0 && (byte == GxCmd::GX_NOP_CMD ||
+                              (byte & GxCmd::GX_OPCODE_MASK_CMD) == GxCmd::GX_CMD_INVL_VC_CMD)) {
+            continue;
+        }
+        g_rawHdr[g_rawLen++] = byte;
+        const uint8_t cmd = g_rawHdr[0];
+        const uint8_t opcode = cmd & GxCmd::GX_OPCODE_MASK_CMD;
+        uint32_t need = 0;
+        if (cmd == GxCmd::GX_LOAD_BP_REG_CMD) need = 5;
+        else if (opcode == GxCmd::GX_LOAD_CP_REG_CMD) need = 6;
+        else if (opcode == GxCmd::GX_LOAD_XF_REG_CMD) need = 5;
+        else if (opcode >= GxCmd::GX_LOAD_INDX_A_CMD && opcode <= GxCmd::GX_LOAD_INDX_D_CMD) need = 5;
+        else if (opcode == GxCmd::GX_CMD_CALL_DL_CMD) need = 9;
+        else if (GxStream::IsDrawOpcode(opcode)) need = 3;
+        else return false;
+        if (g_rawLen < need) continue;
+        g_rawLen = 0;
+        CountTrack(g_trackRawCmds);
+        if (opcode == GxCmd::GX_LOAD_CP_REG_CMD) {
+            ShadowApplyCp(g_rawHdr[1], TrackBE32(g_rawHdr + 2));
+        } else if (opcode == GxCmd::GX_LOAD_XF_REG_CMD) {
+            GxHle::detail::g_rawSkipBytes = (uint32_t(TrackBE16(g_rawHdr + 1)) + 1u) * 4u;
+        } else if (opcode == GxCmd::GX_CMD_CALL_DL_CMD) {
+            if (!ShadowFollowDisplayList(TrackBE32(g_rawHdr + 1), TrackBE32(g_rawHdr + 5))) return false;
+        } else if (GxStream::IsDrawOpcode(opcode)) {
+            // A zero count leaves the consumer inside the packet: not followable.
+            const uint32_t count = TrackBE16(g_rawHdr + 1);
+            uint32_t stride = 0;
+            if (count == 0 || !ShadowStrideFor(cmd & GxCmd::GX_VAT_MASK_CMD, stride)) return false;
+            payload = uint64_t(stride) * count;
+        }
+    }
+    return true;
+}
+
+void VtxTrackRawBoundary(bool lost) noexcept {
+    g_rawLost = lost;
+    g_rawLen = 0;
+    GxHle::detail::g_rawSkipBytes = 0;
+}
+
+void VtxTrackAfterSync() noexcept {
+    // Everything queued has run; the consumer's own parser state says whether its next byte
+    // starts a packet. Only a parser that had lost its place is re-armed.
+    if (g_rawLost && !g_vtxDlRecording && !g_hleGxState.inBegin && g_hleGxState.fifoByteCount == 0 &&
+        !IsDisplayListActive()) {
+        VtxTrackRawBoundary(false);
+    }
+}
+} // namespace
+
+void GxHle::VtxShadowObserveCommands(const uint8_t* bytes, uint32_t count) noexcept {
+    // Called with a known shadow and more bytes than the proven payload has left.
+    if (!VtxTrackEnabled() || g_vtxDlRecording || VtxShadowMode() == 0) {
+        GxHle::VtxShadowInvalidate();
+        return;
+    }
+    if (g_rawLost) {
+        CountTrack(g_trackBoundaryLost);
+        GxHle::VtxShadowInvalidate();
+        return;
+    }
+    bool followed = false;
+    try {
+        followed = ParseRawStream(bytes, count);
+    } catch (...) {
+        followed = false;
+    }
+    if (!followed) {
+        CountTrack(g_trackRawLost);
+        GxHle::VtxShadowInvalidate();
+    }
+}
+
+void GxVtxShadowNoteDisplayList(uint32_t addr, uint32_t nbytes) noexcept {
+    if (GxHle::OnHleThread()) return;
+    if (!GxHle::Deferring() || !GxHle::detail::g_vertexShadowKnown || !VtxTrackEnabled() ||
+        g_vtxDlRecording || VtxShadowMode() == 0) {
+        GxHle::VtxShadowInvalidate();
+        return;
+    }
+    bool followed = false;
+    try {
+        followed = ShadowFollowDisplayList(addr, nbytes);
+    } catch (...) {
+        followed = false;
+    }
+    if (followed) {
+        CountTrack(g_trackDlKept);
+    } else {
+        CountTrack(g_trackDlLost);
+        GxHle::VtxShadowInvalidate();
+    }
+}
+
+void GxVtxShadowNoteDisplayListRecording(bool active) noexcept {
+    if (GxHle::Deferring()) g_vtxDlRecording = active;
+}
+
+
+extern "C" void kartpad_vtx_track_counters(uint64_t* out) {
+    out[0] = g_trackDlKept.load(std::memory_order_relaxed);
