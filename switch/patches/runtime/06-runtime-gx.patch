+static inline void EmitLytDrawQuad(uint32_t posAddr, uint32_t sizeAddr, int texCoordCount,
+                                   uint32_t texCoordAddr, const uint32_t* colors) {
+    const float x0 = Memory::ReadFloat32(posAddr);
+    const float y0 = Memory::ReadFloat32(posAddr + 4);
+    // The casts pin the arithmetic to PPC single precision regardless of the
+    // host's FLT_EVAL_METHOD.
+    const float x1 = static_cast<float>(x0 + Memory::ReadFloat32(sizeAddr));
+    const float y1 = static_cast<float>(y0 - Memory::ReadFloat32(sizeAddr + 4));
+
+    // perf.cfg `gx_diag 1`: once per second, how many lyt quads were drawn and the 2D state the
+    // first one saw (projection, viewport, scissor, its rectangle and colour).
+    static const bool diag = kartpad_opt != nullptr && kartpad_opt("gx_diag", 0) != 0;
+    if (diag) {
+        static uint32_t quads = 0;
+        static uint64_t windowStart = 0;
+        const uint64_t now = static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count());
+        ++quads;
+        if (now - windowStart >= 1000ull) {
+            std::fprintf(stderr,
+                "[gx_diag] lyt quads/s=%u first rect=(%.1f,%.1f)-(%.1f,%.1f) tex=%d col0=%08x "
+                "proj=[%g %g %g %g %g %g %g] vp=[%g %g %g %g %g %g] sc=[%d %d %d %d]\n",
+                quads, x0, y0, x1, y1, texCoordCount, colors ? colors[0] : 0u,
+                g_projectionVector[0], g_projectionVector[1], g_projectionVector[2], g_projectionVector[3],
+                g_projectionVector[4], g_projectionVector[5], g_projectionVector[6],
+                g_viewportState[0], g_viewportState[1], g_viewportState[2], g_viewportState[3],
+                g_viewportState[4], g_viewportState[5], g_scissorLeft, g_scissorTop, g_scissorWidth,
+                g_scissorHeight);
+            quads = 0;
+            windowStart = now;
+        }
+    }
+
+    if (GxHle::Deferring()) {
+        // Same decisions as the inline path below, made on the GX HLE thread (it owns
+        // g_hleGxState and Aurora's producer side). Guest memory (texcoords; colours were read by
+        // the caller) is read here, at call time, and queued by value.
+        if (texCoordCount > 8) {
+            return;  // neither path below draws it
+        }
+        struct LytQuad {
+            std::array<uint8_t, 4u * (8u + 4u + 8u * 8u)> vertices;
+            uint32_t bytes;
+            int texCoordCount;
+            bool hasColors;
+        } quad{};
+        AppendLytQuadVertices(quad.vertices.data(), quad.bytes, x0, y0, x1, y1, texCoordAddr,
+                              texCoordCount, colors);
+        quad.texCoordCount = texCoordCount;
+        quad.hasColors = colors != nullptr;
+        GxHle::Submit([quad]() {
+            // CanSubmitLytDrawDirect only tests `colors` for null.
+            static const uint32_t kNonNull[4] = {};
+            if (CanSubmitLytDrawDirect(quad.texCoordCount, quad.hasColors ? kNonNull : nullptr)) {
+                EnsureAuroraFrameActive();
+                ApplyAuroraVtxDesc();
+                ApplyAuroraVtxAttrFmtForDisplayList(GX_VTXFMT0, false);
+                EnsureDefaultGxAlphaCompare();
+                if (aurora::gx::fifo::submit_raw_draw(GX_QUADS, GX_VTXFMT0, quad.vertices.data(), 4,
+                                                      quad.bytes)) {
+                    GXMarkFrameWork();
+                    SyncAppliedVtxStateFromHleReal();
+                    return;
+                }
+            }
+            std::array<uint8_t, 3u + 4u * (8u + 4u + 8u * 8u)> packet{};
+            static_assert(sizeof(packet) == 3u + sizeof(quad.vertices));
+            uint32_t pos = 0;
+            packet[pos++] = GX_DRAW_QUADS_CMD | GX_VTXFMT0;
+            BigEndian::Append16(packet.data(), pos, 4);
+            std::memcpy(packet.data() + pos, quad.vertices.data(), quad.bytes);
+            SubmitLytDrawPacket(packet.data(), pos + quad.bytes);
+        });
+        return;
+    }
+
+    if (SubmitLytDrawDirect(x0, y0, x1, y1, texCoordCount, texCoordAddr, colors)) {
+        return;
+    }
+
+    // GX has exactly 8 texture coordinates, so nw4r::lyt cannot ask for more.
+    // The fixed packet buffer below is sized for that maximum; bail rather than
+    // overrun it if the guest ever hands us something else.
+    if (texCoordCount > 8) {
+        return;
+    }
+
+    std::array<uint8_t, 3u + 4u * (8u + 4u + 8u * 8u)> packet{};
+    uint32_t pos = 0;
+    packet[pos++] = GX_DRAW_QUADS_CMD | GX_VTXFMT0;
+    BigEndian::Append16(packet.data(), pos, 4);
+    AppendLytQuadVertices(packet.data(), pos, x0, y0, x1, y1, texCoordAddr, texCoordCount, colors);
+    SubmitLytDrawPacket(packet.data(), pos);
+}
