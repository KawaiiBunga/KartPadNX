-static uint64_t HashScanLayoutState() {
-    if (!g_hleGxState.vtxLayoutHashDirty) {
-        return g_hleGxState.vtxLayoutHash;
-    }
-#if defined(__SWITCH__)
-    // Canonical words exclude VtxAttrFmt's padding. Hash all fields just as the
-    // original key did, without its chain of 650 dependent FNV multiplications.
-    // This cache is in-memory only; changing its hash has no on-SD consequence.
-    std::array<uint32_t, 26u + 8u * 26u * 3u> words;
-    size_t index = 0;
-    for (const auto attr : g_hleGxState.vtxDesc) words[index++] = static_cast<uint32_t>(attr);
-    for (const auto& fmt : g_hleGxState.vtxAttrFmt) {
-        for (const auto& attr : fmt) {
-            words[index++] = static_cast<uint32_t>(attr.cnt);
-            words[index++] = static_cast<uint32_t>(attr.type);
-            words[index++] = attr.frac;
-        }
-    }
-    const uint64_t hash = XXH3_64bits(words.data(), sizeof(words));
-#else
-    uint64_t hash = 1469598103934665603ull;
-    auto mix = [&hash](uint32_t value) {
-        hash ^= static_cast<uint64_t>(value);
-        hash *= 1099511628211ull;
-    };
-    for (int attr = 0; attr < 26; ++attr) {
-        mix(static_cast<uint32_t>(g_hleGxState.vtxDesc[attr]));
-    }
-    for (int fmt = 0; fmt < 8; ++fmt) {
-        for (int attr = 0; attr < 26; ++attr) {
-            const auto& f = g_hleGxState.vtxAttrFmt[fmt][attr];
-            mix(static_cast<uint32_t>(f.cnt));
-            mix(static_cast<uint32_t>(f.type));
-            mix(static_cast<uint32_t>(f.frac));
-        }
-    }
-#endif
-    g_hleGxState.vtxLayoutHash = hash;
-    g_hleGxState.vtxLayoutHashDirty = false;
-    return g_hleGxState.vtxLayoutHash;
-}
