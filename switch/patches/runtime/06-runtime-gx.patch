-    uint32_t word0 = (wrapS & 0x3u) | ((wrapT & 0x3u) << 2) | 0x10u;
-    uint32_t word1 = 0;
-    if (!mipmap) {
-        word0 = (word0 & 0xFFFFFF10u) | (wrapS & 0x3u) | ((wrapT & 0x3u) << 2) | 0x90u;
-    } else {
-        word0 = (word0 & 0xFFFFFF10u) | (wrapS & 0x3u) | ((wrapT & 0x3u) << 2) |
