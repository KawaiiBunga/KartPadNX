+// True only while the applied-state mirror is a verbatim copy of HLE vertex state at
+// generation s_appliedVtxStateGeneration; any HLE-side mutation bumps that generation, so the
+// memoized republish below can never observe a stale match.
+static bool s_appliedVtxStateMatchesHle = false;
+static uint32_t s_appliedVtxStateGeneration = 0;
+static uint64_t s_appliedIndexedDescMask = 0;
+static uint64_t s_appliedIndexedDescValue = 0;
+extern "C" uint64_t AuroraGXGetPackedVtxDesc();
+
+static bool DlVcdPackedCheckEnabled() {
+    static const bool enabled = kartpad_opt != nullptr && kartpad_opt("dl_vcd_packed", 1) != 0;
+    return enabled;
+}
+
+static void CaptureAppliedIndexedDesc() {
+    uint64_t mask = 0, value = 0;
+    for (int attr = GX_VA_POS; attr <= GX_VA_TEX7; ++attr) {
+        const auto type = g_hleGxState.vtxDesc[attr];
+        if (type != GX_INDEX8 && type != GX_INDEX16) continue;
+        const unsigned shift = attr <= GX_VA_CLR1
+            ? 9u + 2u * (attr - GX_VA_POS) : 32u + 2u * (attr - GX_VA_TEX0);
+        mask |= uint64_t(3) << shift;
+        value |= uint64_t(type) << shift;
+    }
+    s_appliedIndexedDescMask = mask;
+    s_appliedIndexedDescValue = value;
+}
+
+static void InvalidateAppliedAuroraState() {
+    s_appliedVtxDescValid = false;
+    s_appliedVtxAttrFmtValid = false;
+    s_appliedVtxStateMatchesHle = false;
+    for (auto& array : s_appliedArrays) {
+        array.valid = false;
+    }
+}
+
+static void SyncAppliedVtxStateFromHleReal() {
+    // skip the republish only when the mirror is already an exact copy of
+    // HLE state
+    if (s_appliedVtxStateMatchesHle && s_appliedVtxDescValid && s_appliedVtxAttrFmtValid &&
+        s_appliedVtxStateGeneration == g_hleGxState.vtxStateGeneration) {
+        return;
+    }
+    // Both mirrors are dense arrays of the same trivially copyable element types
+    // as their HLE counterparts, so publish them with three memcpys instead of
+    // 234 individual element assignments.
+    static_assert(sizeof(s_appliedVtxDesc) == sizeof(g_hleGxState.vtxDesc));
+    static_assert(sizeof(s_appliedSourceVtxDesc) == sizeof(g_hleGxState.vtxDesc));
+    static_assert(sizeof(s_appliedVtxAttrFmt) == sizeof(g_hleGxState.vtxAttrFmt));
+    std::memcpy(s_appliedVtxDesc.data(), g_hleGxState.vtxDesc, sizeof(g_hleGxState.vtxDesc));
+    std::memcpy(s_appliedSourceVtxDesc.data(), g_hleGxState.vtxDesc, sizeof(g_hleGxState.vtxDesc));
+    s_appliedVtxDescValid = true;
+
+    std::memcpy(s_appliedVtxAttrFmt, g_hleGxState.vtxAttrFmt, sizeof(g_hleGxState.vtxAttrFmt));
+    s_appliedVtxAttrFmtValid = true;
+
+    s_appliedVtxStateMatchesHle = true;
+    s_appliedVtxStateGeneration = g_hleGxState.vtxStateGeneration;
+    CaptureAppliedIndexedDesc();
+}
+
+extern "C" void aurora_gx_worker_sync(void) __attribute__((weak));
+
+static void ApplyAuroraArrayIfChanged(GXAttr attr, const void* data, uint32_t size, uint8_t stride) {
+    auto& applied = s_appliedArrays[attr];
+    if (applied.valid && applied.data == data && applied.size == size && applied.stride == stride) {
+        return;
+    }
+    GXSetArray(attr, data, size, stride);
+    applied.data = data;
+    applied.size = size;
+    applied.stride = stride;
+    applied.valid = true;
+}
+
+// Aurora's live vertex descriptor for one attribute, read straight back out of
+// its CP shadow registers (GXGetVtxDesc is the exact inverse of GXSetVtxDesc,
+// GX_VA_NRM included). This is the ground truth the applied-state mirror is
+// checked against below; it is a switch plus a shift/mask, no state change and
+// no FIFO traffic.
+static bool AuroraVtxDescMatchesLive(GXAttr attr, GXAttrType expected) {
+    GXAttrType live = GX_NONE;
+    GXGetVtxDesc(attr, &live);
+    return live == expected;
+}
+
+
+static void ApplyAuroraVtxDesc() {
+    // Under the same full-mirror generation invariant used by VAT, every
+    // software descriptor/source descriptor already matches. Only indexed
+    // live CP descriptors can differ after a raw list, so check exactly those
+    // bits in one producer-shadow read. A mismatch retains the original loop.
+    if (s_appliedVtxDescValid && s_appliedVtxStateMatchesHle &&
+        s_appliedVtxStateGeneration == g_hleGxState.vtxStateGeneration && DlVcdPackedCheckEnabled() &&
+        (AuroraGXGetPackedVtxDesc() & s_appliedIndexedDescMask) == s_appliedIndexedDescValue) {
+        return;
+    }
+    const bool hadValidState = s_appliedVtxDescValid;
+    if (!hadValidState) {
+        s_appliedVtxStateMatchesHle = false;
+    }
+    for (int attr = 0; attr < 26; ++attr) {
+        if (attr == GX_VA_NBT) continue;
+        const GXAttr gxAttr = static_cast<GXAttr>(attr);
+        const GXAttrType type = g_hleGxState.vtxDesc[attr];
+        bool needsPublish = !hadValidState || s_appliedVtxDesc[attr] != type;
+        // GXGetVtxDesc only decodes GX_VA_PNMTXIDX..GX_VA_TEX7; the XF array
+        // pseudo-attributes above GX_VA_TEX7 have no CP descriptor bits, so
+        // probing them would always report GX_NONE and republish a no-op.
+        if (!needsPublish && !IsMatrixIndexAttr(gxAttr) && gxAttr <= GX_VA_TEX7 &&
+            (type == GX_INDEX8 || type == GX_INDEX16)) {
+            needsPublish = !AuroraVtxDescMatchesLive(gxAttr, type);
+        }
+        if (needsPublish) {
+            GXSetVtxDesc(gxAttr, type);
+            s_appliedVtxDesc[attr] = type;
+        }
+        if (!hadValidState || s_appliedSourceVtxDesc[attr] != type) {
+            GXSetSourceVtxDesc(gxAttr, type);
+            s_appliedSourceVtxDesc[attr] = type;
+        }
+    }
+    s_appliedVtxDescValid = true;
+}
+
+// Size of one element of the guest array an indexed attribute reads from. An
+// NBT3 normal is indexed per 3-component group, not per 9-component triple.
+static uint32_t GetIndexedAttrElementSizeBytes(GXAttr attr, const VtxAttrFmt& fmt) {
+    if (attr == GX_VA_NRM && fmt.cnt == GX_NRM_NBT3) {
+        return 3u * static_cast<uint32_t>(GetCompSizeBytes(fmt.type));
+    }
+    return DirectAttrByteSize(attr, fmt, /*matrixAttrIsOneByte=*/false, /*fallbackComps=*/0u);
+}
+
+// perf.cfg `dl_vat_gen_skip` (default 1): when the whole mirror is a verified copy of the HLE
+// vertex state (s_appliedVtxStateMatchesHle, set by SyncAppliedVtxStateFromHleReal) and no
+// vtxDesc/vtxAttrFmt mutation has happened since (vtxStateGeneration unchanged), every row
+// already matches, so the 312-byte memcmp below (0.9% of a race frame) cannot fail. This is the
+// same invariant SyncAppliedVtxStateFromHleReal already relies on to skip its republish.
+static bool DlVatGenerationSkipEnabled() {
+    static const bool enabled = kartpad_opt != nullptr && kartpad_opt("dl_vat_gen_skip", 1) != 0;
+    return enabled;
+}
+
+static void ApplyAuroraVtxAttrFmt(GXVtxFmt fmt) {
+    if (s_appliedVtxAttrFmtValid && s_appliedVtxStateMatchesHle &&
+        s_appliedVtxStateGeneration == g_hleGxState.vtxStateGeneration && DlVatGenerationSkipEnabled()) {
+        return;
+    }
+    const bool hadValidState = s_appliedVtxAttrFmtValid;
+    // Rows other than `fmt` keep their contents and every write below copies
+    // g_hleGxState, so an already-matching mirror still matches. Only the rebuild
+    // from an invalidated mirror leaves the untouched rows divergent.
+    if (!hadValidState) {
+        s_appliedVtxStateMatchesHle = false;
+    }
+    // The mirror is refreshed by memcpy (SyncAppliedVtxStateFromHleReal) and by
+    // the row copy below, so an unchanged row is byte-identical, padding
+    // included. One 312-byte compare replaces 24 field compares on the common
+    // path; a false mismatch (differing padding) just falls through to the loop.
+    // This function ran on every display-list call: 1.6% of a race frame.
+    if (hadValidState &&
+        std::memcmp(s_appliedVtxAttrFmt[fmt], g_hleGxState.vtxAttrFmt[fmt], sizeof(s_appliedVtxAttrFmt[fmt])) == 0) {
+        return;
+    }
+    for (int attr = 0; attr < 26; ++attr) {
+        if (attr == GX_VA_NBT) continue;
+        if (IsMatrixIndexAttr(static_cast<GXAttr>(attr))) continue;
+        const auto& f = g_hleGxState.vtxAttrFmt[fmt][attr];
+        if (hadValidState && SameVtxAttrFmt(s_appliedVtxAttrFmt[fmt][attr], f)) {
+            continue;
+        }
+        GXSetVtxAttrFmt(fmt, static_cast<GXAttr>(attr), f.cnt, f.type, f.frac);
+    }
+    // Rows are only ever compared in this function and wholesale-copied by the
+    // sync, so mirroring the attributes the loop skips (NBT, matrix indices)
+    // is harmless and keeps the next call on the memcmp path.
+    std::memcpy(s_appliedVtxAttrFmt[fmt], g_hleGxState.vtxAttrFmt[fmt], sizeof(s_appliedVtxAttrFmt[fmt]));
+    s_appliedVtxAttrFmtValid = true;
+}
+
+static void ApplyAuroraVtxAttrFmtAll() {
+    for (int fmt = 0; fmt < 8; ++fmt) {
+        ApplyAuroraVtxAttrFmt(static_cast<GXVtxFmt>(fmt));
+    }
+}
+
+// `rowMask` names the VAT rows that can differ from the applied mirror. The default (all rows) is
+// always correct; a scan-cache hit narrows it to the rows its replayed CP writes touched when the
+// mirror was a verified copy of the HLE state before the replay (perf.cfg `dl_vat_row_mask`).
+// Every skipped row would have passed ApplyAuroraVtxAttrFmt's memcmp unchanged: the replay writes
+// no other row and nothing else runs between the replay and this call.
+static void ApplyAuroraVtxAttrFmtForDisplayList(GXVtxFmt fmt, bool mixed, uint32_t rowMask) {
+    if (!mixed && fmt < GX_MAX_VTXFMT) {
+        if ((rowMask & (1u << fmt)) != 0) {
+            ApplyAuroraVtxAttrFmt(fmt);
+        }
+        return;
+    }
+    if (rowMask == 0xFFu) {
+        ApplyAuroraVtxAttrFmtAll();
+        return;
+    }
+    for (uint32_t row = 0; row < 8; ++row) {
+        if ((rowMask & (1u << row)) != 0) {
+            ApplyAuroraVtxAttrFmt(static_cast<GXVtxFmt>(row));
+        }
+    }
+}
+
+static bool DlVatRowMaskEnabled() {
+    static const bool enabled = kartpad_opt != nullptr && kartpad_opt("dl_vat_row_mask", 1) != 0;
+    return enabled;
+}
+
+
+
+// The usual vertex array lies within a mapped page. Resolve it once instead
+// of doing the same page/region lookup in Contains() and then GetPointer().
+// Slow/cross-page mappings retain their original Contains + GuestToHostPtr
+// behavior. Never cache pointers across calls or change deferred-read policy.
+static const uint8_t* DisplayListArrayPointer(uint32_t address, uint32_t bytes) {
+    static const bool fast = kartpad_opt != nullptr && kartpad_opt("dl_array_resolve", 1) != 0;
+    if (fast && bytes != 0 && address <= UINT32_MAX - (bytes - 1u)) {
+        uint8_t* pointer = nullptr;
+        if (MemoryInline::TryGetPointerFast(address, bytes, pointer)) return pointer;
+    }
+    if (!Memory::Contains(address, bytes)) return nullptr;
+    return static_cast<const uint8_t*>(GuestToHostPtr(address, bytes));
+}
+
+static bool ApplyAuroraArraysForDisplayList(const std::array<uint32_t, GX_VA_MAX_ATTR>& maxIdx,
+                                            const std::array<bool, GX_VA_MAX_ATTR>& sawIdx,
+                                            GXVtxFmt vtxfmt,
+                                            bool vtxfmtMixed) {
+    static std::array<std::array<std::vector<uint8_t>, 2>, GX_VA_MAX_ATTR> s_packedArrays;
+    static std::array<uint32_t, GX_VA_MAX_ATTR> s_packedArrayCursor{};
+    bool ok = true;
+    if (vtxfmt >= GX_MAX_VTXFMT) {
+        vtxfmt = g_hleGxState.currentVtxFmt;
+    }
+    for (int attr = 0; attr < 26; ++attr) {
+        const GXAttrType type = g_hleGxState.vtxDesc[attr]; if (type != GX_INDEX8 && type != GX_INDEX16) continue;
+        if (!sawIdx[attr]) continue;
+        const auto& arr = g_hleGxState.vtxArray[attr];
+        if (arr.base == 0 || arr.stride == 0) { ok = false; continue; }
+        const uint32_t count = maxIdx[attr] + 1u;
+        const GXAttr gxAttr = static_cast<GXAttr>(attr);
+        const auto& fmt = g_hleGxState.vtxAttrFmt[vtxfmt][attr];
+        const uint32_t elemSize = GetIndexedAttrElementSizeBytes(gxAttr, fmt);
+        if (elemSize == 0) {
+            ok = false;
+            continue;
+        }
+        const uint32_t span = (count > 0) ? (static_cast<uint32_t>((count - 1u) * arr.stride) + elemSize) : 0u;
+        const bool needsPack = arr.stride > 0xffu;
+        const uint8_t* hostPtr = DisplayListArrayPointer(arr.base, span);
+        if (!hostPtr) {
+            ok = false;
+            continue;
+        }
+        // Aurora's storage-fetch shaders consume guest big-endian bytes directly
+        // and honor the array stride. Keep the backing pointer stable so per-frame
+        // storage uploads can be cached instead of repacking every display-list call.
+        if (!needsPack) {
+            ApplyAuroraArrayIfChanged(gxAttr, hostPtr, span, static_cast<uint8_t>(arr.stride));
+            continue;
+        }
+        // With the GX decode worker the draw that last used this slot may still be queued
+        // (Aurora reads arrays when it decodes the draw). Rare: only strides above 255.
+        if (aurora_gx_worker_sync) aurora_gx_worker_sync();
+        auto& packed = s_packedArrays[attr][++s_packedArrayCursor[attr] & 1u];
+        if (!PackIndexedAttrData(hostPtr, arr.stride, count, elemSize, packed)) {
+            ok = false;
+            continue;
+        }
+        ApplyAuroraArrayIfChanged(gxAttr, packed.data(), static_cast<uint32_t>(packed.size()), static_cast<uint8_t>(elemSize));
+    }
+    return ok;
+}
+
+static bool ApplyAuroraIndexedXFArraysForDisplayList(const std::array<uint32_t, GX_VA_MAX_ATTR>& maxXfIdx,
+                                                     const std::array<uint32_t, GX_VA_MAX_ATTR>& maxXfBytes,
+                                                     const std::array<bool, GX_VA_MAX_ATTR>& sawXfIdx) {
+    bool ok = true;
+    for (int attr = GX_POS_MTX_ARRAY; attr <= GX_LIGHT_ARRAY; ++attr) {
+        if (!sawXfIdx[attr]) {
+            continue;
+        }
+        const auto& arr = g_hleGxState.vtxArray[attr];
+        const uint32_t bytes = maxXfBytes[attr];
+        if (arr.base == 0 || arr.stride == 0 || bytes == 0) {
+            ok = false;
+            continue;
+        }
+        const uint32_t span = maxXfIdx[attr] * arr.stride + bytes;
+        const uint8_t* hostPtr = DisplayListArrayPointer(arr.base, span);
+        if (!hostPtr) {
+            ok = false;
+            continue;
+        }
+        ApplyAuroraArrayIfChanged(static_cast<GXAttr>(attr), hostPtr, span, static_cast<uint8_t>(arr.stride));
+    }
+    return ok;
+}
+
+} // namespace
+
+extern "C" void GxNotifyDisplayListMemoryWrite(uint32_t addr, uint32_t size) {
+    GxGuestWrite::NotifyWrite(addr, size);
+}
+
+// Mid-frame audio pump attempts, and how many found guest interrupts off
+// (Audio_HLE_PollDeferred then does nothing). Read by the [stages] report.
+std::atomic<uint32_t> g_audioPumpCalls{0};
+std::atomic<uint32_t> g_audioPumpIrqOff{0};
+
+#if defined(__SWITCH__)
+extern "C" int kartpad_perf_int(const char* key, int fallback) __attribute__((weak));
+
+// Audio DMA is a 3 ms cadence, but the guest only reaches the scheduler's idle
+// loop once per ~50 ms frame at stock clocks. There it caught up ~16 blocks in
+// a row, each waiting on the mix worker (4-5% of the game thread in a race,
+// measured 2026-09-23). Pumping on wall-clock cadence from this call, which a
+// race makes ~1,500 times a frame, lets the worker mix each block while the
+// game keeps running. Audio_HLE_PollDeferred is the same interrupt-context
+// entry the Aurora frame-wait path already uses from inside GX calls, and it
+// does nothing while the guest has interrupts disabled.
+// perf.cfg `audio_pump_us` (default 0 = off). Measured 2026-09-23: every attempt
+// in a race found guest interrupts off (this runtime delivers interrupt-context
+// callbacks from the idle loop), so the pump never ticked; kept for experiments.
+// CNTPCT_EL0 (as libnx armGetSystemTick; Horizon traps CNTVCT_EL0 at EL0)
+// runs at 19.2 MHz on the Switch; read directly so this file does
+// not pull <switch.h> (its u32/s32 typedefs collide with the Dolphin SDK's).
+static inline uint64_t ReadSystemTick() {
+    uint64_t t;
+    __asm__ volatile("mrs %0, cntpct_el0" : "=r"(t));
+    return t;
+}
+
+static void PumpAudioOnCadence() {
+    static const uint64_t periodTicks = [] {
+        const int us = kartpad_perf_int ? kartpad_perf_int("audio_pump_us", 0) : 0;
+        return us > 0 ? static_cast<uint64_t>(us) * 192u / 10u : uint64_t{0};
+    }();
+    static uint64_t lastTick = 0;
+    static bool active = false;
+    // Guest interrupt delivery: never from the GX HLE thread.
+    if (periodTicks == 0 || active || GxHle::OnHleThread()) return;
+    const uint64_t now = ReadSystemTick();
+    if (now - lastTick < periodTicks) return;
+    g_audioPumpCalls.fetch_add(1, std::memory_order_relaxed);
+    if (!OS_HLE_InterruptsEnabled()) {
+        // Retry on the next call rather than a whole period later.
+        g_audioPumpIrqOff.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    lastTick = now;
+    active = true;
+    Audio_HLE_PollDeferred();
+    active = false;
+}
+#endif
+
+// Display-list replay cost by class, for the [stages] report (guest thread
+// only, outermost call only). [0] register-only lists, [1] lists with draws.
+namespace {
+struct DlClassStats {
+    uint64_t calls = 0;
+    uint64_t ticks = 0;
+    uint64_t bytes = 0;
+};
+DlClassStats g_dlStats[2];
+uint64_t g_dlRegAuroraTicks = 0;  // register-only: time inside Aurora's decoder
+uint64_t g_dlDrawAuroraTicks = 0; // draw lists: time inside Aurora's decoder
+// Distinct lists per report interval, by class: a direct-mapped table of
+// (address,size) stamped with the interval epoch. Collisions undercount a
+// little; this sizes a cache, it is not exact.
+constexpr uint32_t kDlSeenSlots = 16384;
+struct DlSeen { uint32_t addr; uint32_t size; uint32_t epoch; };
+DlSeen g_dlSeen[kDlSeenSlots];
+uint32_t g_dlEpoch = 1;
+uint64_t g_dlUnique[2] = {};
+int g_dlClass = 1;
+int g_dlDepth = 0;
+
+inline uint64_t DlTick() {
+#if defined(__SWITCH__) && defined(__aarch64__)
+    uint64_t t;
+    __asm__ volatile("mrs %0, cntpct_el0" : "=r"(t));
+    return t;
+#else
+    return 0;
+#endif
+}
+} // namespace
+
+// out: [0..2] reg-only calls/ticks/bytes, [3..5] draw calls/ticks/bytes,
+// [6] reg-only ticks inside Aurora, [7] draw-list ticks inside Aurora, [8..9]
+// distinct reg-only/draw lists. Ticks are CNTPCT (19.2 MHz). Cumulative.
+extern "C" void kartpad_dl_counters(uint64_t* out) {
+    out[0] = g_dlStats[0].calls; out[1] = g_dlStats[0].ticks; out[2] = g_dlStats[0].bytes;
+    out[3] = g_dlStats[1].calls; out[4] = g_dlStats[1].ticks; out[5] = g_dlStats[1].bytes;
+    out[6] = g_dlRegAuroraTicks;
+    out[7] = g_dlDrawAuroraTicks;
+    out[8] = g_dlUnique[0];
+    out[9] = g_dlUnique[1];
+    ++g_dlEpoch;  // called once per report: start a new distinct-list interval
+}
+
+static void GX__CallDisplayList_Impl(uint32_t listAddr, uint32_t nbytes);
+
+// perf.cfg `dl_uniq_stats` (default 0): the distinct-list counters ([stages] `uniq=`) stamp a
+// random slot of a 192 KB table per call; that one cache miss was 0.54% of r39's race. They size
+// the scan caches and are only needed for that analysis.
+static bool DlUniqueStatsEnabled() {
+    static const bool enabled = kartpad_opt != nullptr && kartpad_opt("dl_uniq_stats", 0) != 0;
+    return enabled;
+}
+
+// Guest-side vertex-layout tracking (gx_vertex.cpp): follows the list's CP layout writes into the
+// getter shadow, or forgets the shadow when it cannot.
+void GxVtxShadowNoteDisplayList(uint32_t addr, uint32_t nbytes) noexcept;
+
+extern "C" void GX__CallDisplayList_80172f64(uint32_t listAddr, uint32_t nbytes) { GxVtxShadowNoteDisplayList(listAddr, nbytes); GX_HLE_DEFER(GX__CallDisplayList_80172f64, listAddr, nbytes);
+    if (nbytes == 0 || listAddr == 0) return;
+#if defined(__SWITCH__)
+    PumpAudioOnCadence();
+#endif
+    if (g_dlDepth++ != 0) {
+        GX__CallDisplayList_Impl(listAddr, nbytes);
+        --g_dlDepth;
+        return;
+    }
+    const uint64_t t0 = DlTick();
+    g_dlClass = 1;
+    try {
+        GX__CallDisplayList_Impl(listAddr, nbytes);
+    } catch (...) {
+        --g_dlDepth;
+        throw;
+    }
+    --g_dlDepth;
+    DlClassStats& st = g_dlStats[g_dlClass];
+    ++st.calls;
+    st.ticks += DlTick() - t0;
+    st.bytes += nbytes;
+    if (DlUniqueStatsEnabled()) {
+        DlSeen& seen = g_dlSeen[((listAddr >> 5) * 2654435761u) & (kDlSeenSlots - 1)];
+        if (seen.epoch != g_dlEpoch || seen.addr != listAddr || seen.size != nbytes) {
+            seen = {listAddr, nbytes, g_dlEpoch};
+            ++g_dlUnique[g_dlClass];
+        }
+    }
+}
+
+// perf.cfg `dl_prefetch` (default 1): the list's bytes are usually cold (r22: the copy of small
+// lists into the GX batch buffer was 1.2% of the race, almost all of it the first touch of guest
+// memory). Prefetching the first kDlPrefetchLines cache lines on entry overlaps that miss with the
+// class/scan cache lookups that run before anything reads the list.
+static bool DlPrefetchEnabled() {
+    static const bool enabled = kartpad_opt != nullptr && kartpad_opt("dl_prefetch", 1) != 0;
+    return enabled;
+}
+static uint32_t DlPrefetchLines() {
+    static const uint32_t lines = kartpad_opt != nullptr ? kartpad_opt("dl_prefetch_lines", 8) : 8;
+    return lines;
+}
+
+static void GX__CallDisplayList_Impl(uint32_t listAddr, uint32_t nbytes) {
+    try {
+        const uint8_t* list = static_cast<const uint8_t*>(GuestToHostPtr(listAddr, nbytes));
+        if (!list) return;
+        if (DlPrefetchEnabled()) {
+            const uint32_t lines = std::min<uint32_t>((nbytes + 63u) / 64u, DlPrefetchLines());
+            for (uint32_t line = 0; line < lines; ++line) {
+                __builtin_prefetch(list + line * 64u);
+            }
+        }
+
+        // Register-only lists contain only BP/CP/XF register writes and no draw primitives.
+        // Classifying them before hashing VCD/VAT state or probing the scan cache saves ~50% of display lists!
+        const DlClassResult classification = DisplayListMayContainDraw(list, listAddr, nbytes);
+        const bool mayContainDraw = classification.mayContainDraw;
+        if (!mayContainDraw) {
+            if (g_dlDepth == 1) g_dlClass = 0;
+            EnsureAuroraFrameActive();
+            GXMarkFrameWork();
+            const uint64_t ta = DlTick();
+            GXCallDisplayList(list, nbytes);
+            if (g_dlDepth == 1) g_dlRegAuroraTicks += DlTick() - ta;
+            // The republish is required even for register-only lists (verified by
+            // experiment: dropping it corrupts in-race geometry decode). It is
+            // instead memoized inside SyncAppliedVtxStateFromHleReal, so a run of
+            // register-only lists between draws pays for at most one mirror copy.
+            SyncAppliedVtxStateFromHleReal();
+            return;
+        }
+
+        const bool allowScanCache = nbytes <= kDlScanCacheMaxEntryBytes;
+        const uint64_t scanLayoutHash = allowScanCache ? HashScanLayoutState() : 0;
