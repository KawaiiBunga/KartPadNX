-    if (type == kWiiSockStream) {
-        return SOCK_STREAM;
-    }
-    if (type == kWiiSockDgram) {
-        return SOCK_DGRAM;
-    }
-#ifdef SOCK_RAW
-    if (type == kWiiSockRaw) {
