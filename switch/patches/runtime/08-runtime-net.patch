-bool IsWouldBlockError(int err) {
-#ifdef _WIN32
-    return err == WSAEWOULDBLOCK || err == WSAEINPROGRESS || err == WSAEALREADY;
-#else
-    return err == EWOULDBLOCK || err == EAGAIN || err == EINPROGRESS || err == EALREADY;
-#endif
-}
