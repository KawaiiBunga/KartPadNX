-static void ConfigureUdpSocket(NativeSocket socket, int type) {
-#ifdef _WIN32
-    if (type != SOCK_DGRAM) {
-        return;
-    }
-
-    BOOL disabled = FALSE;
-    DWORD bytesReturned = 0;
-    WSAIoctl(socket, SIO_UDP_CONNRESET, &disabled, sizeof(disabled),
-             nullptr, 0, &bytesReturned, nullptr, nullptr);
-#else
-    (void)socket;
-    (void)type;
-#endif
-}
