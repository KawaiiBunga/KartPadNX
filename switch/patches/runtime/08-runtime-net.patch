+static bool IsRetroNasSslHost(std::string_view hostname) {
+    if (!RetroRewindProfileActive()) {
+        return false;
+    }
+    const std::string lowered = Lower(hostname);
+    return StartsWith(lowered, "nas.") || StartsWith(lowered, "naswii.");
+}
