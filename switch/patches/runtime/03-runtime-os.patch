+    // Keep delivering audio; nothing wakes this thread again.
+    for (;;) {
+        if (!g_hosted.ticks) {
+            HostSleepNs(1'000'000'000);
+            continue;
+        }
+        HostSleepNs(1'000'000);
+        CpuContextScope scope(&ctx);
+        try {
+            RunAudioTick();
+        } catch (...) {
+        }
+    }
+}
+
+void* HostThreadEntry(void*) {
+    HostMain();
+    return nullptr;
+}
