+void HostSleepNs(int64_t ns) noexcept {
+#if defined(__SWITCH__)
+    svcSleepThread(ns);
+#else
+    std::this_thread::sleep_for(std::chrono::nanoseconds(ns));
+#endif
+}
+
+uint64_t NsSince(Clock::time_point start) noexcept {
+    return static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count());
+}
+
+// One AX audio interrupt slice: Audio_HLE_Tick delivers whichever 3 ms blocks are due. Runs
+// while the hosted thread is parked, on a copy of its registers (the interrupt uses the
+// interrupted thread's stack below its SP, as on hardware). Audio_HLE_Tick takes IL only around
+// the guest callbacks, so mix joins and sample pushes never hold the guest core off.
+void RunAudioTick() {
+    CpuContext* interrupted = TryGetCpuContext();
+    CpuContext registers = interrupted != nullptr ? *interrupted : g_hosted.ctx;
+    CpuContextScope scope(&registers);
+    Audio_HLE_HostTick(&registers);
+    g_tickRuns.fetch_add(1, std::memory_order_relaxed);
+}
+
+// Parked in a wait queue: wait for WakeHosted, servicing the audio interrupt meanwhile.
+bool TryLockIl() noexcept {
+    uint32_t expected = 0;
+    return g_ilWord.compare_exchange_strong(expected, 1u, std::memory_order_acquire, std::memory_order_relaxed);
+}
+
+// Exclusive mode, once woken: the sound thread runs only when the guest core lets it (scheduler
+// enabled, running thread of lower priority), but its AX interrupt keeps being delivered meanwhile.
+// The wait is announced as a thread wait (g_hostedWantsThread) for CoreYieldSlow to weigh.
+struct ThreadWait {
+    bool active = false;
+    Clock::time_point start{};
+    void Begin() noexcept {
+        if (active) return;
+        active = true;
+        start = Clock::now();
+        g_hostedWantsThread.fetch_add(1, std::memory_order_seq_cst);
+        g_hostedWants.fetch_add(1, std::memory_order_seq_cst);
+        g_ilContended[1].fetch_add(1, std::memory_order_relaxed);
+    }
+    void End() noexcept {
+        if (!active) return;
+        active = false;
+        g_hostedWants.fetch_sub(1, std::memory_order_seq_cst);
+        g_hostedWantsThread.fetch_sub(1, std::memory_order_seq_cst);
+        const uint64_t waited = NsSince(start);
+        g_ilWaitNs[1].fetch_add(waited, std::memory_order_relaxed);
+        if (waited > g_hostedWaitMaxNs.load(std::memory_order_relaxed)) {
+            g_hostedWaitMaxNs.store(waited, std::memory_order_relaxed);
+        }
+    }
+};
+
+void AcquireCore() noexcept;
+
+void ParkUntilWoken() {
+    auto nextTick = Clock::now();
+    bool woken = false;
+    ThreadWait wait;
+    for (;;) {
+        if (!woken) {
+            std::unique_lock<std::mutex> lock(g_hosted.mutex);
+            if (g_hosted.woken) {
+                g_hosted.woken = false;
+                woken = true;
+            } else if (!g_hosted.ticks) {
+                g_hosted.cv.wait(lock, [] { return g_hosted.woken; });
+                g_hosted.woken = false;
+                woken = true;
+            } else if (Clock::now() < nextTick) {
+                g_hosted.cv.wait_until(lock, nextTick, [] { return g_hosted.woken; });
+                if (g_hosted.woken) {
+                    g_hosted.woken = false;
+                    woken = true;
+                }
+            }
+        }
+        if (woken) {
+            // Parallel mode, or the AX interrupt that woke us kept IL for this burst.
+            if (!g_exclusive || t_coreHeld) {
+                wait.End();
+                return;
+            }
+            if (!g_hosted.ticks) {
+                AcquireCore();
+                return;
+            }
+            wait.Begin();
+            if (t_ilDepth == 0 && g_threadGrant.load(std::memory_order_acquire) && TryLockIl()) {
+                if (g_threadGrant.exchange(false, std::memory_order_acq_rel)) {
+                    t_coreHeld = true;
+                    wait.End();
+                    return;
+                }
+                IlUnlock();  // revoked in between: the guest core holds the core again
+            }
+            if (Clock::now() < nextTick) {
+                HostSleepNs(20'000);
+                continue;
+            }
+        }
+        nextTick = Clock::now() + kTickSlice;
+        t_parkTick = g_exclusive;
+        try {
+            RunAudioTick();
+        } catch (const std::exception& e) {
+            RT_LOGF(RT_TAG_OS, "[snd_host] audio tick threw: %s\n", e.what());
+        } catch (...) {
+            RT_LOGF(RT_TAG_OS, "[snd_host] audio tick threw\n");
+        }
+        t_parkTick = false;
+    }
+}
+
+// Exclusive mode: hold IL as a whole while this host thread runs guest code.
+void AcquireCore() noexcept {
+    if (t_coreHeld) return;
+    if (t_ilDepth == 0) {
+        if (t_hostedThread == 0 || !g_exclusive) {
+            IlLockSlow();
+        } else {
+            g_hostedWantsThread.fetch_add(1, std::memory_order_seq_cst);
+            for (;;) {
+                IlLockSlow();
+                if (g_threadGrant.exchange(false, std::memory_order_acq_rel)) break;
+                IlUnlock();  // offered for an interrupt only
+                HostSleepNs(20'000);
+            }
+            g_hostedWantsThread.fetch_sub(1, std::memory_order_seq_cst);
+        }
+    }
+    t_coreHeld = true;
+}
+
+void HostMain() {
+    if (kartpad_thread_apply) kartpad_thread_apply(kRoleSndGuest, 0);
+#if defined(__SWITCH__)
+    g_indirectRawDispatchMemo = g_hostedRawMemo;
+    g_indirectResolvedDispatchMemo = g_hostedResolvedMemo;
+#endif
