+            RT_LOGF(RT_TAG_OS, "[snd_host] thread 0x%08x threw: %s; sound processing stopped\n", thread, e.what());
+        } catch (...) {
+            RT_LOGF(RT_TAG_OS, "[snd_host] thread 0x%08x threw; sound processing stopped\n", thread);
+        }
+        g_hosted.running.store(false, std::memory_order_release);
+        g_hosted.settled.store(true, std::memory_order_release);
