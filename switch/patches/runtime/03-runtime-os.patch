+void GuestFiberManager::ResumeGuestThread(uint32_t guestThreadAddr) {
+    std::lock_guard<std::mutex> lock(s_mutex);
+    auto it = s_fibers.find(guestThreadAddr);
+    if (it == s_fibers.end()) {
+        RT_LOG(RT_TAG_OS) << "ResumeGuestThread: no fiber for 0x"
