+        RT_LOG(RT_TAG_OS) << "ResumeGuestThread: thread 0x"
+                  << std::hex << guestThreadAddr << " already terminated" << std::dec << std::endl;
+        return;
+    }
+    
+    it->second.state = ThreadState::READY;
