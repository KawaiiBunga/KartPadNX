+static void WakeupThreadQueue(CpuContext* ctx, bool allowImmediateReschedule)
+{
+    CpuContext* cpu = ctx ? ctx : &GetPersistentCpuContext();
+    const uint32_t queueAddr = cpu->gpr[3];
+    if (queueAddr == 0) {
