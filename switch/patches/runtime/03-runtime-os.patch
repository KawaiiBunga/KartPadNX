+namespace OsHleInternal {
+std::atomic<uint32_t> g_interrupt_mask{0};
+} // namespace OsHleInternal
+
+namespace {
+std::once_flag interrupt_init_log_once;
+std::once_flag exception_init_log_once;
+
+// This host thread's MSR[EE] (os_host_thread.h). Once a hosted guest thread exists, an EE=0
+// section holds the interrupt lock, which is what keeps it and the guest core apart.
+inline void SetHostEe(bool enabled)
+{
+    if (enabled == OsHostThread::t_eeEnabled) {
+        return;
+    }
+    if (enabled) {
+        OsHostThread::t_eeEnabled = true;
+        OsHostThread::IlRelease();
+    } else {
+        OsHostThread::IlAcquire();
+        OsHostThread::t_eeEnabled = false;
+    }
+}
+
+inline void UpdateCurrentContextInterruptFlag(bool enabled)
+{
+    // The hosted thread's saved context is not the guest core's current one.
+    if (OsHostThread::OnHostedThread()) {
+        return;
+    }
+    // Both OSDisableInterrupts and OSRestoreInterrupts land here. A failed lookup means no
+    // context exists yet (normal during early boot), so we just skip the write in that case.
+#if defined(__SWITCH__)
+    // Hot (every nw4r::snd lock): read through the scalar page proofs directly instead of the
+    // checked TryRead/TryWrite path. Same guest-visible read-modify-write; any page without a
+    // proof falls through to the checked path below.
+    if (const uintptr_t lowBias =
+            MemoryInline::g_scalarReadablePageBias[kOSCurrentContextAddr >> MemoryInline::kPageShift]) {
+        uint32_t ctxBits = 0;
+        std::memcpy(&ctxBits, reinterpret_cast<const void*>((lowBias - 1u) + kOSCurrentContextAddr), 4);
+        const uint32_t context = __builtin_bswap32(ctxBits);
+        if (context == 0) {
+            return;
+        }
+        const uint32_t flagsAddr = context + 0x1A2u;
+        const uintptr_t readBias = MemoryInline::g_scalarReadablePageBias[flagsAddr >> MemoryInline::kPageShift];
+        const uintptr_t writeBias = MemoryInline::g_scalarWritablePageBias[flagsAddr >> MemoryInline::kPageShift];
+        if (readBias != 0 && readBias == writeBias) {
+            auto* flags = reinterpret_cast<uint8_t*>((writeBias - 1u) + flagsAddr);
+            uint16_t raw = 0;
+            std::memcpy(&raw, flags, 2);
+            const uint16_t modeFlags = __builtin_bswap16(raw);
+            const uint16_t updated = enabled ? static_cast<uint16_t>(modeFlags | 0x0002u)
+                                             : static_cast<uint16_t>(modeFlags & static_cast<uint16_t>(~0x0002u));
+            if (updated != modeFlags) {
+                raw = __builtin_bswap16(updated);
+                std::memcpy(flags, &raw, 2);
+            }
+            return;
+        }
+    }
+#endif
+    uint32_t currentContext = 0;
+    if (!MemoryInline::TryReadGuestScalar(kOSCurrentContextAddr, currentContext) ||
+        currentContext == 0) {
+        return;
+    }
+    const uint32_t modeFlagsAddr = currentContext + 0x1A2u;
+    uint16_t modeFlags = 0;
+    if (!MemoryInline::TryReadGuestScalar(modeFlagsAddr, modeFlags)) {
+        return;
+    }
+    const uint16_t updated = enabled ? static_cast<uint16_t>(modeFlags | 0x0002u)
+                                     : static_cast<uint16_t>(modeFlags & static_cast<uint16_t>(~0x0002u));
+    if (updated == modeFlags) {
+        return;
+    }
+    MemoryInline::TryWriteGuestScalar(modeFlagsAddr, updated);
+}
+} // namespace
+
+// Minimal, host-side replacements for early OS interrupt/exception helpers. The EE flag is per
+// host thread and only read by the thread that owns it.
+// The trace reads only the caller's LR. Kept out of the native's own body because the translator
+// classifies any native whose body reaches for the CpuContext as a full-context call boundary, which
+// made every OSDisableInterrupts caller a full residency fence (b73).
+static void TraceDisableInterruptsCaller()
+{
+    if (const CpuContext* caller = TryGetCpuContext()) OsHostThread::TraceCall(1, caller->lr, 0);
+}
+
+extern "C" int32_t OS__DisableInterrupts_801a65ac()
+{
+    if (OsHostThread::g_traceCalls) {
+        TraceDisableInterruptsCaller();
+    }
+    const bool previous = OsHostThread::t_eeEnabled;
+    SetHostEe(false);
+    UpdateCurrentContextInterruptFlag(false);
+    return previous ? 1 : 0;
+}
+
+extern "C" int32_t OS__RestoreInterrupts_801a65d4(int32_t level)
+{
+    const bool prev = OsHostThread::t_eeEnabled;
+    SetHostEe(level != 0);
+    UpdateCurrentContextInterruptFlag(level != 0);
+    return prev ? 1 : 0;
