-GuestFiber* GuestFiberManager::GetFiber(uint32_t guestThreadAddr) {
-    std::lock_guard<std::mutex> lock(s_mutex);
-    auto it = s_fibers.find(guestThreadAddr);
-    return it != s_fibers.end() ? &it->second : nullptr;
