+// never hosted anything). The entry's first instruction is checked too, so another build or
+// region never matches.
+constexpr uint32_t kSoundThreadEntry = 0x800A49C0u;
+constexpr uint32_t kSoundThreadEntryInsn = 0x9421FFF0u;  // stwu r1, -16(r1)
+constexpr int kRoleSndGuest = 8;                          // perf_switch.h KARTPAD_ROLE_SND_GUEST
+constexpr auto kTickSlice = std::chrono::microseconds(1000);
+
+std::atomic<uint32_t> g_ilWord{0};
+std::atomic<uint64_t> g_ilContended[2]{};  // [0] fiber host, [1] hosted thread
+std::atomic<uint64_t> g_ilWaitNs[2]{};
+std::atomic<uint64_t> g_hostedWaitMaxNs{0};  // longest hosted IL wait since the last report
+std::atomic<uint64_t> g_coreYields{0};       // guest core handed IL to the hosted thread
+// Of g_hostedWants: waits to run the sound thread itself, which the Wii's priority rules gate
+// (CoreYieldSlow). The rest are AX interrupts, taken at any EE=1 point.
+std::atomic<int32_t> g_hostedWantsThread{0};
+std::atomic<uint64_t> g_coreYieldsDeferred{0};  // hand-overs refused by the priority/scheduler rule
