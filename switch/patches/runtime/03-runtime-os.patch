+void GuestFiberManager::SuspendGuestThread(uint32_t guestThreadAddr) {
+    std::lock_guard<std::mutex> lock(s_mutex);
+    
+    auto it = s_fibers.find(guestThreadAddr);
+    if (it == s_fibers.end()) {
+        return;
+    }
+    
+    it->second.state = ThreadState::WAITING;
+    
