+// over under the Wii's rules or waits/idles, revoked once it holds IL again. Without it a hosted
+// thread done with an interrupt could take IL back before the guest core and run a burst.
+std::atomic<bool> g_threadGrant{false};
+constexpr uint32_t kCoreBit = 0x80000000u;   // IlReleaseAll: the whole-thread hold
+bool g_exclusive = false;                    // perf.cfg snd_host_parallel 0; set before the thread starts
+__thread bool t_parkTick = false;            // hosted: RunAudioTick from ParkUntilWoken
+
