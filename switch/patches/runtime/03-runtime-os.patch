+// One guest thread can run on a host thread of its own instead of as a fiber on the guest core:
+// nw4r::snd's SoundThread (perf.cfg `snd_host_thread`, default 1), plus the AX audio interrupt
+// that feeds it (`snd_host_ticks`, default 1). It was ~16% of the guest core in a race, all of it
+// serialized with the game.
+//
+// The Wii runs both on one CPU: the sound thread and the AX interrupt preempt the game, and the
+// game keeps them out with interrupts disabled. Here they really run in parallel, so "interrupts
+// disabled" becomes a lock (IL) held by whichever host thread has its guest code in an EE=0
+// section, by guest interrupt callbacks, and by the HLE OS while it edits thread/mutex/message
+// state. Each host thread keeps its own EE flag. The fiber host still owns every other thread and
+// all scheduling; the hosted thread blocks and wakes on host primitives and never switches fibers.
+//
+// Parallel mode (default from b70; perf.cfg `snd_host_parallel 1`): the hosted thread runs guest
+// code alongside the game; IL excludes only EE=0 sections and interrupt callbacks. The b65 boot
+// crash blamed on it below was a thread switch inside a scratch-context NAND callback (b69).
+//
+// Exclusive mode (perf.cfg `snd_host_parallel 0`): the two never run guest code at the
+// same time, as on the Wii, where the higher-priority sound thread stops the game while it runs.
+// It costs the game core the whole sound workload (b69: ~320 ms/s waiting at stock clocks).
+// Each host thread holds IL as a whole (t_coreHeld) whenever it runs guest code, apart from its
+// EE=0 depth. The hosted thread drops it when it parks; the guest core hands it over at the points
+// where the Wii would switch to the sound thread or take the AX interrupt: interrupts re-enabled
+// (depth back to 0), a fiber switch, the idle loop, OSResumeThread of the sound thread, and host
+// waits (GX ring). b65 ran them in parallel and RR crashed at boot: MiiManager::Init called
+// through RootScene's MEM2 heap and found its vtable slot 0, with nothing else changed.
+
+#include <atomic>
+#include <cstdint>
+
+struct CpuContext;
+
+namespace OsHostThread {
+
+extern std::atomic<bool> g_ilEnabled;     // set once the hosted thread starts
+extern std::atomic<uint32_t> g_hostedWants;  // the hosted thread is waiting for IL
+extern __thread uint32_t t_ilDepth;       // IL holds by this host thread
+extern __thread bool t_coreHeld;          // exclusive mode: this host thread holds IL while it runs
+extern __thread uint32_t t_hostedThread;  // guest OSThread this host thread runs; 0 on the fiber host
+extern __thread bool t_eeEnabled;         // this host thread's MSR[EE]
+
+void IlLockSlow() noexcept;
+void IlUnlock() noexcept;
+// Guest core, exclusive mode: let the waiting hosted thread run its burst, then take IL back.
+void CoreYieldSlow() noexcept;
+
+inline void IlAcquire() noexcept {
+    if (!g_ilEnabled.load(std::memory_order_relaxed)) return;
+    if (t_ilDepth++ == 0 && !t_coreHeld) IlLockSlow();
+}
+
+// Depth back to 0 with the core held is a Wii preemption point (interrupts re-enabled).
+inline void IlRelease() noexcept {
+    if (t_ilDepth == 0) return;
+    if (--t_ilDepth != 0) return;
+    if (!t_coreHeld) {
+        IlUnlock();
+    } else if (g_hostedWants.load(std::memory_order_relaxed) != 0 && t_hostedThread == 0) {
+        CoreYieldSlow();
+    }
+}
+
+// Drop every hold of this host thread, the whole-thread one included (it is about to wait for the
+// other one); returns them for IlRestoreAll.
+uint32_t IlReleaseAll() noexcept;
+void IlRestoreAll(uint32_t depth) noexcept;
+
+class IlScope {
+public:
+    IlScope() noexcept { IlAcquire(); }
+    ~IlScope() { Release(); }
+    void Release() noexcept {
+        if (held_) {
+            held_ = false;
+            IlRelease();
+        }
+    }
+    IlScope(const IlScope&) = delete;
+    IlScope& operator=(const IlScope&) = delete;
+
+private:
+    bool held_ = true;
+};
+
+// Fiber switches on the fiber host (fiber_manager.cpp, SwitchHostFiber). Every guest thread has
+// its own MSR[EE] and its own IL holds, as each Wii thread reloads its own MSR, so a switch made
+// inside a lock scope must not hand the lock to the next fiber. b64: an alarm callback polled in
+// the scheduler's idle loop woke the game thread and switched to it inside the loop's IlScope; the
+// game then held IL for its whole frame and the hosted sound thread ran only while the game waited
+// for vsync (no sound at stock clocks).
+struct FiberIlState {
+    uint32_t depth;
+    bool ee;
+};
+
+// Before the switch: drop this fiber's holds (the core's own hold stays). A fiber starting fresh
+// begins with MSR[EE] set.
+inline FiberIlState FiberSwitchOut() noexcept {
+    const FiberIlState saved{t_ilDepth, t_eeEnabled};
+    if (t_ilDepth != 0) {
+        t_ilDepth = 0;
+        if (!t_coreHeld) IlUnlock();
+    }
+    t_eeEnabled = true;
+    return saved;
+}
+
+// After the switch back (whoever switched here dropped its holds first): this fiber's own state.
+// A fiber that went out with EE=0 before the hosted thread existed holds IL from now on. A thread
+// switch to a fiber with interrupts enabled is a preemption point.
+inline void FiberSwitchIn(const FiberIlState& saved) noexcept {
+    t_eeEnabled = saved.ee;
+    uint32_t depth = saved.depth;
+    if (g_ilEnabled.load(std::memory_order_relaxed)) {
+        if (!saved.ee && depth == 0) depth = 1;
+        if (depth != 0 && !t_coreHeld) IlLockSlow();
+    } else {
+        depth = 0;
+    }
+    t_ilDepth = depth;
+    if (depth == 0 && t_coreHeld && g_hostedWants.load(std::memory_order_relaxed) != 0) CoreYieldSlow();
+}
+
+inline bool OnHostedThread() noexcept { return t_hostedThread != 0; }
+bool IsHosted(uint32_t thread) noexcept;
+// The hosted thread runs the AX audio interrupt; the fiber host must not tick audio.
+bool OwnsAudioTicks() noexcept;
+
+// OS HLE hooks. All but ClaimCreatedThread run with this host thread's EE disabled (IL held).
+bool ClaimCreatedThread(uint32_t thread, uint32_t entry, uint32_t arg, const CpuContext& creator) noexcept;
+bool StartIfHosted(uint32_t thread) noexcept;               // OSResumeThread took the count to 0
+// OSResumeThread, after its EE=0 section, when StartIfHosted started the thread: waits (bounded)
+// until the hosted thread first blocks, as the Wii's higher-priority sound thread would run first.
+void AwaitHostedSettled() noexcept;
+void SleepHosted(CpuContext* cpu, uint32_t queue) noexcept;  // OSSleepThread on the hosted thread
+void WakeHosted(uint32_t thread) noexcept;                   // it was popped off a wait queue
+void SleepTicksHosted(uint64_t ticks) noexcept;              // OSSleepTicks on the hosted thread
+// A retry loop that cannot park (scheduler disabled) lets the hosted thread make progress.
+void PauseUnlocked() noexcept;
+// Audio_HLE_Tick, inside its guest-callback lock on the parked hosted thread: if the callback woke
+// the sound thread, keep IL for its burst instead of handing it back and forth (exclusive mode).
+void KeepIlForWokenSoundThread() noexcept;
+// Diagnostic (perf.cfg snd_heap_watch): recent OS calls per side (1 OSDisableInterrupts, 2 OSLockMutex,
+// 3 OSUnlockMutex) with the guest caller's LR, dumped when the heap watchdog fires.
+void TraceCallSlow(uint32_t kind, uint32_t lr, uint32_t arg) noexcept;
+extern bool g_traceCalls;
+inline void TraceCall(uint32_t kind, uint32_t lr, uint32_t arg) noexcept {
+    if (g_traceCalls) TraceCallSlow(kind, lr, arg);
+}
+// Fiber-host idle loop: a game thread may be waiting on the hosted thread, so poll instead of
+// sleeping to the next 1 ms service slice.
+bool HostedThreadRunning() noexcept;
+// OSLockMutex found the mutex held across the two host threads ([stages] snd mtx=).
+void NoteMutexBlocked(uint32_t owner) noexcept;
+
+}  // namespace OsHostThread
