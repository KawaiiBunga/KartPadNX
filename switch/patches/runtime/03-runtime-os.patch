+constexpr uint32_t kEggHeapList = 0x80384320u;       // nw4r::ut::List: head, tail, u16 count, u16 offset
+constexpr uint32_t kEggHeapRootMutex = 0x80384330u;  // EGG::Heap::sRootMutex; owner at +8
