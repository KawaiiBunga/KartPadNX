+        IlReleaseAll();
+        t_eeEnabled = true;
+        {
+            IlScope il;
+            try {
+                const uint16_t attributes = ::Memory::Read16(thread + kThreadAttrOffset);
+                const bool detached = (attributes & 1u) != 0;
+                if (!detached) ::Memory::Write32(thread + kThreadExitValueOffset, 0);
+                ::Memory::Write16(thread + kThreadStateOffset, detached ? 0u : kThreadStateMoribund);
+                OS_HLE_WakeupThreadNoReschedule(&ctx, thread + kThreadJoinQueueOffset);
+            } catch (const ::Memory::AccessViolation&) {
+            }
