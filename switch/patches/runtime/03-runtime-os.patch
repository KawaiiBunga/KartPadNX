+}  // namespace
+
+void IlLockSlow() noexcept {
+    uint32_t expected = 0;
+    if (g_ilWord.compare_exchange_strong(expected, 1u, std::memory_order_acquire, std::memory_order_relaxed)) {
+        if (t_hostedThread == 0) g_ilHoldStart = Clock::now();
+        return;
+    }
+    const int side = t_hostedThread != 0 ? 1 : 0;
+    g_ilContended[side].fetch_add(1, std::memory_order_relaxed);
+    if (side == 1) g_hostedWants.fetch_add(1, std::memory_order_seq_cst);
+    const auto start = Clock::now();
+    for (uint32_t spins = 0;; ++spins) {
+        if (g_ilWord.load(std::memory_order_relaxed) == 0) {
+            expected = 0;
+            if (g_ilWord.compare_exchange_weak(expected, 1u, std::memory_order_acquire,
+                                               std::memory_order_relaxed)) {
+                break;
+            }
+        }
+        if (spins < 4096) {
+            CpuPause();
+        } else if (side == 0) {
+            HostSleepNs(0);  // the guest core has nothing else to run
+        } else {
+            HostSleepNs(20'000);  // let the lower-priority workers sharing this core run
+        }
+    }
+    const uint64_t waited = NsSince(start);
+    g_ilWaitNs[side].fetch_add(waited, std::memory_order_relaxed);
+    if (side == 0) {
+        g_ilHoldStart = Clock::now();
+    } else {
+        g_hostedWants.fetch_sub(1, std::memory_order_relaxed);
+        if (waited > g_hostedWaitMaxNs.load(std::memory_order_relaxed)) {
+            g_hostedWaitMaxNs.store(waited, std::memory_order_relaxed);
+        }
+    }
+}
+
+// OSDisableScheduler nesting (os_internal.h): a woken higher-priority thread cannot preempt then.
+bool GuestSchedulerDisabled() noexcept {
+    uint32_t count = 0;
+    return MemoryInline::TryReadGuestScalar(kSchedulerIdleFlagAddr, count) && count != 0;
+}
+
+// The Wii's rule for the sound thread itself (not its AX interrupt): it preempts the guest core's
+// running thread only while the scheduler is enabled and that thread has a lower priority (a
+// higher number; the effective priority, so a thread holding a mutex the sound thread wants has
+// been raised to its level and is not preempted).
+bool SoundThreadMayPreempt() noexcept {
+    if (GuestSchedulerDisabled()) return false;
+    uint32_t running = 0;
+    if (!MemoryInline::TryReadGuestScalar(kOSRunningContextAddr, running) || running == 0) return true;
+    uint32_t runningPriority = 0, soundPriority = 0;
+    if (!MemoryInline::TryReadGuestScalar(running + kThreadPriorityOffset, runningPriority) ||
+        !MemoryInline::TryReadGuestScalar(g_hosted.thread + kThreadPriorityOffset, soundPriority)) {
+        return true;
+    }
+    return static_cast<int32_t>(runningPriority) > static_cast<int32_t>(soundPriority);
+}
+
+void CoreYieldSlow() noexcept {
+    // An AX interrupt is taken at any EE=1 point; a sound-thread burst only when the Wii would
+    // switch to it. Otherwise the next preemption point, a thread switch or the idle loop will do.
+    const int32_t waiting = static_cast<int32_t>(g_hostedWants.load(std::memory_order_seq_cst));
+    const int32_t asThread = g_hostedWantsThread.load(std::memory_order_seq_cst);
+    const bool grant = SoundThreadMayPreempt();
+    if (waiting - asThread <= 0 && !grant) {
+        g_coreYieldsDeferred.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    if (grant) g_threadGrant.store(true, std::memory_order_release);
+    g_coreYields.fetch_add(1, std::memory_order_relaxed);
+    t_coreHeld = false;
+    IlUnlock();
+    // Don't race the waiter back to the lock: it may be between two of its 20 us sleeps. Bounded,
+    // so a waiter that already gave up never stalls the game.
+    const auto start = Clock::now();
+    for (uint32_t spins = 1; g_hostedWants.load(std::memory_order_seq_cst) != 0 &&
+                             g_ilWord.load(std::memory_order_relaxed) == 0;
+         ++spins) {
+        CpuPause();
+        if ((spins & 255u) == 0 && NsSince(start) > 1'000'000) break;
+    }
+    IlLockSlow();  // the burst runs; [stages] snd il guest= is this wait
+    g_threadGrant.store(false, std::memory_order_release);
+    t_coreHeld = true;
+}
+
+void HeapWatchCheck() noexcept;
+
+void IlUnlock() noexcept {
+    if (g_heapWatch) HeapWatchCheck();
+    if (t_hostedThread == 0) {
+        const uint64_t held = NsSince(g_ilHoldStart);
+        g_ilHoldNs.fetch_add(held, std::memory_order_relaxed);
+        if (held > g_ilHoldMaxNs.load(std::memory_order_relaxed)) {
+            g_ilHoldMaxNs.store(held, std::memory_order_relaxed);
+        }
+    }
+    g_ilWord.store(0, std::memory_order_release);
+}
+
+uint32_t IlReleaseAll() noexcept {
+    const uint32_t held = t_ilDepth | (t_coreHeld ? kCoreBit : 0u);
+    if (t_coreHeld && t_hostedThread == 0) g_threadGrant.store(true, std::memory_order_release);
+    if (held != 0) {
+        t_ilDepth = 0;
+        t_coreHeld = false;
+        IlUnlock();
+    }
+    return held;
+}
+
+// Adds to what is held already (KeepIlForWokenSoundThread may have kept the lock).
+void IlRestoreAll(uint32_t held) noexcept {
+    if (held == 0) return;
+    if ((held & kCoreBit) != 0 && t_hostedThread != 0 && g_exclusive) {
+        AcquireCore();  // the sound thread resumes: priority rules apply
+    } else if (t_ilDepth == 0 && !t_coreHeld) {
+        IlLockSlow();
+        if (t_hostedThread == 0) g_threadGrant.store(false, std::memory_order_release);
+    }
+    t_ilDepth += held & ~kCoreBit;
+    if ((held & kCoreBit) != 0) t_coreHeld = true;
+}
+
+void KeepIlForWokenSoundThread() noexcept {
+    if (!t_parkTick || t_coreHeld || t_ilDepth == 0) return;
+    // The interrupted guest thread outranks the sound thread (or has the scheduler off): the
+    // burst waits for a later point, as on the Wii.
+    if (!SoundThreadMayPreempt()) return;
+    std::lock_guard<std::mutex> lock(g_hosted.mutex);
+    if (g_hosted.woken) t_coreHeld = true;
+}
+
+namespace {
+int64_t SteadyNs() noexcept {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now().time_since_epoch()).count();
+}
+
+bool GuestWordAt(uint32_t address, uint32_t& value) noexcept {
+    return MemoryInline::TryReadGuestScalar(address, value);
+}
+
+bool PlausibleCode(uint32_t address) noexcept {
+    return address >= 0x80000000u && address < 0x82000000u && (address & 3u) == 0;
+}
+
+void DumpTraces() {
+    static const char* const kKinds[] = {"?", "DisableInterrupts", "LockMutex", "UnlockMutex"};
+    for (int s = 0; s < 2; ++s) {
+        const uint32_t next = g_traceNext[s].load(std::memory_order_relaxed);
+        const uint32_t n = next < kTraceEntries ? next : kTraceEntries;
+        RT_LOGF(RT_TAG_OS, "[heapwatch] last %u OS calls on the %s (oldest first, %u total):\n", n,
+                s ? "sound thread" : "guest core", next);
+        for (uint32_t k = next - n; k != next; ++k) {
+            const TraceEntry& e = g_trace[s][k % kTraceEntries];
+            RT_LOGF(RT_TAG_OS, "[heapwatch]   %s lr 0x%08x arg 0x%08x\n", kKinds[e.kind < 4 ? e.kind : 0], e.lr, e.arg);
+        }
+    }
+}
+
+// A MEM exp heap block lies outside its heap, has a bad signature or link, or a free block covers
+// an EGG heap object (heap objects live in used blocks of their parent).
+void FreeListReport(int side, uint32_t heap, uint32_t handle, uint32_t block, const char* what, uint32_t extra) {
+    if (g_heapWatchFired.exchange(true)) return;
+    const int64_t now = SteadyNs();
+    const int64_t mine = g_heapCleanNs[side].load(std::memory_order_relaxed);
+    const int64_t other = g_heapCleanNs[side ^ 1].load(std::memory_order_relaxed);
+    RT_LOGF(RT_TAG_OS,
+            "[heapwatch] MEM free list of EGG heap 0x%08x (MEM 0x%08x): block 0x%08x %s (0x%08x); found by the %s. "
+            "Last clean walk: this side %.3f ms ago, other side %.3f ms ago. checks %llu, sound wakes %llu, ticks %llu\n",
+            heap, handle, block, what, extra, side ? "sound thread (hosted)" : "guest core",
+            mine ? (now - mine) / 1e6 : -1.0, other ? (now - other) / 1e6 : -1.0,
+            static_cast<unsigned long long>(g_heapChecks.load()),
+            static_cast<unsigned long long>(g_wakes.load()), static_cast<unsigned long long>(g_tickRuns.load()));
+    for (uint32_t row = 0; row < 4; ++row) {
+        const uint32_t base = block + row * 16u;
+        uint32_t w[4] = {};
+        for (int k = 0; k < 4; ++k) GuestWordAt(base + 4u * k, w[k]);
+        RT_LOGF(RT_TAG_OS, "[heapwatch]   %08x: %08x %08x %08x %08x\n", base, w[0], w[1], w[2], w[3]);
+    }
+    DumpTraces();
+    std::fflush(stderr);
+}
+
+void HeapWatchReport(int side, uint32_t heap, uint32_t vtable, uint32_t slot, uint32_t index, uint32_t count) {
+    if (g_heapWatchFired.exchange(true)) return;
+    const int64_t now = SteadyNs();
+    const int64_t mine = g_heapCleanNs[side].load(std::memory_order_relaxed);
+    const int64_t other = g_heapCleanNs[side ^ 1].load(std::memory_order_relaxed);
+    RT_LOGF(RT_TAG_OS,
+            "[heapwatch] EGG heap 0x%08x (#%u of %u) vtable 0x%08x alloc slot 0x%08x: found by the %s. "
+            "Last clean walk: %s %.3f ms ago, %s %.3f ms ago (the more recent one bounds the writer). "
+            "checks %llu, sound wakes %llu, audio ticks %llu, sound thread lr 0x%08x\n",
+            heap, index, count, vtable, slot, side ? "sound thread (hosted)" : "guest core",
+            side ? "sound thread" : "guest core", mine ? (now - mine) / 1e6 : -1.0,
+            side ? "guest core" : "sound thread", other ? (now - other) / 1e6 : -1.0,
+            static_cast<unsigned long long>(g_heapChecks.load()),
+            static_cast<unsigned long long>(g_wakes.load()), static_cast<unsigned long long>(g_tickRuns.load()),
+            g_hosted.ctx.lr);
+    for (uint32_t row = 0; row < 8; ++row) {
+        const uint32_t base = heap - 0x20u + row * 16u;
+        uint32_t w[4] = {};
+        for (int k = 0; k < 4; ++k) GuestWordAt(base + 4u * k, w[k]);
+        RT_LOGF(RT_TAG_OS, "[heapwatch]   %08x: %08x %08x %08x %08x\n", base, w[0], w[1], w[2], w[3]);
+    }
+    DumpTraces();
+    std::fflush(stderr);
+}
+}  // namespace
+
+void HeapWatchCheck() noexcept {
+    if (g_heapWatchFired.load(std::memory_order_relaxed)) return;
+    const int side = t_hostedThread != 0 ? 1 : 0;
+    uint32_t owner = 0, head = 0, countOffset = 0;
+    // The game is creating or destroying a heap: the list may be half-linked.
+    if (!GuestWordAt(kEggHeapRootMutex + 8u, owner) || owner != 0) return;
+    if (!GuestWordAt(kEggHeapList, head) || !GuestWordAt(kEggHeapList + 8u, countOffset)) return;
+    const uint32_t count = countOffset >> 16, offset = countOffset & 0xffffu;
+    constexpr uint32_t kMaxHeaps = 128;
+    uint32_t heaps[kMaxHeaps];
+    uint32_t numHeaps = 0;
+    uint32_t heap = head;
+    for (uint32_t i = 0; heap != 0 && i < count && i < 512; ++i) {
+        uint32_t vtable = 0, slot = 0;
+        if (!GuestWordAt(heap, vtable)) return;
+        if (!PlausibleCode(vtable) || !GuestWordAt(vtable + 0x14u, slot) || !PlausibleCode(slot)) {
+            HeapWatchReport(side, heap, vtable, slot, i, count);
+            return;
+        }
+        if (numHeaps < kMaxHeaps) heaps[numHeaps++] = heap;
+        if (!GuestWordAt(heap + offset + 4u, heap)) return;
+    }
+    // MEM exp heap free lists (MEMiHeapHead 'EXPH' at [heap+0x10]: start +0x18, end +0x1C, free
+    // list head +0x3C; blocks: u16 'FR', u16 attr, u32 size, prev, next; 0x10-byte header).
+    for (uint32_t h = 0; h < numHeaps; ++h) {
+        uint32_t handle = 0, sig = 0, start = 0, end = 0, block = 0;
+        if (!GuestWordAt(heaps[h] + 0x10u, handle) || !GuestWordAt(handle, sig) || sig != 0x45585048u) continue;
+        if (!GuestWordAt(handle + 0x18u, start) || !GuestWordAt(handle + 0x1Cu, end) ||
+            !GuestWordAt(handle + 0x3Cu, block)) {
+            continue;
+        }
+        uint32_t prev = 0;
+        for (uint32_t n = 0; block != 0 && n < 4096; ++n) {
+            uint32_t tag = 0, size = 0, linkPrev = 0, next = 0;
+            if (!GuestWordAt(block, tag) || !GuestWordAt(block + 4u, size) || !GuestWordAt(block + 8u, linkPrev) ||
+                !GuestWordAt(block + 12u, next)) {
+                break;
+            }
+            if ((tag >> 16) != 0x4652u) return FreeListReport(side, heaps[h], handle, block, "bad signature", tag);
+            if (block < start || block + 0x10u + size > end || block + 0x10u + size < block) {
+                return FreeListReport(side, heaps[h], handle, block, "outside its heap", size);
+            }
+            if (linkPrev != prev) return FreeListReport(side, heaps[h], handle, block, "bad prev link", linkPrev);
+            if (prev != 0 && block <= prev) return FreeListReport(side, heaps[h], handle, block, "out of order", prev);
+            const uint32_t blockEnd = block + 0x10u + size;
+            for (uint32_t o = 0; o < numHeaps; ++o) {
+                if (heaps[o] >= block && heaps[o] < blockEnd) {
+                    return FreeListReport(side, heaps[h], handle, block, "covers an EGG heap object", heaps[o]);
+                }
+            }
+            prev = block;
+            block = next;
+        }
+    }
+    g_heapCleanNs[side].store(SteadyNs(), std::memory_order_relaxed);
+    g_heapChecks.fetch_add(1, std::memory_order_relaxed);
+}
+
+void TraceCallSlow(uint32_t kind, uint32_t lr, uint32_t arg) noexcept {
+    const int side = t_hostedThread != 0 ? 1 : 0;
+    const uint32_t i = g_traceNext[side].fetch_add(1, std::memory_order_relaxed);
+    g_trace[side][i % kTraceEntries] = TraceEntry{kind, lr, arg};
+}
+
+bool IsHosted(uint32_t thread) noexcept {
+    return thread != 0 && g_claimed.load(std::memory_order_acquire) && thread == g_hosted.thread;
+}
+
+bool OwnsAudioTicks() noexcept {
+    return g_ownsTicks.load(std::memory_order_acquire);
+}
+
+bool HostedThreadRunning() noexcept {
+    return g_hosted.running.load(std::memory_order_relaxed);
+}
+
+void NoteMutexBlocked(uint32_t owner) noexcept {
+    if (!g_ilEnabled.load(std::memory_order_relaxed)) return;
+    if (t_hostedThread != 0) {
+        g_hostedBlockedOnGuest.fetch_add(1, std::memory_order_relaxed);
+    } else if (IsHosted(owner)) {
+        g_guestBlockedOnHosted.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+bool ClaimCreatedThread(uint32_t thread, uint32_t entry, uint32_t arg, const CpuContext& creator) noexcept {
+    if (thread == 0 || g_claimed.load(std::memory_order_relaxed)) return false;
+    if (entry != kSoundThreadEntry) {
+        // A handful per boot; names every guest thread in the log (b61 matched none of them).
+        RT_LOGF(RT_TAG_OS, "[snd_host] OSCreateThread 0x%08x entry 0x%08x (fiber)\n", thread, entry);
+        return false;
+    }
+    if (!kartpad_opt || kartpad_opt("snd_host_thread", 1) == 0) return false;
+    uint32_t insn = 0;
+    if (!MemoryInline::TryReadGuestScalar(entry, insn) || insn != kSoundThreadEntryInsn) {
+        RT_LOGF(RT_TAG_OS, "[snd_host] entry 0x%08x does not match SoundThreadFunc (0x%08x); not hosting\n",
+                entry, insn);
+        return false;
+    }
+    if (g_claimed.load(std::memory_order_relaxed)) return false;
+    g_hosted.thread = thread;
+    g_hosted.entry = entry;
+    g_hosted.arg = arg;
+    g_hosted.ticks = kartpad_opt("snd_host_ticks", 1) != 0;
+    g_hosted.ctx = creator;  // fibers inherit the shared register file (GQRs, HID2, FPSCR) the same way
+    if (g_hosted.ctx.hid2 == 0) g_hosted.ctx.hid2 = 0x10000000u;  // OSCreateThread's fiber default
+    g_claimed.store(true, std::memory_order_release);
+    return true;
+}
+
+bool StartIfHosted(uint32_t thread) noexcept {
+    if (!IsHosted(thread) || g_hosted.started) return false;
+    g_hosted.started = true;
+    try {
+        ::Memory::Write16(thread + kThreadStateOffset, kThreadStateRunning);
+        ::Memory::Write32(thread + kThreadQueueOffset, 0);
+    } catch (const ::Memory::AccessViolation&) {
+    }
+    // IL goes live before a second host thread can touch guest state. The caller (OSResumeThread)
+    // is inside an EE=0 section, which from now on holds IL.
+    // b70 defaults: parallel (exclusive cost the game core ~320 ms/s of sound work at stock), and no
+    // heap watchdog (b69 found the boot crash; in parallel mode it would walk every heap at each
+    // interrupt re-enable).
+    g_exclusive = !(kartpad_opt && kartpad_opt("snd_host_parallel", 1) != 0);
+    g_heapWatch = kartpad_opt && kartpad_opt("snd_heap_watch", 0) != 0;
+    g_traceCalls = g_heapWatch;
+    g_ilEnabled.store(true, std::memory_order_seq_cst);
+    if (!t_eeEnabled && t_ilDepth == 0) {
+        IlLockSlow();
+        t_ilDepth = 1;
+    }
+    if (g_exclusive) AcquireCore();
+    g_ownsTicks.store(g_hosted.ticks, std::memory_order_release);
+    // A raw pthread that is never joined or detached: it lives for the whole session. b63 used
+    // std::thread(...).detach(); libsysbase's pthread_detach fails on the Switch, so libstdc++
+    // threw and unwinding destroyed the still-joinable std::thread -> std::terminate() at boot,
+    // with this thread holding IL. attr NULL: the pthread_create wrap gives it the 8 MiB floor.
+    pthread_t tid;
+    const int rc = pthread_create(&tid, nullptr, HostThreadEntry, nullptr);
+    if (rc != 0) {
+        // The claimed thread has no fiber, so it cannot fall back to the scheduler: sound stays
+        // silent, the game keeps running, and the idle loop delivers the AX ticks again.
+        RT_LOGF(RT_TAG_OS, "[snd_host] could not start the host thread (pthread_create %d); sound thread will not run\n", rc);
+        g_ownsTicks.store(false, std::memory_order_release);
+        g_hosted.settled.store(true, std::memory_order_release);
+    }
+    return true;
+}
+
+void AwaitHostedSettled() noexcept {
+    // On the Wii the sound thread outranks its creator, so OSResumeThread switches to it and the
+    // creator continues only once it blocks (on its message queue). Its setup (AX callback
+    // registration) needs IL, which an EE=0 caller would still hold: such a caller cannot wait.
+    if (t_ilDepth != 0 || g_hosted.settled.load(std::memory_order_acquire)) return;
+    const uint32_t held = IlReleaseAll();  // exclusive mode: the core's own hold
+    const auto deadline = Clock::now() + std::chrono::milliseconds(500);
+    while (!g_hosted.settled.load(std::memory_order_acquire)) {
+        if (Clock::now() >= deadline) {
+            RT_LOGF(RT_TAG_OS, "[snd_host] sound thread still starting after 500 ms; creator continues\n");
+            break;
+        }
+        HostSleepNs(50'000);
+    }
+    IlRestoreAll(held);
+}
+
+void SleepHosted(CpuContext* cpu, uint32_t queue) noexcept {
+    const uint32_t thread = t_hostedThread;
+    const int32_t irqState = OS__DisableInterrupts_801a65ac();
+    try {
+        ::Memory::Write16(thread + kThreadStateOffset, kThreadStateWaiting);
+        const int32_t priority = static_cast<int32_t>(::Memory::Read32(thread + kThreadPriorityOffset));
+        InsertThreadIntoQueueByPriority(queue, thread, priority);
+    } catch (const ::Memory::AccessViolation& e) {
+        LogMemoryError(RT_TAG_OS, "OSSleepThread(hosted)", e);
+        OS__RestoreInterrupts_801a65d4(irqState);
+        return;
+    }
+
+    static thread_local Clock::time_point busyStart = Clock::now();
+    g_busyNs.fetch_add(NsSince(busyStart), std::memory_order_relaxed);
+    g_hosted.running.store(false, std::memory_order_release);
+    const uint32_t depth = IlReleaseAll();
+    g_hosted.settled.store(true, std::memory_order_release);
+    ParkUntilWoken();
+    IlRestoreAll(depth);
+    g_hosted.running.store(true, std::memory_order_release);
+    busyStart = Clock::now();
+    (void)cpu;
+
+    // WakeHosted already marked us RUNNING and off the queue.
+    OS__RestoreInterrupts_801a65d4(irqState);
+}
+
+void WakeHosted(uint32_t thread) noexcept {
+    try {
+        ::Memory::Write16(thread + kThreadStateOffset, kThreadStateRunning);
+        ::Memory::Write32(thread + kThreadQueueOffset, 0);
+    } catch (const ::Memory::AccessViolation&) {
+    }
+    {
+        std::lock_guard<std::mutex> lock(g_hosted.mutex);
+        g_hosted.woken = true;
+    }
+    g_hosted.cv.notify_one();
+    g_wakes.fetch_add(1, std::memory_order_relaxed);
+}
+
+void SleepTicksHosted(uint64_t ticks) noexcept {
+    // Wii timebase: bus clock / 4 = 60.75 MHz.
+    const int64_t ns = static_cast<int64_t>(ticks * 1000ull / 60750ull * 1000ull);
+    const uint32_t depth = IlReleaseAll();
+    g_hosted.running.store(false, std::memory_order_release);
+    HostSleepNs(ns > 0 ? ns : 0);
+    g_hosted.running.store(true, std::memory_order_release);
+    IlRestoreAll(depth);
+}
+
+void PauseUnlocked() noexcept {
+    if (!g_ilEnabled.load(std::memory_order_relaxed)) return;
+    const uint32_t depth = IlReleaseAll();
+    for (int i = 0; i < 256; ++i) CpuPause();
+    HostSleepNs(0);
+    IlRestoreAll(depth);
+}
+
+}  // namespace OsHostThread
+
+// [stages] snd field (perf_diag.cpp): hosted thread wakes, audio ticks, busy ns, IL contention and
+// wait ns on the guest core / hosted thread, whether hosting is active, then OSLockMutex calls that
+// found the mutex held by the other host thread (guest core blocked / hosted thread blocked), then
+// the guest core's total IL hold ns and its longest hold since the previous call, then the guest
+// core's hand-overs to the hosted thread, the hosted thread's longest IL wait since the previous
+// call, the mode (1 exclusive, 0 parallel), and hand-overs the priority/scheduler rule deferred.
+extern "C" void kartpad_snd_host_counters(uint64_t* out) {
+    using namespace OsHostThread;
+    out[0] = g_wakes.load(std::memory_order_relaxed);
+    out[1] = g_tickRuns.load(std::memory_order_relaxed);
+    out[2] = g_busyNs.load(std::memory_order_relaxed);
+    out[3] = g_ilContended[0].load(std::memory_order_relaxed);
+    out[4] = g_ilWaitNs[0].load(std::memory_order_relaxed);
+    out[5] = g_ilContended[1].load(std::memory_order_relaxed);
+    out[6] = g_ilWaitNs[1].load(std::memory_order_relaxed);
+    out[7] = g_ilEnabled.load(std::memory_order_relaxed) ? 1u : 0u;
+    out[8] = g_guestBlockedOnHosted.load(std::memory_order_relaxed);
+    out[9] = g_hostedBlockedOnGuest.load(std::memory_order_relaxed);
+    out[10] = g_ilHoldNs.load(std::memory_order_relaxed);
+    out[11] = g_ilHoldMaxNs.exchange(0, std::memory_order_relaxed);
+    out[12] = g_coreYields.load(std::memory_order_relaxed);
+    out[13] = g_hostedWaitMaxNs.exchange(0, std::memory_order_relaxed);
+    out[14] = g_exclusive ? 1u : 0u;
+    out[15] = g_coreYieldsDeferred.load(std::memory_order_relaxed);
+}
+
+// Host waits on the guest core (gx_hle_thread.cpp ProducerWait): with interrupts enabled the sound
+// thread may run while the core sleeps. Weak in callers, so standalone tests link without this.
+extern "C" uint32_t kartpad_guest_wait_begin() {
+    using namespace OsHostThread;
+    if (!t_coreHeld || t_ilDepth != 0 || t_hostedThread != 0 || GuestSchedulerDisabled()) return 0;
+    g_threadGrant.store(true, std::memory_order_release);  // the guest thread is blocked
+    t_coreHeld = false;
+    IlUnlock();
+    return 1;
+}
+
+extern "C" void kartpad_guest_wait_end(uint32_t released) {
+    using namespace OsHostThread;
+    if (released == 0) return;
+    IlLockSlow();
+    g_threadGrant.store(false, std::memory_order_release);
+    t_coreHeld = true;
+}
